<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= typeof title !=='undefined' ? title : 'Dashboard' %>
    </title>

    <!-- Font Awesome & Google Fonts -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 4 (keep for grid/modal/dropdown) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/css/bootstrap.min.css" rel="stylesheet">

    <!-- jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Theme: anti-flash -->
    <script>
        (function() {
            var theme = localStorage.getItem('aqua-theme');
            if (theme === 'dark') {
                document.documentElement.classList.add('theme-dark');
            }
        })();
    </script>

    <style>
        /* ============================================
           OCTAVIA DESIGN SYSTEM — Layout Foundation
           Light, friendly, structured — blue primary
           ============================================ */

        :root {
            /* Primary */
            --oct-primary: #3B82F6;
            --oct-primary-dark: #2563EB;
            --oct-primary-light: #93C5FD;
            --oct-primary-bg: #EFF6FF;

            /* Accents */
            --oct-green: #4ADE80;
            --oct-green-dark: #16A34A;
            --oct-yellow: #FBBF24;
            --oct-yellow-dark: #D97706;
            --oct-pink: #F472B6;
            --oct-pink-dark: #DB2777;
            --oct-indigo: #6366F1;
            --oct-red: #EF4444;

            /* Surfaces */
            --oct-bg: #F5F7FA;
            --oct-card: #FFFFFF;
            --oct-card-hover: #FAFBFC;

            /* Text */
            --oct-text: #1E293B;
            --oct-text-2: #64748B;
            --oct-text-muted: #94A3B8;

            /* Borders & shadows */
            --oct-border: #E2E8F0;
            --oct-border-light: #F1F5F9;
            --oct-shadow-sm: 0 2px 12px rgba(0, 0, 0, 0.06);
            --oct-shadow-md: 0 8px 24px rgba(0, 0, 0, 0.12);
            --oct-shadow-lift: 0 12px 32px rgba(0, 0, 0, 0.1);

            /* Sidebar */
            --oct-sidebar-w: 220px;
            --oct-sidebar-bg: #FFFFFF;
            --oct-sidebar-active: #EFF6FF;
            --oct-sidebar-hover: #F8FAFC;
            --oct-sidebar-text: #64748B;
            --oct-sidebar-text-active: #3B82F6;
            --oct-sidebar-border: #F1F5F9;
        }

        .theme-dark {
            --oct-bg: #0F172A;
            --oct-card: #1E293B;
            --oct-card-hover: #253349;
            --oct-text: #F1F5F9;
            --oct-text-2: #CBD5E1;
            --oct-text-muted: #64748B;
            --oct-border: #334155;
            --oct-border-light: #1E293B;
            --oct-primary-bg: rgba(59, 130, 246, 0.1);
            --oct-shadow-sm: 0 2px 12px rgba(0, 0, 0, 0.2);
            --oct-shadow-md: 0 8px 24px rgba(0, 0, 0, 0.3);
            --oct-shadow-lift: 0 12px 32px rgba(0, 0, 0, 0.35);
            --oct-sidebar-bg: #1E293B;
            --oct-sidebar-active: rgba(59, 130, 246, 0.12);
            --oct-sidebar-hover: #253349;
            --oct-sidebar-text: #94A3B8;
            --oct-sidebar-text-active: #93C5FD;
            --oct-sidebar-border: #334155;
        }

        /* ── Reset & Base ── */
        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--oct-bg) !important;
            color: var(--oct-text);
            margin: 0;
            min-height: 100vh;
        }

        h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
            font-family: 'Poppins', sans-serif;
            color: var(--oct-text);
        }

        /* ── Layout Shell ── */
        .oct-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ── */
        .oct-sidebar {
            width: var(--oct-sidebar-w);
            background: var(--oct-sidebar-bg);
            border-right: 1px solid var(--oct-sidebar-border);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease;
            overflow-y: auto;
        }

        .oct-sidebar-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1.25rem 1.25rem;
            text-decoration: none;
            border-bottom: 1px solid var(--oct-sidebar-border);
        }

        .oct-sidebar-brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--oct-primary), var(--oct-indigo));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1rem;
        }

        .oct-sidebar-brand-text {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1.0625rem;
            color: var(--oct-text);
            letter-spacing: -0.01em;
        }

        .oct-sidebar-nav {
            list-style: none;
            padding: 0.75rem 0.625rem;
            margin: 0;
            flex: 1;
        }

        .oct-sidebar-label {
            font-size: 0.6875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--oct-text-muted);
            padding: 0.75rem 0.75rem 0.375rem;
        }

        .oct-nav-item {
            margin-bottom: 2px;
        }

        .oct-nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.625rem 0.75rem;
            border-radius: 10px;
            color: var(--oct-sidebar-text);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.15s ease;
        }

        .oct-nav-link:hover {
            background: var(--oct-sidebar-hover);
            color: var(--oct-text);
            text-decoration: none;
        }

        .oct-nav-link.active {
            background: var(--oct-sidebar-active);
            color: var(--oct-sidebar-text-active);
            font-weight: 600;
        }

        .oct-nav-link i {
            width: 20px;
            text-align: center;
            font-size: 0.9375rem;
        }

        .oct-sidebar-footer {
            padding: 1rem 0.625rem;
            border-top: 1px solid var(--oct-sidebar-border);
        }

        /* ── Main Content ── */
        .oct-main {
            flex: 1;
            margin-left: var(--oct-sidebar-w);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── Topbar ── */
        .oct-topbar {
            background: var(--oct-card);
            border-bottom: 1px solid var(--oct-border-light);
            padding: 0 1.5rem;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .oct-topbar-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .oct-sidebar-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.25rem;
            color: var(--oct-text-2);
            cursor: pointer;
            padding: 0.375rem;
            border-radius: 8px;
        }

        .oct-sidebar-toggle:hover {
            background: var(--oct-primary-bg);
            color: var(--oct-primary);
        }

        .oct-topbar-right {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .oct-topbar-btn {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            border: none;
            background: transparent;
            color: var(--oct-text-2);
            font-size: 1.05rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s ease;
        }

        .oct-topbar-btn:hover {
            background: var(--oct-primary-bg);
            color: var(--oct-primary);
        }

        .oct-user-menu {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            padding: 0.375rem 0.625rem;
            border-radius: 10px;
            transition: background 0.15s ease;
        }

        .oct-user-menu:hover {
            background: var(--oct-primary-bg);
        }

        .oct-user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--oct-primary), var(--oct-indigo));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 0.875rem;
        }

        .oct-user-name {
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--oct-text);
        }

        /* ── Page Content ── */
        .oct-content {
            flex: 1;
            padding: 1.5rem 1.75rem 2rem;
        }

        /* ── Footer ── */
        .oct-footer {
            background: var(--oct-card);
            border-top: 1px solid var(--oct-border-light);
            padding: 1rem 1.75rem;
            text-align: center;
            font-size: 0.8125rem;
            color: var(--oct-text-muted);
        }

        /* ── Dropdown overrides ── */
        .dropdown-menu {
            border: 1px solid var(--oct-border);
            border-radius: 12px;
            box-shadow: var(--oct-shadow-md);
            padding: 0.5rem;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 0.5rem 0.875rem;
            font-size: 0.875rem;
            color: var(--oct-text);
        }

        .dropdown-item:hover {
            background: var(--oct-primary-bg);
            color: var(--oct-primary);
        }

        .dropdown-item.text-danger:hover {
            background: rgba(239, 68, 68, 0.08);
            color: var(--oct-red);
        }

        .dropdown-divider {
            border-color: var(--oct-border-light);
        }

        /* ── Form overrides ── */
        .form-control {
            border: 1.5px solid var(--oct-border);
            border-radius: 10px;
            padding: 0.625rem 0.875rem;
            font-size: 0.875rem;
            color: var(--oct-text);
            background: var(--oct-card);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-control:focus {
            border-color: var(--oct-primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            background: var(--oct-card);
        }

        .form-control-sm {
            padding: 0.3rem 0.625rem;
            font-size: 0.8125rem;
            border-radius: 8px;
        }

        .theme-dark .form-control {
            background: var(--oct-card);
            border-color: var(--oct-border);
            color: var(--oct-text);
        }

        .theme-dark .form-control:focus {
            border-color: var(--oct-primary);
        }

        .theme-dark select.form-control option {
            background: var(--oct-card);
            color: var(--oct-text);
        }

        /* Fix: keep space for select dropdown arrow */
        select.form-control {
            padding-right: 2.25rem;
            background-position: right 0.75rem center;
            background-size: auto;
        }

        select.form-control-sm {
            padding-right: 2rem;
            background-position: right 0.5rem center;
        }

        /* ── Table overrides ── */
        .table {
            color: var(--oct-text);
        }

        .table thead th {
            background: var(--oct-bg);
            color: var(--oct-text-muted);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.6875rem;
            letter-spacing: 0.06em;
            border-bottom: 2px solid var(--oct-border);
        }

        .table td {
            vertical-align: middle;
            border-top: 1px solid var(--oct-border-light);
            font-size: 0.875rem;
        }

        .table-hover tbody tr:hover {
            background-color: var(--oct-card-hover);
        }

        .table-bordered td,
        .table-bordered th {
            border-color: var(--oct-border-light);
        }

        /* ── Button overrides ── */
        .btn {
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.875rem;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: var(--oct-primary);
            border-color: var(--oct-primary);
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.25);
        }

        .btn-primary:hover {
            background: var(--oct-primary-dark);
            border-color: var(--oct-primary-dark);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.35);
            transform: translateY(-1px);
        }

        .btn-success {
            background: var(--oct-green-dark);
            border-color: var(--oct-green-dark);
        }

        .btn-warning {
            background: var(--oct-yellow);
            border-color: var(--oct-yellow);
            color: #1E293B;
        }

        .btn-danger {
            background: var(--oct-red);
            border-color: var(--oct-red);
        }

        .btn-info {
            background: #06B6D4;
            border-color: #06B6D4;
        }

        .btn-outline-primary {
            color: var(--oct-primary);
            border-color: var(--oct-primary);
        }

        .btn-outline-primary:hover {
            background: var(--oct-primary);
            color: #fff;
        }

        .btn-outline-secondary {
            color: var(--oct-text-2);
            border-color: var(--oct-border);
        }

        .btn-outline-secondary:hover {
            background: var(--oct-card-hover);
            border-color: var(--oct-primary);
            color: var(--oct-primary);
        }

        .btn-outline-danger {
            color: var(--oct-red);
            border-color: var(--oct-red);
        }

        .btn-outline-danger:hover {
            background: var(--oct-red);
            color: #fff;
        }

        .btn-sm {
            padding: 0.375rem 0.75rem;
            font-size: 0.8125rem;
            border-radius: 8px;
        }

        .btn-link {
            border-radius: 8px;
        }

        /* ── Badge overrides ── */
        .badge {
            font-weight: 600;
            font-size: 0.75rem;
            padding: 0.375em 0.75em;
            border-radius: 50rem;
        }

        .badge-primary {
            background: var(--oct-primary);
        }

        .badge-secondary {
            background: var(--oct-text-muted);
        }

        .badge-success {
            background: var(--oct-green-dark);
        }

        .badge-info {
            background: #06B6D4;
        }

        .badge-warning {
            background: var(--oct-yellow);
            color: #1E293B;
        }

        .badge-danger {
            background: var(--oct-red);
        }

        /* ── Modal overrides ── */
        .modal-content {
            border: 1px solid var(--oct-border);
            border-radius: 16px;
            box-shadow: var(--oct-shadow-md);
            background: var(--oct-card);
            color: var(--oct-text);
        }

        .modal-header {
            border-bottom: 1px solid var(--oct-border-light);
            padding: 1.25rem 1.5rem;
        }

        .modal-header .modal-title {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 1.0625rem;
        }

        .modal-header .close {
            color: var(--oct-text-muted);
        }

        .modal-body {
            padding: 1.5rem;
        }

        .modal-footer {
            border-top: 1px solid var(--oct-border-light);
            padding: 1rem 1.5rem;
        }

        /* ── Alert overrides ── */
        .alert {
            border-radius: 12px;
            border: none;
            font-size: 0.875rem;
        }

        .alert-success {
            background: rgba(74, 222, 128, 0.12);
            color: var(--oct-green-dark);
        }

        .alert-info {
            background: rgba(6, 182, 212, 0.1);
            color: #0E7490;
        }

        .alert-warning {
            background: rgba(251, 191, 36, 0.12);
            color: var(--oct-yellow-dark);
        }

        .alert-danger {
            background: rgba(239, 68, 68, 0.1);
            color: #DC2626;
        }

        .alert-primary {
            background: var(--oct-primary-bg);
            color: var(--oct-primary-dark);
        }

        /* ── Card overrides (generic Bootstrap .card) ── */
        .card {
            background: var(--oct-card);
            border: 1px solid var(--oct-border-light);
            border-radius: 16px;
            box-shadow: var(--oct-shadow-sm);
            color: var(--oct-text);
        }

        .card-header {
            background: var(--oct-card);
            border-bottom: 1px solid var(--oct-border-light);
        }

        .card-body {
            color: var(--oct-text);
        }

        .shadow {
            box-shadow: var(--oct-shadow-sm) !important;
        }

        /* ── Input group overrides ── */
        .input-group-text {
            background: var(--oct-bg);
            border: 1.5px solid var(--oct-border);
            border-radius: 0 10px 10px 0;
            color: var(--oct-text-muted);
            font-size: 0.875rem;
        }

        .input-group .form-control {
            border-radius: 10px 0 0 10px;
        }

        /* ── Page link overrides (pagination) ── */
        .page-link {
            color: var(--oct-text-2);
            border-color: var(--oct-border-light);
            background: var(--oct-card);
        }

        .page-item.active .page-link {
            background: var(--oct-primary);
            border-color: var(--oct-primary);
            color: #fff;
        }

        /* ── DataTables wrapper styling ── */
        .dataTables_wrapper .dataTables_paginate {
            text-align: right;
            padding-top: 0.75rem;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 0.375rem 0.75rem;
            margin: 0 0.125rem;
            border-radius: 8px !important;
            border: 1.5px solid var(--oct-border) !important;
            background: var(--oct-card) !important;
            color: var(--oct-text-2) !important;
            font-size: 0.8125rem;
            font-weight: 500;
            transition: all 0.15s ease;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: var(--oct-primary-bg) !important;
            border-color: var(--oct-primary) !important;
            color: var(--oct-primary) !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: var(--oct-primary) !important;
            border-color: var(--oct-primary) !important;
            color: #fff !important;
            font-weight: 600;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
            opacity: 0.4;
            cursor: default;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
            background: var(--oct-card) !important;
            border-color: var(--oct-border) !important;
            color: var(--oct-text-2) !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.previous,
        .dataTables_wrapper .dataTables_paginate .paginate_button.next {
            font-weight: 600;
        }

        .dataTables_wrapper .dataTables_paginate span .paginate_button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 36px;
            height: 36px;
            padding: 0 0.5rem;
        }

        .dataTables_wrapper .dataTables_info {
            color: var(--oct-text-muted);
            font-size: 0.8125rem;
            padding-top: 0.75rem;
        }

        .dataTables_wrapper .dataTables_length {
            color: var(--oct-text-muted);
            font-size: 0.8125rem;
        }

        .dataTables_wrapper .dataTables_length select {
            background: var(--oct-card);
            border: 1.5px solid var(--oct-border);
            border-radius: 8px;
            color: var(--oct-text);
            padding: 0.25rem 1.75rem 0.25rem 0.5rem;
        }

        .dataTables_wrapper .dataTables_filter {
            color: var(--oct-text-muted);
            font-size: 0.8125rem;
        }

        .dataTables_wrapper .dataTables_filter input {
            background: var(--oct-card);
            border: 1.5px solid var(--oct-border);
            border-radius: 8px;
            color: var(--oct-text);
            padding: 0.3rem 0.625rem;
            font-size: 0.8125rem;
            margin-left: 0.375rem;
        }

        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: var(--oct-primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            outline: none;
        }

        /* ── Toasts / SweetAlert theming ── */
        .swal2-popup {
            border-radius: 16px !important;
            font-family: 'Inter', sans-serif !important;
        }

        /* ── Responsive ── */
        @media (max-width: 767px) {
            .oct-sidebar {
                transform: translateX(-100%);
            }

            .oct-sidebar.oct-open {
                transform: translateX(0);
            }

            .oct-main {
                margin-left: 0;
            }

            .oct-sidebar-toggle {
                display: flex;
            }

            .oct-content {
                padding: 1rem;
            }

            .oct-user-name {
                display: none;
            }
        }

        @media (min-width: 768px) and (max-width: 991px) {
            .oct-sidebar {
                width: 64px;
            }

            .oct-sidebar-brand-text,
            .oct-sidebar-label,
            .oct-nav-link span {
                display: none;
            }

            .oct-sidebar-brand {
                justify-content: center;
                padding: 1rem;
            }

            .oct-nav-link {
                justify-content: center;
                padding: 0.625rem;
            }

            .oct-main {
                margin-left: 64px;
            }
        }

        /* ── Reduced motion ── */
        @media (prefers-reduced-motion: reduce) {
            .oct-sidebar,
            .btn,
            .form-control,
            .oct-nav-link,
            .dropdown-menu {
                transition: none !important;
            }
        }

        /* ── DataTables dark-mode overrides ── */
        .theme-dark .dataTables_wrapper .dataTables_length select,
        .theme-dark .dataTables_wrapper .dataTables_filter input {
            background-color: var(--oct-card) !important;
            border-color: var(--oct-border) !important;
            color: var(--oct-text) !important;
        }

        .theme-dark .odd { background-color: var(--oct-card) !important; }
        .theme-dark .even { background-color: var(--oct-card-hover) !important; }

        /* Dark theme — DataTables pagination */
        .theme-dark .dataTables_wrapper .dataTables_paginate .paginate_button {
            background: var(--oct-card) !important;
            border-color: var(--oct-border) !important;
            color: var(--oct-text-2) !important;
        }

        .theme-dark .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: var(--oct-primary-bg) !important;
            border-color: var(--oct-primary) !important;
            color: var(--oct-primary-light) !important;
        }

        .theme-dark .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: var(--oct-primary) !important;
            border-color: var(--oct-primary) !important;
            color: #fff !important;
        }

        .theme-dark .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
            opacity: 0.35;
        }

        .theme-dark .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
            background: var(--oct-card) !important;
            border-color: var(--oct-border) !important;
            color: var(--oct-text-2) !important;
        }

        .theme-dark .dataTables_wrapper .dataTables_info {
            color: var(--oct-text-muted) !important;
        }

        .theme-dark .dataTables_wrapper .dataTables_length {
            color: var(--oct-text-muted) !important;
        }

        .theme-dark .dataTables_wrapper .dataTables_filter {
            color: var(--oct-text-muted) !important;
        }

        .theme-dark .dataTables_wrapper .dataTables_length select,
        .theme-dark .dataTables_wrapper .dataTables_filter input {
            background-color: var(--oct-card) !important;
            border-color: var(--oct-border) !important;
            color: var(--oct-text) !important;
        }

        .theme-dark .dataTables_wrapper .dataTables_filter input:focus {
            border-color: var(--oct-primary) !important;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15) !important;
        }

        /* Dark theme — table header */
        .theme-dark .dataTables_wrapper table thead th {
            background: var(--oct-bg) !important;
            color: var(--oct-text-muted) !important;
            border-bottom-color: var(--oct-border) !important;
        }

        .theme-dark .dataTables_wrapper table thead .sorting_asc,
        .theme-dark .dataTables_wrapper table thead .sorting_desc {
            background: var(--oct-primary-bg) !important;
            color: var(--oct-primary) !important;
        }

        .theme-dark .dataTables_wrapper table td {
            border-top-color: var(--oct-border-light) !important;
            color: var(--oct-text) !important;
        }

        .theme-dark .dataTables_wrapper table tbody tr:hover td {
            background-color: var(--oct-card-hover) !important;
        }
    </style>
</head>

<body>
    <div class="oct-shell">
        <!-- Sidebar -->
        <aside class="oct-sidebar" id="octSidebar">
            <a class="oct-sidebar-brand" href="/dashboard">
                <div class="oct-sidebar-brand-icon"><i class="fas fa-cubes"></i></div>
                <span class="oct-sidebar-brand-text">Aqua Stock</span>
            </a>

            <ul class="oct-sidebar-nav">
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isPrefix('/dashboard') ? 'active' : '' %>" href="/dashboard">
                        <i class="fas fa-th-large"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="oct-sidebar-label">Management</li>

                <% if (user && user.role === 'admin') { %>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isPrefix('/admin/users') ? 'active' : '' %>" href="/admin/users">
                        <i class="fas fa-users"></i>
                        <span>Users</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isPrefix('/admin/products') ? 'active' : '' %>" href="/admin/products">
                        <i class="fas fa-box"></i>
                        <span>Produk</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isPrefix('/admin/divisi') ? 'active' : '' %>" href="/admin/divisi">
                        <i class="fas fa-tags"></i>
                        <span>Divisi</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isActive('/admin/shipments') ? 'active' : '' %>" href="/admin/shipments">
                        <i class="fas fa-arrow-right-arrow-left"></i>
                        <span>Pengiriman</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isActive('/admin/orders') ? 'active' : '' %>" href="/admin/orders">
                        <i class="fas fa-shopping-cart"></i>
                        <span>Pesanan Cabang</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isPrefix('/admin/cabang') ? 'active' : '' %>" href="/admin/cabang">
                        <i class="fas fa-store-alt"></i>
                        <span>Stok Cabang</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isActive('/admin/laporan') ? 'active' : '' %>" href="/admin/laporan">
                        <i class="fas fa-chart-bar"></i>
                        <span>Laporan</span>
                    </a>
                </li>
                <% } %>

                <% if (user && user.role === 'cabang') { %>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isActive('/cabang/shipments') ? 'active' : '' %>" href="/cabang/shipments">
                        <i class="fas fa-arrow-right-arrow-left"></i>
                        <span>Pengiriman Masuk</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isActive('/cabang/orders') ? 'active' : '' %>" href="/cabang/orders">
                        <i class="fas fa-shopping-cart"></i>
                        <span>Pesanan Saya</span>
                    </a>
                </li>
                <% } %>

                <% if (user && user.role === 'sales') { %>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isActive('/sales/orders') ? 'active' : '' %>" href="/sales/orders">
                        <i class="fas fa-shopping-cart"></i>
                        <span>Buat Pesanan</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isActive('/sales/report') ? 'active' : '' %>" href="/sales/report">
                        <i class="fas fa-chart-bar"></i>
                        <span>Laporan Penjualan</span>
                    </a>
                </li>
                <% } %>

                <% if (user && user.role === 'gudang') { %>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isPrefix('/gudang/orders') ? 'active' : '' %>" href="/gudang/orders">
                        <i class="fas fa-boxes"></i>
                        <span>Pengemasan</span>
                    </a>
                </li>
                <li class="oct-nav-item">
                    <a class="oct-nav-link <%= isActive('/admin/shipments') ? 'active' : '' %>" href="/admin/shipments">
                        <i class="fas fa-arrow-right-arrow-left"></i>
                        <span>Pengiriman</span>
                    </a>
                </li>
                <% } %>
            </ul>

            <div class="oct-sidebar-footer">
                <a class="oct-nav-link" href="#" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
                <form id="logoutForm" action="/logout" method="post" style="display:none;"></form>
            </div>
        </aside>

        <!-- Main -->
        <div class="oct-main">
            <!-- Topbar -->
            <header class="oct-topbar">
                <div class="oct-topbar-left">
                    <button class="oct-sidebar-toggle" id="octSidebarToggle" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
                <div class="oct-topbar-right">
                    <button class="oct-topbar-btn" id="octThemeToggle" title="Ganti Tema">
                        <i class="fas fa-moon"></i>
                    </button>
                    <div class="dropdown">
                        <div class="oct-user-menu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <div class="oct-user-avatar">
                                <%= ((profile && profile.username) || (user && user.username) || 'U').charAt(0).toUpperCase() %>
                            </div>
                            <span class="oct-user-name">
                                <%= ((profile && profile.username) || (user && user.username) || 'User').toUpperCase() %>
                            </span>
                        </div>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item" href="/dashboard"><i class="fas fa-user fa-sm mr-2" style="color:var(--oct-text-muted)"></i> Profile</a>
                            <div class="dropdown-divider"></div>
                            <form action="/logout" method="post" class="m-0">
                                <button class="dropdown-item text-danger" type="submit"><i class="fas fa-sign-out-alt fa-sm mr-2" style="color:var(--oct-red)"></i> Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="oct-content">
                <%- body %>
            </main>

            <!-- Footer -->
            <footer class="oct-footer">
                &copy; <%= new Date().getFullYear() %> Aqua Stock
            </footer>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>

    <!-- Theme Toggle -->
    <script>
        (function() {
            var btn = document.getElementById('octThemeToggle');
            var icon = btn.querySelector('i');

            function updateIcon(isDark) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }

            updateIcon(document.documentElement.classList.contains('theme-dark'));

            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var isDark = document.documentElement.classList.toggle('theme-dark');
                localStorage.setItem('aqua-theme', isDark ? 'dark' : 'light');
                updateIcon(isDark);
            });
        })();
    </script>

    <!-- Mobile sidebar toggle -->
    <script>
        (function() {
            var toggle = document.getElementById('octSidebarToggle');
            var sidebar = document.getElementById('octSidebar');

            if (toggle && sidebar) {
                toggle.addEventListener('click', function() {
                    sidebar.classList.toggle('oct-open');
                });

                // Close on outside click
                document.addEventListener('click', function(e) {
                    if (sidebar.classList.contains('oct-open') && !sidebar.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
                        sidebar.classList.remove('oct-open');
                    }
                });
            }
        })();
    </script>

    <% if (user && user.role === 'admin') { %>
    <script>
        (function() {
            const POLLING_INTERVAL = 15000;
            let lastCheck = localStorage.getItem('lastOrderCheckTime');
            if (!lastCheck) {
                lastCheck = Date.now();
                localStorage.setItem('lastOrderCheckTime', lastCheck);
            }

            function checkNewOrders() {
                fetch('/admin/orders/check-new?since=' + lastCheck)
                    .then(res => res.json())
                    .then(data => {
                        if (data && data.hasNew && data.orders.length > 0) {
                            data.orders.forEach(order => {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'info',
                                    title: 'Pesanan Baru Masuk!',
                                    html: '<b>' + order.kode_order + '</b> dari <b>' + order.nama_cabang + '</b>',
                                    showConfirmButton: true,
                                    confirmButtonText: 'Lihat',
                                    showCloseButton: true,
                                    timer: 10000,
                                    timerProgressBar: true
                                }).then(function(result) {
                                    if (result.isConfirmed) {
                                        window.location.href = '/admin/orders';
                                    }
                                });
                            });
                            lastCheck = Math.max.apply(null, data.orders.map(function(o) { return o.createdAt || Date.now(); }));
                            localStorage.setItem('lastOrderCheckTime', lastCheck);
                        }
                    })
                    .catch(function(err) { console.error("Error polling orders:", err); });
            }

            setInterval(checkNewOrders, POLLING_INTERVAL);
        })();
    </script>
    <% } %>
</body>

</html>