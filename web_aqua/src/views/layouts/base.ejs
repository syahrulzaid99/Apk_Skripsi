                        <div class="oct-avatar oct-avatar-solid oct-avatar-sm">
                            <%= ((profile && profile.username) || (user && user.username) || 'U').charAt(0).toUpperCase() %>
                        </div>
                        <div class="oct-sidebar-user-meta">
                            <span class="oct-sidebar-user-name">
                                <%= (profile && profile.nama_cabang) || (profile && profile.username) || (user && user.username) || 'Pengguna' %>
                            </span>
                            <span class="oct-sidebar-user-role">
                                <%= (user && user.role) || 'pengguna' %>
                            </span>
                        </div>
                    </div>
                    <div class="dropdown-menu" style="width:calc(var(--oct-sidebar-w) - 1.5rem);">
                        <a class="dropdown-item" href="/dashboard"><i class="fas fa-gauge-high fa-sm mr-2" style="color:var(--oct-text-muted)"></i> Dashboard</a>
                        <div class="dropdown-divider"></div>
                        <form action="/logout" method="post" class="m-0">
