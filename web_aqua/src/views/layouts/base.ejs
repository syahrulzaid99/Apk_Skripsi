        </aside>

        <!-- Main -->
        <div class="oct-main">
            <!-- Topbar -->
            <header class="oct-topbar" id="octTopbar">
                <div class="oct-topbar-left">
                    <button class="oct-sidebar-toggle" id="octSidebarToggle" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="octSidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <nav class="oct-crumb" aria-label="Breadcrumb">
                        <a href="/dashboard"><i class="fas fa-droplet" style="font-size:0.6875rem; margin-right:0.25rem;"></i>Aqua Stock</a>
                        <i class="fas fa-chevron-right oct-crumb-sep"></i>
                        <span class="oct-crumb-current"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></span>
                    </nav>
                </div>
                <div class="oct-topbar-right">
                    <% if (user && user.role === 'admin') { %>
                    <span class="oct-live" id="octLive" title="Memeriksa pesanan baru setiap 15 detik">
                        <span class="oct-live-dot"></span>
                        <span>Memantau pesanan baru</span>
                    </span>
                    <% } %>
                    <button class="oct-topbar-btn" id="octThemeToggle" title="Ganti tema" aria-label="Ganti tema">
                        <i class="fas fa-moon"></i>
                    </button>
                </div>
            </header>

            <!-- Page Content -->
            <main class="oct-content" id="octMain">
                <%- body %>
            </main>

            <!-- Footer -->
            <footer class="oct-footer">
                <span>&copy; <%= new Date().getFullYear() %> Aqua Japan &middot; Sistem manajemen stok &amp; distribusi</span>
                <span>Masuk sebagai <strong style="color:var(--oct-text-2); font-weight:600;"><%= (user && user.username) || '—' %></strong> (<%= (user && user.role) || '—' %>)</span>
            </footer>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>

    <!-- Theme toggle -->
    <script>
        (function() {
            var btn = document.getElementById('octThemeToggle');
            if (!btn) return;
            var icon = btn.querySelector('i');

            function updateIcon(isDark) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
                btn.setAttribute('title', isDark ? 'Beralih ke tema terang' : 'Beralih ke tema gelap');
            }

            updateIcon(document.documentElement.classList.contains('theme-dark'));

            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var isDark = document.documentElement.classList.toggle('theme-dark');
                localStorage.setItem('aqua-theme', isDark ? 'dark' : 'light');
                updateIcon(isDark);
            });
        })();
    </script>

    <!-- Sidebar: mobile drawer + menu search -->
    <script>
        (function() {
            var toggle = document.getElementById('octSidebarToggle');
            var sidebar = document.getElementById('octSidebar');
            var scrim = document.getElementById('octScrim');

            function setOpen(open) {
                sidebar.classList.toggle('oct-open', open);
                scrim.classList.toggle('oct-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                document.body.style.overflow = open ? 'hidden' : '';
            }

            if (toggle && sidebar) {
                toggle.addEventListener('click', function() {
                    setOpen(!sidebar.classList.contains('oct-open'));
                });
                scrim.addEventListener('click', function() { setOpen(false); });
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && sidebar.classList.contains('oct-open')) setOpen(false);
                });
            }

            // Menu filter — hides non-matching items and any group label left empty
            var search = document.getElementById('octNavSearch');
            var list = document.getElementById('octNavList');
            var empty = document.getElementById('octNavEmpty');

            if (search && list) {
                var isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
                var hint = document.getElementById('octKbdHint');
                if (hint && !isMac) hint.textContent = 'Ctrl K';

                search.addEventListener('input', function() {
                    var q = search.value.trim().toLowerCase();
                    var nodes = Array.prototype.slice.call(list.children);
                    var shown = 0;
                    var pendingLabel = null;
                    var labelHasMatch = false;

                    nodes.forEach(function(node) {
                        if (node.classList.contains('oct-sidebar-label')) {
                            if (pendingLabel) pendingLabel.style.display = labelHasMatch ? '' : 'none';
                            pendingLabel = node;
                            labelHasMatch = false;
                            return;
                        }
                        var text = (node.textContent || '').trim().toLowerCase();
                        var hit = !q || text.indexOf(q) !== -1;
                        node.style.display = hit ? '' : 'none';
                        if (hit) { shown++; labelHasMatch = true; }
                    });

                    if (pendingLabel) pendingLabel.style.display = labelHasMatch ? '' : 'none';
                    if (empty) empty.style.display = shown === 0 ? 'block' : 'none';
                });

                document.addEventListener('keydown', function(e) {
                    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                        e.preventDefault();
                        if (window.innerWidth <= 991) setOpen(true);
                        search.focus();
                        search.select();
                    }
                });

                search.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') { search.value = ''; search.dispatchEvent(new Event('input')); search.blur(); }
                    if (e.key === 'Enter') {
                        var first = list.querySelector('.oct-nav-item:not([style*="none"]) .oct-nav-link');
                        if (first) window.location.href = first.getAttribute('href');
                    }
                });
            }
        })();
    </script>

    <!-- Topbar: border appears once content scrolls under it -->
    <script>
        (function() {
            var topbar = document.getElementById('octTopbar');
            if (!topbar) return;
            var threshold = 6;
            function onScroll() {
                topbar.classList.toggle('oct-stuck', window.scrollY > threshold);
            }
            onScroll();
            window.addEventListener('scroll', onScroll, { passive: true });
        })();
    </script>

    <!-- Shared helpers available to every view -->
    <script>
        window.Aqua = window.Aqua || {};

        /* Reads ?ok= / ?err= then strips them from the URL. */
        Aqua.flash = function(messages) {
            var params = new URLSearchParams(window.location.search);
            var ok = params.get('ok');
            var err = params.get('err');
            if (!ok && !err) return;

            if (ok && typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'success',
                    title: (messages && messages[ok]) || 'Perubahan tersimpan',
                    showConfirmButton: false, timer: 2600, timerProgressBar: true
                });
            }
            if (err && typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error', title: 'Gagal',
                    text: (messages && messages[err]) || err,
                    confirmButtonText: 'Tutup'
                });
            }
            params.delete('ok');
            params.delete('err');
            var qs = params.toString();
            window.history.replaceState({}, '', location.pathname + (qs ? '?' + qs : ''));
        };

        /* Confirm dialog wired to the design system. */
        Aqua.confirm = function(opts) {
            return Swal.fire({
                icon: opts.icon || 'warning',
                title: opts.title || 'Lanjutkan?',
                text: opts.text || '',
                showCancelButton: true,
                confirmButtonText: opts.confirmText || 'Ya, lanjutkan',
                cancelButtonText: 'Batal',
                reverseButtons: true
            });
        };

        /* Filters a table's rows against a search box. */
        Aqua.filterTable = function(inputSel, tableSel, emptySel) {
            var input = document.querySelector(inputSel);
            var table = document.querySelector(tableSel);
            if (!input || !table) return;
            var empty = emptySel ? document.querySelector(emptySel) : null;

            input.addEventListener('input', function() {
                var q = input.value.trim().toLowerCase();
                var rows = table.tBodies[0] ? table.tBodies[0].rows : [];
                var shown = 0;
                for (var i = 0; i < rows.length; i++) {
                    var hit = !q || (rows[i].textContent || '').toLowerCase().indexOf(q) !== -1;
                    rows[i].style.display = hit ? '' : 'none';
                    if (hit) shown++;
                }
                if (empty) empty.style.display = shown === 0 ? '' : 'none';
            });
        };

        /* Wires a .oct-drop dropzone to show the chosen filenames. */
        Aqua.dropzone = function(rootSel) {
            document.querySelectorAll(rootSel || '.oct-drop').forEach(function(drop) {
                var input = drop.querySelector('input[type="file"]');
                var out = drop.querySelector('.oct-drop-files');
                if (!input) return;

                function render() {
                    if (!out) return;
                    var n = input.files ? input.files.length : 0;
                    if (!n) { out.textContent = ''; return; }
                    out.textContent = n === 1 ? input.files[0].name : n + ' berkas dipilih';
                }

                input.addEventListener('change', render);
                ['dragenter', 'dragover'].forEach(function(ev) {
                    drop.addEventListener(ev, function(e) { e.preventDefault(); drop.classList.add('oct-drag'); });
                });
                ['dragleave', 'drop'].forEach(function(ev) {
                    drop.addEventListener(ev, function() { drop.classList.remove('oct-drag'); });
                });
            });
        };

        document.addEventListener('DOMContentLoaded', function() { Aqua.dropzone(); });
    </script>

    <% if (user && user.role === 'admin') { %>
    <script>
        (function() {
            const POLLING_INTERVAL = 15000;
            let lastCheck = localStorage.getItem('lastOrderCheckTime');
            if (!lastCheck) {
                lastCheck = Date.now();
                localStorage.setItem('lastOrderCheckTime', lastCheck);
            }

            function checkNewOrders() {
                fetch('/admin/orders/check-new?since=' + lastCheck)
                    .then(res => res.json())
                    .then(data => {
                        if (data && data.hasNew && data.orders.length > 0) {
                            data.orders.forEach(order => {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'info',
                                    title: 'Pesanan baru masuk',
                                    html: '<b>' + order.kode_order + '</b> dari <b>' + order.nama_cabang + '</b>',
                                    showConfirmButton: true,
                                    confirmButtonText: 'Lihat',
                                    showCloseButton: true,
                                    timer: 10000,
                                    timerProgressBar: true
                                }).then(function(result) {
                                    if (result.isConfirmed) {
                                        window.location.href = '/admin/orders';
                                    }
                                });
                            });
                            lastCheck = Math.max.apply(null, data.orders.map(function(o) { return o.createdAt || Date.now(); }));
                            localStorage.setItem('lastOrderCheckTime', lastCheck);
                        }
                    })
                    .catch(function(err) { console.error("Error polling orders:", err); });
            }

            setInterval(checkNewOrders, POLLING_INTERVAL);
        })();
    </script>
    <% } %>
</body>

</html>
