<%
    var repOrders   = Array.isArray(orders) ? orders : [];
    var repUsers    = (usersMap && typeof usersMap === 'object') ? usersMap : {};
    var repSum      = summary || {};
    var repStatus   = statusCount || {};
    var repMonthly  = Array.isArray(monthly) ? monthly : [];
    var repBranches = Array.isArray(branches) ? branches : [];

    function repRupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
    function repNum(n) { return Number(n || 0).toLocaleString('id-ID'); }

    function repDateObj(v) {
        if (!v) return null;
        var d;
        if (v.toDate) d = v.toDate();
        else if (v._seconds) d = new Date(v._seconds * 1000);
        else d = new Date(v);
        return (d && !isNaN(d)) ? d : null;
    }
    function repFmt(v) {
        var d = repDateObj(v);
        if (!d) return '—';
        return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
    }
    function repStamp(v) {
        var d = repDateObj(v);
        return d ? d.getTime() : 0;
    }

    var REP_LABEL = {
        pending: 'Menunggu', approved_sales: 'Disetujui sales', approved_admin: 'Diverifikasi', dipaket: 'Dikemas',
        dikirim: 'Dikirim', terkirim: 'Dikirim', diterima: 'Diterima',
        selesai: 'Selesai', ditolak: 'Ditolak', rejected: 'Ditolak'
    };
    // 'rejected' has no pill colour of its own — reuse the ditolak palette
    function repPill(st) { return st === 'rejected' ? 'ditolak' : st; }

    var repTotalOrders = Number(repSum.totalOrders || repOrders.length || 0);
    var repTotalRp     = Number(repSum.totalPendapatan || 0);
    var repTotalItem   = Number(repSum.totalItem || 0);
    var repCabangCount = Object.keys(repUsers).length;
    var repAvgRp       = repTotalOrders > 0 ? Math.round(repTotalRp / repTotalOrders) : 0;

    // Buckets for the segmented filter above the order table
    var nMenunggu = 0, nProses = 0, nSelesai = 0, nDitolak = 0;
    for (var rk = 0; rk < repOrders.length; rk++) {
        var stk = String(repOrders[rk].status || 'pending').toLowerCase();
        if (stk === 'pending') nMenunggu++;
        else if (stk === 'ditolak' || stk === 'rejected') nDitolak++;
        else if (stk === 'selesai' || stk === 'diterima') nSelesai++;
        else nProses++;
    }
    var repBuckets = [
        { key: 'all',     label: 'Semua',    n: repOrders.length, rx: '' },
        { key: 'pending', label: 'Menunggu', n: nMenunggu, rx: '(?:^|\\s)pending(?:\\s|$)' },
        { key: 'proses',  label: 'Diproses', n: nProses,   rx: '(?:^|\\s)(?:approved_sales|approved_admin|dipaket|dikirim|terkirim)(?:\\s|$)' },
        { key: 'selesai', label: 'Selesai',  n: nSelesai,  rx: '(?:^|\\s)(?:selesai|diterima)(?:\\s|$)' },
        { key: 'ditolak', label: 'Ditolak',  n: nDitolak,  rx: '(?:^|\\s)(?:ditolak|rejected)(?:\\s|$)' }
    ];

    // Status distribution — exactly the six figures the route computes
    var repDist = [
        { key: 'pending',        label: 'Menunggu',     n: Number(repStatus.pending || 0) },
        { key: 'approved_sales', label: 'Disetujui sales', n: Number(repStatus.approved_sales || 0) },
        { key: 'approved_admin', label: 'Diverifikasi', n: Number(repStatus.approved_admin || 0) },
        { key: 'dipaket',        label: 'Dikemas',      n: Number(repStatus.dipaket || 0) },
        { key: 'dikirim',        label: 'Dikirim',      n: Number(repStatus.dikirim || 0) },
        { key: 'selesai',        label: 'Selesai',      n: Number(repStatus.selesai || 0) },
        { key: 'ditolak',        label: 'Ditolak',      n: Number(repStatus.rejected || 0) }
    ];
    var repDistTotal = 0;
    for (var rd = 0; rd < repDist.length; rd++) repDistTotal += repDist[rd].n;

    // Branch ranking totals
    var brMaxRp = 0, brTotRp = 0, brTotOrders = 0, brTotItem = 0;
    for (var rb = 0; rb < repBranches.length; rb++) {
        var bv = Number(repBranches[rb].totalPendapatan || 0);
        if (bv > brMaxRp) brMaxRp = bv;
        brTotRp += bv;
        brTotOrders += Number(repBranches[rb].totalOrders || 0);
        brTotItem += Number(repBranches[rb].totalItem || 0);
    }
    var brShareBase = repTotalRp > 0 ? repTotalRp : brTotRp;
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .rep-chart { height: 300px; }

    /* Mini trend bars inside a branch row */
    .rep-spark {
        display: flex;
        align-items: flex-end;
        gap: 2px;
        height: 26px;
        min-width: 72px;
    }

    .rep-spark-bar {
        flex: 1;
        min-width: 4px;
        border-radius: 3px 3px 0 0;
        background: var(--oct-primary-light);
    }

    .rep-spark-bar:last-child { background: var(--oct-primary); }

    /* Contribution meter in the ranking table */
    .rep-share {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .rep-share-track {
        width: 64px;
        height: 6px;
        border-radius: 999px;
        background: var(--oct-inset-2);
        overflow: hidden;
        flex: 0 0 auto;
    }

    .rep-share-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--oct-primary);
    }

    .rep-rank {
        width: 24px;
        height: 24px;
        border-radius: 8px;
        background: var(--oct-inset);
        border: 1px solid var(--oct-border-light);
        color: var(--oct-text-2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 0.6875rem;
        font-variant-numeric: tabular-nums;
    }

    .rep-rank-top {
        background: var(--oct-primary-bg);
        border-color: transparent;
        color: var(--oct-primary);
    }

    /* Keep DataTables chrome inside the card gutter */
    #ordersTable_wrapper .dataTables_length,
    #ordersTable_wrapper .dataTables_info,
    #ordersTable_wrapper .dataTables_paginate { padding-left: 0.875rem; padding-right: 0.875rem; }

    @media (max-width: 575px) {
        .rep-share-track { display: none; }
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Laporan penjualan saya</h1>
        <p class="oct-page-sub">Rekap pesanan yang Anda buat untuk setiap cabang, lengkap dengan pendapatan per bulan dan rinciannya.</p>
    </div>
    <% if (repOrders.length > 0) { %>
    <div class="oct-page-actions">
        <button id="btnDownloadExcel" type="button" class="btn btn-primary">
            <i class="fas fa-file-excel mr-2"></i>Unduh Excel
        </button>
    </div>
    <% } %>
</div>

<% if (repOrders.length === 0) { %>

    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-chart-simple"></i></div>
            <h2 class="oct-empty-title">Belum ada data penjualan</h2>
            <p class="oct-empty-text">Setiap pesanan yang Anda buat untuk cabang akan terangkum di sini beserta pendapatan dan statusnya.</p>
            <div class="oct-empty-actions">
                <a class="btn btn-primary" href="/sales/orders"><i class="fas fa-receipt mr-2"></i>Pesanan cabang</a>
            </div>
        </div>
    </div>

<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-receipt"></i></span>
                    <span class="oct-kpi-label">Total pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= repNum(repTotalOrders) %></span>
                    <span class="oct-kpi-note">sejak awal</span>
                </div>
                <div class="oct-kpi-foot"><%= repNum(nMenunggu) %> masih menunggu persetujuan</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-wallet"></i></span>
                    <span class="oct-kpi-label">Total pendapatan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm"><%= repRupiah(repTotalRp) %></span>
                </div>
                <div class="oct-kpi-foot">rata-rata <%= repRupiah(repAvgRp) %> per pesanan</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-cubes"></i></span>
                    <span class="oct-kpi-label">Item terjual</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= repNum(repTotalItem) %></span>
                    <span class="oct-kpi-note">unit</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-store"></i></span>
                    <span class="oct-kpi-label">Cabang dilayani</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= repNum(repCabangCount) %></span>
                    <% if (nSelesai > 0) { %>
                        <span class="oct-delta oct-delta-up"><i class="fas fa-check"></i> <%= repNum(nSelesai) %> selesai</span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Tren pendapatan + sebaran status -->
    <div class="oct-grid <%= repMonthly.length > 0 ? 'oct-grid-main' : '' %> mb-3">
        <% if (repMonthly.length > 0) { %>
        <section class="oct-card">
            <div class="oct-card-head">
                <div>
                    <h2 class="oct-card-title">Pendapatan per bulan</h2>
                    <p class="oct-card-sub">Nilai pesanan dan jumlah transaksi pada setiap periode.</p>
                </div>
                <span class="oct-chip"><i class="fas fa-calendar"></i> <%= repMonthly.length %> bulan</span>
            </div>
            <div class="oct-card-body">
                <div class="rep-chart"><canvas id="salesChart"></canvas></div>
            </div>
        </section>
        <% } %>

        <section class="oct-card">
            <div class="oct-card-head">
                <div>
                    <h2 class="oct-card-title">Sebaran status</h2>
                    <p class="oct-card-sub">Posisi pesanan pada alur persetujuan.</p>
                </div>
            </div>
            <div class="oct-card-body">
                <div class="oct-stat-list">
                    <% for (var di = 0; di < repDist.length; di++) {
                        var dRow = repDist[di];
                        var dPct = repDistTotal > 0 ? Math.round((dRow.n / repDistTotal) * 100) : 0;
                    %>
                    <div class="oct-stat-row">
                        <span class="oct-pill oct-pill-dot oct-pill-<%= dRow.key %>"><%= dRow.label %></span>
                        <span class="oct-row-tight">
                            <span class="oct-stat-value"><%= repNum(dRow.n) %></span>
                            <span class="oct-cell-sub"><%= dPct %>%</span>
                        </span>
                    </div>
                    <% } %>
                </div>
                <% if (repDistTotal === 0) { %>
                    <p class="oct-card-sub mt-3 mb-0">Belum ada pesanan yang tercatat pada alur ini.</p>
                <% } %>
            </div>
        </section>
    </div>

    <!-- Peringkat cabang -->
    <section class="oct-card mb-3">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Kontribusi per cabang</h2>
                <p class="oct-card-sub">Cabang diurutkan dari pendapatan terbesar. Kolom tren menampilkan nilai tiap bulan.</p>
            </div>
            <span class="oct-chip"><i class="fas fa-store"></i> <%= repBranches.length %> cabang</span>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Cabang</th>
                            <th class="col-fit">Tren</th>
                            <th class="num">Pesanan</th>
                            <th class="num">Item</th>
                            <th class="num">Pendapatan</th>
                            <th class="num">Kontribusi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (repBranches.length === 0) { %>
                            <tr><td colspan="7" class="oct-td-muted text-center" style="padding:1.5rem;">Belum ada data cabang.</td></tr>
                        <% } %>
                        <% for (var bi = 0; bi < repBranches.length; bi++) {
                            var b = repBranches[bi];
                            var bRp = Number(b.totalPendapatan || 0);
                            var bMonthly = Array.isArray(b.monthly) ? b.monthly : [];
                            var bMax = 1;
                            for (var bm = 0; bm < bMonthly.length; bm++) {
                                var mv = Number(bMonthly[bm].total || 0);
                                if (mv > bMax) bMax = mv;
                            }
                            var bShare = brShareBase > 0 ? Math.round((bRp / brShareBase) * 100) : 0;
                            var bNama = b.nama_cabang || b.username || b.cabang_id || '—';
                            var bLokasi = b.kota ? (b.kota + (b.provinsi ? ', ' + b.provinsi : '')) : (b.username || '—');
                        %>
                        <tr>
                            <td class="col-fit">
                                <span class="rep-rank <%= bi === 0 ? 'rep-rank-top' : '' %>"><%= bi + 1 %></span>
                            </td>
                            <td>
                                <div class="oct-cell-media">
                                    <span class="oct-avatar oct-avatar-sm"><i class="fas fa-store" style="font-size:0.6875rem;"></i></span>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= bNama %></span>
                                        <span class="oct-cell-sub"><%= bLokasi %></span>
                                    </span>
                                </div>
                            </td>
                            <td class="col-fit">
                                <% if (bMonthly.length > 0) { %>
                                    <span class="rep-spark">
                                        <% for (var bs = 0; bs < bMonthly.length; bs++) {
                                            var sVal = Number(bMonthly[bs].total || 0);
                                            var sH = Math.max(3, Math.round((sVal / bMax) * 26));
                                        %>
                                        <span class="rep-spark-bar" style="height:<%= sH %>px;"
                                              title="<%= bMonthly[bs].label || '—' %>: <%= repRupiah(sVal) %> · <%= repNum(bMonthly[bs].count) %> pesanan"></span>
                                        <% } %>
                                    </span>
                                <% } else { %>
                                    <span class="oct-td-muted">—</span>
                                <% } %>
                            </td>
                            <td class="num"><%= repNum(b.totalOrders) %></td>
                            <td class="num"><%= repNum(b.totalItem) %></td>
                            <td class="num oct-td-strong"><%= repRupiah(bRp) %></td>
                            <td class="num">
                                <span class="rep-share">
                                    <span class="rep-share-track"><span class="rep-share-fill" style="width:<%= bShare %>%;"></span></span>
                                    <span class="oct-td-strong"><%= bShare %>%</span>
                                </span>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                    <% if (repBranches.length > 0) { %>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="oct-td-muted">Total</td>
                            <td class="num"><%= repNum(brTotOrders) %></td>
                            <td class="num"><%= repNum(brTotItem) %></td>
                            <td class="num" style="color:var(--oct-primary);"><%= repRupiah(brTotRp) %></td>
                            <td class="num">100%</td>
                        </tr>
                    </tfoot>
                    <% } %>
                </table>
            </div>
        </div>
    </section>

    <!-- Detail pesanan -->
    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Detail pesanan</h2>
                <p class="oct-card-sub">Seluruh pesanan yang Anda buat, terbaru lebih dulu.</p>
            </div>
            <div class="oct-row">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="tableSearch">Cari pesanan</label>
                    <input type="text" id="tableSearch" placeholder="Cari kode atau cabang…" autocomplete="off">
                </div>
            </div>
        </div>

        <div class="oct-toolbar">
            <div class="oct-seg" id="repSeg" role="tablist" aria-label="Saring berdasarkan status">
                <% for (var qi = 0; qi < repBuckets.length; qi++) { var qb = repBuckets[qi]; %>
                    <button type="button" role="tab"
                            class="oct-seg-item <%= qi === 0 ? 'active' : '' %>"
                            data-bucket="<%= qb.key %>"
                            data-rx="<%= qb.rx %>"
                            aria-selected="<%= qi === 0 %>">
                        <%= qb.label %><span class="oct-seg-count"><%= qb.n %></span>
                    </button>
                <% } %>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="ordersTable">
                    <thead>
                        <tr>
                            <th>Kode order</th>
                            <th>Cabang</th>
                            <th class="col-fit">Tanggal</th>
                            <th class="col-fit">Status</th>
                            <th class="num">Jumlah item</th>
                            <th class="num">Total harga</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var oi = 0; oi < repOrders.length; oi++) {
                            var o = repOrders[oi];
                            var cab = repUsers[o.cabang_id] || null;
                            var st = String(o.status || 'pending').toLowerCase();
                            var itemCount = 0;
                            if (Array.isArray(o.items)) {
                                for (var it = 0; it < o.items.length; it++) itemCount += Number(o.items[it].qty || 0);
                            }
                            var oTotal = Number(o.total_harga || 0);
                            var cabNama = cab ? (cab.nama_cabang || cab.username || o.cabang_id) : (o.cabang_id || '—');
                            var cabKota = cab && cab.kota ? (cab.kota + (cab.provinsi ? ', ' + cab.provinsi : '')) : (cab && cab.username ? cab.username : '—');
                        %>
                        <tr>
                            <td><span class="oct-kode oct-mono"><%= o.kode_order || '—' %></span></td>
                            <td>
                                <span class="oct-cell-stack">
                                    <span class="oct-cell-main"><%= cabNama %></span>
                                    <span class="oct-cell-sub"><%= cabKota %></span>
                                </span>
                            </td>
                            <td class="col-fit" data-order="<%= repStamp(o.createdAt) %>"><%= repFmt(o.createdAt) %></td>
                            <td class="col-fit" data-filter="<%= st %> <%= REP_LABEL[st] || st %>" data-order="<%= st %>">
                                <span class="oct-pill oct-pill-dot oct-pill-<%= repPill(st) %>"><%= REP_LABEL[st] || st %></span>
                            </td>
                            <td class="num oct-td-strong" data-order="<%= itemCount %>"><%= repNum(itemCount) %></td>
                            <td class="num oct-td-strong" data-order="<%= oTotal %>"><%= repRupiah(oTotal) %></td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

<% } %>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap4.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        /* ── Design tokens for the chart ───────────────────────────
           Every colour below is read from the :root custom properties
           in layouts/base.ejs — no literals live in this view. */
        var css = getComputedStyle(document.documentElement);
        function tok(name) {
            var v = css.getPropertyValue(name);
            return v ? v.trim() : '';
        }
        function alpha(hex, aa) {
            return /^#[0-9a-fA-F]{6}$/.test(hex) ? hex + aa : hex;
        }

        /* ── DataTable with Excel export ───────────────────────── */
        if (document.getElementById('ordersTable')) {
            var dt = $('#ordersTable').DataTable({
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                order: [[2, 'desc']],
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                buttons: [{
                    extend: 'excelHtml5',
                    title: 'Laporan Penjualan',
                    exportOptions: { columns: ':visible' }
                }],
                language: {
                    search: "Cari:",
                    paginate: { previous: "Sebelumnya", next: "Selanjutnya" },
                    info: "Menampilkan _START_ s/d _END_ dari _TOTAL_ pesanan",
                    lengthMenu: "Tampilkan _MENU_ pesanan",
                    emptyTable: "Belum ada pesanan",
                    zeroRecords: "Tidak ada pesanan yang cocok"
                }
            });
            $('#ordersTable_filter').hide();
            $('#tableSearch').on('keyup', function() { dt.search(this.value).draw(); });

            // Segmented status filter — matches the raw status token in data-filter
            var seg = document.getElementById('repSeg');
            if (seg) {
                seg.addEventListener('click', function(e) {
                    var btn = e.target.closest('.oct-seg-item');
                    if (!btn) return;
                    seg.querySelectorAll('.oct-seg-item').forEach(function(b) {
                        var on = b === btn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    dt.column(3).search(btn.dataset.rx || '', true, false).draw();
                });
            }

            // Excel download button
            $('#btnDownloadExcel').on('click', function() {
                try {
                    dt.button('.buttons-excel').trigger();
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Gagal', text: 'Ekspor Excel tidak tersedia. Muat ulang halaman lalu coba lagi.' });
                }
            });
        }

        /* ── Chart ─────────────────────────────────────────────── */
        var monthlyData = <%- JSON.stringify(repMonthly) %>;
        if (monthlyData.length > 0) {
            var ctx = document.getElementById('salesChart');
            if (ctx) {
                var cSeries1 = tok('--oct-series-1');
                var cSeries2 = tok('--oct-series-2');
                var cGrid    = tok('--oct-border-light');
                var cText    = tok('--oct-text');
                var cText2   = tok('--oct-text-2');
                var cMuted   = tok('--oct-text-muted');
                var cCard    = tok('--oct-card');
                var cBorder  = tok('--oct-border');

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: monthlyData.map(function(m) { return m.label; }),
                        datasets: [{
                            label: 'Pendapatan (Rp)',
                            data: monthlyData.map(function(m) { return m.total; }),
                            backgroundColor: alpha(cSeries1, 'CC'),
                            borderColor: cSeries1,
                            borderWidth: 1,
                            borderRadius: 8,
                            barPercentage: 0.6,
                        }, {
                            label: 'Jumlah pesanan',
                            data: monthlyData.map(function(m) { return m.count; }),
                            backgroundColor: alpha(cSeries2, '80'),
                            borderColor: cSeries2,
                            borderWidth: 1,
                            borderRadius: 8,
                            barPercentage: 0.6,
                            yAxisID: 'y1',
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        scales: {
                            x: { grid: { display: false }, ticks: { color: cMuted } },
                            y: {
                                position: 'left',
                                ticks: {
                                    color: cMuted,
                                    callback: function(v) {
                                        return v >= 1000000 ? 'Rp ' + (v/1000000).toLocaleString('id-ID') + 'M' :
                                               v >= 1000 ? 'Rp ' + (v/1000).toLocaleString('id-ID') + 'K' : 'Rp ' + v.toLocaleString('id-ID');
                                    }
                                },
                                grid: { color: cGrid, drawBorder: false }
                            },
                            y1: {
                                position: 'right',
                                grid: { display: false },
                                ticks: { stepSize: 1, color: cMuted }
                            }
                        },
                        plugins: {
                            legend: { position: 'top', labels: { usePointStyle: true, padding: 16, color: cText2 } },
                            tooltip: {
                                backgroundColor: cCard, bodyColor: cText2, titleColor: cText,
                                borderColor: cBorder, borderWidth: 1, padding: 12,
                                callbacks: {
                                    label: function(c) {
                                        if (c.datasetIndex === 0) return 'Pendapatan: Rp ' + c.parsed.y.toLocaleString('id-ID');
                                        return 'Pesanan: ' + c.parsed.y;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }
    });
</script>
