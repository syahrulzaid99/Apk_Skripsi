<%
    var list = Array.isArray(orders) ? orders : [];
    var umap = (usersMap && typeof usersMap === 'object') ? usersMap : {};
    var cabangs = Array.isArray(cabangList) ? cabangList : [];
    var prods = Array.isArray(products) ? products : [];

    function slDate(v) {
        if (!v) return null;
        return new Date(v._seconds ? v._seconds * 1000 : v);
    }
    function slFmt(v, withTime) {
        var d = slDate(v);
        if (!d || isNaN(d)) return '—';
        var opt = { day: '2-digit', month: 'short', year: 'numeric' };
        if (withTime) { opt.hour = '2-digit'; opt.minute = '2-digit'; }
        return d.toLocaleDateString('id-ID', opt);
    }
    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
    function namaCabang(o) {
        var c = umap[o.cabang_id];
        if (!c) return o.cabang_id || '—';
        return c.username || c.nama_cabang || o.cabang_id || '—';
    }

    var STATUS_LABEL = {
        pending: 'Menunggu', approved_admin: 'Diverifikasi', dipaket: 'Dikemas',
        dikirim: 'Dikirim', diterima: 'Diterima', selesai: 'Selesai',
        ditolak: 'Ditolak', rejected: 'Ditolak'
    };

    var PAY_LABEL = {
        settlement: 'Lunas', capture: 'Lunas', pending: 'Belum bayar',
        deny: 'Ditolak', cancel: 'Dibatalkan', expire: 'Kedaluwarsa',
        failed_to_generate: 'Tagihan gagal dibuat'
    };

    // Kelompok status untuk segmented filter
    function bucketOf(s) {
        if (s === 'pending') return 'pending';
        if (s === 'approved_admin') return 'approved_admin';
        if (s === 'dipaket') return 'dipaket';
        if (s === 'dikirim') return 'dikirim';
        if (s === 'diterima' || s === 'selesai') return 'diterima';
        if (s === 'ditolak' || s === 'rejected') return 'ditolak';
        return 'lainnya';
    }

    var cnt = { pending: 0, approved_admin: 0, dipaket: 0, dikirim: 0, diterima: 0, ditolak: 0, lainnya: 0 };
    var nilaiTotal = 0, nLunas = 0, nBelumBayar = 0, nUnit = 0;

    for (var k = 0; k < list.length; k++) {
        var stk = String(list[k].status || 'pending').toLowerCase();
        cnt[bucketOf(stk)]++;

        nilaiTotal += Number(list[k].total_harga || 0);

        var payk = String(list[k].payment_status || '').toLowerCase();
        if (payk === 'settlement' || payk === 'capture') nLunas++;
        else nBelumBayar++;

        var itk = Array.isArray(list[k].items) ? list[k].items : [];
        for (var z = 0; z < itk.length; z++) nUnit += Number(itk[z].qty || 0);
    }

    var buckets = [
        { key: 'all', label: 'Semua', n: list.length },
        { key: 'pending', label: 'Menunggu', n: cnt.pending },
        { key: 'approved_admin', label: 'Diverifikasi', n: cnt.approved_admin },
        { key: 'dipaket', label: 'Dikemas', n: cnt.dipaket },
        { key: 'dikirim', label: 'Dikirim', n: cnt.dikirim },
        { key: 'diterima', label: 'Diterima', n: cnt.diterima },
        { key: 'ditolak', label: 'Ditolak', n: cnt.ditolak }
    ];
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .slo-toolbar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        width: 100%;
    }

    .slo-cabang-select { max-width: 200px; }

    .slo-qty { width: 84px; margin-left: auto; text-align: right; }

    .slo-picker-wrap { max-height: 380px; overflow-y: auto; }

    @media (max-width: 575px) {
        .slo-cabang-select { max-width: none; flex: 1 1 100%; }
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Buat pesanan untuk cabang</h1>
        <p class="oct-page-sub">Ajukan permintaan stok atas nama cabang dan pantau status seluruh pesanan yang berjalan.</p>
    </div>
    <div class="oct-page-actions">
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalCreate">
            <i class="fas fa-plus mr-2"></i>Buat pesanan
        </button>
    </div>
</div>

<% if (list.length === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-cart-shopping"></i></div>
            <h2 class="oct-empty-title">Belum ada pesanan</h2>
            <p class="oct-empty-text">Pesanan yang Anda buat untuk cabang akan tampil di sini lengkap dengan status persetujuan dan pembayarannya.</p>
            <div class="oct-empty-actions">
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalCreate">
                    <i class="fas fa-plus mr-2"></i>Buat pesanan pertama
                </button>
            </div>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-receipt"></i></span>
                    <span class="oct-kpi-label">Total pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= list.length %></span>
                    <span class="oct-kpi-note">seluruh cabang</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-hourglass-half"></i></span>
                    <span class="oct-kpi-label">Menunggu persetujuan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= cnt.pending %></span>
                    <% if (cnt.pending > 0) { %>
                        <span class="oct-delta oct-delta-warn"><i class="fas fa-clock"></i> tertahan</span>
                    <% } else { %>
                        <span class="oct-kpi-note">tidak ada antrean</span>
                    <% } %>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-money-check-dollar"></i></span>
                    <span class="oct-kpi-label">Sudah lunas</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nLunas %></span>
                    <% if (nBelumBayar > 0) { %>
                        <span class="oct-delta oct-delta-warn"><i class="fas fa-circle-exclamation"></i> <%= nBelumBayar %> belum bayar</span>
                    <% } %>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-wallet"></i></span>
                    <span class="oct-kpi-label">Nilai seluruh pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm"><%= rupiah(nilaiTotal) %></span>
                </div>
                <div class="oct-kpi-foot"><%= nUnit.toLocaleString('id-ID') %> unit dipesan</div>
            </div>
        </div>
    </div>

    <!-- Daftar pesanan -->
    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Daftar pesanan</h2>
                <p class="oct-card-sub" id="sloCount"><%= list.length %> pesanan ditampilkan</p>
            </div>
        </div>

        <div class="oct-toolbar">
            <div class="slo-toolbar">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="sloSearch">Cari pesanan</label>
                    <input type="text" id="sloSearch" placeholder="Cari kode pesanan atau cabang…" autocomplete="off">
                </div>

                <label class="oct-sr" for="filterCabang">Saring cabang</label>
                <select id="filterCabang" class="form-control form-control-sm slo-cabang-select">
                    <option value="">Semua cabang</option>
                    <% for (var ci = 0; ci < cabangs.length; ci++) { %>
                        <option value="<%= cabangs[ci].id %>"><%= cabangs[ci].username %></option>
                    <% } %>
                </select>

                <div class="oct-seg" id="sloSeg" role="tablist" aria-label="Saring berdasarkan status">
                    <% for (var bi = 0; bi < buckets.length; bi++) { var b = buckets[bi]; %>
                        <button type="button" role="tab" class="oct-seg-item <%= bi === 0 ? 'active' : '' %>" data-bucket="<%= b.key %>" aria-selected="<%= bi === 0 %>">
                            <%= b.label %><span class="oct-seg-count"><%= b.n %></span>
                        </button>
                    <% } %>
                </div>

                <button type="button" class="oct-icon-btn" id="filterResetBtn" title="Reset filter" aria-label="Reset filter">
                    <i class="fas fa-rotate-left"></i>
                </button>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="sloTable">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Pesanan</th>
                            <th>Cabang</th>
                            <th class="num">Item</th>
                            <th class="num">Total</th>
                            <th class="col-fit">Pembayaran</th>
                            <th class="col-fit">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var si = 0; si < list.length; si++) {
                            var o = list[si];
                            var st = String(o.status || 'pending').toLowerCase();
                            var bkt = bucketOf(st);
                            var pay = String(o.payment_status || '').toLowerCase();
                            var payCls = (pay === 'settlement' || pay === 'capture') ? 'lunas' : (pay || 'pending');
                            var itemsO = Array.isArray(o.items) ? o.items : [];
                            var cari = ((o.kode_order || '') + ' ' + namaCabang(o)).toLowerCase();
                        %>
                        <tr data-cabang-id="<%= o.cabang_id %>" data-status="<%= st %>" data-bucket="<%= bkt %>" data-search="<%= cari %>">
                            <td class="col-fit oct-td-muted"><%= si + 1 %></td>
                            <td>
                                <span class="oct-cell-stack">
                                    <span class="oct-cell-main oct-mono"><%= o.kode_order || '—' %></span>
                                    <span class="oct-cell-sub">
                                        <%= slFmt(o.createdAt, false) %><% if (o.created_by_role === 'sales') { %> &middot; dibuat sales<% } %>
                                    </span>
                                </span>
                            </td>
                            <td>
                                <div class="oct-cell-media">
                                    <span class="oct-avatar oct-avatar-sm"><i class="fas fa-store" style="font-size:0.6875rem;"></i></span>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= namaCabang(o) %></span>
                                        <span class="oct-cell-sub"><%= itemsO.length %> produk</span>
                                    </span>
                                </div>
                            </td>
                            <td class="num"><%= itemsO.length.toLocaleString('id-ID') %></td>
                            <td class="num oct-td-strong"><%= rupiah(o.total_harga) %></td>
                            <td class="col-fit">
                                <span class="oct-pill oct-pill-<%= payCls %>"><%= PAY_LABEL[pay] || 'Belum bayar' %></span>
                            </td>
                            <td class="col-fit">
                                <span class="oct-pill oct-pill-dot oct-pill-<%= st %>"><%= STATUS_LABEL[st] || st || '—' %></span>
                            </td>
                        </tr>
                        <% } %>
                        <tr id="sloNoMatch" hidden>
                            <td colspan="7" class="oct-td-muted text-center" style="padding:1.5rem;">Tidak ada pesanan yang cocok dengan filter.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
<% } %>

<!-- Modal: buat pesanan -->
<div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="modalCreateLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <form method="post" action="/sales/orders" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalCreateLabel">Buat pesanan untuk cabang</h5>
                    <p class="oct-card-sub">Pilih cabang tujuan, lalu isi kuantitas pada produk yang dipesan.</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" title="Tutup" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
            </div>

            <div class="modal-body">
                <div class="form-row mb-3">
                    <div class="col-md-6 form-group mb-2 mb-md-0">
                        <label for="cabangTujuan">Cabang tujuan <span class="text-danger">*</span></label>
                        <select name="cabang_id" id="cabangTujuan" class="form-control" required>
                            <option value="">— pilih cabang —</option>
                            <% for (var cj = 0; cj < cabangs.length; cj++) { %>
                                <option value="<%= cabangs[cj].id %>"><%= cabangs[cj].username %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-6 form-group mb-0">
                        <label for="salesKeterangan">Keterangan <span class="oct-label-hint">(opsional)</span></label>
                        <input name="keterangan" id="salesKeterangan" class="form-control" placeholder="Catatan tambahan untuk pusat">
                    </div>
                </div>

                <div class="oct-card-head oct-card-head-plain" style="padding:0 0 0.625rem;">
                    <div>
                        <h3 class="oct-card-title">Pilih produk</h3>
                        <p class="oct-card-sub">Isi kolom qty pesan pada produk yang dibutuhkan cabang.</p>
                    </div>
                    <div class="oct-search">
                        <i class="fas fa-magnifying-glass"></i>
                        <label class="oct-sr" for="searchProduct">Cari produk</label>
                        <input type="text" id="searchProduct" placeholder="Cari nama produk atau SKU…" autocomplete="off">
                    </div>
                </div>

                <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

                <div class="oct-tablewrap oct-tablewrap-card slo-picker-wrap">
                    <table class="oct-table oct-table-sm" id="productsTable">
                        <thead>
                            <tr>
                                <th>Produk</th>
                                <th>Satuan</th>
                                <th class="num">Harga</th>
                                <th class="num">Stok pusat</th>
                                <th class="num" style="min-width:110px;">Qty pesan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (prods.length === 0) { %>
                                <tr><td colspan="5" class="oct-td-muted text-center" style="padding:1.5rem;">Belum ada produk yang bisa dipesan.</td></tr>
                            <% } %>
                            <% for (var pi = 0; pi < prods.length; pi++) { var p = prods[pi]; %>
                            <tr class="product-row" data-search="<%= ((p.nama_produk || '') + ' ' + (p.sku || '')).toLowerCase() %>">
                                <td>
                                    <div class="oct-cell-media">
                                        <% if (p.gambar_url) { %>
                                            <img class="oct-thumb" src="<%= p.gambar_url %>" alt="Foto produk <%= p.nama_produk || 'tanpa nama' %>" loading="lazy">
                                        <% } else { %>
                                            <span class="oct-thumb oct-thumb-empty"><i class="fas fa-image"></i></span>
                                        <% } %>
                                        <span class="oct-cell-stack">
                                            <span class="oct-cell-main"><%= p.nama_produk || '—' %></span>
                                            <span class="oct-cell-sub oct-mono"><%= p.sku || '—' %></span>
                                        </span>
                                    </div>
                                </td>
                                <td class="oct-td-muted"><%= p.satuan || '—' %></td>
                                <td class="num"><%= rupiah(p.harga_jual) %></td>
                                <td class="num oct-td-strong"><%= Number(p.stok || 0).toLocaleString('id-ID') %></td>
                                <td class="num">
                                    <label class="oct-sr" for="qty_<%= p.id %>">Qty pesan untuk <%= p.nama_produk || '' %></label>
                                    <input type="number" id="qty_<%= p.id %>" class="form-control form-control-sm qty-input slo-qty"
                                           name="qty_<%= p.id %>"
                                           data-product-id="<%= p.id %>"
                                           data-product-name="<%= p.nama_produk %>"
                                           data-harga="<%= Number(p.harga_jual || 0) %>"
                                           min="0" max="<%= p.stok || 0 %>" value="0" inputmode="numeric">
                                </td>
                            </tr>
                            <% } %>
                            <tr id="prodNoMatch" hidden>
                                <td colspan="5" class="oct-td-muted text-center" style="padding:1.5rem;">Produk tidak ditemukan.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="oct-stat-row mt-3">
                    <span class="oct-stat-key">Perkiraan total</span>
                    <span class="oct-stat-value" id="sloEstTotal" style="font-size:1rem;">Rp 0</span>
                </div>
                <p class="oct-card-sub mt-2 mb-0">Harga final mengikuti data produk saat pesanan diproses pusat.</p>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-primary" type="submit"><i class="fas fa-cart-shopping mr-2"></i>Buat pesanan</button>
            </div>

            <input type="hidden" name="data_barang_json" id="salesDataBarang">
        </form>
    </div>
</div>

<script>
    (function () {
        /* ── Filter daftar pesanan ─────────────────────────────── */
        var table = document.getElementById('sloTable');
        if (table) {
            var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-status]'));
            var searchEl = document.getElementById('sloSearch');
            var segEl = document.getElementById('sloSeg');
            var filterCabang = document.getElementById('filterCabang');
            var filterResetBtn = document.getElementById('filterResetBtn');
            var emptyRow = document.getElementById('sloNoMatch');
            var countEl = document.getElementById('sloCount');
            var bucket = 'all';

            function applyFilter() {
                var q = searchEl ? searchEl.value.trim().toLowerCase() : '';
                var cv = filterCabang ? filterCabang.value : '';
                var shown = 0;

                rows.forEach(function (row) {
                    var okCabang = !cv || row.getAttribute('data-cabang-id') === cv;
                    var okBucket = bucket === 'all' || row.getAttribute('data-bucket') === bucket;
                    var okSearch = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
                    var hit = okCabang && okBucket && okSearch;
                    row.hidden = !hit;
                    if (hit) shown++;
                });

                if (emptyRow) emptyRow.hidden = shown !== 0;
                if (countEl) countEl.textContent = shown + ' pesanan ditampilkan';
            }

            function setBucket(key) {
                bucket = key;
                if (!segEl) return;
                segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                    var on = b.dataset.bucket === key;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-selected', on ? 'true' : 'false');
                });
            }

            if (searchEl) searchEl.addEventListener('input', applyFilter);
            if (filterCabang) filterCabang.addEventListener('change', applyFilter);

            if (segEl) {
                segEl.addEventListener('click', function (e) {
                    var btn = e.target.closest('.oct-seg-item');
                    if (!btn) return;
                    setBucket(btn.dataset.bucket);
                    applyFilter();
                });
            }

            if (filterResetBtn) {
                filterResetBtn.addEventListener('click', function () {
                    if (searchEl) searchEl.value = '';
                    if (filterCabang) filterCabang.value = '';
                    setBucket('all');
                    applyFilter();
                });
            }
        }

        /* ── Pencarian produk di dalam modal ───────────────────── */
        var searchProduct = document.getElementById('searchProduct');
        if (searchProduct) {
            searchProduct.addEventListener('keyup', function () {
                var q = this.value.trim().toLowerCase();
                var shown = 0;
                document.querySelectorAll('.product-row').forEach(function (row) {
                    var hit = !q || (row.getAttribute('data-search') || '').indexOf(q) >= 0;
                    row.style.display = hit ? '' : 'none';
                    if (hit) shown++;
                });
                var noMatch = document.getElementById('prodNoMatch');
                if (noMatch) noMatch.hidden = shown !== 0;
            });
        }

        /* ── Perkiraan total + kirim data_barang_json ──────────── */
        var createForm = document.querySelector('#modalCreate form');
        if (createForm) {
            var estEl = document.getElementById('sloEstTotal');

            function recalc() {
                var total = 0;
                createForm.querySelectorAll('.qty-input').forEach(function (inp) {
                    var qty = parseInt(inp.value, 10) || 0;
                    if (qty > 0) total += qty * (Number(inp.getAttribute('data-harga')) || 0);
                });
                if (estEl) estEl.textContent = 'Rp ' + total.toLocaleString('id-ID');
            }

            createForm.querySelectorAll('.qty-input').forEach(function (inp) {
                inp.addEventListener('input', function () {
                    var max = Number(inp.getAttribute('max') || 0);
                    if (Number(inp.value) > max) inp.value = max;
                    if (Number(inp.value) < 0) inp.value = 0;
                    recalc();
                });
            });

            createForm.addEventListener('submit', function (e) {
                var items = [];
                createForm.querySelectorAll('.qty-input').forEach(function (inp) {
                    var qty = parseInt(inp.value, 10) || 0;
                    if (qty > 0) items.push({ product_id: inp.getAttribute('data-product-id'), qty: qty });
                });

                if (items.length === 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Belum ada produk dipilih',
                        text: 'Isi kuantitas minimal satu produk sebelum membuat pesanan.'
                    });
                    return;
                }

                document.getElementById('salesDataBarang').value = JSON.stringify(items);
            });

            $('#modalCreate').on('hidden.bs.modal', function () {
                createForm.reset();
                var hidden = document.getElementById('salesDataBarang');
                if (hidden) hidden.value = '';
                document.querySelectorAll('.product-row').forEach(function (row) { row.style.display = ''; });
                var noMatch = document.getElementById('prodNoMatch');
                if (noMatch) noMatch.hidden = true;
                recalc();
            });

            recalc();
        }

        /* ── Flash messages ────────────────────────────────────── */
        Aqua.flash({
            created: 'Pesanan berhasil dibuat'
        });
    })();
</script>
