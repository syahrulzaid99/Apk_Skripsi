<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.5rem;">
    <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(1.25rem,3vw,1.5rem); font-weight:700; margin:0; color:var(--oct-text);">
        <span style="margin-right:0.5rem;">&#128722;</span>Buat Pesanan untuk Cabang
    </h1>
    <button class="btn btn-primary" data-toggle="modal" data-target="#modalCreate" style="display:inline-flex; align-items:center; gap:0.5rem; border-radius:50rem;">
        <i class="fas fa-plus"></i> Buat Pesanan
    </button>
</div>

<style>
    .oct-card { background: var(--oct-card); border: 1px solid var(--oct-border-light); border-radius: 16px; box-shadow: var(--oct-shadow-sm); overflow: hidden; margin-bottom: 1rem; }
    .oct-card-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--oct-border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
    .oct-card-body { padding: 1rem 1.25rem; }
    .oct-pill { padding: 0.375em 1em; border-radius: 50rem; font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; display: inline-block; }
    .oct-pill-pending { background: var(--oct-yellow); color: #1E293B; }
    .oct-pill-dikirim, .oct-pill-dipaket { background: var(--oct-green-dark); }
    .oct-pill-diterima, .oct-pill-selesai, .oct-pill-approved_admin { background: #06B6D4; }
    .oct-pill-rejected { background: var(--oct-red); }
    .oct-kode { color: var(--oct-primary); background: var(--oct-primary-bg); padding: 0.25rem 0.625rem; border-radius: 6px; font-weight: 700; font-size: 0.8125rem; font-family: 'JetBrains Mono', monospace; }
</style>

<% var list = Array.isArray(orders) ? orders : []; %>

<!-- Filter -->
<div class="card" style="margin-bottom:1rem; border-radius:16px;">
    <div class="card-body" style="padding:0.75rem 1.25rem;">
        <div class="d-flex align-items-center flex-wrap" style="gap:0.75rem;">
            <span style="font-size:0.8125rem; font-weight:600; color:var(--oct-text-2);"><i class="fas fa-filter" style="margin-right:0.25rem;"></i> Filter</span>
            <select id="filterCabang" class="form-control form-control-sm" style="max-width:200px;">
                <option value="">Semua Cabang</option>
                <% (cabangList || []).forEach(function(c) { %><option value="<%= c.id %>"><%= c.username %></option><% }); %>
            </select>
            <select id="filterStatus" class="form-control form-control-sm" style="max-width:180px;">
                <option value="">Semua Status</option>
                <option value="pending">Pending</option><option value="approved_admin">Diverifikasi</option>
                <option value="dipaket">Dikemas</option><option value="dikirim">Dikirim</option>
                <option value="diterima">Diterima</option><option value="rejected">Ditolak</option>
            </select>
            <button id="filterResetBtn" class="btn btn-sm btn-outline-secondary"><i class="fas fa-undo"></i> Reset</button>
        </div>
    </div>
</div>

<% if (list.length === 0) { %>
    <div class="oct-card"><div class="oct-card-body text-center" style="padding:3rem;">
        <i class="fas fa-shopping-cart" style="font-size:2.5rem; color:var(--oct-text-muted); opacity:0.3; display:block; margin-bottom:0.75rem;"></i>
        <span style="color:var(--oct-text-muted);">Belum ada pesanan.</span>
    </div></div>
<% } %>

<% for (var si = 0; si < list.length; si++) { %>
    <% var o = list[si]; var st = (o.status || '').toLowerCase(); var cabang = (usersMap && usersMap[o.cabang_id]) ? usersMap[o.cabang_id] : null; %>
    <div class="oct-card" data-cabang-id="<%= o.cabang_id %>" data-status="<%= st %>">
        <div class="oct-card-header">
            <div>
                <span class="oct-kode"><%= o.kode_order %></span>
                <span style="color:var(--oct-text-muted); font-size:0.8125rem; margin-left:0.5rem;">
                    <i class="fas fa-store" style="margin-right:0.25rem;"></i> <%= cabang ? cabang.username : o.cabang_id %>
                </span>
                <% if (o.created_by_role === 'sales') { %><span class="badge" style="background:#06B6D4; margin-left:0.375rem;">oleh sales</span><% } %>
            </div>
            <span class="oct-pill oct-pill-<%= st %>"><%= (o.status || 'pending').toUpperCase() %></span>
        </div>
        <div class="oct-card-body">
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem; font-size:0.875rem;">
                <div>Total: <strong>Rp <%= (o.total_harga || 0).toLocaleString('id-ID') %></strong></div>
                <div><%= (o.items || []).length %> item</div>
                <div class="text-right">
                    <% if (o.payment_status === 'settlement') { %><span class="badge" style="background:var(--oct-green-dark);">LUNAS</span><% } else { %><span class="badge" style="background:var(--oct-yellow); color:#1E293B;">BELUM BAYAR</span><% } %>
                </div>
            </div>
        </div>
    </div>
<% } %>

<!-- CREATE ORDER MODAL -->
<div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <form method="post" action="/sales/orders" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header"><h5 class="modal-title">Buat Pesanan untuk Cabang</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div>
            <div class="modal-body">
                <div class="form-row mb-3">
                    <div class="col-md-6">
                        <label style="font-weight:600;">Pilih Cabang Tujuan <span style="color:var(--oct-red);">*</span></label>
                        <select name="cabang_id" class="form-control" required>
                            <option value="">-- Pilih Cabang --</option>
                            <% (cabangList || []).forEach(function(c) { %><option value="<%= c.id %>"><%= c.username %></option><% }); %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label style="font-weight:600;">Keterangan (opsional)</label>
                        <input name="keterangan" class="form-control" placeholder="Catatan tambahan">
                    </div>
                </div>
                <hr>
                <span style="font-family:'Poppins',sans-serif; font-weight:600; font-size:0.9375rem; color:var(--oct-text); margin-bottom:0.75rem; display:block;">Pilih Produk</span>
                <div class="mb-3"><input id="searchProduct" class="form-control" placeholder="Cari produk..."></div>
                <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
                    <table class="table table-bordered table-hover" id="productsTable">
                        <thead>
                            <tr><th>Produk</th><th>SKU</th><th>Satuan</th><th class="text-right">Harga</th><th class="text-right">Stok</th><th class="text-center" style="width:120px;">Qty Pesan</th></tr>
                        </thead>
                        <tbody>
                            <% (products || []).forEach(function(p) { %>
                            <tr class="product-row" data-search="<%= (p.nama_produk + ' ' + p.sku).toLowerCase() %>">
                                <td><strong><%= p.nama_produk %></strong></td><td><%= p.sku %></td><td><%= p.satuan %></td>
                                <td class="text-right">Rp <%= (p.harga_jual || 0).toLocaleString('id-ID') %></td>
                                <td class="text-right"><%= p.stok || 0 %></td>
                                <td class="text-center"><input type="number" class="form-control form-control-sm qty-input" name="qty_<%= p.id %>" data-product-id="<%= p.id %>" data-product-name="<%= p.nama_produk %>" min="0" max="<%= p.stok || 0 %>" value="0" style="width:70px; display:inline;"></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-success" type="submit"><i class="fas fa-shopping-cart" style="margin-right:0.375rem;"></i> Buat Pesanan</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function() {
        var params = new URLSearchParams(window.location.search);
        var ok = params.get('ok'), err = params.get('err');
        if (ok && typeof Swal !== 'undefined') { Swal.fire({toast:true,position:'top-end',icon:'success',title:ok==='created'?'Pesanan berhasil dibuilt!':ok,showConfirmButton:false,timer:3000,timerProgressBar:true}); params.delete('ok'); window.history.replaceState({},'',location.pathname+(params.toString()?'?'+params.toString():'')); }
        if (err && typeof Swal !== 'undefined') { Swal.fire({icon:'error',title:'Gagal',text:err,confirmButtonColor:'#3B82F6'}); params.delete('err'); window.history.replaceState({},'',location.pathname+(params.toString()?'?'+params.toString():'')); }

        var filterCabang = document.getElementById('filterCabang');
        var filterStatus = document.getElementById('filterStatus');
        var filterResetBtn = document.getElementById('filterResetBtn');
        var cards = document.querySelectorAll('.oct-card[data-cabang-id]');
        function applyFilter() {
            var cv = filterCabang.value, sv = filterStatus.value;
            cards.forEach(function(card) {
                var match = (!cv || card.getAttribute('data-cabang-id') === cv) && (!sv || card.getAttribute('data-status') === sv);
                card.style.display = match ? '' : 'none';
            });
        }
        filterCabang.addEventListener('change', applyFilter);
        filterStatus.addEventListener('change', applyFilter);
        filterResetBtn.addEventListener('click', function() { filterCabang.value = ''; filterStatus.value = ''; applyFilter(); });
    })();

    document.getElementById('searchProduct').addEventListener('keyup', function() {
        var q = this.value.toLowerCase();
        document.querySelectorAll('.product-row').forEach(function(row) { row.style.display = q ? (row.getAttribute('data-search').indexOf(q) >= 0 ? '' : 'none') : ''; });
    });

    document.querySelector('#modalCreate form').addEventListener('submit', function(e) {
        var items = [];
        document.querySelectorAll('.qty-input').forEach(function(inp) { var qty = parseInt(inp.value) || 0; if (qty > 0) items.push({product_id:inp.getAttribute('data-product-id'),qty:qty}); });
        if (items.length === 0) { e.preventDefault(); Swal.fire({icon:'warning',title:'Pilih Produk',text:'Minimal pilih 1 produk dengan qty > 0',confirmButtonColor:'#3B82F6'}); return; }
        var hidden = document.createElement('input'); hidden.type = 'hidden'; hidden.name = 'data_barang_json'; hidden.value = JSON.stringify(items); this.appendChild(hidden);
    });
</script>