<%
    var list = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : [];
    var umap = (typeof usersMap !== 'undefined' && usersMap && typeof usersMap === 'object') ? usersMap : {};
    var smap = (typeof shipMap !== 'undefined' && shipMap && typeof shipMap === 'object') ? shipMap : {};

    function tkDate(v) { if (!v) return null; return new Date(v._seconds ? v._seconds * 1000 : v); }
    function tkFmt(v, withTime) {
        var d = tkDate(v);
        if (!d || isNaN(d)) return '—';
        var opt = { day: '2-digit', month: 'short', year: 'numeric' };
        if (withTime) { opt.hour = '2-digit'; opt.minute = '2-digit'; }
        return d.toLocaleDateString('id-ID', opt);
    }
    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
    function namaCabang(o) {
        var c = umap[o.cabang_id];
        if (!c) return o.cabang_id || '—';
        return c.username || c.nama_cabang || o.cabang_id || '—';
    }

    // Peringkat progres: -1 = ditolak, 0 = dibuat, 1..5 = tahap pengiriman
    var RANK = { pending: 0, approved_sales: 1, approved_admin: 2, dipaket: 3, dikirim: 4, diterima: 5, selesai: 5 };
    function rankOf(s) {
        if (RANK[s] !== undefined) return RANK[s];
        if (s === 'rejected' || s === 'ditolak') return -1;
        return 0;
    }

    var HIST_LABEL = {
        pending: 'Pesanan dibuat', approved_sales: 'Dikonfirmasi sales', approved_admin: 'Diverifikasi admin',
        dipaket: 'Dikemas gudang', dikirim: 'Dikirim', diterima: 'Diterima cabang', selesai: 'Selesai',
        rejected: 'Ditolak sales', ditolak: 'Ditolak admin'
    };

    var STATUS_PILL = {
        pending: ['oct-pill-menunggu', 'Menunggu'], approved_sales: ['oct-pill-disetujui', 'Dikonfirmasi'],
        approved_admin: ['oct-pill-approved', 'Diverifikasi'], dipaket: ['oct-pill-dipaket', 'Dikemas'],
        dikirim: ['oct-pill-dikirim', 'Dikirim'], diterima: ['oct-pill-diterima', 'Diterima'],
        selesai: ['oct-pill-selesai', 'Selesai'], rejected: ['oct-pill-ditolak', 'Ditolak'],
        ditolak: ['oct-pill-ditolak', 'Ditolak admin']
    };

    function dotClsFor(es) {
        if (es === 'rejected' || es === 'ditolak') return 'oct-dot-bad';
        if (es === 'diterima' || es === 'selesai') return 'oct-dot-ok';
        if (es === 'dikirim') return 'oct-dot-blue';
        if (es === 'pending') return 'oct-dot-warn';
        return 'oct-dot-info';
    }

    // Timeline dari history[] (audit trail); fallback ke field timestamp untuk data lama
    function buildTimeline(o) {
        var tl = [];
        var hist = Array.isArray(o.history) ? o.history : [];
        if (hist.length) {
            for (var i = 0; i < hist.length; i++) {
                var e = hist[i] || {};
                var es = String(e.status || '').toLowerCase();
                tl.push({
                    label: HIST_LABEL[es] || e.status || '—',
                    time: tkFmt(e.at, true),
                    sub: 'oleh ' + (e.by_username || e.by || '—') + (e.note ? ' · ' + e.note : ''),
                    dot: dotClsFor(es)
                });
            }
            return tl;
        }
        var evs = [
            ['Pesanan dibuat', o.createdAt, 'oct-dot-warn'],
            ['Dikonfirmasi sales', o.approved_sales_at, 'oct-dot-info'],
            ['Diverifikasi admin', o.approved_admin_at, 'oct-dot-info'],
            ['Dikemas gudang', o.packed_at, 'oct-dot-info']
        ];
        for (var j = 0; j < evs.length; j++) {
            if (evs[j][1]) tl.push({ label: evs[j][0], time: tkFmt(evs[j][1], true), sub: '', dot: evs[j][2] });
        }
        var st = String(o.status || '').toLowerCase();
        if (o.kode_pengiriman) {
            tl.push({ label: 'Dikirim', time: tkFmt(o.updatedAt, true), sub: 'Resi ' + o.kode_pengiriman, dot: 'oct-dot-blue' });
        }
        if (st === 'diterima' || st === 'selesai') {
            var sh = smap[o.shipment_id];
            tl.push({
                label: 'Diterima cabang',
                time: tkFmt((sh && sh.diterima_at) || o.updatedAt, true),
                sub: (sh && sh.diterima_oleh) ? 'oleh ' + sh.diterima_oleh : '',
                dot: 'oct-dot-ok'
            });
        }
        if (st === 'rejected' || st === 'ditolak') {
            tl.push({ label: HIST_LABEL[st], time: tkFmt(o.rejected_at, true), sub: o.rejection_reason || '', dot: 'oct-dot-bad' });
        }
        return tl;
    }

    var nTotal = list.length, nProses = 0, nSelesai = 0, nDitolak = 0, nUnit = 0;
    for (var k = 0; k < list.length; k++) {
        var rk = rankOf(String(list[k].status || 'pending').toLowerCase());
        if (rk === -1) nDitolak++;
        else if (rk >= 5) nSelesai++;
        else nProses++;
        var itk = Array.isArray(list[k].items) ? list[k].items : [];
        for (var z = 0; z < itk.length; z++) nUnit += Number(itk[z].qty || 0);
    }

    var buckets = [
        { key: 'all', label: 'Semua', n: nTotal },
        { key: 'proses', label: 'Dalam proses', n: nProses },
        { key: 'selesai', label: 'Selesai', n: nSelesai },
        { key: 'ditolak', label: 'Ditolak', n: nDitolak }
    ];

    // Data ringkas untuk modal detail (diformat server-side, dikonsumsi JS)
    var rowsJs = [];
    for (var m = 0; m < list.length; m++) {
        var oo = list[m];
        var stk = String(oo.status || 'pending').toLowerCase();
        var pill = STATUS_PILL[stk] || ['oct-pill-secondary', stk];
        var itm = Array.isArray(oo.items) ? oo.items : [];
        rowsJs.push({
            kode: oo.kode_order || '—',
            cabang: namaCabang(oo),
            tanggal: tkFmt(oo.createdAt, false),
            total: rupiah(oo.total_harga),
            resi: oo.kode_pengiriman || '',
            status: pill[1],
            pillCls: pill[0],
            items: itm.map(function (it) {
                return { nama: it.nama_produk || it.nama || it.product_name || '—', qty: Number(it.qty || 0) };
            }),
            timeline: buildTimeline(oo)
        });
    }
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */

    /* Stepper progres horizontal */
    .stk-track {
        display: flex;
        align-items: flex-start;
        min-width: 240px;
        max-width: 280px;
        margin: 0;
        padding: 0.25rem 0 0;
    }

    .stk-step {
        flex: 1;
        text-align: center;
        position: relative;
        min-width: 0;
    }

    .stk-step::before {
        content: '';
        position: absolute;
        top: 6px;
        left: -50%;
        width: 100%;
        height: 2px;
        background: var(--oct-border);
    }

    .stk-step:first-child::before { display: none; }

    .stk-step.done::before { background: var(--oct-green); }

    .stk-dot {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--oct-card-bg, #fff);
        border: 2px solid var(--oct-border);
        position: relative;
        z-index: 1;
    }

    .stk-step.done .stk-dot { background: var(--oct-green); border-color: var(--oct-green); }
    .stk-step.current .stk-dot { background: var(--oct-primary); border-color: var(--oct-primary); box-shadow: 0 0 0 3px var(--oct-primary-bg); }

    .stk-label {
        display: block;
        font-size: 0.625rem;
        line-height: 1.2;
        color: var(--oct-text-muted);
        margin-top: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .stk-step.done .stk-label, .stk-step.current .stk-label { color: var(--oct-text); font-weight: 600; }

    /* Resi */
    .stk-resi {
        font-family: var(--oct-mono, ui-monospace, 'Cascadia Code', Consolas, monospace);
        font-size: 0.8125rem;
        color: var(--oct-primary);
        white-space: nowrap;
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Tracking Pengiriman</h1>
        <p class="oct-page-sub">Pantau progres setiap pesanan cabang — dari konfirmasi, verifikasi admin, pengemasan, hingga diterima cabang.</p>
    </div>
</div>

<% if (list.length === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-truck-fast"></i></div>
            <h2 class="oct-empty-title">Belum ada pesanan untuk dilacak</h2>
            <p class="oct-empty-text">Pesanan cabang yang sudah masuk akan muncul di sini lengkap dengan progres pengirimannya.</p>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-boxes-stacked"></i></span>
                    <span class="oct-kpi-label">Total pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nTotal %></span>
                    <span class="oct-kpi-note">seluruh cabang</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-route"></i></span>
                    <span class="oct-kpi-label">Dalam proses</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nProses %></span>
                    <% if (nProses > 0) { %>
                        <span class="oct-delta oct-delta-warn"><i class="fas fa-hourglass-half"></i> perjalanan</span>
                    <% } else { %>
                        <span class="oct-kpi-note">tidak ada antrean</span>
                    <% } %>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-circle-check"></i></span>
                    <span class="oct-kpi-label">Selesai</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nSelesai %></span>
                    <span class="oct-kpi-note">diterima cabang</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-circle-xmark"></i></span>
                    <span class="oct-kpi-label">Ditolak</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nDitolak %></span>
                    <span class="oct-kpi-foot"><%= nUnit.toLocaleString('id-ID') %> unit tercatat</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Daftar tracking -->
    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Progres pesanan</h2>
                <p class="oct-card-sub" id="trkCount"><%= list.length %> pesanan ditampilkan</p>
            </div>
            <div class="oct-row">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="trkSearch">Cari tracking</label>
                    <input type="text" id="trkSearch" placeholder="Cari kode pesanan, resi, atau cabang…" autocomplete="off">
                </div>
                <div class="oct-seg" id="trkSeg" role="tablist" aria-label="Saring berdasarkan progres">
                    <% for (var bi = 0; bi < buckets.length; bi++) { var b = buckets[bi]; %>
                        <button type="button" role="tab" class="oct-seg-item <%= bi === 0 ? 'active' : '' %>" data-bucket="<%= b.key %>" aria-selected="<%= bi === 0 %>">
                            <%= b.label %><span class="oct-seg-count"><%= b.n %></span>
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="trkTable">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Pesanan</th>
                            <th>Cabang</th>
                            <th>Resi</th>
                            <th class="num">Total</th>
                            <th>Progres</th>
                            <th class="col-fit">Status</th>
                            <th class="col-fit">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var si = 0; si < list.length; si++) {
                            var o = list[si];
                            var st = String(o.status || 'pending').toLowerCase();
                            var rk = rankOf(st);
                            var pill = STATUS_PILL[st] || ['oct-pill-secondary', st || '—'];
                            var cari = ((o.kode_order || '') + ' ' + (o.kode_pengiriman || '') + ' ' + namaCabang(o)).toLowerCase();
                            var bkt = rk === -1 ? 'ditolak' : (rk >= 5 ? 'selesai' : 'proses');
                        %>
                        <tr data-bucket="<%= bkt %>" data-search="<%= cari %>">
                            <td class="col-fit oct-td-muted"><%= si + 1 %></td>
                            <td>
                                <span class="oct-cell-stack">
                                    <span class="oct-cell-main oct-mono"><%= o.kode_order || '—' %></span>
                                    <span class="oct-cell-sub"><%= tkFmt(o.createdAt, false) %></span>
                                </span>
                            </td>
                            <td>
                                <div class="oct-cell-media">
                                    <span class="oct-avatar oct-avatar-sm"><i class="fas fa-store" style="font-size:0.6875rem;"></i></span>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= namaCabang(o) %></span>
                                        <span class="oct-cell-sub"><%= Array.isArray(o.items) ? o.items.length : 0 %> produk</span>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <% if (o.kode_pengiriman) { %>
                                    <span class="stk-resi"><i class="fas fa-truck-ramp-box" style="font-size:0.6875rem; margin-right:0.25rem;"></i><%= o.kode_pengiriman %></span>
                                <% } else { %>
                                    <span class="oct-td-muted">—</span>
                                <% } %>
                            </td>
                            <td class="num oct-td-strong"><%= rupiah(o.total_harga) %></td>
                            <td>
                                <% if (rk === -1) { %>
                                    <span class="oct-pill oct-pill-ditolak"><i class="fas fa-ban mr-1"></i>Ditolak</span>
                                <% } else { %>
                                    <div class="stk-track" role="img" aria-label="Progres pengiriman">
                                        <% var stepDefs = [['sales', 'Sales'], ['admin', 'Admin'], ['kemas', 'Kemas'], ['kirim', 'Kirim'], ['terima', 'Terima']]; %>
                                        <% for (var sti = 0; sti < stepDefs.length; sti++) {
                                            var sd = stepDefs[sti];
                                            var scl = (sti + 1) <= rk ? 'done' : ((sti + 1) === rk + 1 && rk > 0 && rk < 5 ? 'current' : '');
                                        %>
                                            <div class="stk-step <%= scl %>">
                                                <span class="stk-dot"></span>
                                                <span class="stk-label"><%= sd[1] %></span>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                            </td>
                            <td class="col-fit">
                                <span class="oct-pill oct-pill-dot <%= pill[0] %>"><%= pill[1] %></span>
                            </td>
                            <td class="col-fit">
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="openTrk(<%= si %>)" title="Lihat detail progres">
                                    <i class="fas fa-eye mr-1"></i>Detail
                                </button>
                            </td>
                        </tr>
                        <% } %>
                        <tr id="trkNoMatch" hidden>
                            <td colspan="8" class="oct-td-muted text-center" style="padding:1.5rem;">Tidak ada pesanan yang cocok dengan filter.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
<% } %>

<!-- Modal: detail progres -->
<div class="modal fade" id="trkModal" tabindex="-1" role="dialog" aria-labelledby="trkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="trkModalLabel">Detail pengiriman</h5>
                    <p class="oct-card-sub" id="trkModalSub">—</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" title="Tutup" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="oct-note oct-note-accent mb-3" id="trkMeta">
                    <i class="fas fa-circle-info"></i>
                    <span id="trkMetaText">—</span>
                </div>

                <h2 class="oct-card-title">Barang</h2>
                <div class="oct-tablewrap mb-3">
                    <table class="oct-table" id="trkItems">
                        <thead>
                            <tr>
                                <th class="col-fit">#</th>
                                <th>Produk</th>
                                <th class="num">Qty</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <h2 class="oct-card-title">Progres status</h2>
                <ol class="oct-timeline oct-tl-rail" id="trkTimeline"></ol>
            </div>
        </div>
    </div>
</div>

<script>
    /* Data ringkas hasil render server — aman: < di-escape agar tidak menutup tag script */
    var TRK_DATA = <%- JSON.stringify(rowsJs).replace(/</g, '\\u003c') %>;

    (function () {
        function esc(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        /* ── Filter daftar ─────────────────────────────────────── */
        var table = document.getElementById('trkTable');
        if (table) {
            var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-bucket]'));
            var searchEl = document.getElementById('trkSearch');
            var segEl = document.getElementById('trkSeg');
            var emptyRow = document.getElementById('trkNoMatch');
            var countEl = document.getElementById('trkCount');
            var bucket = 'all';

            function applyFilter() {
                var q = searchEl ? searchEl.value.trim().toLowerCase() : '';
                var shown = 0;
                rows.forEach(function (row) {
                    var okBucket = bucket === 'all' || row.getAttribute('data-bucket') === bucket;
                    var okSearch = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
                    var hit = okBucket && okSearch;
                    row.hidden = !hit;
                    if (hit) shown++;
                });
                if (emptyRow) emptyRow.hidden = shown !== 0;
                if (countEl) countEl.textContent = shown + ' pesanan ditampilkan';
            }

            if (searchEl) searchEl.addEventListener('input', applyFilter);

            if (segEl) {
                segEl.addEventListener('click', function (e) {
                    var btn = e.target.closest('.oct-seg-item');
                    if (!btn) return;
                    bucket = btn.dataset.bucket;
                    segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                        var on = b === btn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    applyFilter();
                });
            }
        }

        /* ── Modal detail ──────────────────────────────────────── */
        window.openTrk = function (i) {
            var d = TRK_DATA[i];
            if (!d) return;

            document.getElementById('trkModalLabel').textContent = d.kode;
            document.getElementById('trkModalSub').textContent = d.cabang + ' · ' + d.tanggal;
            document.getElementById('trkMetaText').innerHTML =
                '<strong>Total:</strong> ' + esc(d.total) +
                ' &nbsp;&middot;&nbsp; <strong>Status:</strong> <span class="oct-pill oct-pill-dot ' + esc(d.pillCls) + '">' + esc(d.status) + '</span>' +
                (d.resi ? ' &nbsp;&middot;&nbsp; <strong>Resi:</strong> <span class="oct-mono">' + esc(d.resi) + '</span>' : '');

            var itemsTbody = document.querySelector('#trkItems tbody');
            if (d.items.length === 0) {
                itemsTbody.innerHTML = '<tr><td colspan="3" class="oct-td-muted text-center">Tidak ada item.</td></tr>';
            } else {
                itemsTbody.innerHTML = d.items.map(function (it, idx) {
                    return '<tr><td class="col-fit oct-td-muted">' + (idx + 1) + '</td>' +
                        '<td>' + esc(it.nama) + '</td>' +
                        '<td class="num">' + Number(it.qty || 0).toLocaleString('id-ID') + '</td></tr>';
                }).join('');
            }

            var tlEl = document.getElementById('trkTimeline');
            if (!d.timeline.length) {
                tlEl.innerHTML = '<li class="oct-tl-item"><span class="oct-dot oct-dot-info"></span><div class="oct-tl-body"><p class="oct-tl-text">Belum ada riwayat status.</p></div></li>';
            } else {
                tlEl.innerHTML = d.timeline.map(function (e) {
                    return '<li class="oct-tl-item"><span class="oct-dot ' + esc(e.dot) + '"></span>' +
                        '<div class="oct-tl-body"><p class="oct-tl-text">' + esc(e.label) + '</p>' +
                        (e.sub ? '<p class="oct-tl-sub">' + esc(e.sub) + '</p>' : '') +
                        '</div><span class="oct-tl-time">' + esc(e.time) + '</span></li>';
                }).join('');
            }

            $('#trkModal').modal('show');
        };

        Aqua.flash({});
    })();
</script>
