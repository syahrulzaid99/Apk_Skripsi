<%
    // Halaman ini dirender tanpa csrfToken — jangan tambahkan form yang membutuhkannya.
    var list = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : [];
    var umap = (typeof usersMap !== 'undefined' && usersMap && typeof usersMap === 'object') ? usersMap : {};

    function shDate(v) {
        if (!v) return null;
        return new Date(v._seconds ? v._seconds * 1000 : v);
    }
    function shFmt(v, withTime) {
        var d = shDate(v);
        if (!d || isNaN(d)) return '—';
        var opt = { day: '2-digit', month: 'short', year: 'numeric' };
        if (withTime) { opt.hour = '2-digit'; opt.minute = '2-digit'; }
        return d.toLocaleDateString('id-ID', opt);
    }
    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
    function namaCabang(o) {
        var c = umap[o.cabang_id];
        if (!c) return o.cabang_id || '—';
        return c.username || c.nama_cabang || o.cabang_id || '—';
    }

    // Keputusan sales ditentukan dari field SIAPA yang mengambil keputusan, bukan status saat ini.
    // Setelah disetujui, status bisa lanjut ke approved_admin/dipaket/dikirim/diterima, atau diubah
    // admin menjadi ditolak — bagi sales, keputusan yang diambilnya tetap "disetujui".
    function keputusan(o) {
        if (o.approved_sales_by) return 'disetujui';
        if (o.rejected_by) return 'ditolak';
        return 'lainnya';
    }
    function pillClass(b) { return b === 'disetujui' ? 'oct-pill-disetujui' : (b === 'ditolak' ? 'oct-pill-ditolak' : 'oct-pill-secondary'); }
    function pillLabel(b) { return b === 'disetujui' ? 'Disetujui' : (b === 'ditolak' ? 'Ditolak' : 'Lainnya'); }

    var nSetuju = 0, nTolak = 0, nLainnya = 0, nilaiSetuju = 0, nilaiTotal = 0, nUnit = 0;
    for (var k = 0; k < list.length; k++) {
        var o = list[k];
        var tk = Number(o.total_harga || 0);
        nilaiTotal += tk;

        var kp = keputusan(o);
        if (kp === 'disetujui') { nSetuju++; nilaiSetuju += tk; }
        else if (kp === 'ditolak') nTolak++;
        else nLainnya++;

        var itk = Array.isArray(o.items) ? o.items : [];
        for (var z = 0; z < itk.length; z++) nUnit += Number(itk[z].qty || 0);
    }

    var rasio = list.length ? Math.round((nSetuju / list.length) * 100) : 0;
    var rasioTolak = list.length ? Math.round((nTolak / list.length) * 100) : 0;

    var buckets = [
        { key: 'all', label: 'Semua', n: list.length },
        { key: 'disetujui', label: 'Disetujui', n: nSetuju },
        { key: 'ditolak', label: 'Ditolak', n: nTolak }
    ];
    if (nLainnya > 0) buckets.push({ key: 'lainnya', label: 'Lainnya', n: nLainnya });
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .slh-total {
        color: var(--oct-primary);
        font-size: 0.9375rem;
    }

    .slh-reason {
        display: inline-block;
        max-width: 30ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Riwayat approval</h1>
        <p class="oct-page-sub">Rekap keputusan yang sudah Anda ambil atas pesanan cabang, beserta alasan penolakannya.</p>
    </div>
</div>

<% if (list.length === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-clock-rotate-left"></i></div>
            <h2 class="oct-empty-title">Belum ada riwayat approval</h2>
            <p class="oct-empty-text">Setiap pesanan yang Anda setujui atau tolak akan tercatat di sini lengkap dengan nilai dan alasannya.</p>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-clipboard-list"></i></span>
                    <span class="oct-kpi-label">Total keputusan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= list.length %></span>
                    <span class="oct-kpi-note">pesanan diproses</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-circle-check"></i></span>
                    <span class="oct-kpi-label">Disetujui</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nSetuju %></span>
                    <span class="oct-delta oct-delta-up"><i class="fas fa-arrow-up"></i> <%= rasio %>%</span>
                </div>
                <div class="oct-kpi-foot"><%= rupiah(nilaiSetuju) %> nilai disetujui</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-circle-xmark"></i></span>
                    <span class="oct-kpi-label">Ditolak</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nTolak %></span>
                    <% if (nTolak > 0) { %>
                        <span class="oct-delta oct-delta-down"><i class="fas fa-arrow-down"></i> <%= rasioTolak %>%</span>
                    <% } else { %>
                        <span class="oct-kpi-note">tidak ada penolakan</span>
                    <% } %>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-wallet"></i></span>
                    <span class="oct-kpi-label">Nilai seluruh pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm"><%= rupiah(nilaiTotal) %></span>
                </div>
                <div class="oct-kpi-foot"><%= nUnit.toLocaleString('id-ID') %> unit tercatat</div>
            </div>
        </div>
    </div>

    <!-- Riwayat -->
    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Keputusan approval</h2>
                <p class="oct-card-sub" id="slhCount"><%= list.length %> riwayat ditampilkan</p>
            </div>
            <div class="oct-row">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="slhSearch">Cari riwayat</label>
                    <input type="text" id="slhSearch" placeholder="Cari kode pesanan atau cabang…" autocomplete="off">
                </div>
                <div class="oct-seg" id="slhSeg" role="tablist" aria-label="Saring berdasarkan keputusan">
                    <% for (var bi = 0; bi < buckets.length; bi++) { var b = buckets[bi]; %>
                        <button type="button" role="tab" class="oct-seg-item <%= bi === 0 ? 'active' : '' %>" data-bucket="<%= b.key %>" aria-selected="<%= bi === 0 %>">
                            <%= b.label %><span class="oct-seg-count"><%= b.n %></span>
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="slhTable">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Pesanan</th>
                            <th>Cabang</th>
                            <th class="num">Item</th>
                            <th class="num">Total</th>
                            <th>Catatan / Alasan</th>
                            <th class="col-fit">Keputusan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var si = 0; si < list.length; si++) {
                            var o = list[si];
                            var bkt = keputusan(o);
                            var itemsO = Array.isArray(o.items) ? o.items : [];
                            var cari = ((o.kode_order || '') + ' ' + namaCabang(o) + ' ' + (o.rejection_reason || '') + ' ' + (o.keterangan_sales || '')).toLowerCase();
                        %>
                        <tr data-bucket="<%= bkt %>" data-search="<%= cari %>">
                            <td class="col-fit oct-td-muted"><%= si + 1 %></td>
                            <td>
                                <span class="oct-cell-stack">
                                    <span class="oct-cell-main oct-mono"><%= o.kode_order || '—' %></span>
                                    <span class="oct-cell-sub"><%= shFmt(o.createdAt, false) %></span>
                                </span>
                            </td>
                            <td>
                                <div class="oct-cell-media">
                                    <span class="oct-avatar oct-avatar-sm"><i class="fas fa-store" style="font-size:0.6875rem;"></i></span>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= namaCabang(o) %></span>
                                        <span class="oct-cell-sub"><%= itemsO.length %> produk</span>
                                    </span>
                                </div>
                            </td>
                            <td class="num"><%= itemsO.length.toLocaleString('id-ID') %></td>
                            <td class="num oct-td-strong"><%= rupiah(o.total_harga) %></td>
                            <td class="oct-td-muted">
                                <% if (o.rejection_reason) { %>
                                    <span class="slh-reason" title="<%= o.rejection_reason %>"><i class="fas fa-circle-xmark" style="font-size:0.6875rem; margin-right:0.3rem;"></i><%= o.rejection_reason %></span>
                                <% } else if (o.keterangan_sales) { %>
                                    <span class="slh-reason" title="<%= o.keterangan_sales %>"><i class="fas fa-pen" style="font-size:0.6875rem; margin-right:0.3rem;"></i><%= o.keterangan_sales %></span>
                                <% } else { %>—<% } %>
                            </td>
                            <td class="col-fit">
                                <span class="oct-pill oct-pill-dot <%= pillClass(bkt) %>"><%= pillLabel(bkt) %></span>
                            </td>
                        </tr>
                        <% } %>
                        <tr id="slhNoMatch" hidden>
                            <td colspan="7" class="oct-td-muted text-center" style="padding:1.5rem;">Tidak ada riwayat yang cocok dengan filter.</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="oct-td-muted">Total nilai</td>
                            <td class="num slh-total"><%= rupiah(nilaiTotal) %></td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </section>
<% } %>

<script>
    (function () {
        var table = document.getElementById('slhTable');
        if (table) {
            var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-bucket]'));
            var searchEl = document.getElementById('slhSearch');
            var segEl = document.getElementById('slhSeg');
            var emptyRow = document.getElementById('slhNoMatch');
            var countEl = document.getElementById('slhCount');
            var bucket = 'all';

            function applyFilter() {
                var q = searchEl ? searchEl.value.trim().toLowerCase() : '';
                var shown = 0;

                rows.forEach(function (row) {
                    var okBucket = bucket === 'all' || row.getAttribute('data-bucket') === bucket;
                    var okSearch = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
                    var hit = okBucket && okSearch;
                    row.hidden = !hit;
                    if (hit) shown++;
                });

                if (emptyRow) emptyRow.hidden = shown !== 0;
                if (countEl) countEl.textContent = shown + ' riwayat ditampilkan';
            }

            if (searchEl) searchEl.addEventListener('input', applyFilter);

            if (segEl) {
                segEl.addEventListener('click', function (e) {
                    var btn = e.target.closest('.oct-seg-item');
                    if (!btn) return;
                    bucket = btn.dataset.bucket;
                    segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                        var on = b === btn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    applyFilter();
                });
            }
        }

        Aqua.flash({});
    })();
</script>
