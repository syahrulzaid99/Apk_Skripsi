<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Masuk — Aqua Stock</title>
    <meta name="description" content="Masuk ke Aqua Stock — manajemen stok, pengiriman, dan penjualan distribusi Aqua Japan.">
    <meta name="theme-color" content="#F5F4FA">
    <link rel="icon" href="/assets/logo.png">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <meta name="csrf-token" content="<%= csrfToken %>">

    <script>
        (function() {
            var theme = localStorage.getItem('aqua-theme');
            if (theme === 'dark') document.documentElement.classList.add('theme-dark');
        })();
    </script>

    <style>
        /* ============================================================
           Standalone page (layout: false) — carries its own copy of the
           Aqua Stock tokens. Keep these values in sync with the :root
           block in layouts/base.ejs.
           ============================================================ */
        :root {
            --oct-primary: #1355bf;
            --oct-primary-dark: #1355bf;
            --oct-primary-light: #B8D4F5;
            --oct-primary-bg: #E9F1FB;
            --oct-primary-ring: rgba(19, 85, 191, 0.18);
            --oct-on-primary: #FFFFFF;

            --oct-bg: #F5F4FA;
            --oct-card: #FFFFFF;
            --oct-inset: #F7F6FC;

            --oct-text: #16141F;
            --oct-text-2: #5C5872;
            --oct-text-muted: #8B87A0;

            --oct-border: #E4E1F0;
            --oct-border-light: #EFEDF7;

            --oct-shadow-lift: 0 24px 60px rgba(30, 22, 70, 0.14), 0 2px 6px rgba(30, 22, 70, 0.05);

            --oct-r-xl: 22px;
            --oct-r-lg: 16px;
            --oct-r: 12px;
            --oct-r-sm: 9px;
        }

        .theme-dark {
            --oct-primary: #7FA8E8;
            --oct-primary-dark: #9DB9F0;
            --oct-primary-light: #3D5278;
            --oct-primary-bg: #1E2734;
            --oct-primary-ring: rgba(127, 168, 232, 0.28);
            --oct-on-primary: #14111F;

            --oct-bg: #100E18;
            --oct-card: #191626;
            --oct-inset: #201C30;

            --oct-text: #F3F1FA;
            --oct-text-2: #ABA6C0;
            --oct-text-muted: #7B7695;

            --oct-border: #2C2740;
            --oct-border-light: #241F35;

            --oct-shadow-lift: 0 24px 60px rgba(0, 0, 0, 0.55), 0 2px 8px rgba(0, 0, 0, 0.35);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html { background: var(--oct-bg); }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--oct-bg);
            color: var(--oct-text);
            font-size: 0.9375rem;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        h1, h2, p { text-wrap: pretty; }

        /* Soft violet wash behind the card */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(58% 46% at 50% 0%, var(--oct-primary-ring) 0%, transparent 70%),
                radial-gradient(48% 40% at 50% 100%, var(--oct-primary-ring) 0%, transparent 72%);
            pointer-events: none;
        }

        .login-sr {
            position: absolute;
            width: 1px; height: 1px;
            padding: 0; margin: -1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
            white-space: nowrap;
            border: 0;
        }

        a:focus-visible,
        button:focus-visible,
        input:focus-visible {
            outline: 2px solid var(--oct-primary);
            outline-offset: 2px;
            border-radius: var(--oct-r-sm);
        }

        /* ── Card: brand panel + form ─────────────────────────── */
        .login-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 840px;
            display: grid;
            grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
            background: var(--oct-card);
            border: 1px solid var(--oct-border-light);
            border-radius: var(--oct-r-xl);
            box-shadow: var(--oct-shadow-lift);
            overflow: hidden;
        }

        /* The brand panel is a violet gradient in both themes, so its
           foreground stays white — expressed as rgba(), never a hex. */
        .login-brand {
            background: linear-gradient(160deg, var(--oct-primary) 0%, var(--oct-primary-dark) 100%);
            color: rgba(255, 255, 255, 1);
            padding: 2.25rem 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.75rem;
        }

        .login-brand-mark {
            display: flex;
            align-items: center;
            gap: 0.6875rem;
        }

        .login-brand-meta {
            display: flex;
            flex-direction: column;
            line-height: 1.25;
            min-width: 0;
        }

        .login-brand-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 12px;
            display: block;
        }

        .login-brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .login-brand-name {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1rem;
            letter-spacing: -0.025em;
            line-height: 1.2;
        }

        .login-brand-sub {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.72);
        }

        .login-brand-body { margin-top: auto; }

        .login-brand-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -0.04em;
            line-height: 1.18;
            margin-bottom: 0.5rem;
        }

        .login-brand-text {
            font-size: 0.8125rem;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.78);
            max-width: 32ch;
        }

        .login-points {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.625rem;
            margin-top: 1.5rem;
        }

        .login-points li {
            display: flex;
            align-items: center;
            gap: 0.5625rem;
            font-size: 0.8125rem;
            color: rgba(255, 255, 255, 0.9);
        }

        .login-points i {
            width: 20px;
            height: 20px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.16);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.625rem;
            flex-shrink: 0;
        }

        /* ── Form pane ────────────────────────────────────────── */
        .login-pane {
            padding: 2.5rem 2.25rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 1.375rem;
            letter-spacing: -0.035em;
            color: var(--oct-text);
            margin-bottom: 0.25rem;
        }

        .login-subtitle {
            font-size: 0.8125rem;
            color: var(--oct-text-2);
            margin-bottom: 1.75rem;
        }

        .login-field { margin-bottom: 1rem; }

        .login-field label {
            display: block;
            font-size: 0.78125rem;
            font-weight: 600;
            color: var(--oct-text-2);
            margin-bottom: 0.375rem;
        }

        .login-inputbox {
            position: relative;
            display: flex;
            align-items: center;
        }

        .login-inputbox .login-icon {
            position: absolute;
            left: 14px;
            color: var(--oct-text-muted);
            font-size: 0.875rem;
            pointer-events: none;
            transition: color 0.16s ease;
        }

        .login-inputbox input {
            width: 100%;
            padding: 0.75rem 2.75rem 0.75rem 2.625rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.9375rem;
            color: var(--oct-text);
            background: var(--oct-inset);
            border: 1px solid var(--oct-border);
            border-radius: var(--oct-r);
            outline: none;
            transition: border-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
        }

        .login-inputbox input::placeholder {
            color: var(--oct-text-muted);
            font-weight: 400;
        }

        .login-inputbox input:hover { border-color: var(--oct-primary-light); }

        .login-inputbox input:focus {
            border-color: var(--oct-primary-light);
            background: var(--oct-card);
            box-shadow: 0 0 0 3px var(--oct-primary-ring);
        }

        .login-inputbox input:focus ~ .login-icon { color: var(--oct-primary); }

        .login-toggle {
            position: absolute;
            right: 10px;
            width: 30px;
            height: 30px;
            background: none;
            border: none;
            border-radius: 8px;
            color: var(--oct-text-muted);
            cursor: pointer;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.16s ease, background 0.16s ease;
        }

        .login-toggle:hover {
            color: var(--oct-primary);
            background: var(--oct-primary-bg);
        }

        .login-submit {
            width: 100%;
            margin-top: 0.75rem;
            padding: 0.8125rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.9375rem;
            font-weight: 600;
            color: var(--oct-on-primary);
            background: var(--oct-primary);
            border: 1px solid var(--oct-primary);
            border-radius: var(--oct-r);
            cursor: pointer;
            box-shadow: 0 1px 2px var(--oct-primary-ring);
            transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, transform 0.12s ease;
        }

        .login-submit:hover {
            background: var(--oct-primary-dark);
            border-color: var(--oct-primary-dark);
            box-shadow: 0 6px 18px var(--oct-primary-ring);
        }

        .login-submit:active {
            transform: translateY(1px);
            box-shadow: none;
        }

        .login-note {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            margin-top: 1.25rem;
            padding: 0.625rem 0.75rem;
            font-size: 0.75rem;
            color: var(--oct-text-2);
            background: var(--oct-inset);
            border: 1px solid var(--oct-border-light);
            border-radius: var(--oct-r-sm);
        }

        .login-note i {
            color: var(--oct-text-muted);
            font-size: 0.6875rem;
            margin-top: 0.1875rem;
        }

        .login-footer {
            margin-top: 1.5rem;
            font-size: 0.75rem;
            color: var(--oct-text-muted);
            text-align: center;
        }

        /* ── Theme toggle ─────────────────────────────────────── */
        .login-theme {
            position: fixed;
            top: 16px;
            right: 16px;
            z-index: 9;
        }

        .login-theme button {
            width: 36px;
            height: 36px;
            background: var(--oct-card);
            border: 1px solid var(--oct-border);
            border-radius: var(--oct-r-sm);
            color: var(--oct-text-2);
            font-size: 0.875rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
        }

        .login-theme button:hover {
            background: var(--oct-primary-bg);
            color: var(--oct-primary);
            border-color: var(--oct-primary-light);
        }

        /* ── SweetAlert2 (standalone page carries its own theming) ── */
        .swal2-popup {
            border-radius: var(--oct-r-lg) !important;
            font-family: 'Inter', sans-serif !important;
            background: var(--oct-card) !important;
            color: var(--oct-text) !important;
            font-size: 0.9375rem !important;
        }

        .swal2-title, .swal2-html-container { color: var(--oct-text) !important; }
        .swal2-title { font-family: 'Plus Jakarta Sans', sans-serif !important; letter-spacing: -0.025em; }

        .swal2-styled.swal2-confirm {
            background: var(--oct-primary) !important;
            color: var(--oct-on-primary) !important;
            border-radius: var(--oct-r-sm) !important;
            font-weight: 600 !important;
            box-shadow: none !important;
        }

        .swal2-styled.swal2-cancel {
            background: var(--oct-inset) !important;
            color: var(--oct-text) !important;
            border-radius: var(--oct-r-sm) !important;
            font-weight: 600 !important;
        }

        /* ── Responsive ───────────────────────────────────────── */
        @media (max-width: 820px) {
            .login-card {
                grid-template-columns: minmax(0, 1fr);
                max-width: 420px;
            }

            .login-brand {
                padding: 1.375rem 1.5rem;
                gap: 0;
            }

            .login-brand-body { display: none; }
            .login-pane { padding: 2rem 1.5rem 1.75rem; }
        }

        @media (max-width: 440px) {
            body { padding: 0.875rem; }
            .login-pane { padding: 1.75rem 1.25rem 1.5rem; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>
    <div class="login-theme">
        <button type="button" id="themeBtn" title="Ganti tema" aria-label="Ganti tema"><i class="fas fa-moon"></i></button>
    </div>

    <main class="login-card">
        <aside class="login-brand">
            <div class="login-brand-mark">
                <span class="login-brand-icon"><img src="/assets/logo.png" alt="Aqua Stock" class="login-brand-img"></span>
                <span class="login-brand-meta">
                    <span class="login-brand-name">Aqua Stock</span>
                    <span class="login-brand-sub">Distribusi Aqua Japan</span>
                </span>
            </div>

            <div class="login-brand-body">
                <h2 class="login-brand-title">Satu sistem untuk stok, pengiriman, dan penjualan.</h2>
                <p class="login-brand-text">Pantau pergerakan barang dari gudang pusat sampai diterima cabang, dalam satu tempat.</p>
                <ul class="login-points">
                    <li><i class="fas fa-boxes-stacked"></i> Stok pusat dan cabang selalu selaras</li>
                    <li><i class="fas fa-truck-fast"></i> Pengiriman terlacak sampai diterima</li>
                    <li><i class="fas fa-chart-simple"></i> Laporan penjualan siap diunduh</li>
                </ul>
            </div>
        </aside>

        <div class="login-pane">
            <h1 class="login-title">Masuk ke akun Anda</h1>
            <p class="login-subtitle">Gunakan akun yang diberikan administrator.</p>

            <form method="post" action="/login">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="login-field">
                    <label for="username">Nama pengguna</label>
                    <div class="login-inputbox">
                        <input name="username" id="username" placeholder="Masukkan username"
                            value="<%= typeof oldUsername !== 'undefined' && oldUsername ? oldUsername : '' %>"
                            required autocomplete="off">
                        <i class="fas fa-user login-icon"></i>
                    </div>
                </div>

                <div class="login-field">
                    <label for="password">Kata sandi</label>
                    <div class="login-inputbox">
                        <input name="password" id="password" type="password" placeholder="Masukkan password" required>
                        <i class="fas fa-lock login-icon"></i>
                        <button type="button" class="login-toggle" id="togglePass" title="Lihat kata sandi" aria-label="Lihat kata sandi" aria-pressed="false">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="login-submit">Masuk</button>
            </form>

            <p class="login-note">
                <i class="fas fa-circle-info"></i>
                <span>Lupa kata sandi atau belum punya akun? Hubungi administrator sistem.</span>
            </p>

            <p class="login-footer">
                &copy; <%= new Date().getFullYear() %> Aqua Japan &middot; Aqua Stock
            </p>
        </div>
    </main>

    <script>
        // Theme toggle
        (function() {
            var btn = document.getElementById('themeBtn');
            var icon = btn.querySelector('i');
            function update(isDark) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
                btn.setAttribute('title', isDark ? 'Beralih ke tema terang' : 'Beralih ke tema gelap');
            }
            update(document.documentElement.classList.contains('theme-dark'));
            btn.addEventListener('click', function() {
                var dark = document.documentElement.classList.toggle('theme-dark');
                localStorage.setItem('aqua-theme', dark ? 'dark' : 'light');
                update(dark);
            });
        })();

        // Password toggle
        (function() {
            var btn = document.getElementById('togglePass');
            var input = document.getElementById('password');
            var icon = btn.querySelector('i');
            btn.addEventListener('click', function() {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                btn.setAttribute('title', show ? 'Sembunyikan kata sandi' : 'Lihat kata sandi');
                btn.setAttribute('aria-label', show ? 'Sembunyikan kata sandi' : 'Lihat kata sandi');
            });
        })();

        // Error handling
        document.addEventListener('DOMContentLoaded', function() {
            var err = '<%= typeof error !== "undefined" ? error : "" %>';
            if (err === 'invalid') {
                Swal.fire({
                    icon: 'error', title: 'Login gagal',
                    text: 'Nama pengguna atau kata sandi salah.',
                    confirmButtonText: 'Coba lagi'
                }).then(function() {
                    document.getElementById('password').value = '';
                    document.getElementById('password').focus();
                });
            } else if (err === 'empty') {
                Swal.fire({
                    icon: 'warning', title: 'Isian belum lengkap',
                    text: 'Isi nama pengguna dan kata sandi terlebih dahulu.',
                    confirmButtonText: 'Oke'
                });
            } else {
                var u = document.getElementById('username');
                if (!u.value) u.focus();
                else document.getElementById('password').focus();
            }
        });
    </script>
</body>

</html>
