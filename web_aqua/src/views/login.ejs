<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login — Aqua Stock</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <meta name="csrf-token" content="<%= csrfToken %>">

    <script>
        (function() {
            var theme = localStorage.getItem('aqua-theme');
            if (theme === 'dark') document.documentElement.classList.add('theme-dark');
        })();
    </script>

    <style>
        :root {
            --oct-bg: #F5F7FA;
            --oct-card: #FFFFFF;
            --oct-text: #1E293B;
            --oct-text-2: #64748B;
            --oct-text-muted: #94A3B8;
            --oct-primary: #3B82F6;
            --oct-primary-dark: #2563EB;
            --oct-primary-light: #93C5FD;
            --oct-primary-bg: #EFF6FF;
            --oct-indigo: #6366F1;
            --oct-border: #E2E8F0;
            --oct-input-bg: #F8FAFC;
        }

        .theme-dark {
            --oct-bg: #0F172A;
            --oct-card: #1E293B;
            --oct-text: #F1F5F9;
            --oct-text-2: #CBD5E1;
            --oct-text-muted: #64748B;
            --oct-primary: #60A5FA;
            --oct-primary-dark: #3B82F6;
            --oct-primary-light: #93C5FD;
            --oct-primary-bg: rgba(59, 130, 246, 0.1);
            --oct-border: #334155;
            --oct-input-bg: #0F172A;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--oct-bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        /* ── Background decoration ── */
        body::before {
            content: '';
            position: fixed;
            top: -50%;
            right: -30%;
            width: 80%;
            height: 80%;
            background: radial-gradient(circle, rgba(59,130,246,0.06) 0%, transparent 70%);
            pointer-events: none;
        }
        body::after {
            content: '';
            position: fixed;
            bottom: -40%;
            left: -20%;
            width: 60%;
            height: 60%;
            background: radial-gradient(circle, rgba(99,102,241,0.05) 0%, transparent 70%);
            pointer-events: none;
        }

        .theme-dark body::before { background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%); }
        .theme-dark body::after { background: radial-gradient(circle, rgba(99,102,241,0.06) 0%, transparent 70%); }

        /* ── Card ── */
        .login-card {
            width: 100%;
            max-width: 400px;
            background: var(--oct-card);
            border: 1px solid var(--oct-border);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.04);
            padding: 2.5rem 2rem 2rem;
            position: relative;
            z-index: 1;
        }

        .theme-dark .login-card {
            box-shadow: 0 20px 60px rgba(0,0,0,0.25), 0 2px 8px rgba(0,0,0,0.15);
        }

        /* ── Logo & Title ── */
        .login-logo {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--oct-primary), var(--oct-indigo));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.375rem;
            margin: 0 auto 1rem;
            box-shadow: 0 6px 20px rgba(59,130,246,0.25);
        }

        .login-title {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1.375rem;
            color: var(--oct-text);
            text-align: center;
            margin: 0 0 0.125rem;
        }

        .login-subtitle {
            font-size: 0.8125rem;
            color: var(--oct-text-muted);
            text-align: center;
            margin: 0 0 1.75rem;
        }

        /* ── Input fields ── */
        .input-field {
            position: relative;
            margin-bottom: 1rem;
        }

        .input-field label {
            display: block;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--oct-text-2);
            margin-bottom: 0.375rem;
        }

        .input-box {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-box .icon {
            position: absolute;
            left: 14px;
            color: var(--oct-text-muted);
            font-size: 0.9375rem;
            pointer-events: none;
            transition: color 0.15s ease;
        }

        .input-box input {
            width: 100%;
            padding: 0.75rem 0.875rem 0.75rem 2.625rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.9375rem;
            color: var(--oct-text);
            background: var(--oct-input-bg);
            border: 1.5px solid var(--oct-border);
            border-radius: 12px;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        }

        .input-box input::placeholder {
            color: var(--oct-text-muted);
            font-weight: 400;
        }

        .input-box input:hover {
            border-color: var(--oct-primary-light);
        }

        .input-box input:focus {
            border-color: var(--oct-primary);
            background: var(--oct-card);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

        .input-box input:focus + .icon,
        .input-box input:focus ~ .icon {
            color: var(--oct-primary);
        }

        /* ── Password toggle ── */
        .input-box .toggle-pass {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: var(--oct-text-muted);
            cursor: pointer;
            padding: 4px;
            font-size: 0.9375rem;
            transition: color 0.15s ease;
        }

        .input-box .toggle-pass:hover {
            color: var(--oct-primary);
        }

        /* ── Button ── */
        .btn-login {
            width: 100%;
            margin-top: 0.5rem;
            padding: 0.8125rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.9375rem;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, var(--oct-primary), var(--oct-primary-dark));
            border: none;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(59,130,246,0.3);
            transition: all 0.2s ease;
            letter-spacing: 0.01em;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(59,130,246,0.4);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        /* ── Footer text ── */
        .login-footer {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.75rem;
            color: var(--oct-text-muted);
        }

        /* ── Theme toggle ── */
        .theme-toggle {
            position: fixed;
            top: 16px;
            right: 16px;
            z-index: 999;
        }

        .theme-toggle button {
            width: 40px;
            height: 40px;
            background: var(--oct-card);
            border: 1px solid var(--oct-border);
            border-radius: 10px;
            color: var(--oct-text-2);
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .theme-toggle button:hover {
            background: var(--oct-primary-bg);
            color: var(--oct-primary);
            border-color: var(--oct-primary);
        }

        @media (max-width: 440px) {
            .login-card { padding: 2rem 1.5rem 1.5rem; }
        }
    </style>
</head>

<body>
    <div class="theme-toggle">
        <button id="themeBtn" title="Ganti Tema"><i class="fas fa-moon"></i></button>
    </div>

    <div class="login-card">
        <div class="login-logo">
            <i class="fas fa-cubes"></i>
        </div>
        <h1 class="login-title">Aqua Stock</h1>
        <p class="login-subtitle">Sistem Manajemen Logistik</p>

        <form method="post" action="/login">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="input-field">
                <label for="username">Nama Pengguna</label>
                <div class="input-box">
                    <input name="username" id="username" placeholder="Masukkan username"
                        value="<%= typeof oldUsername !== 'undefined' && oldUsername ? oldUsername : '' %>"
                        required autocomplete="off">
                    <i class="fas fa-user icon"></i>
                </div>
            </div>

            <div class="input-field">
                <label for="password">Kata Sandi</label>
                <div class="input-box">
                    <input name="password" id="password" type="password" placeholder="Masukkan password" required>
                    <i class="fas fa-lock icon"></i>
                    <button type="button" class="toggle-pass" id="togglePass" title="Lihat password">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-login">Masuk Sistem</button>
        </form>

        <div class="login-footer">
            &copy; <%= new Date().getFullYear() %> Aqua Stock
        </div>
    </div>

    <script>
        // Theme toggle
        (function() {
            var btn = document.getElementById('themeBtn');
            var icon = btn.querySelector('i');
            function update(isDark) { icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon'; }
            update(document.documentElement.classList.contains('theme-dark'));
            btn.addEventListener('click', function() {
                var dark = document.documentElement.classList.toggle('theme-dark');
                localStorage.setItem('aqua-theme', dark ? 'dark' : 'light');
                update(dark);
            });
        })();

        // Password toggle
        (function() {
            var btn = document.getElementById('togglePass');
            var input = document.getElementById('password');
            var icon = btn.querySelector('i');
            btn.addEventListener('click', function() {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
            });
        })();

        // Error handling
        document.addEventListener('DOMContentLoaded', function() {
            var err = '<%= typeof error !== "undefined" ? error : "" %>';
            if (err === 'invalid') {
                Swal.fire({
                    icon: 'error', title: 'Login Gagal',
                    text: 'Username atau password salah!',
                    confirmButtonText: 'Coba Lagi', confirmButtonColor: '#3B82F6'
                }).then(function() {
                    document.getElementById('password').value = '';
                    document.getElementById('password').focus();
                });
            } else if (err === 'empty') {
                Swal.fire({
                    icon: 'warning', title: 'Input Kosong',
                    text: 'Silakan isi username dan password.',
                    confirmButtonText: 'Oke', confirmButtonColor: '#3B82F6'
                });
            } else {
                var u = document.getElementById('username');
                if (!u.value) u.focus();
                else document.getElementById('password').focus();
            }
        });
    </script>
</body>

</html>