<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.5rem;">
    <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(1.25rem,3vw,1.5rem); font-weight:700; margin:0; color:var(--oct-text);">
        <span style="margin-right:0.5rem;">&#128230;</span>Pengemasan
    </h1>
</div>

<style>
    .oct-card { background: var(--oct-card); border: 1px solid var(--oct-border-light); border-radius: 16px; box-shadow: var(--oct-shadow-sm); overflow: hidden; margin-bottom: 1rem; }
    .oct-card-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--oct-border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
    .oct-card-body { padding: 1rem 1.25rem; }
    .oct-pill { padding: 0.375em 1em; border-radius: 50rem; font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; display: inline-block; }
    .oct-pill-approved_admin { background: #06B6D4; }
    .oct-pill-dipaket { background: var(--oct-yellow-dark); }
    .oct-pill-dikirim { background: var(--oct-green-dark); }
    .oct-kode { color: var(--oct-primary); background: var(--oct-primary-bg); padding: 0.25rem 0.625rem; border-radius: 6px; font-weight: 700; font-size: 0.8125rem; font-family: 'JetBrains Mono', monospace; }
    .oct-btn-pack { background: var(--oct-yellow); color: #1E293B; border: none; border-radius: 8px; padding: 0.375rem 0.875rem; font-weight: 600; font-size: 0.8125rem; cursor: pointer; transition: all 0.15s ease; box-shadow: 0 2px 8px rgba(251,191,36,0.25); }
    .oct-btn-pack:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(251,191,36,0.35); }
    .oct-btn-send { background: var(--oct-green-dark); color: #fff; border: none; border-radius: 8px; padding: 0.375rem 0.875rem; font-weight: 600; font-size: 0.8125rem; cursor: pointer; transition: all 0.15s ease; box-shadow: 0 2px 8px rgba(22,163,74,0.25); }
    .oct-btn-send:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(22,163,74,0.35); }
</style>

<!-- Filter -->
<div class="card" style="margin-bottom:1rem; border-radius:16px;">
    <div class="card-body" style="padding:0.75rem 1.25rem;">
        <div class="d-flex align-items-center flex-wrap" style="gap:0.75rem;">
            <span style="font-size:0.8125rem; font-weight:600; color:var(--oct-text-2);"><i class="fas fa-filter" style="margin-right:0.25rem;"></i> Filter</span>
            <select id="filterStatus" class="form-control form-control-sm" style="max-width:180px;">
                <option value="">Semua Status</option>
                <option value="approved_admin">Siap Dikemas</option>
                <option value="dipaket">Sedang Diproses</option>
                <option value="dikirim">Sudah Dikirim</option>
            </select>
            <button id="filterResetBtn" class="btn btn-sm btn-outline-secondary"><i class="fas fa-undo"></i> Reset</button>
        </div>
    </div>
</div>

<% var list = Array.isArray(orders) ? orders : []; %>

<% if (list.length === 0) { %>
    <div class="oct-card"><div class="oct-card-body text-center" style="padding:3rem;">
        <i class="fas fa-boxes" style="font-size:2.5rem; color:var(--oct-text-muted); opacity:0.3; display:block; margin-bottom:0.75rem;"></i>
        <span style="color:var(--oct-text-muted);">Tidak ada pesanan untuk dikemas.</span>
    </div></div>
<% } %>

<% for (var si = 0; si < list.length; si++) { %>
    <% var o = list[si]; var st = (o.status || '').toLowerCase(); var cabang = (usersMap && usersMap[o.cabang_id]) ? usersMap[o.cabang_id] : null; %>
    <div class="oct-card" data-status="<%= st %>">
        <div class="oct-card-header">
            <div>
                <div style="font-weight:700; margin-bottom:0.375rem;">
                    <span class="oct-kode"><%= o.kode_order %></span>
                    <% if (o.kode_pengiriman) { %><span style="color:var(--oct-text-muted); font-size:0.8125rem; margin-left:0.5rem;">Resi: <%= o.kode_pengiriman %></span><% } %>
                </div>
                <span style="color:var(--oct-text-muted); font-size:0.8125rem;">
                    <i class="fas fa-store" style="margin-right:0.25rem;"></i> <%= cabang ? cabang.username || cabang.nama_cabang : o.cabang_id %>
                </span>
            </div>
            <span class="oct-pill oct-pill-<%= st %>">
                <% if (st === 'approved_admin') { %>SIAP DIKEMAS<% } %>
                <% if (st === 'dipaket') { %>DIKEMAS<% } %>
                <% if (st === 'dikirim') { %>DIKIRIM<% } %>
            </span>
        </div>
        <div class="oct-card-body">
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem; font-size:0.875rem; margin-bottom:1rem;">
                <div>Total: <strong>Rp <%= (o.total_harga || 0).toLocaleString('id-ID') %></strong></div>
                <div>Item: <strong><%= (o.items || []).length %></strong></div>
                <div class="text-right" style="color:var(--oct-text-muted);"><%= (o.catatan_packing || '') %></div>
            </div>
            <div class="d-flex" style="gap:0.625rem;">
                <a href="/gudang/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye" style="margin-right:0.25rem;"></i> Detail</a>
                <% if (st === 'approved_admin') { %>
                    <button class="oct-btn-pack" onclick="packOrder('<%= o.id %>')"><i class="fas fa-box" style="margin-right:0.375rem;"></i> Tandai Dikemas</button>
                <% } %>
                <% if (st === 'dipaket') { %>
                    <button class="oct-btn-send" onclick="sendOrder('<%= o.id %>')"><i class="fas fa-truck" style="margin-right:0.375rem;"></i> Kirim Barang</button>
                <% } %>
            </div>
        </div>
    </div>
<% } %>

<!-- Pack Modal -->
<div class="modal fade" id="modalPack" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="formPack" method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header"><h5 class="modal-title">Tandai Dikemas</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div>
            <div class="modal-body">
                <p style="color:var(--oct-text-muted); font-size:0.875rem;">Konfirmasi bahwa pesanan sudah dikemas dan siap dikirim.</p>
                <div class="form-group"><label style="font-weight:600;">Catatan Packing (opsional)</label><textarea name="catatan_packing" class="form-control" rows="3" placeholder="Contoh: dus karton, segel aman"></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="oct-btn-pack" type="submit" style="border-radius:10px; padding:0.625rem 1.25rem;"><i class="fas fa-box" style="margin-right:0.375rem;"></i> Tandai Dikemas</button>
            </div>
        </form>
    </div>
</div>

<!-- Send Modal -->
<div class="modal fade" id="modalSend" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="formSend" method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header"><h5 class="modal-title">Kirim Barang</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div>
            <div class="modal-body">
                <div class="alert alert-info"><i class="fas fa-info-circle" style="margin-right:0.375rem;"></i> Barang akan dikirim ke cabang dan resi pengiriman akan dibuat otomatis.</div>
                <p style="color:var(--oct-text-muted); font-size:0.875rem; margin:0;">Lanjutkan pengiriman barang ini?</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="oct-btn-send" type="submit" style="border-radius:10px; padding:0.625rem 1.25rem;"><i class="fas fa-truck" style="margin-right:0.375rem;"></i> Ya, Kirim</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function() {
        var params = new URLSearchParams(window.location.search);
        var ok = params.get('ok'), err = params.get('err');
        if (ok && typeof Swal !== 'undefined') {
            var title = ok === 'packed' ? 'Pesanan ditandai sudah dikemas!' : ok === 'sent' ? 'Barang berhasil dikirim!' : ok;
            Swal.fire({toast:true,position:'top-end',icon:'success',title:title,showConfirmButton:false,timer:3000,timerProgressBar:true});
            params.delete('ok'); window.history.replaceState({},'',location.pathname+(params.toString()?'?'+params.toString():''));
        }
        if (err && typeof Swal !== 'undefined') { Swal.fire({icon:'error',title:'Gagal',text:err,confirmButtonColor:'#3B82F6'}); params.delete('err'); window.history.replaceState({},'',location.pathname+(params.toString()?'?'+params.toString():'')); }

        var filterStatus = document.getElementById('filterStatus');
        var filterResetBtn = document.getElementById('filterResetBtn');
        var cards = document.querySelectorAll('.oct-card[data-status]');
        filterStatus.addEventListener('change', function() { var v = filterStatus.value; cards.forEach(function(c) { c.style.display = (!v || c.getAttribute('data-status') === v) ? '' : 'none'; }); });
        filterResetBtn.addEventListener('click', function() { filterStatus.value = ''; cards.forEach(function(c) { c.style.display = ''; }); });
    })();

    function packOrder(id) { var form = document.getElementById('formPack'); form.action = '/gudang/orders/' + id + '/pack'; form.querySelector('textarea').value = ''; $('#modalPack').modal('show'); }
    function sendOrder(id) { var form = document.getElementById('formSend'); form.action = '/gudang/orders/' + id + '/send'; $('#modalSend').modal('show'); }
</script>