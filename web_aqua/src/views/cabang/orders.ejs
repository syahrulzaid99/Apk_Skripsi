<%
    var list = Array.isArray(orders) ? orders : [];

    function ordDate(v) {
        if (!v) return null;
        return new Date(v._seconds ? v._seconds * 1000 : v);
    }
    function ordFmt(v, withTime) {
        var d = ordDate(v);
        if (!d || isNaN(d)) return '—';
        var opt = { day: '2-digit', month: 'short', year: 'numeric' };
        if (withTime) { opt.hour = '2-digit'; opt.minute = '2-digit'; }
        return d.toLocaleDateString('id-ID', opt);
    }
    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }

    var STATUS_LABEL = {
        pending: 'Menunggu', approved_sales: 'Disetujui Sales', approved_admin: 'Disetujui', dipaket: 'Dipaket',
        dikirim: 'Dikirim', diterima: 'Diterima', selesai: 'Selesai', ditolak: 'Ditolak'
    };
    // Lifecycle order used by the progress rail
    var FLOW = ['pending', 'approved_admin', 'dipaket', 'dikirim', 'diterima'];
    var FLOW_LABEL = {
        pending: 'Pesanan dibuat', approved_admin: 'Disetujui admin', dipaket: 'Dikemas gudang',
        dikirim: 'Dalam pengiriman', diterima: 'Diterima cabang'
    };

    // Summary figures
    var totalOrders = list.length;
    var countMenunggu = 0, countJalan = 0, nilaiTotal = 0, countSelesai = 0;
    for (var k = 0; k < list.length; k++) {
        var stk = String(list[k].status || 'pending').toLowerCase();
        var tk = Number(list[k].total_harga || 0);
        if (!tk && Array.isArray(list[k].items)) {
            for (var z = 0; z < list[k].items.length; z++) tk += Number(list[k].items[z].subtotal || 0);
        }
        nilaiTotal += tk;
        if (stk === 'pending') countMenunggu++;
        else if (stk === 'dikirim' || stk === 'dipaket' || stk === 'approved_admin' || stk === 'approved_sales') countJalan++;
        else if (stk === 'diterima' || stk === 'selesai') countSelesai++;
    }

    // Segmented filter buckets
    var buckets = [
        { key: 'all', label: 'Semua', n: totalOrders },
        { key: 'pending', label: 'Menunggu', n: countMenunggu },
        { key: 'proses', label: 'Diproses', n: countJalan },
        { key: 'diterima', label: 'Selesai', n: countSelesai }
    ];
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .ord-layout {
        display: grid;
        grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
        gap: var(--oct-gap);
        align-items: start;
    }

    .ord-rail {
        background: var(--oct-inset);
        border: 1px solid var(--oct-border-light);
        border-radius: var(--oct-r-lg);
        padding: 0.75rem;
        position: sticky;
        top: 84px;
        max-height: calc(100dvh - 108px);
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .ord-rail-list {
        overflow-y: auto;
        margin: 0 -0.25rem;
        padding: 0 0.25rem;
        scrollbar-width: thin;
        scrollbar-color: var(--oct-border) transparent;
    }

    .ord-rail-list::-webkit-scrollbar { width: 6px; }
    .ord-rail-list::-webkit-scrollbar-thumb { background: var(--oct-border); border-radius: 3px; }

    .ord-rail-count {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--oct-text-muted);
        padding: 0 0.25rem;
    }

    /* One row per order in the rail */
    .ord-item { align-items: flex-start; }
    .ord-item-top { display: flex; align-items: center; gap: 0.375rem; }
    .ord-item-total { font-size: 0.75rem; font-weight: 600; color: var(--oct-text-2); font-variant-numeric: tabular-nums; }

    .ord-detail { min-width: 0; }
    .ord-detail[hidden] { display: none; }

    .ord-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1.125rem 1.25rem;
        border-bottom: 1px solid var(--oct-border-light);
    }

    .ord-head-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 1.125rem;
        letter-spacing: -0.03em;
        margin: 0 0 0.3125rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .ord-head-amount {
        text-align: right;
        line-height: 1.2;
    }

    .ord-head-amount b {
        display: block;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.035em;
        font-variant-numeric: tabular-nums;
    }

    /* Progress rail — horizontal on desktop, stacks on narrow */
    .ord-flow {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 1fr;
        gap: 0.5rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--oct-border-light);
    }

    .ord-step { min-width: 0; }

    .ord-step-bar {
        height: 4px;
        border-radius: 999px;
        background: var(--oct-inset-2);
        margin-bottom: 0.5rem;
    }

    .ord-step.done .ord-step-bar { background: var(--oct-primary); }
    .ord-step.current .ord-step-bar { background: var(--oct-primary); }
    .ord-step.failed .ord-step-bar { background: var(--oct-red); }

    .ord-step-label {
        font-size: 0.75rem;
        color: var(--oct-text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ord-step.done .ord-step-label,
    .ord-step.current .ord-step-label { color: var(--oct-text); font-weight: 600; }
    .ord-step.failed .ord-step-label { color: var(--oct-red); font-weight: 600; }

    .ord-notes { display: flex; flex-direction: column; gap: 0.5rem; padding: 0 1.25rem 1.25rem; }

    /* Item picker rows inside the create-order modal */
    .ord-pick {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 104px 34px;
        gap: 0.5rem;
        align-items: start;
        padding: 0.625rem;
        border: 1px solid var(--oct-border-light);
        border-radius: var(--oct-r);
        background: var(--oct-card);
        margin-bottom: 0.5rem;
    }

    .ord-pick-meta { font-size: 0.6875rem; color: var(--oct-text-muted); margin-top: 0.3125rem; min-height: 1em; }
    .ord-pick-sum {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.875rem 1rem;
        background: var(--oct-inset);
        border-radius: var(--oct-r);
        margin-top: 0.75rem;
    }

    @media (max-width: 991px) {
        .ord-layout { grid-template-columns: minmax(0, 1fr); }
        .ord-rail { position: static; max-height: none; }
        .ord-rail-list { max-height: 320px; }
    }

    @media (max-width: 640px) {
        .ord-flow { grid-auto-flow: row; }
        .ord-pick { grid-template-columns: minmax(0, 1fr) 84px 34px; }
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Pesanan saya</h1>
        <p class="oct-page-sub">Ajukan permintaan stok ke pusat dan pantau setiap pesanan sampai barang diterima di cabang.</p>
    </div>
    <div class="oct-page-actions">
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalTambahPesanan">
            <i class="fas fa-plus mr-2"></i>Buat pesanan
        </button>
    </div>
</div>

<% if (totalOrders === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-receipt"></i></div>
            <h2 class="oct-empty-title">Belum ada pesanan</h2>
            <p class="oct-empty-text">Pesanan yang Anda ajukan ke pusat akan muncul di sini, lengkap dengan status persetujuan dan pengirimannya.</p>
            <div class="oct-empty-actions">
                <button class="btn btn-primary" data-toggle="modal" data-target="#modalTambahPesanan">
                    <i class="fas fa-plus mr-2"></i>Buat pesanan pertama
                </button>
            </div>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-receipt"></i></span>
                    <span class="oct-kpi-label">Total pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= totalOrders %></span>
                    <span class="oct-kpi-note">sejak awal</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-hourglass-half"></i></span>
                    <span class="oct-kpi-label">Menunggu persetujuan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= countMenunggu %></span>
                    <% if (countMenunggu > 0) { %>
                        <span class="oct-delta oct-delta-warn"><i class="fas fa-clock"></i> perlu ditunggu</span>
                    <% } else { %>
                        <span class="oct-kpi-note">tidak ada antrean</span>
                    <% } %>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-truck-fast"></i></span>
                    <span class="oct-kpi-label">Sedang diproses</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= countJalan %></span>
                    <span class="oct-kpi-note">disetujui s/d dikirim</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-wallet"></i></span>
                    <span class="oct-kpi-label">Nilai seluruh pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm"><%= rupiah(nilaiTotal) %></span>
                </div>
                <div class="oct-kpi-foot"><%= countSelesai %> pesanan sudah diterima</div>
            </div>
        </div>
    </div>

    <!-- Daftar + detail -->
    <div class="ord-layout">
        <aside class="ord-rail">
            <div class="oct-search" style="max-width:none; flex:none;">
                <i class="fas fa-magnifying-glass"></i>
                <label class="oct-sr" for="ordSearch">Cari pesanan</label>
                <input type="text" id="ordSearch" placeholder="Cari kode pesanan…" autocomplete="off">
            </div>

            <div class="oct-seg" id="ordSeg" role="tablist" aria-label="Saring berdasarkan status">
                <% for (var bi = 0; bi < buckets.length; bi++) { var b = buckets[bi]; %>
                    <button type="button" role="tab" class="oct-seg-item <%= bi === 0 ? 'active' : '' %>" data-bucket="<%= b.key %>" aria-selected="<%= bi === 0 %>">
                        <%= b.label %><span class="oct-seg-count"><%= b.n %></span>
                    </button>
                <% } %>
            </div>

            <div class="ord-rail-count" id="ordRailCount"><%= totalOrders %> pesanan</div>

            <div class="ord-rail-list oct-listnav" id="ordList" role="tablist" aria-label="Daftar pesanan">
                <% for (var si = 0; si < list.length; si++) {
                    var o = list[si];
                    var st = String(o.status || 'pending').toLowerCase();
                    var bucket = st === 'pending' ? 'pending'
                               : (st === 'diterima' || st === 'selesai') ? 'diterima'
                               : (st === 'ditolak') ? 'ditolak' : 'proses';
                    var dotClass = st === 'ditolak' ? 'oct-dot-bad'
                                 : (st === 'diterima' || st === 'selesai') ? 'oct-dot-ok'
                                 : st === 'pending' ? 'oct-dot-warn' : 'oct-dot-info';
                    var tot = Number(o.total_harga || 0);
                    if (!tot && Array.isArray(o.items)) { for (var q = 0; q < o.items.length; q++) tot += Number(o.items[q].subtotal || 0); }
                    var nItems = Array.isArray(o.items) ? o.items.length : 0;
                %>
                <button type="button" role="tab"
                        class="oct-listnav-item ord-item <%= si === 0 ? 'active' : '' %>"
                        data-target="ordDetail<%= si %>"
                        data-bucket="<%= bucket %>"
                        data-search="<%= (o.kode_order || '').toLowerCase() %>"
                        aria-selected="<%= si === 0 %>"
                        aria-controls="ordDetail<%= si %>">
                    <span class="oct-dot <%= dotClass %>" style="margin-top:0.4375rem;"></span>
                    <span class="oct-listnav-meta">
                        <span class="ord-item-top">
                            <span class="oct-listnav-title"><%= o.kode_order || '—' %></span>
                        </span>
                        <span class="oct-listnav-sub"><%= ordFmt(o.createdAt, false) %> &middot; <%= nItems %> item</span>
                    </span>
                    <span class="ord-item-total"><%= rupiah(tot) %></span>
                </button>
                <% } %>
            </div>

            <p class="oct-empty-text" id="ordListEmpty" hidden style="padding:0.75rem 0.25rem; text-align:left;">
                Tidak ada pesanan yang cocok.
            </p>
        </aside>

        <div class="ord-detail-host">
            <% for (var di = 0; di < list.length; di++) {
                var od = list[di];
                var sd = String(od.status || 'pending').toLowerCase();
                var isRejected = sd === 'ditolak';
                var doneIdx = FLOW.indexOf(sd === 'selesai' ? 'diterima' : sd);
                var itemsD = Array.isArray(od.items) ? od.items : [];
                var totD = Number(od.total_harga || 0);
                if (!totD) { for (var y = 0; y < itemsD.length; y++) totD += Number(itemsD[y].subtotal || 0); }
                var qtyD = 0;
                for (var y2 = 0; y2 < itemsD.length; y2++) qtyD += Number(itemsD[y2].qty || 0);
                var payD = String(od.payment_status || '').toLowerCase();
            %>
            <section class="oct-card ord-detail" id="ordDetail<%= di %>" role="tabpanel" <%= di === 0 ? '' : 'hidden' %>>
                <header class="ord-head">
                    <div>
                        <h2 class="ord-head-title">
                            <%= od.kode_order || '—' %>
                            <span class="oct-pill oct-pill-dot oct-pill-<%= sd %>"><%= STATUS_LABEL[sd] || sd %></span>
                        </h2>
                        <p class="oct-card-sub">
                            Dibuat <%= ordFmt(od.createdAt, true) %>
                            <% if (od.updatedAt && String(od.updatedAt) !== String(od.createdAt)) { %>
                                &middot; diperbarui <%= ordFmt(od.updatedAt, true) %>
                            <% } %>
                        </p>
                    </div>
                    <div class="ord-head-amount">
                        <b><%= rupiah(totD) %></b>
                        <span class="oct-card-sub"><%= itemsD.length %> produk &middot; <%= qtyD.toLocaleString('id-ID') %> unit</span>
                    </div>
                </header>

                <!-- Progres pesanan -->
                <div class="ord-flow">
                    <% if (isRejected) { %>
                        <div class="ord-step failed" style="grid-column:1/-1;">
                            <div class="ord-step-bar"></div>
                            <div class="ord-step-label"><i class="fas fa-circle-xmark mr-1"></i>Pesanan ditolak</div>
                        </div>
                    <% } else {
                        for (var fi = 0; fi < FLOW.length; fi++) {
                            var cls = fi < doneIdx ? 'done' : (fi === doneIdx ? 'current' : '');
                    %>
                        <div class="ord-step <%= cls %>">
                            <div class="ord-step-bar"></div>
                            <div class="ord-step-label"><%= FLOW_LABEL[FLOW[fi]] %></div>
                        </div>
                    <% } } %>
                </div>

                <!-- Ringkasan pesanan -->
                <div class="oct-card-body" style="padding-bottom:0.75rem;">
                    <div class="oct-dl">
                        <div>
                            <div class="oct-dl-key">Kode pesanan</div>
                            <div class="oct-dl-val oct-mono"><%= od.kode_order || '—' %></div>
                        </div>
                        <div>
                            <div class="oct-dl-key">Status pembayaran</div>
                            <div class="oct-dl-val">
                                <% if (payD) { %>
                                    <span class="oct-pill oct-pill-<%= payD %>"><%= payD.replace(/_/g, ' ') %></span>
                                <% } else { %>
                                    <span class="oct-td-muted">Belum ada data</span>
                                <% } %>
                            </div>
                        </div>
                        <div>
                            <div class="oct-dl-key">Jumlah unit</div>
                            <div class="oct-dl-val"><%= qtyD.toLocaleString('id-ID') %></div>
                        </div>
                        <div>
                            <div class="oct-dl-key">Total tagihan</div>
                            <div class="oct-dl-val"><%= rupiah(totD) %></div>
                        </div>
                    </div>
                </div>

                <!-- Rincian produk -->
                <div class="oct-card-head oct-card-head-plain" style="padding-top:0.5rem;">
                    <h3 class="oct-card-title">Rincian produk</h3>
                    <span class="oct-chip"><%= itemsD.length %> baris</span>
                </div>

                <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

                <div class="oct-card-body" style="padding-top:0.75rem;">
                    <div class="oct-tablewrap oct-tablewrap-card">
                        <table class="oct-table oct-table-sm oct-table-nested">
                            <thead>
                                <tr>
                                    <th class="col-fit">#</th>
                                    <th>Produk</th>
                                    <th>Satuan</th>
                                    <th class="num">Harga</th>
                                    <th class="num">Qty</th>
                                    <th class="num">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (itemsD.length === 0) { %>
                                    <tr><td colspan="6" class="oct-td-muted text-center" style="padding:1.5rem;">Tidak ada item pada pesanan ini.</td></tr>
                                <% } %>
                                <% for (var ii = 0; ii < itemsD.length; ii++) { var it = itemsD[ii]; %>
                                <tr>
                                    <td class="col-fit oct-td-muted"><%= ii + 1 %></td>
                                    <td>
                                        <div class="oct-cell-media">
                                            <% if (it.gambar_url) { %>
                                                <img class="oct-thumb" src="<%= it.gambar_url %>" alt="Foto produk <%= it.nama_produk || '' %>" loading="lazy">
                                            <% } else { %>
                                                <span class="oct-thumb oct-thumb-empty"><i class="fas fa-image"></i></span>
                                            <% } %>
                                            <span class="oct-cell-stack">
                                                <span class="oct-cell-main"><%= it.nama_produk || '—' %></span>
                                                <span class="oct-cell-sub oct-mono"><%= it.sku || '—' %></span>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="oct-td-muted"><%= it.satuan || '—' %></td>
                                    <td class="num"><%= rupiah(it.harga) %></td>
                                    <td class="num oct-td-strong"><%= Number(it.qty || 0).toLocaleString('id-ID') %></td>
                                    <td class="num oct-td-strong"><%= rupiah(it.subtotal) %></td>
                                </tr>
                                <% } %>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="oct-td-muted">Grand total</td>
                                    <td class="num"><%= qtyD.toLocaleString('id-ID') %></td>
                                    <td class="num" style="color:var(--oct-primary); font-size:0.9375rem;"><%= rupiah(totD) %></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <% if (od.keterangan || od.keterangan_admin) { %>
                <div class="ord-notes">
                    <% if (od.keterangan) { %>
                        <div class="oct-note">
                            <i class="fas fa-note-sticky"></i>
                            <span><strong>Catatan Anda:</strong> <%= od.keterangan %></span>
                        </div>
                    <% } %>
                    <% if (od.keterangan_admin) { %>
                        <div class="oct-note oct-note-accent">
                            <i class="fas fa-comment-dots"></i>
                            <span><strong>Pesan admin:</strong> <%= od.keterangan_admin %></span>
                        </div>
                    <% } %>
                </div>
                <% } %>
            </section>
            <% } %>
        </div>
    </div>
<% } %>

<!-- Modal: buat pesanan -->
<div class="modal fade" id="modalTambahPesanan" tabindex="-1" role="dialog" aria-labelledby="modalTambahPesananLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <form method="POST" action="/cabang/orders" id="formTambahPesanan">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="data_barang_json" id="data_barang_json">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="modalTambahPesananLabel">Buat pesanan baru</h5>
                        <p class="oct-card-sub">Pilih produk dan jumlah yang ingin diminta dari stok pusat.</p>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <label for="ordKeterangan">Catatan pesanan <span class="oct-label-hint">(opsional)</span></label>
                        <textarea name="keterangan" id="ordKeterangan" class="form-control" rows="2" placeholder="Contoh: mohon dikirim sebelum akhir pekan."></textarea>
                    </div>

                    <div class="oct-card-head oct-card-head-plain" style="padding:0 0 0.625rem;">
                        <h3 class="oct-card-title">Daftar produk</h3>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddItem">
                            <i class="fas fa-plus mr-1"></i>Tambah item
                        </button>
                    </div>

                    <div id="itemsBody"></div>

                    <p class="oct-empty-text" id="itemsEmpty" style="text-align:left; padding:0.75rem 0;">
                        Belum ada item. Tekan <strong>Tambah item</strong> untuk mulai.
                    </p>

                    <div class="ord-pick-sum">
                        <span class="oct-stat-key">Perkiraan total</span>
                        <span class="oct-stat-value" id="ordEstTotal" style="font-size:1rem;">Rp 0</span>
                    </div>
                    <p class="oct-card-sub mt-2">Harga final mengikuti data produk saat pesanan diproses pusat.</p>

                    <template id="tplRow">
                        <div class="ord-pick">
                            <div>
                                <label class="oct-sr">Produk</label>
                                <select class="form-control form-control-sm product-select" required>
                                    <option value="">— pilih produk —</option>
                                    <% var _p = Array.isArray(products) ? products : []; for (var j = 0; j < _p.length; j++) { var p = _p[j]; %>
                                        <option value="<%= p.id %>"
                                                data-sku="<%= p.sku || '' %>"
                                                data-satuan="<%= p.satuan || '' %>"
                                                data-harga="<%= Number(p.harga_jual || 0) %>"
                                                data-stok="<%= Number(p.stok || 0) %>"><%= (p.sku || '—') %> — <%= (p.nama_produk || '—') %></option>
                                    <% } %>
                                </select>
                                <div class="ord-pick-meta detail-produk"></div>
                            </div>
                            <div>
                                <label class="oct-sr">Kuantitas</label>
                                <input type="number" class="form-control form-control-sm qty-input num" min="1" step="1" value="1" required style="text-align:right;">
                                <div class="ord-pick-meta line-total"></div>
                            </div>
                            <button type="button" class="oct-icon-btn oct-icon-btn-danger btnRemoveRow" title="Hapus item" aria-label="Hapus item" style="margin-top:0.125rem;">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>
                    </template>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane mr-2"></i>Kirim pesanan
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        /* ── Master/detail: rail selection ─────────────────────── */
        var listEl = document.getElementById('ordList');
        if (listEl) {
            var items = Array.prototype.slice.call(listEl.querySelectorAll('.ord-item'));
            var panels = Array.prototype.slice.call(document.querySelectorAll('.ord-detail'));
            var searchEl = document.getElementById('ordSearch');
            var segEl = document.getElementById('ordSeg');
            var countEl = document.getElementById('ordRailCount');
            var emptyEl = document.getElementById('ordListEmpty');
            var bucket = 'all';

            function select(id) {
                items.forEach(function (btn) {
                    var on = btn.dataset.target === id;
                    btn.classList.toggle('active', on);
                    btn.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                panels.forEach(function (p) { p.hidden = p.id !== id; });
            }

            items.forEach(function (btn) {
                btn.addEventListener('click', function () { select(btn.dataset.target); });
            });

            function applyFilter() {
                var q = searchEl ? searchEl.value.trim().toLowerCase() : '';
                var shown = 0;
                var firstVisible = null;

                items.forEach(function (btn) {
                    var okBucket = bucket === 'all' || btn.dataset.bucket === bucket;
                    var okSearch = !q || btn.dataset.search.indexOf(q) !== -1;
                    var hit = okBucket && okSearch;
                    btn.hidden = !hit;
                    if (hit) { shown++; if (!firstVisible) firstVisible = btn; }
                });

                if (countEl) countEl.textContent = shown + ' pesanan';
                if (emptyEl) emptyEl.hidden = shown !== 0;

                // Keep the open panel valid for the current filter
                var active = items.filter(function (b) { return b.classList.contains('active') && !b.hidden; })[0];
                if (!active && firstVisible) select(firstVisible.dataset.target);
            }

            if (searchEl) searchEl.addEventListener('input', applyFilter);

            if (segEl) {
                segEl.addEventListener('click', function (e) {
                    var btn = e.target.closest('.oct-seg-item');
                    if (!btn) return;
                    bucket = btn.dataset.bucket;
                    segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                        var on = b === btn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    applyFilter();
                });
            }
        }

        /* ── Create-order modal ────────────────────────────────── */
        var body = document.getElementById('itemsBody');
        var tpl = document.getElementById('tplRow');
        var btnAdd = document.getElementById('btnAddItem');
        var form = document.getElementById('formTambahPesanan');
        var fieldJSON = document.getElementById('data_barang_json');
        var emptyHint = document.getElementById('itemsEmpty');
        var estEl = document.getElementById('ordEstTotal');

        function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }

        function recalc() {
            var total = 0;
            body.querySelectorAll('.ord-pick').forEach(function (row) {
                var sel = row.querySelector('.product-select');
                var opt = sel.options[sel.selectedIndex];
                var harga = opt ? Number(opt.getAttribute('data-harga') || 0) : 0;
                var qty = Number(row.querySelector('.qty-input').value || 0);
                var line = harga * qty;
                total += line;
                var out = row.querySelector('.line-total');
                if (out) out.textContent = line ? rupiah(line) : '';
            });
            if (estEl) estEl.textContent = rupiah(total);
            if (emptyHint) emptyHint.hidden = body.children.length > 0;
        }

        function updateDetail(sel) {
            var opt = sel.options[sel.selectedIndex];
            var box = sel.parentNode.querySelector('.detail-produk');
            if (!box) return;
            if (!opt || !opt.value) { box.textContent = ''; return; }
            var satuan = opt.getAttribute('data-satuan') || '—';
            var stok = Number(opt.getAttribute('data-stok') || 0);
            var harga = Number(opt.getAttribute('data-harga') || 0);
            box.textContent = rupiah(harga) + ' / ' + satuan + ' · stok pusat ' + stok.toLocaleString('id-ID');
        }

        function addRow() {
            var clone = document.importNode(tpl.content, true);
            var row = clone.querySelector('.ord-pick');
            var sel = row.querySelector('.product-select');
            var qty = row.querySelector('.qty-input');

            sel.addEventListener('change', function () { updateDetail(sel); recalc(); });
            qty.addEventListener('input', recalc);
            row.querySelector('.btnRemoveRow').addEventListener('click', function () {
                row.parentNode.removeChild(row);
                recalc();
            });

            body.appendChild(row);
            recalc();
            sel.focus();
        }

        if (btnAdd) btnAdd.addEventListener('click', addRow);

        $('#modalTambahPesanan')
            .on('shown.bs.modal', function () { if (!body.children.length) addRow(); })
            .on('hidden.bs.modal', function () {
                body.innerHTML = '';
                form.reset();
                if (fieldJSON) fieldJSON.value = '';
                recalc();
            });

        if (form) form.addEventListener('submit', function (ev) {
            var rows = body.querySelectorAll('.ord-pick');
            if (!rows.length) {
                ev.preventDefault();
                Swal.fire({ icon: 'warning', title: 'Pesanan masih kosong', text: 'Tambahkan minimal satu produk sebelum mengirim.' });
                return;
            }

            var items = [];
            var invalid = null;

            rows.forEach(function (row) {
                var sel = row.querySelector('.product-select');
                var qtyEl = row.querySelector('.qty-input');
                var qty = Number(qtyEl.value || 0);

                sel.classList.toggle('is-invalid', !sel.value);
                qtyEl.classList.toggle('is-invalid', !(qty > 0));

                if (!sel.value || !(qty > 0)) { invalid = invalid || (!sel.value ? sel : qtyEl); return; }
                items.push({ product_id: sel.value, qty: qty });
            });

            if (invalid || !items.length) {
                ev.preventDefault();
                invalid.focus();
                Swal.fire({ icon: 'error', title: 'Data belum lengkap', text: 'Setiap baris harus punya produk dan kuantitas minimal 1.' });
                return;
            }

            fieldJSON.value = JSON.stringify(items);
        });

        /* ── Flash messages ────────────────────────────────────── */
        Aqua.flash({
            created: 'Pesanan berhasil dikirim ke pusat'
        });
    })();
</script>
