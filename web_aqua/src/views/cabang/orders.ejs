<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.5rem;">
    <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(1.25rem,3vw,1.5rem); font-weight:700; margin:0; color:var(--oct-text);">
        <span style="margin-right:0.5rem;">&#128722;</span>Pesanan Saya
    </h1>
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalTambahPesanan" style="display:inline-flex; align-items:center; gap:0.5rem; border-radius:50rem;">
        <i class="fas fa-plus"></i> Buat Pesanan Baru
    </button>
</div>

<style>
    .oct-card { background: var(--oct-card); border: 1px solid var(--oct-border-light); border-radius: 16px; box-shadow: var(--oct-shadow-sm); overflow: hidden; margin-bottom: 1.25rem; }
    .oct-card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--oct-border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .oct-card-body { padding: 1.25rem 1.5rem; }
    .oct-pill { padding: 0.375em 1em; border-radius: 50rem; font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; display: inline-block; }
    .oct-pill-pending { background: var(--oct-yellow); color: #1E293B; }
    .oct-pill-diproses { background: #06B6D4; }
    .oct-pill-dikirim { background: var(--oct-primary); }
    .oct-pill-selesai { background: var(--oct-green-dark); }
    .oct-pill-ditolak { background: var(--oct-red); }
    .oct-pill-secondary { background: var(--oct-text-muted); }
    .oct-kode { color: var(--oct-primary); background: var(--oct-primary-bg); padding: 0.25rem 0.625rem; border-radius: 6px; font-weight: 700; font-size: 0.8125rem; font-family: 'JetBrains Mono', monospace; }
    .oct-table { border-collapse: separate; border-spacing: 0; }
    .oct-table thead th { border-bottom: 2px solid var(--oct-border); background: var(--oct-bg); color: var(--oct-text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.6875rem; letter-spacing: 0.06em; padding: 0.75rem 0.625rem; }
    .oct-table td { border-top: 1px solid var(--oct-border-light); padding: 0.625rem; vertical-align: middle; font-size: 0.875rem; }
    .oct-table tbody tr:hover { background: var(--oct-card-hover); }
    .oct-grand-total { font-weight: 900; font-size: 1.0625rem; background: linear-gradient(135deg, var(--oct-green-dark), #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
</style>

<% var list = Array.isArray(orders) ? orders : []; %>

<% if (list.length === 0) { %>
    <div class="oct-card"><div class="oct-card-body text-center" style="padding:3rem;">
        <i class="fas fa-shopping-cart" style="font-size:2.5rem; color:var(--oct-text-muted); opacity:0.3; display:block; margin-bottom:0.75rem;"></i>
        <span style="color:var(--oct-text-muted);">Belum ada pesanan yang dibuat.</span><br>
        <button class="btn btn-primary mt-3" style="border-radius:50rem;" data-toggle="modal" data-target="#modalTambahPesanan">Buat Pesanan Pertama Anda</button>
    </div></div>
<% } %>

<% for (var si = 0; si < list.length; si++) { %>
    <% var o = list[si]; var st = (o.status || '').toLowerCase(); %>
    <div class="oct-card">
        <div class="oct-card-header">
            <div>
                <div style="font-weight:700; margin-bottom:0.5rem;">Kode Order: <span class="oct-kode"><%= o.kode_order %></span></div>
                <div style="font-size:0.8125rem; color:var(--oct-text-muted);">
                    <i class="far fa-clock" style="margin-right:0.25rem;"></i>
                    <% if (o.createdAt) { %><strong style="color:var(--oct-text);"><%= new Date(o.createdAt._seconds ? o.createdAt._seconds * 1000 : o.createdAt).toLocaleDateString('id-ID', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></strong><% } else { %>-<% } %>
                </div>
            </div>
            <span class="oct-pill oct-pill-<%= st || 'secondary' %>"><%= (o.status || 'pending').toUpperCase() %></span>
        </div>
        <div class="oct-card-body">
            <% if (o.keterangan) { %>
                <div class="alert" style="background:var(--oct-bg); border:1px solid var(--oct-border-light); padding:0.625rem 1rem; margin-bottom:0.75rem; font-size:0.875rem; color:var(--oct-text-2);">
                    <i class="fas fa-sticky-note" style="margin-right:0.375rem;"></i><strong>Catatan Anda:</strong> <%= o.keterangan %>
                </div>
            <% } %>
            <% if (o.keterangan_admin) { %>
                <div class="alert alert-info" style="padding:0.625rem 1rem; margin-bottom:0.75rem; font-size:0.875rem;">
                    <i class="fas fa-comment-dots" style="margin-right:0.375rem;"></i><strong>Pesan Admin:</strong> <%= o.keterangan_admin %>
                </div>
            <% } %>
            <div class="table-responsive">
                <table class="table oct-table w-100" style="margin-bottom:0.5rem;">
                    <thead><tr>
                        <th style="width:48px;">#</th><th style="width:64px;">Gambar</th><th>SKU</th><th>Nama Produk</th>
                        <th style="width:100px;">Satuan</th><th style="width:110px;" class="text-right">Harga</th>
                        <th style="width:90px;" class="text-right">Qty</th><th style="width:130px;" class="text-right">Subtotal</th>
                    </tr></thead>
                    <tbody>
                        <% var grandTotal = 0; var items = Array.isArray(o.items) ? o.items : []; for (var i = 0; i < items.length; i++) { var it = items[i]; var sub = Number(it.subtotal || 0); grandTotal += sub; %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td class="text-center"><% if (it.gambar_url) { %><img src="<%= it.gambar_url %>" alt="img" style="width:40px;height:40px;object-fit:cover;border-radius:8px;"><% } else { %><span style="color:var(--oct-text-muted); font-size:0.75rem;">(no image)</span><% } %></td>
                            <td><%= it.sku || '-' %></td><td><%= it.nama_produk || '-' %></td><td><%= it.satuan || '-' %></td>
                            <td class="text-right">Rp <%= Number(it.harga || 0).toLocaleString('id-ID') %></td>
                            <td class="text-right font-weight-bold"><%= it.qty %></td>
                            <td class="text-right font-weight-bold" style="color:var(--oct-primary);">Rp <%= sub.toLocaleString('id-ID') %></td>
                        </tr>
                        <% } %>
                    </tbody>
                    <tfoot><tr style="background:var(--oct-bg);">
                        <td colspan="7" class="text-right text-uppercase" style="font-weight:700; color:var(--oct-text-muted); font-size:0.75rem; letter-spacing:0.05em; vertical-align:middle;">Grand Total</td>
                        <td class="text-right oct-grand-total">Rp <%= grandTotal.toLocaleString('id-ID') %></td>
                    </tr></tfoot>
                </table>
            </div>
        </div>
    </div>
<% } %>

<!-- Modal: Tambah Pesanan -->
<div class="modal fade" id="modalTambahPesanan" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <form method="POST" action="/cabang/orders" id="formTambahPesanan">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="data_barang_json" id="data_barang_json">
            <div class="modal-content">
                <div class="modal-header" style="background:var(--oct-primary); color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-cart-plus" style="margin-right:0.5rem;"></i>Buat Pesanan Baru</h5>
                    <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body" style="background:var(--oct-bg);">
                    <div class="card" style="margin-bottom:1rem;">
                        <div class="card-body">
                            <div class="form-group mb-0">
                                <label style="font-weight:600; color:var(--oct-text-2);">Catatan Pesanan (opsional)</label>
                                <textarea name="keterangan" class="form-control" rows="2" placeholder="Cth: Mohon dikirimkan secepatnya."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div style="padding:0.75rem 1rem; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--oct-border-light);">
                            <span style="font-family:'Poppins',sans-serif; font-weight:600; font-size:0.9375rem; color:var(--oct-text);">Daftar Produk</span>
                            <button type="button" class="btn btn-sm btn-outline-primary" style="border-radius:50rem;" id="btnAddItem"><i class="fas fa-plus" style="margin-right:0.25rem;"></i> Tambah Item</button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" id="tblItems">
                                <thead><tr>
                                    <th style="width:40px; border-top:none;">#</th>
                                    <th style="border-top:none;">Produk (SKU - Nama)</th>
                                    <th style="width:130px; border-top:none;" class="text-right">Kuantitas</th>
                                    <th style="width:60px; border-top:none;"></th>
                                </tr></thead>
                                <tbody id="itemsBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <template id="tplRow">
                        <tr>
                            <td class="row-index text-center align-middle" style="color:var(--oct-text-muted); font-weight:600;"></td>
                            <td class="align-middle">
                                <select class="form-control product-select" required>
                                    <option value="">— pilih produk —</option>
                                    <% var _p = Array.isArray(products) ? products : []; for (var j = 0; j < _p.length; j++) { var p = _p[j]; %>
                                        <option value="<%= p.id %>" data-sku="<%= p.sku || '' %>" data-satuan="<%= p.satuan || '' %>"><%= (p.sku||'-') %> — <%= (p.nama_produk||'-') %> (Rp <%= (p.harga_jual||0).toLocaleString('id-ID') %>)</option>
                                    <% } %>
                                </select>
                                <div style="font-size:0.75rem; color:var(--oct-text-muted); margin-top:0.25rem;" class="detail-produk"></div>
                            </td>
                            <td class="align-middle"><input type="number" class="form-control qty-input text-right font-weight-bold" min="1" step="1" value="1" required></td>
                            <td class="text-center align-middle"><button type="button" class="btn btn-sm btn-light text-danger rounded-circle btnRemoveRow" style="width:32px;height:32px;padding:0;"><i class="fas fa-times"></i></button></td>
                        </tr>
                    </template>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane" style="margin-right:0.375rem;"></i> Kirim Pesanan</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var body = document.getElementById('itemsBody');
        var tpl = document.getElementById('tplRow');
        var btnAdd = document.getElementById('btnAddItem');
        var form = document.getElementById('formTambahPesanan');
        var fieldJSON = document.getElementById('data_barang_json');

        function renumber() { body.querySelectorAll('tr').forEach(function(tr, i) { var c = tr.querySelector('.row-index'); if (c) c.textContent = (i + 1); }); }
        function updateDetail(sel) { var opt = sel.options[sel.selectedIndex]; var info = (opt && opt.value) ? ('Satuan: ' + (opt.getAttribute('data-satuan') || '')) : ''; var d = sel.closest('td').querySelector('.detail-produk'); if (d) d.textContent = info; }
        function addRow() {
            var clone = document.importNode(tpl.content, true);
            var tr = clone.querySelector('tr');
            var sel = tr.querySelector('.product-select');
            sel.addEventListener('change', function() { updateDetail(sel); });
            tr.querySelector('.btnRemoveRow').addEventListener('click', function() { tr.parentNode.removeChild(tr); renumber(); });
            body.appendChild(tr); renumber();
        }

        if (btnAdd) btnAdd.addEventListener('click', addRow);
        $('#modalTambahPesanan').on('shown.bs.modal', function() { if (!body.querySelector('tr')) addRow(); }).on('hidden.bs.modal', function() { body.innerHTML = ''; form.reset(); if (fieldJSON) fieldJSON.value = ''; });
        if (form) form.addEventListener('submit', function(ev) {
            var rows = body.querySelectorAll('tr');
            if (!rows.length) { ev.preventDefault(); Swal.fire({icon:'warning',title:'Oops...',text:'Tambahkan minimal 1 item.',confirmButtonColor:'#3B82F6'}); return; }
            var items = []; var valid = true;
            rows.forEach(function(tr) { var sel = tr.querySelector('.product-select'); var qty = Number((tr.querySelector('.qty-input') || {}).value || 0); if (sel.value && qty > 0) items.push({product_id:sel.value,qty:qty}); else valid = false; });
            if (!valid || !items.length) { ev.preventDefault(); Swal.fire({icon:'error',title:'Data Tidak Lengkap',text:'Pilih produk dan qty > 0.',confirmButtonColor:'#3B82F6'}); return; }
            fieldJSON.value = JSON.stringify(items);
        });

        var params = new URLSearchParams(window.location.search);
        var ok = params.get('ok'), err = params.get('err');
        if (ok && typeof Swal !== 'undefined') { Swal.fire({toast:true,position:'top-end',icon:'success',title:ok==='created'?'Pesanan berhasil dikirim!':'Berhasil',showConfirmButton:false,timer:3000,timerProgressBar:true}); params.delete('ok'); window.history.replaceState({},'',location.pathname+(params.toString()?'?'+params.toString():'')); }
        if (err && typeof Swal !== 'undefined') { Swal.fire({icon:'error',title:'Gagal',text:err,confirmButtonColor:'#3B82F6'}); params.delete('err'); window.history.replaceState({},'',location.pathname+(params.toString()?'?'+params.toString():'')); }
    })();
</script>