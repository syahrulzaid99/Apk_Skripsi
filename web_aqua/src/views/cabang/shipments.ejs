<%
    var list = Array.isArray(shipments) ? shipments : [];

    function shpDate(v) {
        if (!v) return null;
        return new Date(v._seconds ? v._seconds * 1000 : v);
    }
    function shpFmt(v, withTime) {
        var d = shpDate(v);
        if (!d || isNaN(d)) return '—';
        var opt = { day: '2-digit', month: 'short', year: 'numeric' };
        if (withTime) { opt.hour = '2-digit'; opt.minute = '2-digit'; }
        return d.toLocaleDateString('id-ID', opt);
    }
    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
    function itemsOf(s) {
        return Array.isArray(s._items) ? s._items : (Array.isArray(s.data_barang) ? s.data_barang : []);
    }
    function qtyOf(it) {
        return Number(it._qty || it.qty || it.jumlah || it.quantity || it.qty_in || it.qty_out || 0);
    }

    var STATUS_LABEL = {
        dikirim: 'Dalam perjalanan', terkirim: 'Dalam perjalanan',
        diterima: 'Diterima', ditolak: 'Ditolak', draft: 'Draft'
    };

    var totalShp = list.length;
    var nMenunggu = 0, nDiterima = 0, nDitolak = 0, nUnit = 0;
    for (var k = 0; k < list.length; k++) {
        var stk = String(list[k].status || '').toLowerCase();
        if (stk === 'diterima') nDiterima++;
        else if (stk === 'ditolak') nDitolak++;
        else nMenunggu++;
        var itk = itemsOf(list[k]);
        for (var z = 0; z < itk.length; z++) nUnit += qtyOf(itk[z]);
    }

    var buckets = [
        { key: 'all', label: 'Semua', n: totalShp },
        { key: 'menunggu', label: 'Perlu konfirmasi', n: nMenunggu },
        { key: 'diterima', label: 'Diterima', n: nDiterima },
        { key: 'ditolak', label: 'Ditolak', n: nDitolak }
    ];
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .shp-layout {
        display: grid;
        grid-template-columns: minmax(0, 330px) minmax(0, 1fr);
        gap: var(--oct-gap);
        align-items: start;
    }

    .shp-rail {
        background: var(--oct-inset);
        border: 1px solid var(--oct-border-light);
        border-radius: var(--oct-r-lg);
        padding: 0.75rem;
        position: sticky;
        top: 84px;
        max-height: calc(100dvh - 108px);
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .shp-rail-list {
        overflow-y: auto;
        margin: 0 -0.25rem;
        padding: 0 0.25rem;
        scrollbar-width: thin;
        scrollbar-color: var(--oct-border) transparent;
    }

    .shp-rail-list::-webkit-scrollbar { width: 6px; }
    .shp-rail-list::-webkit-scrollbar-thumb { background: var(--oct-border); border-radius: 3px; }

    .shp-rail-count {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--oct-text-muted);
        padding: 0 0.25rem;
    }

    .shp-detail[hidden] { display: none; }

    .shp-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1.125rem 1.25rem;
        border-bottom: 1px solid var(--oct-border-light);
    }

    .shp-head-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 1.125rem;
        letter-spacing: -0.03em;
        margin: 0 0 0.3125rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    /* Sender → receiver route line */
    .shp-route {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.875rem 1.25rem;
        background: var(--oct-inset);
        border-bottom: 1px solid var(--oct-border-light);
        flex-wrap: wrap;
    }

    .shp-route-node { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
    .shp-route-arrow { color: var(--oct-text-muted); font-size: 0.75rem; }

    .shp-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--oct-border-light);
    }

    /* DOM order puts "konfirmasi" first so Enter submits it; visually reject sits left */
    .shp-btn-reject { order: -1; margin-right: auto; }

    .shp-proofs { display: flex; flex-wrap: wrap; gap: 0.5rem; }

    .shp-proof {
        width: 76px;
        height: 76px;
        object-fit: cover;
        border-radius: var(--oct-r-sm);
        border: 1px solid var(--oct-border);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .shp-proof:hover { transform: scale(1.04); box-shadow: var(--oct-shadow-md); }

    .shp-qty-in { max-width: 90px; margin-left: auto; text-align: right; }
    .shp-note-in { min-width: 140px; }

    @media (max-width: 991px) {
        .shp-layout { grid-template-columns: minmax(0, 1fr); }
        .shp-rail { position: static; max-height: none; }
        .shp-rail-list { max-height: 300px; }
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Pengiriman masuk</h1>
        <p class="oct-page-sub">Periksa barang yang dikirim pusat, catat jumlah yang benar-benar diterima, lalu konfirmasi agar stok cabang bertambah.</p>
    </div>
    <% if (nMenunggu > 0) { %>
    <div class="oct-page-actions">
        <span class="oct-pill oct-pill-dot oct-pill-pending"><%= nMenunggu %> menunggu konfirmasi</span>
    </div>
    <% } %>
</div>

<% if (totalShp === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-truck-fast"></i></div>
            <h2 class="oct-empty-title">Belum ada pengiriman</h2>
            <p class="oct-empty-text">Setiap kali pusat mengirim barang ke cabang Anda, surat jalannya akan tampil di sini untuk dikonfirmasi.</p>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-truck-fast"></i></span>
                    <span class="oct-kpi-label">Total pengiriman</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= totalShp %></span>
                    <span class="oct-kpi-note">surat jalan</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-clipboard-check"></i></span>
                    <span class="oct-kpi-label">Perlu konfirmasi</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nMenunggu %></span>
                    <% if (nMenunggu > 0) { %>
                        <span class="oct-delta oct-delta-warn"><i class="fas fa-triangle-exclamation"></i> tertahan</span>
                    <% } else { %>
                        <span class="oct-kpi-note">semua sudah diproses</span>
                    <% } %>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-box-open"></i></span>
                    <span class="oct-kpi-label">Diterima</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nDiterima %></span>
                    <% if (nDitolak > 0) { %>
                        <span class="oct-delta oct-delta-down"><i class="fas fa-circle-xmark"></i> <%= nDitolak %> ditolak</span>
                    <% } %>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-cubes"></i></span>
                    <span class="oct-kpi-label">Unit dikirim</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nUnit.toLocaleString('id-ID') %></span>
                    <span class="oct-kpi-note">akumulasi</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Daftar + detail -->
    <div class="shp-layout">
        <aside class="shp-rail">
            <div class="oct-search" style="max-width:none; flex:none;">
                <i class="fas fa-magnifying-glass"></i>
                <label class="oct-sr" for="shpSearch">Cari pengiriman</label>
                <input type="text" id="shpSearch" placeholder="Cari resi atau nomor PO…" autocomplete="off">
            </div>

            <div class="oct-seg" id="shpSeg" role="tablist" aria-label="Saring berdasarkan status">
                <% for (var bi = 0; bi < buckets.length; bi++) { var b = buckets[bi]; %>
                    <button type="button" role="tab" class="oct-seg-item <%= bi === 0 ? 'active' : '' %>" data-bucket="<%= b.key %>" aria-selected="<%= bi === 0 %>">
                        <%= b.label %><span class="oct-seg-count"><%= b.n %></span>
                    </button>
                <% } %>
            </div>

            <div class="shp-rail-count" id="shpRailCount"><%= totalShp %> pengiriman</div>

            <div class="shp-rail-list oct-listnav" id="shpList" role="tablist" aria-label="Daftar pengiriman">
                <% for (var si = 0; si < list.length; si++) {
                    var s = list[si];
                    var st = String(s.status || 'draft').toLowerCase();
                    var bucket = st === 'diterima' ? 'diterima' : (st === 'ditolak' ? 'ditolak' : 'menunggu');
                    var dotClass = st === 'diterima' ? 'oct-dot-ok' : (st === 'ditolak' ? 'oct-dot-bad' : 'oct-dot-warn');
                    var itemsR = itemsOf(s);
                %>
                <button type="button" role="tab"
                        class="oct-listnav-item <%= si === 0 ? 'active' : '' %>"
                        style="align-items:flex-start;"
                        data-target="shpDetail<%= si %>"
                        data-bucket="<%= bucket %>"
                        data-search="<%= ((s.kode_pengiriman || '') + ' ' + (s.po_number || '') + ' ' + (s.so_number || '')).toLowerCase() %>"
                        aria-selected="<%= si === 0 %>"
                        aria-controls="shpDetail<%= si %>">
                    <span class="oct-dot <%= dotClass %>" style="margin-top:0.4375rem;"></span>
                    <span class="oct-listnav-meta">
                        <span class="oct-listnav-title oct-mono" style="font-size:0.8125rem;"><%= s.kode_pengiriman || '—' %></span>
                        <span class="oct-listnav-sub">PO <%= s.po_number || '—' %> &middot; <%= itemsR.length %> produk</span>
                    </span>
                    <% if (bucket === 'menunggu') { %>
                        <span class="oct-seg-count" style="background:var(--oct-yellow-bg); color:var(--oct-yellow-dark);">baru</span>
                    <% } %>
                </button>
                <% } %>
            </div>

            <p class="oct-empty-text" id="shpListEmpty" hidden style="padding:0.75rem 0.25rem; text-align:left;">
                Tidak ada pengiriman yang cocok.
            </p>
        </aside>

        <div>
            <% for (var di = 0; di < list.length; di++) {
                var sd = list[di];
                var st2 = String(sd.status || 'draft').toLowerCase();
                var canConfirm = (st2 !== 'diterima' && st2 !== 'ditolak');
                var pengirim = (usersMap && usersMap[sd.pengirim]) ? usersMap[sd.pengirim] : null;
                var penerima = (usersMap && usersMap[sd.penerima]) ? usersMap[sd.penerima] : null;
                var itemsD = itemsOf(sd);
                var totalKirim = 0, totalTerima = 0, nilai = 0, adaSelisih = false;
                for (var y = 0; y < itemsD.length; y++) {
                    var qk = qtyOf(itemsD[y]);
                    totalKirim += qk;
                    var qt = itemsD[y].qty_diterima != null ? Number(itemsD[y].qty_diterima) : null;
                    if (qt != null) { totalTerima += qt; if (qt < qk) adaSelisih = true; }
                    nilai += qk * (Number(itemsD[y].item_net_value || 0) + Number(itemsD[y].item_tax || 0));
                }
            %>
            <section class="oct-card shp-detail" id="shpDetail<%= di %>" role="tabpanel" <%= di === 0 ? '' : 'hidden' %>>
                <header class="shp-head">
                    <div>
                        <h2 class="shp-head-title">
                            <span class="oct-mono"><%= sd.kode_pengiriman || '—' %></span>
                            <span class="oct-pill oct-pill-dot oct-pill-<%= st2 %>"><%= STATUS_LABEL[st2] || st2 %></span>
                            <% if (adaSelisih) { %><span class="oct-pill oct-pill-pending">ada selisih</span><% } %>
                        </h2>
                        <p class="oct-card-sub">
                            <% if (st2 === 'diterima') { %>Dikonfirmasi <%= shpFmt(sd.diterima_at, true) %>
                            <% } else if (st2 === 'ditolak') { %>Ditolak <%= shpFmt(sd.ditolak_at, true) %>
                            <% } else { %>Menunggu pemeriksaan barang di cabang<% } %>
                        </p>
                    </div>
                    <div style="text-align:right; line-height:1.3;">
                        <div style="font-family:'Plus Jakarta Sans',sans-serif; font-size:1.25rem; font-weight:800; letter-spacing:-0.035em; font-variant-numeric:tabular-nums;">
                            <%= totalKirim.toLocaleString('id-ID') %>
                        </div>
                        <div class="oct-card-sub">unit dikirim<% if (st2 === 'diterima') { %> &middot; <%= totalTerima.toLocaleString('id-ID') %> diterima<% } %></div>
                    </div>
                </header>

                <div class="shp-route">
                    <span class="shp-route-node">
                        <span class="oct-avatar oct-avatar-sm"><i class="fas fa-warehouse" style="font-size:0.6875rem;"></i></span>
                        <span class="oct-cell-stack">
                            <span class="oct-cell-sub">Pengirim</span>
                            <span class="oct-cell-main"><%= pengirim ? pengirim.username : (sd.pengirim || '—') %></span>
                        </span>
                    </span>
                    <i class="fas fa-arrow-right-long shp-route-arrow"></i>
                    <span class="shp-route-node">
                        <span class="oct-avatar oct-avatar-sm"><i class="fas fa-store" style="font-size:0.6875rem;"></i></span>
                        <span class="oct-cell-stack">
                            <span class="oct-cell-sub">Penerima</span>
                            <span class="oct-cell-main"><%= penerima ? penerima.username : (sd.penerima || '—') %></span>
                        </span>
                    </span>
                    <span class="oct-spacer"></span>
                    <span class="oct-chip"><i class="fas fa-file-invoice"></i> PO <%= sd.po_number || '—' %></span>
                    <span class="oct-chip"><i class="fas fa-hashtag"></i> SO <%= sd.so_number || '—' %></span>
                    <% if (nilai > 0) { %><span class="oct-chip"><i class="fas fa-tag"></i> <%= rupiah(nilai) %></span><% } %>
                </div>

                <% if (canConfirm) { %>
                <form method="POST" action="/cabang/shipments/<%= sd.id %>/confirm" enctype="multipart/form-data" class="shp-form" data-resi="<%= sd.kode_pengiriman || '' %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="aksi" value="diterima">
                <% } %>

                    <div class="oct-card-head">
                        <div>
                            <h3 class="oct-card-title">Barang dalam pengiriman</h3>
                            <p class="oct-card-sub">
                                <% if (canConfirm) { %>Isi kolom <strong>qty diterima</strong> sesuai hitungan fisik. Selisih akan tercatat.
                                <% } else { %>Jumlah yang tercatat saat konfirmasi.<% } %>
                            </p>
                        </div>
                        <% if (canConfirm) { %>
                        <button type="button" class="btn btn-sm btn-outline-primary btnFillAll">
                            <i class="fas fa-wand-magic-sparkles mr-1"></i>Semua sesuai
                        </button>
                        <% } %>
                    </div>

                    <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

                    <div class="oct-card-body" style="padding-bottom:0.75rem;">
                        <div class="oct-tablewrap oct-tablewrap-card">
                            <table class="oct-table oct-table-sm oct-table-nested">
                                <thead>
                                    <tr>
                                        <th class="col-fit">#</th>
                                        <th>Produk</th>
                                        <th>Satuan</th>
                                        <th>Barcode</th>
                                        <th class="num">Dikirim</th>
                                        <th class="num" style="min-width:110px;">Diterima</th>
                                        <th style="min-width:150px;">Catatan</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (itemsD.length === 0) { %>
                                        <tr><td colspan="7" class="oct-td-muted text-center" style="padding:1.5rem;">Tidak ada rincian barang pada surat jalan ini.</td></tr>
                                    <% } %>
                                    <% for (var ii = 0; ii < itemsD.length; ii++) {
                                        var it = itemsD[ii];
                                        var p = it._p || null;
                                        var qKirim = qtyOf(it);
                                        var qTerima = it.qty_diterima != null ? Number(it.qty_diterima) : null;
                                        var sku = (p && p.sku) || it.sku || '—';
                                        var nama = (p && p.nama_produk) || it.nama || it.nama_produk || '—';
                                        var satuan = (p && p.satuan) || it.satuan || '—';
                                        var barcode = (p && p.barcode) || it.barcode || '—';
                                        var img = (p && p.gambar_url) || '';
                                    %>
                                    <tr>
                                        <td class="col-fit oct-td-muted"><%= ii + 1 %></td>
                                        <td>
                                            <div class="oct-cell-media">
                                                <% if (img) { %>
                                                    <img class="oct-thumb" src="<%= img %>" alt="Foto produk <%= nama %>" loading="lazy">
                                                <% } else { %>
                                                    <span class="oct-thumb oct-thumb-empty"><i class="fas fa-image"></i></span>
                                                <% } %>
                                                <span class="oct-cell-stack">
                                                    <span class="oct-cell-main"><%= nama %></span>
                                                    <span class="oct-cell-sub oct-mono"><%= sku %></span>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="oct-td-muted"><%= satuan %></td>
                                        <td class="oct-td-muted oct-mono" style="font-size:0.75rem;"><%= barcode %></td>
                                        <td class="num oct-td-strong js-qty-kirim" data-qty="<%= qKirim %>"><%= qKirim.toLocaleString('id-ID') %></td>

                                        <% if (canConfirm) { %>
                                        <td class="num">
                                            <label class="oct-sr">Qty diterima untuk <%= nama %></label>
                                            <input type="number" name="qty_diterima" class="form-control form-control-sm shp-qty-in js-qty-terima"
                                                   min="0" max="<%= qKirim %>" step="1" value="<%= qKirim %>" inputmode="numeric">
                                        </td>
                                        <td>
                                            <label class="oct-sr">Catatan untuk <%= nama %></label>
                                            <input type="text" name="catatan_item" class="form-control form-control-sm shp-note-in" placeholder="opsional" maxlength="140">
                                        </td>
                                        <% } else { %>
                                        <td class="num">
                                            <% if (qTerima != null) { %>
                                                <span class="oct-td-strong"><%= qTerima.toLocaleString('id-ID') %></span>
                                                <% if (qTerima < qKirim) { %>
                                                    <span class="badge badge-warning ml-1">−<%= (qKirim - qTerima).toLocaleString('id-ID') %></span>
                                                <% } %>
                                            <% } else { %>
                                                <span class="oct-td-muted">—</span>
                                            <% } %>
                                        </td>
                                        <td class="oct-td-muted"><%= it.catatan_penerimaan || '—' %></td>
                                        <% } %>
                                    </tr>
                                    <% } %>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" class="oct-td-muted">Total</td>
                                        <td class="num"><%= totalKirim.toLocaleString('id-ID') %></td>
                                        <td class="num js-sum-terima"><%= canConfirm ? totalKirim.toLocaleString('id-ID') : (itemsD.length ? totalTerima.toLocaleString('id-ID') : '—') %></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                <% if (canConfirm) { %>
                    <div class="oct-card-body" style="padding-top:0;">
                        <div class="oct-grid oct-grid-2">
                            <div class="form-group mb-0">
                                <label>Foto bukti penerimaan <span class="oct-label-hint">(opsional, maks 10)</span></label>
                                <div class="oct-drop">
                                    <input type="file" name="bukti_foto" multiple accept="image/*" aria-label="Unggah foto bukti penerimaan">
                                    <i class="fas fa-cloud-arrow-up oct-drop-icon"></i>
                                    <span class="oct-drop-text">Seret berkas ke sini atau klik untuk memilih</span>
                                    <span class="oct-drop-hint">JPG, PNG, WEBP atau GIF &middot; maks 5&nbsp;MB per berkas</span>
                                    <span class="oct-drop-files"></span>
                                </div>
                            </div>
                            <div class="form-group mb-0">
                                <label for="ket<%= di %>">Catatan umum <span class="oct-label-hint">(opsional)</span></label>
                                <textarea name="keterangan" id="ket<%= di %>" class="form-control" rows="4" maxlength="500"
                                          placeholder="Contoh: satu dus penyok, isi tetap lengkap."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="shp-actions">
                        <button type="submit" class="btn btn-primary btnConfirmShip">
                            <i class="fas fa-check mr-2"></i>Konfirmasi diterima
                        </button>
                        <button type="submit" name="aksi" value="ditolak" class="btn btn-outline-danger shp-btn-reject btnRejectShip">
                            <i class="fas fa-xmark mr-2"></i>Tolak pengiriman
                        </button>
                    </div>
                </form>
                <% } else { %>
                    <div class="oct-card-body" style="padding-top:0;">
                        <div class="oct-panel-inset">
                            <div class="oct-dl mb-3">
                                <div>
                                    <div class="oct-dl-key">Keterangan</div>
                                    <div class="oct-dl-val"><%= (sd.keterangan != null && sd.keterangan !== '') ? sd.keterangan : '—' %></div>
                                </div>
                                <div>
                                    <div class="oct-dl-key">Selisih total</div>
                                    <div class="oct-dl-val">
                                        <% var selisih = totalKirim - totalTerima; %>
                                        <% if (st2 === 'ditolak') { %>
                                            <span class="oct-td-muted">Seluruh kiriman ditolak</span>
                                        <% } else if (selisih > 0) { %>
                                            <span style="color:var(--oct-yellow-dark); font-weight:600;">Kurang <%= selisih.toLocaleString('id-ID') %> unit</span>
                                        <% } else { %>
                                            <span style="color:var(--oct-green-dark); font-weight:600;">Sesuai jumlah kirim</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <% if (Array.isArray(sd.bukti_penerimaan_urls) && sd.bukti_penerimaan_urls.length) { %>
                                <div class="oct-dl-key">Bukti penerimaan</div>
                                <div class="shp-proofs mt-2">
                                    <% for (var b2 = 0; b2 < sd.bukti_penerimaan_urls.length; b2++) { %>
                                        <a href="<%= sd.bukti_penerimaan_urls[b2] %>" target="_blank" rel="noopener">
                                            <img src="<%= sd.bukti_penerimaan_urls[b2] %>" class="shp-proof" alt="Bukti penerimaan <%= b2 + 1 %> untuk resi <%= sd.kode_pengiriman %>" loading="lazy">
                                        </a>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <p class="oct-card-sub mb-0">Tidak ada foto bukti yang diunggah.</p>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </section>
            <% } %>
        </div>
    </div>
<% } %>

<script>
    (function () {
        /* ── Master/detail: rail selection ─────────────────────── */
        var listEl = document.getElementById('shpList');
        if (listEl) {
            var items = Array.prototype.slice.call(listEl.querySelectorAll('.oct-listnav-item'));
            var panels = Array.prototype.slice.call(document.querySelectorAll('.shp-detail'));
            var searchEl = document.getElementById('shpSearch');
            var segEl = document.getElementById('shpSeg');
            var countEl = document.getElementById('shpRailCount');
            var emptyEl = document.getElementById('shpListEmpty');
            var bucket = 'all';

            function select(id) {
                items.forEach(function (btn) {
                    var on = btn.dataset.target === id;
                    btn.classList.toggle('active', on);
                    btn.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                panels.forEach(function (p) { p.hidden = p.id !== id; });
            }

            items.forEach(function (btn) {
                btn.addEventListener('click', function () { select(btn.dataset.target); });
            });

            function applyFilter() {
                var q = searchEl ? searchEl.value.trim().toLowerCase() : '';
                var shown = 0;
                var firstVisible = null;

                items.forEach(function (btn) {
                    var okBucket = bucket === 'all' || btn.dataset.bucket === bucket;
                    var okSearch = !q || btn.dataset.search.indexOf(q) !== -1;
                    var hit = okBucket && okSearch;
                    btn.hidden = !hit;
                    if (hit) { shown++; if (!firstVisible) firstVisible = btn; }
                });

                if (countEl) countEl.textContent = shown + ' pengiriman';
                if (emptyEl) emptyEl.hidden = shown !== 0;

                var active = items.filter(function (b) { return b.classList.contains('active') && !b.hidden; })[0];
                if (!active && firstVisible) select(firstVisible.dataset.target);
            }

            if (searchEl) searchEl.addEventListener('input', applyFilter);

            if (segEl) {
                segEl.addEventListener('click', function (e) {
                    var btn = e.target.closest('.oct-seg-item');
                    if (!btn) return;
                    bucket = btn.dataset.bucket;
                    segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                        var on = b === btn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    applyFilter();
                });
            }
        }

        /* ── Confirmation forms ────────────────────────────────── */
        document.querySelectorAll('.shp-form').forEach(function (form) {
            var qtyInputs = Array.prototype.slice.call(form.querySelectorAll('.js-qty-terima'));
            var sumCell = form.querySelector('.js-sum-terima');
            var fillBtn = form.querySelector('.btnFillAll');

            // Which submit button was used — SubmitEvent.submitter isn't in older Safari
            var lastSubmitter = null;
            form.querySelectorAll('button[type="submit"]').forEach(function (b) {
                b.addEventListener('click', function () { lastSubmitter = b; });
            });

            function recalc() {
                var total = 0;
                qtyInputs.forEach(function (input) { total += Number(input.value || 0); });
                if (sumCell) sumCell.textContent = total.toLocaleString('id-ID');
            }

            qtyInputs.forEach(function (input) {
                var max = Number(input.getAttribute('max') || 0);
                input.addEventListener('input', function () {
                    // Received can never exceed what was shipped
                    if (Number(input.value) > max) input.value = max;
                    if (Number(input.value) < 0) input.value = 0;
                    recalc();
                });
            });

            if (fillBtn) {
                fillBtn.addEventListener('click', function () {
                    qtyInputs.forEach(function (input) { input.value = input.getAttribute('max') || 0; });
                    recalc();
                });
            }

            // Both actions move real stock — confirm before submitting
            var pending = false;
            form.addEventListener('submit', function (ev) {
                if (pending) return;
                ev.preventDefault();

                var submitter = ev.submitter || lastSubmitter;
                var reject = !!(submitter && submitter.classList.contains('btnRejectShip'));
                var resi = form.dataset.resi || 'pengiriman ini';
                var total = 0;
                qtyInputs.forEach(function (input) { total += Number(input.value || 0); });

                var opts = reject
                    ? {
                        icon: 'warning',
                        title: 'Tolak pengiriman?',
                        text: 'Seluruh barang pada ' + resi + ' dikembalikan ke stok pusat dan stok cabang tidak bertambah.',
                        confirmText: 'Ya, tolak'
                    }
                    : {
                        icon: 'question',
                        title: 'Konfirmasi penerimaan?',
                        text: total.toLocaleString('id-ID') + ' unit akan ditambahkan ke stok cabang Anda.',
                        confirmText: 'Ya, konfirmasi'
                    };

                Aqua.confirm(opts).then(function (res) {
                    if (!res.isConfirmed) return;
                    pending = true;

                    // Re-submit through the same button so `aksi` is sent correctly
                    var btn = form.querySelector(reject ? '.btnRejectShip' : '.btnConfirmShip');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin mr-2"></i>Menyimpan…';
                    form.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; });

                    if (reject) {
                        // Preserve the ditolak value that the disabled button can no longer submit
                        var hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'aksi';
                        hidden.value = 'ditolak';
                        form.appendChild(hidden);
                    }
                    form.submit();
                });
            });

            recalc();
        });

        /* ── Flash messages ────────────────────────────────────── */
        Aqua.flash({
            confirmed: 'Konfirmasi pengiriman tersimpan',
            created: 'Pengiriman dibuat'
        });
    })();
</script>
