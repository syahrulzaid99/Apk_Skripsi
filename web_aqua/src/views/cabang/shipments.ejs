<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.5rem;">
    <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(1.25rem,3vw,1.5rem); font-weight:700; margin:0; color:var(--oct-text);">
        <span style="margin-right:0.5rem;">&#128666;</span>Pengiriman Masuk
    </h1>
</div>

<style>
    .oct-card { background: var(--oct-card); border: 1px solid var(--oct-border-light); border-radius: 16px; box-shadow: var(--oct-shadow-sm); overflow: hidden; margin-bottom: 1.25rem; }
    .oct-card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--oct-border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .oct-card-body { padding: 1.25rem 1.5rem; }
    .oct-pill { padding: 0.375em 1em; border-radius: 50rem; font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; display: inline-block; }
    .oct-pill-terkirim, .oct-pill-dikirim { background: #06B6D4; }
    .oct-pill-diterima { background: var(--oct-green-dark); }
    .oct-pill-ditolak { background: var(--oct-red); }
    .oct-pill-draft { background: var(--oct-text-muted); }
    .oct-kode { color: var(--oct-primary); background: var(--oct-primary-bg); padding: 0.25rem 0.625rem; border-radius: 6px; font-weight: 700; font-size: 0.8125rem; font-family: 'JetBrains Mono', monospace; }
    .oct-section { background: var(--oct-card); border: 1px solid var(--oct-border-light); border-radius: 12px; overflow: hidden; margin-bottom: 1rem; }
    .oct-section-header { padding: 0.75rem 1rem; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.8125rem; color: #fff; }
    .oct-section-header.primary { background: linear-gradient(135deg, var(--oct-primary), var(--oct-primary-dark)); }
    .oct-section-header.secondary { background: linear-gradient(135deg, #64748B, #475569); }
    .oct-table { border-collapse: separate; border-spacing: 0; }
    .oct-table thead th { border-bottom: 2px solid var(--oct-border); background: var(--oct-bg); color: var(--oct-text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.6875rem; letter-spacing: 0.06em; padding: 0.75rem 0.625rem; }
    .oct-table td { border-top: 1px solid var(--oct-border-light); padding: 0.625rem; vertical-align: middle; font-size: 0.875rem; }
    .oct-table tbody tr:hover { background: var(--oct-card-hover); }
    .oct-grand-total { font-weight: 900; font-size: 1.0625rem; background: linear-gradient(135deg, var(--oct-green-dark), #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .oct-btn-success { background: var(--oct-green-dark); color: #fff; border: none; border-radius: 8px; padding: 0.5rem 1rem; font-weight: 600; font-size: 0.8125rem; cursor: pointer; transition: all 0.15s ease; box-shadow: 0 2px 8px rgba(22,163,74,0.25); }
    .oct-btn-success:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(22,163,74,0.35); }
    .bukti-img { border-radius: 8px; border: 2px solid var(--oct-card); box-shadow: 0 4px 10px rgba(0,0,0,0.1); transition: transform 0.2s ease; }
    .bukti-img:hover { transform: scale(1.15); }
    .soft-panel { background: var(--oct-bg); border-radius: 12px; padding: 1rem; }
</style>

<% var list = Array.isArray(shipments) ? shipments : []; %>

<% if (list.length === 0) { %>
    <div class="oct-card"><div class="oct-card-body text-center" style="padding:2rem; color:var(--oct-text-muted);">
        <i class="fas fa-truck" style="font-size:2rem; opacity:0.3; display:block; margin-bottom:0.75rem;"></i>
        <span>Tidak ada pengiriman.</span>
    </div></div>
<% } %>

<% for (var si = 0; si < list.length; si++) { %>
    <% var s = list[si]; var pengirim = (usersMap && usersMap[s.pengirim]) ? usersMap[s.pengirim] : null; var penerima = (usersMap && usersMap[s.penerima]) ? usersMap[s.penerima] : null; var st = (s.status || '').toLowerCase(); %>
    <div class="oct-card">
        <div class="oct-card-header">
            <div>
                <div style="font-weight:700; margin-bottom:0.5rem;">Kode Resi: <span class="oct-kode"><%= s.kode_pengiriman %></span></div>
                <div style="font-size:0.8125rem; color:var(--oct-text-muted); margin-bottom:0.25rem;">
                    <i class="fas fa-file-invoice" style="margin-right:0.25rem;"></i> PO: <strong style="color:var(--oct-text);"><%= s.po_number || '-' %></strong>
                    <span style="margin:0 0.5rem; color:var(--oct-border);">•</span> SO: <strong style="color:var(--oct-text);"><%= s.so_number || '-' %></strong>
                </div>
                <div style="font-size:0.8125rem; color:var(--oct-text-muted);">
                    <i class="fas fa-truck" style="margin-right:0.25rem;"></i> Pengirim: <strong style="color:var(--oct-text);"><%= pengirim ? pengirim.username : s.pengirim %></strong>
                    <span style="color:var(--oct-primary); margin:0 0.5rem;">→</span> Penerima: <strong style="color:var(--oct-text);"><%= penerima ? penerima.username : s.penerima %></strong>
                </div>
            </div>
            <span class="oct-pill oct-pill-<%= st %>"><%= (s.status || 'draft').toUpperCase() %></span>
        </div>

        <div class="oct-card-body">
            <div class="oct-section">
                <div class="oct-section-header primary">Daftar Produk</div>
                <div style="padding:1rem;">
                    <div class="table-responsive">
                        <table class="table oct-table table-sm w-100" style="margin-bottom:0.5rem;">
                            <thead><tr>
                                <th style="width:48px;">#</th><th style="width:64px;">Gambar</th><th>SKU</th><th>Nama Produk</th>
                                <th style="width:100px;">Satuan</th><th style="width:130px;">Barcode</th>
                                <th style="width:100px;" class="text-right">Qty Dikirim</th><th style="width:100px;" class="text-right">Qty Diterima</th>
                            </tr></thead>
                            <tbody>
                                <% var grandTotal = 0; var items = Array.isArray(s._items) ? s._items : (Array.isArray(s.data_barang) ? s.data_barang : []); for (var i = 0; i < items.length; i++) { var it = items[i]; var p = (it && it._p) ? it._p : null; var qtyKirim = Number(it._qty || it.qty || it.jumlah || it.quantity || it.qty_in || it.qty_out || 0); var qtyTerima = it.qty_diterima != null ? Number(it.qty_diterima) : null; var sku = (p && p.sku) || it.sku || '-'; var nama = (p && p.nama_produk) || it.nama || it.nama_produk || '-'; var satuan = (p && p.satuan) || it.satuan || '-'; var barcode = (p && p.barcode) || it.barcode || '-'; var img = (p && p.gambar_url) || ''; var netVal = Number(it && it.item_net_value) || 0; var tax = Number(it && it.item_tax) || 0; grandTotal += qtyKirim * (netVal + tax); %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td class="text-center"><% if (img) { %><img src="<%= img %>" alt="img" style="width:44px;height:44px;object-fit:cover;border-radius:8px;"><% } else { %><span style="color:var(--oct-text-muted); font-size:0.8125rem;">(no image)</span><% } %></td>
                                    <td><%= sku %></td><td><%= nama %></td><td><%= satuan %></td><td><%= barcode %></td>
                                    <td class="text-right font-weight-bold"><%= qtyKirim %></td>
                                    <td class="text-right"><% if (st === 'diterima' && qtyTerima != null) { %><%= qtyTerima %><% if (qtyTerima < qtyKirim) { %> <span class="badge badge-warning">kurang</span><% } %><% } else { %>-<% } %></td>
                                </tr>
                                <% } %>
                            </tbody>
                            <tfoot><tr style="background:var(--oct-bg);">
                                <td colspan="6" class="text-right text-uppercase" style="font-weight:700; color:var(--oct-text-muted); font-size:0.75rem; letter-spacing:0.05em; vertical-align:middle;">Grand Total</td>
                                <td colspan="2" class="text-right oct-grand-total">Rp <%= grandTotal.toLocaleString('id-ID') %></td>
                            </tr></tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="oct-section">
                <div class="oct-section-header secondary">Data Konfirmasi</div>
                <div style="padding:1rem;">
                    <% if (st !== 'diterima' && st !== 'ditolak') { %>
                        <form method="POST" action="/cabang/shipments/<%= s.id %>/confirm" enctype="multipart/form-data">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="aksi" value="diterima">
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm">
                                    <thead><tr>
                                        <th style="width:48px;">#</th><th>Produk</th>
                                        <th style="width:100px;" class="text-right">Qty Dikirim</th>
                                        <th style="width:130px;">Qty Diterima</th><th>Catatan</th>
                                    </tr></thead>
                                    <tbody>
                                        <% var items2 = Array.isArray(s._items) ? s._items : (Array.isArray(s.data_barang) ? s.data_barang : []); for (var j = 0; j < items2.length; j++) { var it2 = items2[j]; var p2 = (it2 && it2._p) ? it2._p : null; var qtyKirim2 = Number(it2._qty || it2.qty || it2.jumlah || it2.quantity || it2.qty_in || it2.qty_out || 0); var labelProduk = '-'; if (p2 && p2.sku) { labelProduk = p2.sku + ' — ' + (p2.nama_produk || ''); } else if (it2 && (it2.sku || it2.nama || it2.nama_produk)) { labelProduk = ((it2.sku || '') + ' ' + (it2.nama || it2.nama_produk || '')).trim(); } %>
                                        <tr>
                                            <td><%= j + 1 %></td><td><%= labelProduk %></td>
                                            <td class="text-right"><%= qtyKirim2 %></td>
                                            <td><input type="number" name="qty_diterima" class="form-control form-control-sm" min="0" step="1" value="<%= qtyKirim2 %>"></td>
                                            <td><input type="text" name="catatan_item" class="form-control form-control-sm" placeholder="opsional"></td>
                                        </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                            <div class="form-group">
                                <label style="font-size:0.8125rem; font-weight:600; color:var(--oct-text-2);">Foto Bukti (opsional, bisa lebih dari satu)</label>
                                <input type="file" name="bukti_foto" multiple accept="image/*" class="form-control-file">
                                <small style="color:var(--oct-text-muted);">Format: jpg/png/webp/gif, maks 5MB per file.</small>
                            </div>
                            <div class="form-group">
                                <label style="font-size:0.8125rem; font-weight:600; color:var(--oct-text-2);">Catatan (opsional)</label>
                                <textarea name="keterangan" class="form-control form-control-sm" rows="2" placeholder="Catatan umum"></textarea>
                            </div>
                            <button type="submit" class="oct-btn-success" style="margin-right:0.5rem;"><i class="fas fa-check" style="margin-right:0.375rem;"></i> Simpan Konfirmasi</button>
                            <button type="submit" formaction="/cabang/shipments/<%= s.id %>/confirm" formmethod="POST" name="aksi" value="ditolak" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-times" style="margin-right:0.375rem;"></i> Tolak Pengiriman
                            </button>
                        </form>
                    <% } else { %>
                        <div class="soft-panel">
                            <div style="margin-bottom:0.5rem;"><strong>Keterangan:</strong> <%= (s.keterangan != null && s.keterangan !== '') ? s.keterangan : '-' %></div>
                            <% if (Array.isArray(s.bukti_penerimaan_urls) && s.bukti_penerimaan_urls.length) { %>
                                <div style="margin-top:0.75rem;">
                                    <div style="font-weight:600; color:var(--oct-primary); margin-bottom:0.5rem;">Bukti Penerimaan:</div>
                                    <div class="d-flex flex-wrap" style="gap:0.5rem;">
                                        <% for (var b = 0; b < s.bukti_penerimaan_urls.length; b++) { %>
                                            <a href="<%= s.bukti_penerimaan_urls[b] %>" target="_blank"><img src="<%= s.bukti_penerimaan_urls[b] %>" class="bukti-img" style="width:80px;height:80px;object-fit:cover;"></a>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
<% } %>

<script>
    $(function () {
        var params = new URLSearchParams(window.location.search);
        var ok = params.get('ok'), err = params.get('err');
        if (ok && typeof Swal !== 'undefined') {
            var title = ok === 'confirmed' ? 'Konfirmasi tersimpan' : ok === 'created' ? 'Pengiriman dibuat' : ok;
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: title, showConfirmButton: false, timer: 2200, timerProgressBar: true });
            params.delete('ok'); window.history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params.toString() : ''));
        }
        if (err && typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Gagal', text: err, confirmButtonColor: '#3B82F6' });
            params.delete('err'); window.history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params.toString() : ''));
        }
    });
</script>