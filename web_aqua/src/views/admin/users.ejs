<%
    var list = Array.isArray(users) ? users : [];

    var ROLES = ['admin', 'cabang', 'sales', 'gudang'];
    var ROLE_ICON = {
        admin: 'fa-shield-halved',
        cabang: 'fa-store',
        sales: 'fa-cart-shopping',
        gudang: 'fa-warehouse'
    };
    var ROLE_LABEL = { admin: 'Admin', cabang: 'Cabang', sales: 'Sales', gudang: 'Gudang' };

    var roleCount = { admin: 0, cabang: 0, sales: 0, gudang: 0 };
    var lengkapAlamat = 0;
    for (var ci = 0; ci < list.length; ci++) {
        var rc = String(list[ci].role || '').toLowerCase();
        if (roleCount[rc] == null) roleCount[rc] = 0;
        roleCount[rc]++;
        if (list[ci].kota || list[ci].provinsi || list[ci].jalan) lengkapAlamat++;
    }
    var totalUsers = list.length;
    var timOperasional = roleCount.sales + roleCount.gudang;

    function usrInitial(s) { return String(s || 'U').charAt(0).toUpperCase(); }
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .usr-role-cell { text-transform: capitalize; }

    /* DataTables chrome sits inside the table card; keep it breathing */
    .usr-tablehost .dataTables_wrapper { padding: 0; }
    .usr-tablehost .dataTables_info,
    .usr-tablehost .dataTables_paginate { padding-left: 0.875rem; padding-right: 0.875rem; }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Kelola pengguna</h1>
        <p class="oct-page-sub">Buat dan atur akun untuk admin, cabang, sales, dan gudang beserta data lokasinya.</p>
    </div>
    <div class="oct-page-actions">
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalCreate">
            <i class="fas fa-plus mr-2"></i>Tambah pengguna
        </button>
    </div>
</div>

<!-- Ringkasan -->
<div class="oct-panel mb-3">
    <div class="oct-kpi-grid">
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-users"></i></span>
                <span class="oct-kpi-label">Total pengguna</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= totalUsers %></span>
                <span class="oct-kpi-note">akun aktif</span>
            </div>
            <div class="oct-kpi-foot"><%= lengkapAlamat %> akun sudah punya data alamat</div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-shield-halved"></i></span>
                <span class="oct-kpi-label">Admin</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= roleCount.admin %></span>
                <span class="oct-kpi-note">akses penuh</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-store"></i></span>
                <span class="oct-kpi-label">Cabang</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= roleCount.cabang %></span>
                <span class="oct-kpi-note">titik distribusi</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-people-carry-box"></i></span>
                <span class="oct-kpi-label">Sales &amp; gudang</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= timOperasional %></span>
                <span class="oct-kpi-note"><%= roleCount.sales %> sales &middot; <%= roleCount.gudang %> gudang</span>
            </div>
        </div>
    </div>
</div>

<!-- Daftar pengguna -->
<section class="oct-card">
    <div class="oct-card-head">
        <div>
            <h2 class="oct-card-title">Daftar pengguna</h2>
            <p class="oct-card-sub">Klik ikon pensil untuk mengubah data, ikon tempat sampah untuk menghapus akun.</p>
        </div>
        <div class="oct-row">
            <% if (totalUsers > 0) { %>
            <div class="oct-seg" id="usrSeg" role="tablist" aria-label="Saring berdasarkan peran">
                <button type="button" role="tab" class="oct-seg-item active" data-role="" aria-selected="true">
                    Semua<span class="oct-seg-count"><%= totalUsers %></span>
                </button>
                <% for (var ri = 0; ri < ROLES.length; ri++) { var rk = ROLES[ri]; %>
                <button type="button" role="tab" class="oct-seg-item" data-role="<%= rk %>" aria-selected="false">
                    <%= ROLE_LABEL[rk] %><span class="oct-seg-count"><%= roleCount[rk] || 0 %></span>
                </button>
                <% } %>
            </div>
            <div class="oct-search">
                <i class="fas fa-magnifying-glass"></i>
                <label class="oct-sr" for="tableSearch">Cari pengguna</label>
                <input type="text" id="tableSearch" placeholder="Cari nama, cabang, atau kota…" autocomplete="off">
            </div>
            <% } %>
        </div>
    </div>

    <% if (totalUsers === 0) { %>
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-user-plus"></i></div>
            <h2 class="oct-empty-title">Belum ada pengguna</h2>
            <p class="oct-empty-text">Setiap akun yang dibuat akan tampil di sini lengkap dengan peran dan lokasi cabangnya.</p>
            <div class="oct-empty-actions">
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalCreate">
                    <i class="fas fa-plus mr-2"></i>Tambah pengguna pertama
                </button>
            </div>
        </div>
    <% } else { %>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body usr-tablehost">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="usersTable">
                    <thead>
                        <tr>
                            <th>Pengguna</th>
                            <th class="col-fit">Peran</th>
                            <th>Cabang</th>
                            <th>Kota</th>
                            <th>Provinsi</th>
                            <th>Jalan</th>
                            <th class="oct-td-actions">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var ui = 0; ui < list.length; ui++) {
                            var u = list[ui];
                            var role = String(u.role || '').toLowerCase();
                            var icon = ROLE_ICON[role] || 'fa-user';
                        %>
                        <tr>
                            <td>
                                <div class="oct-cell-media">
                                    <span class="oct-avatar oct-avatar-sm"><%= usrInitial(u.username) %></span>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= u.username || '—' %></span>
                                        <span class="oct-cell-sub"><%= u.nama_cabang || 'Tanpa cabang' %></span>
                                    </span>
                                </div>
                            </td>
                            <td class="col-fit"><span class="oct-chip usr-role-cell"><i class="fas <%= icon %>"></i><%= u.role || '—' %></span></td>
                            <td><%= u.nama_cabang || '—' %></td>
                            <td><%= u.kota || '—' %></td>
                            <td><%= u.provinsi || '—' %></td>
                            <td class="oct-td-muted"><%= u.jalan || '—' %></td>
                            <td class="oct-td-actions">
                                <button type="button" class="oct-icon-btn oct-icon-btn-primary"
                                    title="Ubah <%= u.username || 'pengguna' %>" aria-label="Ubah <%= u.username || 'pengguna' %>"
                                    data-toggle="modal"
                                    data-target="#modalEdit" data-id="<%= u.id %>" data-username="<%= u.username %>"
                                    data-role="<%= u.role %>" data-nama-cabang="<%= u.nama_cabang || '' %>"
                                    data-provinsi="<%= u.provinsi || '' %>" data-kota="<%= u.kota || '' %>"
                                    data-jalan="<%= u.jalan || '' %>">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button type="button" class="oct-icon-btn oct-icon-btn-danger btn-del"
                                    title="Hapus <%= u.username || 'pengguna' %>" aria-label="Hapus <%= u.username || 'pengguna' %>"
                                    data-id="<%= u.id %>" data-username="<%= u.username %>">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</section>

<!-- CREATE MODAL -->
<div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="modalCreateLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <form method="post" action="/admin/users" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalCreateLabel">Tambah pengguna</h5>
                    <p class="oct-card-sub">Akun langsung bisa dipakai setelah disimpan.</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" title="Tutup" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="create_username">Username</label>
                        <input name="username" id="create_username" class="form-control" required autocomplete="off">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="create_password">Kata sandi <span class="oct-label-hint">(minimal 6 karakter)</span></label>
                        <input name="password" id="create_password" type="password" class="form-control" required minlength="6" autocomplete="new-password">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="create_role">Peran</label>
                        <select name="role" id="create_role" class="form-control" required>
                            <option value="admin">admin</option>
                            <option value="cabang">cabang</option>
                            <option value="sales">sales</option>
                            <option value="gudang">gudang</option>
                        </select>
                    </div>
                    <div class="form-group col-md-8">
                        <label for="create_nama_cabang">Nama cabang <span class="oct-label-hint">(opsional)</span></label>
                        <input name="nama_cabang" id="create_nama_cabang" class="form-control" placeholder="mis. Cabang Bandung">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="create_provinsi">Provinsi</label>
                        <input name="provinsi" id="create_provinsi" class="form-control">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="create_kota">Kota</label>
                        <input name="kota" id="create_kota" class="form-control">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="create_jalan">Jalan</label>
                        <input name="jalan" id="create_jalan" class="form-control">
                    </div>
                </div>
                <div class="oct-note">
                    <i class="fas fa-circle-info"></i>
                    <span>Data cabang hanya dipakai untuk peran <strong>cabang</strong>, tetapi boleh diisi untuk peran lain sebagai catatan lokasi.</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk mr-2"></i>Simpan</button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="modalEditLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <form id="formEdit" method="post" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalEditLabel">Ubah pengguna</h5>
                    <p class="oct-card-sub">Kosongkan kata sandi bila tidak ingin menggantinya.</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" title="Tutup" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="edit_username">Username</label>
                        <input name="username" id="edit_username" class="form-control" required autocomplete="off">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="edit_password">Kata sandi baru <span class="oct-label-hint">(opsional)</span></label>
                        <input name="password" id="edit_password" type="password" class="form-control" minlength="6" autocomplete="new-password">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="edit_role">Peran</label>
                        <select name="role" id="edit_role" class="form-control" required>
                            <option value="admin">admin</option>
                            <option value="cabang">cabang</option>
                            <option value="sales">sales</option>
                            <option value="gudang">gudang</option>
                        </select>
                    </div>
                    <div class="form-group col-md-8">
                        <label for="edit_nama_cabang">Nama cabang</label>
                        <input name="nama_cabang" id="edit_nama_cabang" class="form-control">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="edit_provinsi">Provinsi</label>
                        <input name="provinsi" id="edit_provinsi" class="form-control">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="edit_kota">Kota</label>
                        <input name="kota" id="edit_kota" class="form-control">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="edit_jalan">Jalan</label>
                        <input name="jalan" id="edit_jalan" class="form-control">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk mr-2"></i>Simpan perubahan</button>
            </div>
        </form>
    </div>
</div>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        /* ── Tabel pengguna ─────────────────────────────────────── */
        if ($('#usersTable').length) {
            var dt = $('#usersTable').DataTable({
                pageLength: 10,
                lengthChange: false,
                order: [[0, 'asc']],
                columnDefs: [{ orderable: false, targets: -1 }],
                language: {
                    search: 'Cari:',
                    paginate: { previous: 'Sebelumnya', next: 'Selanjutnya' },
                    info: 'Menampilkan _START_ s/d _END_ dari _TOTAL_ pengguna',
                    infoEmpty: 'Tidak ada pengguna untuk ditampilkan',
                    emptyTable: 'Belum ada pengguna',
                    zeroRecords: 'Tidak ada pengguna yang cocok'
                }
            });
            $('#usersTable_filter').hide();
            $('#tableSearch').on('keyup', function () { dt.search(this.value).draw(); });

            /* Saring berdasarkan peran — kolom 1 berisi teks peran */
            $('#usrSeg').on('click', '.oct-seg-item', function () {
                var $btn = $(this);
                $('#usrSeg .oct-seg-item').removeClass('active').attr('aria-selected', 'false');
                $btn.addClass('active').attr('aria-selected', 'true');
                dt.column(1).search($btn.data('role') || '').draw();
            });
        }

        /* ── Modal ubah: isi dari data-* tombol baris ───────────── */
        $('#modalEdit').on('show.bs.modal', function (e) {
            var $btn = $(e.relatedTarget).closest('button');
            var id = $btn.data('id');
            $('#formEdit').attr('action', '/admin/users/' + id);
            $('#edit_username').val($btn.data('username'));
            $('#edit_role').val($btn.data('role'));
            $('#edit_nama_cabang').val($btn.data('namaCabang'));
            $('#edit_provinsi').val($btn.data('provinsi'));
            $('#edit_kota').val($btn.data('kota'));
            $('#edit_jalan').val($btn.data('jalan'));
            $('#edit_password').val('');
        });

        /* ── Hapus pengguna ─────────────────────────────────────── */
        $('#usersTable').on('click', '.btn-del', function () {
            var $btn = $(this);
            var id = $btn.data('id');
            var uname = $btn.data('username');
            Aqua.confirm({
                title: 'Hapus pengguna?',
                text: 'Akun ' + uname + ' akan dihapus permanen dan tidak bisa dipulihkan.',
                confirmText: 'Ya, hapus'
            }).then(function (r) {
                if (!r.isConfirmed) return;
                var form = $('<form>', { method: 'post', action: '/admin/users/' + id + '/delete' });
                form.append($('<input>', { type: 'hidden', name: '_csrf', value: '<%= csrfToken %>' }));
                $('body').append(form);
                form.trigger('submit');
            });
        });

        /* ── Pesan kilat ────────────────────────────────────────── */
        Aqua.flash({
            created: 'Pengguna berhasil dibuat',
            updated: 'Perubahan tersimpan',
            deleted: 'Pengguna dihapus'
        });
    });
</script>
