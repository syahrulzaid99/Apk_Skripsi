<%
    var branchList = (typeof branches !== 'undefined' && Array.isArray(branches)) ? branches : [];
    var sumSales = (typeof salesSummary !== 'undefined' && salesSummary) ? salesSummary : {};
    var rows = (typeof reportRows !== 'undefined' && Array.isArray(reportRows)) ? reportRows : [];

    function lapNum(v) { return Number(v || 0).toLocaleString('id-ID'); }
    function lapRp(v) { return 'Rp ' + Number(v || 0).toLocaleString('id-ID'); }

    function lapToDate(v) {
        if (!v) return null;
        var d;
        if (v.toDate) { try { d = v.toDate(); } catch (e) { d = null; } }
        else if (v._seconds) d = new Date(v._seconds * 1000);
        else d = new Date(v);
        return (d && !isNaN(d)) ? d : null;
    }
    function lapTgl(v) {
        var d = lapToDate(v);
        return d ? d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
    }
    // dd/mm/yyyy — dipakai pada rekap pengiriman
    function lapSlash(v) {
        var d = lapToDate(v);
        if (!d) return '—';
        return String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear();
    }

    // ── Ringkasan pengiriman ──
    var shpNilai = 0, shpQty = 0, shpCost = 0, shpTax = 0;
    var shpInvoices = {}, shpCustomers = {};
    for (var ri = 0; ri < rows.length; ri++) {
        var r0 = rows[ri];
        shpNilai += Number(r0.item_net_value || 0);
        shpQty += Number(r0.billed_qty || 0);
        shpCost += Number(r0.item_cost || 0);
        shpTax += Number(r0.item_tax || 0);
        if (r0.invoice_no) shpInvoices[r0.invoice_no] = 1;
        if (r0.customer_code) shpCustomers[r0.customer_code] = 1;
    }
    var nInvoice = Object.keys(shpInvoices).length;
    var nCustomer = Object.keys(shpCustomers).length;
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .lap-panel { display: none; }
    .lap-panel.active { display: block; }

    .lap-chart { position: relative; width: 100%; }
    .lap-chart canvas { width: 100% !important; }
    .lap-chart-lg { height: 320px; }
    .lap-chart-sm { height: 160px; }

    .lap-branch-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
        gap: var(--oct-gap);
    }

    .lap-branch-id { display: flex; align-items: center; gap: 0.6875rem; min-width: 0; }

    .lap-branch-name {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 0.9375rem;
        letter-spacing: -0.02em;
        color: var(--oct-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .lap-branch-fig { text-align: right; line-height: 1.3; margin-left: auto; }

    .lap-amount {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 1.0625rem;
        letter-spacing: -0.035em;
        font-variant-numeric: tabular-nums;
        color: var(--oct-text);
    }

    /* Peringkat cabang — warna mengikuti seri grafik */
    .lap-rank {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 0.8125rem;
        color: var(--oct-on-primary);
        background: var(--oct-series-1);
        flex-shrink: 0;
    }

    .lap-rank-s2 { background: var(--oct-series-2); }
    .lap-rank-s3 { background: var(--oct-series-3); }
    .lap-rank-s4 { background: var(--oct-series-4); }
    .lap-rank-s5 { background: var(--oct-series-5); }

    .lap-sec-title {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-family: 'Inter', sans-serif;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--oct-text-muted);
        margin: 0 0 0.625rem;
    }

    .lap-sec-title-gap { margin-top: 1.125rem; }
    .lap-mini-empty { text-align: left; font-size: 0.75rem; margin: 0 0 0.5rem; }

    @media (max-width: 960px) {
        .lap-branch-grid { grid-template-columns: minmax(0, 1fr); }
    }

    @media (max-width: 575px) {
        .lap-branch-fig { text-align: left; margin-left: 0; }
        .lap-chart-lg { height: 260px; }
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Laporan</h1>
        <p class="oct-page-sub">Pendapatan tiap cabang dan rekap seluruh transaksi pengiriman, dalam satu halaman.</p>
    </div>
    <div class="oct-page-actions">
        <div class="oct-seg" id="lapTabs" role="tablist" aria-label="Pilih jenis laporan">
            <button type="button" role="tab" id="lapTabPenjualan" class="oct-seg-item lap-tabbtn active"
                    data-tab="penjualan" aria-selected="true" aria-controls="tab-penjualan"
                    onclick="switchTab('penjualan')">
                <i class="fas fa-store"></i>Penjualan
            </button>
            <button type="button" role="tab" id="lapTabPengiriman" class="oct-seg-item lap-tabbtn"
                    data-tab="pengiriman" aria-selected="false" aria-controls="tab-pengiriman"
                    onclick="switchTab('pengiriman')">
                <i class="fas fa-truck-fast"></i>Pengiriman
            </button>
        </div>
    </div>
</div>

<!-- ═══════════ TAB: PENJUALAN ═══════════ -->
<div id="tab-penjualan" class="lap-panel active" role="tabpanel" aria-labelledby="lapTabPenjualan">

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid" id="salesSummary">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-store"></i></span>
                    <span class="oct-kpi-label">Cabang terhitung</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value" id="sumCabang"><%= lapNum(sumSales.totalCabang) %></span>
                    <span class="oct-kpi-note">punya transaksi</span>
                </div>
                <div class="oct-kpi-foot">Angka menyesuaikan filter cabang</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-coins"></i></span>
                    <span class="oct-kpi-label">Total pendapatan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm" id="sumPendapatan"><%= lapRp(sumSales.totalPendapatan) %></span>
                </div>
                <div class="oct-kpi-foot">Penjualan kasir dan pesanan yang disetujui</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-receipt"></i></span>
                    <span class="oct-kpi-label">Total transaksi</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value" id="sumTransaksi"><%= lapNum(sumSales.totalTransaksi) %></span>
                    <span class="oct-kpi-note">nota</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-boxes-stacked"></i></span>
                    <span class="oct-kpi-label">Item terjual</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value" id="sumItem"><%= lapNum(sumSales.totalItemTerjual) %></span>
                    <span class="oct-kpi-note">unit</span>
                </div>
            </div>
        </div>
    </div>

    <% if (branchList.length === 0) { %>
        <div class="oct-card">
            <div class="oct-empty">
                <div class="oct-empty-icon"><i class="fas fa-chart-simple"></i></div>
                <h2 class="oct-empty-title">Belum ada data penjualan</h2>
                <p class="oct-empty-text">Begitu cabang mencatat penjualan atau pesanannya disetujui pusat, ringkasan pendapatan per cabang akan muncul di sini.</p>
            </div>
        </div>
    <% } else { %>

    <!-- Penyaring cabang -->
    <div class="oct-panel mb-3">
        <div class="oct-row">
            <div class="oct-search">
                <i class="fas fa-magnifying-glass"></i>
                <label class="oct-sr" for="cariCabang">Cari cabang</label>
                <input type="text" id="cariCabang" placeholder="Cari nama cabang atau kota…" autocomplete="off">
            </div>
            <span class="oct-spacer"></span>
            <div class="oct-seg" id="lapCabangSeg" role="group" aria-label="Saring berdasarkan cabang">
                <button type="button" class="oct-seg-item filter-cabang active" data-cabang="all" aria-pressed="true">
                    Semua<span class="oct-seg-count"><%= branchList.length %></span>
                </button>
                <% for (var fb = 0; fb < branchList.length; fb++) { var bf = branchList[fb]; %>
                    <button type="button" class="oct-seg-item filter-cabang" data-cabang="<%= bf.cabang_id %>" aria-pressed="false">
                        <%= bf.nama_cabang || bf.username || '—' %>
                    </button>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Tren pendapatan per cabang -->
    <section class="oct-card mb-3">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Tren pendapatan per cabang</h2>
                <p class="oct-card-sub">Perbandingan total pendapatan seluruh cabang yang tercatat.</p>
            </div>
            <span class="oct-chip"><i class="fas fa-circle-info"></i> Nilai dalam rupiah</span>
        </div>
        <div class="oct-card-body">
            <div class="lap-chart lap-chart-lg">
                <canvas id="overviewChart" role="img" aria-label="Grafik perbandingan total pendapatan antar cabang"></canvas>
            </div>
        </div>
    </section>

    <!-- Rincian per cabang -->
    <div class="lap-branch-grid" id="lapBranchGrid">
        <% for (var bi = 0; bi < branchList.length; bi++) {
            var b = branchList[bi];
            var bNama = b.nama_cabang || b.username || '—';
            var bMonthly = Array.isArray(b.monthly) ? b.monthly : [];
            var bRecent = Array.isArray(b.recentSales) ? b.recentSales : [];
            var bCari = (bNama + ' ' + (b.username || '') + ' ' + (b.kota || '') + ' ' + (b.provinsi || '')).toLowerCase();
        %>
        <section class="oct-card branch-card oct-rise"
                 data-cabang-id="<%= b.cabang_id %>"
                 data-pendapatan="<%= Number(b.totalPendapatan || 0) %>"
                 data-transaksi="<%= Number(b.totalTransaksi || 0) %>"
                 data-item="<%= Number(b.totalItemTerjual || 0) %>"
                 data-search="<%= bCari %>">
            <div class="oct-card-head">
                <div class="lap-branch-id">
                    <span class="lap-rank lap-rank-s<%= (bi % 5) + 1 %>"><%= bi + 1 %></span>
                    <span class="oct-cell-stack">
                        <span class="lap-branch-name"><%= bNama %></span>
                        <span class="oct-cell-sub">
                            <% if (b.kota) { %>
                                <i class="fas fa-location-dot"></i> <%= b.kota %><% if (b.provinsi) { %>, <%= b.provinsi %><% } %>
                            <% } else { %>
                                <%= b.username || '—' %>
                            <% } %>
                        </span>
                    </span>
                </div>
                <div class="lap-branch-fig">
                    <div class="lap-amount"><%= lapRp(b.totalPendapatan) %></div>
                    <div class="oct-card-sub"><%= lapNum(b.totalTransaksi) %> transaksi &middot; <%= lapNum(b.totalItemTerjual) %> item</div>
                </div>
            </div>

            <div class="oct-card-body">
                <% if (bMonthly.length > 0) { %>
                    <h3 class="lap-sec-title"><i class="fas fa-chart-line"></i> Pendapatan per hari</h3>
                    <div class="lap-chart lap-chart-sm">
                        <canvas id="branchChart<%= bi %>" role="img" aria-label="Grafik pendapatan harian cabang <%= bNama %>"></canvas>
                    </div>
                <% } else { %>
                    <h3 class="lap-sec-title"><i class="fas fa-chart-line"></i> Pendapatan per hari</h3>
                    <p class="oct-empty-text lap-mini-empty">Belum ada data harian untuk cabang ini.</p>
                <% } %>

                <h3 class="lap-sec-title lap-sec-title-gap"><i class="fas fa-receipt"></i> Transaksi terakhir</h3>

                <div class="oct-tablewrap oct-tablewrap-card">
                    <table class="oct-table oct-table-sm oct-table-nested">
                        <thead>
                            <tr>
                                <th>Kode</th>
                                <th class="col-fit">Sumber</th>
                                <th class="num">Item</th>
                                <th class="num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (bRecent.length === 0) { %>
                                <tr><td colspan="4" class="oct-td-muted text-center" style="padding:1.5rem;">Belum ada transaksi tercatat.</td></tr>
                            <% } %>
                            <% for (var si = 0; si < bRecent.length; si++) { var s = bRecent[si]; %>
                            <tr>
                                <td>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main oct-mono"><%= s.kode_penjualan || '—' %></span>
                                        <span class="oct-cell-sub"><%= lapTgl(s.createdAt) %></span>
                                    </span>
                                </td>
                                <td class="col-fit">
                                    <% if (s.source === 'order') { %>
                                        <span class="oct-chip"><i class="fas fa-file-invoice"></i> Pesanan</span>
                                    <% } else if (s.source === 'pos') { %>
                                        <span class="oct-chip"><i class="fas fa-cash-register"></i> Kasir</span>
                                    <% } else { %>
                                        <span class="oct-td-muted">—</span>
                                    <% } %>
                                </td>
                                <td class="num"><%= lapNum(s.jumlah_item) %></td>
                                <td class="num oct-td-strong"><%= lapRp(s.total_harga) %></td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        <% } %>
    </div>

    <div class="oct-card" id="lapBranchEmpty" hidden>
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-store-slash"></i></div>
            <h2 class="oct-empty-title">Tidak ada cabang yang cocok</h2>
            <p class="oct-empty-text">Ubah kata kunci pencarian atau pilih Semua pada penyaring cabang.</p>
        </div>
    </div>
    <% } %>
</div>

<!-- ═══════════ TAB: PENGIRIMAN ═══════════ -->
<div id="tab-pengiriman" class="lap-panel" role="tabpanel" aria-labelledby="lapTabPengiriman">

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-truck-fast"></i></span>
                    <span class="oct-kpi-label">Nilai pengiriman</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm"><%= lapRp(shpNilai) %></span>
                </div>
                <div class="oct-kpi-foot">Pajak <%= lapRp(shpTax) %> &middot; biaya <%= lapRp(shpCost) %></div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-file-invoice"></i></span>
                    <span class="oct-kpi-label">Jumlah invoice</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= lapNum(nInvoice) %></span>
                    <span class="oct-kpi-note"><%= lapNum(rows.length) %> baris</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-box"></i></span>
                    <span class="oct-kpi-label">Item dikirim</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= lapNum(shpQty) %></span>
                    <span class="oct-kpi-note">unit</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-users"></i></span>
                    <span class="oct-kpi-label">Penerima unik</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= lapNum(nCustomer) %></span>
                    <span class="oct-kpi-note">cabang</span>
                </div>
            </div>
        </div>
    </div>

    <% if (rows.length === 0) { %>
        <div class="oct-card">
            <div class="oct-empty">
                <div class="oct-empty-icon"><i class="fas fa-truck-fast"></i></div>
                <h2 class="oct-empty-title">Belum ada data pengiriman</h2>
                <p class="oct-empty-text">Setiap surat jalan yang dibuat gudang akan terekap di sini beserta nilai, pajak, dan nomor PO-nya.</p>
            </div>
        </div>
    <% } else { %>

    <section class="oct-card mb-3">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Grafik pendapatan pengiriman</h2>
                <p class="oct-card-sub">Nilai barang yang dikirim, dikelompokkan per tanggal invoice.</p>
            </div>
            <span class="oct-chip"><i class="fas fa-calendar-day"></i> Per hari</span>
        </div>
        <div class="oct-card-body">
            <div class="lap-chart lap-chart-lg">
                <canvas id="shipmentChart" role="img" aria-label="Grafik nilai pengiriman per hari"></canvas>
            </div>
            <p class="oct-empty-text lap-mini-empty mt-2" id="shipmentChartEmpty" hidden>Tanggal invoice belum tersedia, grafik tidak dapat ditampilkan.</p>
        </div>
    </section>

    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Rekap transaksi pengiriman</h2>
                <p class="oct-card-sub"><%= lapNum(rows.length) %> baris barang dari <%= lapNum(nInvoice) %> invoice.</p>
            </div>
            <div class="oct-row">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="shipmentSearch">Cari transaksi pengiriman</label>
                    <input type="text" id="shipmentSearch" placeholder="Cari resi, PO, atau produk…" autocomplete="off">
                </div>
                <button type="button" id="btnDownloadExcel" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-file-excel mr-1"></i>Unduh Excel
                </button>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="shipmentTable">
                    <thead>
                        <tr>
                            <th>Invoice No.</th>
                            <th class="col-fit">Invoice Date</th>
                            <th>Delivery Note</th>
                            <th>Customer code</th>
                            <th>Customer name</th>
                            <th>PO number</th>
                            <th class="col-fit">PO Date</th>
                            <th>Material No.</th>
                            <th>Material description</th>
                            <th class="col-fit">Division</th>
                            <th class="num">Billed qty</th>
                            <th class="num">Net value</th>
                            <th class="num">Cost</th>
                            <th class="num">Tax</th>
                            <th>SO number</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (rows.length === 0) { %>
                            <tr><td colspan="15" class="oct-td-muted text-center" style="padding:1.5rem;">Belum ada data pengiriman.</td></tr>
                        <% } %>
                        <% for (var rr = 0; rr < rows.length; rr++) { var r = rows[rr]; %>
                        <tr>
                            <td class="oct-mono"><%= r.invoice_no || '—' %></td>
                            <td class="col-fit"><%= lapSlash(r.invoice_date) %></td>
                            <td class="oct-mono oct-td-muted"><%= r.delivery_note || '—' %></td>
                            <td class="oct-td-muted"><%= r.customer_code || '—' %></td>
                            <td><%= r.customer_name || '—' %></td>
                            <td class="oct-mono"><%= r.po_number || '—' %></td>
                            <td class="col-fit"><%= lapSlash(r.po_date) %></td>
                            <td class="oct-mono"><%= r.material_no || '—' %></td>
                            <td><%= r.material_desc || '—' %></td>
                            <td class="col-fit oct-td-muted"><%= r.material_div || '—' %></td>
                            <td class="num oct-td-strong"><%= Number(r.billed_qty || 0) %></td>
                            <td class="num"><%= Number(r.item_net_value || 0) %></td>
                            <td class="num"><%= Number(r.item_cost || 0) %></td>
                            <td class="num"><%= Number(r.item_tax || 0) %></td>
                            <td class="oct-mono oct-td-muted"><%= r.so_number || '—' %></td>
                        </tr>
                        <% } %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="oct-td-muted">Total</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="num" id="shpTotQty"><%= lapNum(shpQty) %></td>
                            <td class="num" id="shpTotNilai"><%= lapNum(shpNilai) %></td>
                            <td class="num" id="shpTotCost"><%= lapNum(shpCost) %></td>
                            <td class="num" id="shpTotTax"><%= lapNum(shpTax) %></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </section>
    <% } %>
</div>

<!-- DataTables + Excel Export -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap4.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    (function () {
        /* ── Warna diambil dari token desain, bukan hex di view ── */
        var ROOT_CSS = getComputedStyle(document.documentElement);
        function tok(name) { return (ROOT_CSS.getPropertyValue(name) || '').trim(); }
        function alpha(color, a) {
            var c = String(color || '').trim();
            if (c.charAt(0) === '#') {
                if (c.length === 4) c = '#' + c[1] + c[1] + c[2] + c[2] + c[3] + c[3];
                var v = parseInt(c.slice(1, 7), 16);
                if (!isNaN(v)) return 'rgba(' + ((v >> 16) & 255) + ',' + ((v >> 8) & 255) + ',' + (v & 255) + ',' + a + ')';
            }
            return c;
        }

        var PALETTE = ['--oct-series-1', '--oct-series-2', '--oct-series-3', '--oct-series-4', '--oct-series-5'].map(tok);
        var C_TEXT = tok('--oct-text');
        var C_TEXT2 = tok('--oct-text-2');
        var C_MUTED = tok('--oct-text-muted');
        var C_BORDER = tok('--oct-border');
        var C_CARD = tok('--oct-card');
        var GRID = alpha(C_BORDER, 0.7);
        var DIM = alpha(C_MUTED, 0.3);

        /* ── Format rupiah ringkas untuk sumbu grafik ── */
        function fmtRp(v) {
            var n = Number(v) || 0;
            var abs = Math.abs(n);
            if (abs >= 1e9) return 'Rp ' + (n / 1e9).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + ' M';
            if (abs >= 1e6) return 'Rp ' + (n / 1e6).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + ' jt';
            if (abs >= 1e3) return 'Rp ' + (n / 1e3).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + ' rb';
            return 'Rp ' + n.toLocaleString('id-ID');
        }

        var tooltipStyle = {
            backgroundColor: C_CARD,
            titleColor: C_TEXT,
            bodyColor: C_TEXT2,
            borderColor: C_BORDER,
            borderWidth: 1,
            cornerRadius: 10,
            padding: 12,
            titleFont: { family: 'Plus Jakarta Sans', weight: '600', size: 13 },
            bodyFont: { family: 'Plus Jakarta Sans', weight: '500', size: 12 },
            displayColors: false
        };

        /* ═══════════ Pindah tab ═══════════ */
        window.switchTab = function (name) {
            document.querySelectorAll('.lap-panel').forEach(function (el) { el.classList.remove('active'); });
            document.querySelectorAll('.lap-tabbtn').forEach(function (el) {
                var on = el.getAttribute('data-tab') === name;
                el.classList.toggle('active', on);
                el.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            var panel = document.getElementById('tab-' + name);
            if (panel) panel.classList.add('active');

            // Grafik & tabel butuh diukur ulang setelah panelnya terlihat
            if (name === 'pengiriman') {
                setTimeout(function () {
                    if (window.shipmentChartInstance) window.shipmentChartInstance.resize();
                    if (window.shipmentDataTable) window.shipmentDataTable.columns.adjust();
                }, 50);
            }
        };

        document.addEventListener('DOMContentLoaded', function () {
            /* ═══════════════════════════════════════════
               PENJUALAN: grafik perbandingan antar cabang
               ═══════════════════════════════════════════ */
            var branchesData = <%- JSON.stringify(branchList.map(function (b) { return {
                nama: b.nama_cabang || b.username || '-',
                pendapatan: Number(b.totalPendapatan || 0),
                transaksi: Number(b.totalTransaksi || 0),
                item: Number(b.totalItemTerjual || 0)
            }; })).replace(/</g, '\\u003c') %>;

            var overviewCtx = document.getElementById('overviewChart');
            if (overviewCtx && branchesData.length > 0) {
                var mainColor = PALETTE[0];
                var ovGrad = overviewCtx.getContext('2d').createLinearGradient(0, 0, 0, 320);
                ovGrad.addColorStop(0, alpha(mainColor, 0.22));
                ovGrad.addColorStop(1, alpha(mainColor, 0.02));

                window.overviewChartInstance = new Chart(overviewCtx, {
                    type: 'line',
                    data: {
                        labels: branchesData.map(function (d) { return d.nama; }),
                        datasets: [{
                            label: 'Total pendapatan',
                            data: branchesData.map(function (d) { return d.pendapatan; }),
                            backgroundColor: ovGrad,
                            borderColor: mainColor,
                            borderWidth: 2.5,
                            pointBackgroundColor: mainColor,
                            pointBorderColor: C_CARD,
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 8,
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 800, easing: 'easeOutQuart' },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: {
                                    font: { family: 'Plus Jakarta Sans', size: 11, weight: '500' },
                                    color: C_MUTED,
                                    maxRotation: 30
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: GRID, drawBorder: false },
                                ticks: {
                                    font: { family: 'Plus Jakarta Sans', size: 10 },
                                    color: C_MUTED,
                                    callback: function (v) { return fmtRp(v); }
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: Object.assign({}, tooltipStyle, {
                                callbacks: {
                                    title: function (ctx) { return ctx[0].label; },
                                    label: function (ctx) {
                                        return [
                                            'Pendapatan: ' + fmtRp(ctx.parsed.y),
                                            'Transaksi: ' + branchesData[ctx.dataIndex].transaksi,
                                            'Item: ' + branchesData[ctx.dataIndex].item
                                        ];
                                    }
                                }
                            })
                        },
                        interaction: { mode: 'index', intersect: false }
                    }
                });
            }

            /* ═══════════════════════════════════════════
               PENJUALAN: grafik harian tiap cabang
               ═══════════════════════════════════════════ */
            var branchMonthData = <%- JSON.stringify(branchList.map(function (b) { return Array.isArray(b.monthly) ? b.monthly : []; })).replace(/</g, '\\u003c') %>;

            branchMonthData.forEach(function (monthly, i) {
                var canvas = document.getElementById('branchChart' + i);
                if (!canvas || !monthly || monthly.length === 0) return;
                var color = PALETTE[i % PALETTE.length];
                var grad = canvas.getContext('2d').createLinearGradient(0, 0, 0, 160);
                grad.addColorStop(0, alpha(color, 0.2));
                grad.addColorStop(1, alpha(color, 0.02));

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: monthly.map(function (m) { return m.label; }),
                        datasets: [{
                            data: monthly.map(function (m) { return m.total; }),
                            backgroundColor: grad,
                            borderColor: color,
                            borderWidth: 2,
                            pointBackgroundColor: color,
                            pointBorderColor: C_CARD,
                            pointBorderWidth: 1.5,
                            pointRadius: monthly.length > 30 ? 2 : 3.5,
                            pointHoverRadius: monthly.length > 30 ? 5 : 6,
                            tension: 0.35,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 500, easing: 'easeOutQuart' },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: {
                                    font: { family: 'Plus Jakarta Sans', size: 8, weight: '500' },
                                    color: C_MUTED,
                                    maxRotation: 45,
                                    autoSkip: true,
                                    maxTicksLimit: 12
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: GRID, drawBorder: false },
                                ticks: {
                                    font: { family: 'Plus Jakarta Sans', size: 8 },
                                    color: C_MUTED,
                                    callback: function (v) { return fmtRp(v); },
                                    maxTicksLimit: 4
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: Object.assign({}, tooltipStyle, {
                                callbacks: {
                                    title: function (ctx) { return ctx[0].label; },
                                    label: function (ctx) {
                                        return ['Pendapatan: ' + fmtRp(ctx.parsed.y), ctx.raw > 0 ? monthly[ctx.dataIndex].count + ' transaksi' : ''];
                                    }
                                }
                            })
                        }
                    }
                });
            });

            /* ═══════════════════════════════════════════
               PENJUALAN: penyaring cabang + pencarian
               ═══════════════════════════════════════════ */
            var filterBtns = Array.prototype.slice.call(document.querySelectorAll('.filter-cabang'));
            var branchCards = Array.prototype.slice.call(document.querySelectorAll('.branch-card'));
            var cariCabang = document.getElementById('cariCabang');
            var branchEmpty = document.getElementById('lapBranchEmpty');

            function setText(id, value) {
                var el = document.getElementById(id);
                if (el) el.textContent = value;
            }

            function applyBranchFilter() {
                var activeBtn = document.querySelector('.filter-cabang.active');
                var cabangId = activeBtn ? activeBtn.getAttribute('data-cabang') : 'all';
                var q = cariCabang ? cariCabang.value.trim().toLowerCase() : '';
                var totalPendapatan = 0, totalTransaksi = 0, totalItem = 0, visibleCabang = 0;
                var visible = [];

                branchCards.forEach(function (card, i) {
                    var okSeg = (cabangId === 'all' || card.getAttribute('data-cabang-id') === cabangId);
                    var okCari = !q || (card.getAttribute('data-search') || '').indexOf(q) !== -1;
                    var match = okSeg && okCari;
                    visible[i] = match;
                    card.style.display = match ? '' : 'none';
                    if (match) {
                        visibleCabang++;
                        totalPendapatan += Number(card.getAttribute('data-pendapatan')) || 0;
                        totalTransaksi += Number(card.getAttribute('data-transaksi')) || 0;
                        totalItem += Number(card.getAttribute('data-item')) || 0;
                    }
                });

                setText('sumCabang', visibleCabang.toLocaleString('id-ID'));
                setText('sumPendapatan', 'Rp ' + totalPendapatan.toLocaleString('id-ID'));
                setText('sumTransaksi', totalTransaksi.toLocaleString('id-ID'));
                setText('sumItem', totalItem.toLocaleString('id-ID'));
                if (branchEmpty) branchEmpty.hidden = visibleCabang !== 0;

                // Sorot titik cabang yang sedang tampil pada grafik perbandingan
                if (window.overviewChartInstance && branchesData.length > 0) {
                    var ds = window.overviewChartInstance.data.datasets[0];
                    var semua = visible.length === 0 || visible.every(function (v) { return v; });
                    ds.pointBackgroundColor = visible.map(function (v) { return v ? PALETTE[0] : DIM; });
                    ds.pointBorderColor = visible.map(function (v) { return v ? C_CARD : 'transparent'; });
                    ds.pointRadius = visible.map(function (v) { return v ? (semua ? 5 : 8) : 3; });
                    ds.pointHoverRadius = ds.pointRadius.map(function (s) { return s + 3; });
                    window.overviewChartInstance.update();
                }
            }

            filterBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(function (b) {
                        var on = b === btn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-pressed', on ? 'true' : 'false');
                    });
                    applyBranchFilter();
                });
            });

            if (cariCabang) cariCabang.addEventListener('input', applyBranchFilter);

            /* ═══════════════════════════════════════════
               PENGIRIMAN: tabel rekap
               ═══════════════════════════════════════════ */
            if (document.getElementById('shipmentTable')) {
                var dt = $('#shipmentTable').DataTable({
                    pageLength: 50,
                    lengthMenu: [10, 25, 50, 100, 500],
                    order: [[1, 'desc']],
                    dom: "<'row'<'col-sm-12 col-md-4'l><'col-sm-12 col-md-4 text-center'B><'col-sm-12 col-md-4'f>>" +
                         "<'row'<'col-sm-12'tr>>" +
                         "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                    buttons: [{
                        extend: 'excelHtml5',
                        text: 'Unduh Excel',
                        className: 'btn btn-sm btn-outline-primary',
                        title: 'Laporan_Pengiriman_AquaStock'
                    }],
                    language: {
                        search: "Cari:",
                        paginate: { previous: "Sebelumnya", next: "Selanjutnya" },
                        info: "Menampilkan _START_ s/d _END_ dari _TOTAL_ data",
                        lengthMenu: "Tampilkan _MENU_",
                        emptyTable: "Belum ada data pengiriman",
                        zeroRecords: "Tidak ada data yang cocok"
                    }
                });
                window.shipmentDataTable = dt;

                // Pencarian dan tombol unduh sudah disediakan di kepala kartu
                $('#shipmentTable_filter').hide();
                $('#shipmentTable_wrapper .dt-buttons').hide();
                $('#shipmentSearch').on('keyup', function () { dt.search(this.value).draw(); });
                $('#btnDownloadExcel').on('click', function () { dt.button('.buttons-excel').trigger(); });

                // Baris total mengikuti hasil pencarian, bukan seluruh data
                function sumKolom(idx) {
                    return dt.column(idx, { search: 'applied' }).data().toArray()
                        .reduce(function (acc, v) { return acc + (Number(String(v).trim()) || 0); }, 0);
                }
                function segarkanTotal() {
                    setText('shpTotQty', sumKolom(10).toLocaleString('id-ID'));
                    setText('shpTotNilai', sumKolom(11).toLocaleString('id-ID'));
                    setText('shpTotCost', sumKolom(12).toLocaleString('id-ID'));
                    setText('shpTotTax', sumKolom(13).toLocaleString('id-ID'));
                }
                dt.on('draw', segarkanTotal);
                segarkanTotal();
            }

            /* ═══════════════════════════════════════════
               PENGIRIMAN: grafik nilai per hari
               ═══════════════════════════════════════════ */
            var reportData = <%- JSON.stringify(rows).replace(/</g, '\\u003c') %>;
            var groupedData = {};
            reportData.forEach(function (row) {
                if (!row.invoice_date) return;
                var dateObj = new Date(row.invoice_date);
                if (isNaN(dateObj)) return;
                var key = dateObj.getFullYear() + '-' + String(dateObj.getMonth() + 1).padStart(2, '0') + '-' + String(dateObj.getDate()).padStart(2, '0');
                if (!groupedData[key]) groupedData[key] = 0;
                groupedData[key] += Number(row.item_net_value || 0);
            });
            var sortedKeys = Object.keys(groupedData).sort();
            var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
            var labels = sortedKeys.map(function (key) {
                var parts = key.split('-');
                return parseInt(parts[2], 10) + ' ' + monthNames[parseInt(parts[1], 10) - 1] + ' ' + parts[0];
            });
            var dataValues = sortedKeys.map(function (key) { return groupedData[key]; });

            var shipCtx = document.getElementById('shipmentChart');
            var shipEmpty = document.getElementById('shipmentChartEmpty');

            if (shipCtx && sortedKeys.length > 0) {
                var shipColor = PALETTE[0];
                var shipGrad = shipCtx.getContext('2d').createLinearGradient(0, 0, 0, 320);
                shipGrad.addColorStop(0, alpha(shipColor, 0.25));
                shipGrad.addColorStop(1, alpha(shipColor, 0.02));

                var isDense = sortedKeys.length > 30;

                window.shipmentChartInstance = new Chart(shipCtx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Pendapatan (Rp)',
                            data: dataValues,
                            backgroundColor: shipGrad,
                            borderColor: shipColor,
                            borderWidth: 2.5,
                            pointBackgroundColor: shipColor,
                            pointBorderColor: C_CARD,
                            pointBorderWidth: 2,
                            pointRadius: isDense ? 2 : 5,
                            pointHoverRadius: isDense ? 5 : 8,
                            tension: isDense ? 0.3 : 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 800, easing: 'easeOutQuart' },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: {
                                    font: { family: 'Plus Jakarta Sans', size: 10, weight: '500' },
                                    color: C_MUTED,
                                    maxRotation: 45,
                                    autoSkip: true,
                                    maxTicksLimit: 14
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: GRID, drawBorder: false },
                                ticks: {
                                    font: { family: 'Plus Jakarta Sans', size: 10 },
                                    color: C_MUTED,
                                    callback: function (v) { return fmtRp(v); }
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: Object.assign({}, tooltipStyle, {
                                callbacks: {
                                    title: function (ctx) { return 'Periode ' + ctx[0].label; },
                                    label: function (ctx) { return 'Pendapatan: Rp ' + ctx.parsed.y.toLocaleString('id-ID'); }
                                }
                            })
                        },
                        interaction: { mode: 'index', intersect: false }
                    }
                });
            } else if (shipCtx) {
                // Tidak ada tanggal invoice yang bisa dipetakan
                shipCtx.hidden = true;
                if (shipEmpty) shipEmpty.hidden = false;
            }
        });
    })();
</script>
