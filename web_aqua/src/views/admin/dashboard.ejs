<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

    /* ============================================
       OCTAVIA DESIGN SYSTEM
       Light, friendly, structured — blue primary
       with pastel accents & progress ring signature
       ============================================ */

    :root {
        /* Primary palette */
        --oct-primary: #3B82F6;
        --oct-primary-dark: #2563EB;
        --oct-primary-light: #93C5FD;
        --oct-primary-bg: #EFF6FF;

        /* Accents */
        --oct-accent-green: #4ADE80;
        --oct-accent-green-dark: #16A34A;
        --oct-accent-yellow: #FBBF24;
        --oct-accent-yellow-dark: #D97706;
        --oct-accent-pink: #F472B6;
        --oct-accent-pink-dark: #DB2777;
        --oct-accent-indigo: #6366F1;

        /* Surfaces */
        --oct-bg: #F5F7FA;
        --oct-card: #FFFFFF;
        --oct-card-hover: #FAFBFC;

        /* Text */
        --oct-text: #1E293B;
        --oct-text-2: #64748B;
        --oct-text-muted: #94A3B8;

        /* Borders & shadows */
        --oct-border: #E2E8F0;
        --oct-border-light: #F1F5F9;
        --oct-shadow-sm: 0 2px 12px rgba(0, 0, 0, 0.06);
        --oct-shadow-md: 0 8px 24px rgba(0, 0, 0, 0.12);
        --oct-shadow-lift: 0 12px 32px rgba(0, 0, 0, 0.1);
    }

    .theme-dark {
        --oct-bg: #0F172A;
        --oct-card: #1E293B;
        --oct-card-hover: #253349;
        --oct-text: #F1F5F9;
        --oct-text-2: #CBD5E1;
        --oct-text-muted: #64748B;
        --oct-border: #334155;
        --oct-border-light: #1E293B;
        --oct-primary-bg: rgba(59, 130, 246, 0.1);
        --oct-shadow-sm: 0 2px 12px rgba(0, 0, 0, 0.2);
        --oct-shadow-md: 0 8px 24px rgba(0, 0, 0, 0.3);
        --oct-shadow-lift: 0 12px 32px rgba(0, 0, 0, 0.35);
    }

    /* ── Dashboard Shell ── */
    .oct-dashboard {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--oct-bg);
        color: var(--oct-text);
        padding: 2rem 0 3rem;
        min-height: calc(100vh - 200px);
    }

    /* ── Hero Section ── */
    .oct-hero {
        margin-bottom: 2rem;
    }

    .oct-hero-emoji {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 0.75rem;
        animation: oct-wave 2s ease-in-out infinite;
        animation-play-state: paused;
    }

    .oct-hero:hover .oct-hero-emoji {
        animation-play-state: running;
    }

    @keyframes oct-wave {
        0%, 100% { transform: rotate(0deg); }
        15% { transform: rotate(14deg); }
        30% { transform: rotate(-8deg); }
        45% { transform: rotate(14deg); }
        60% { transform: rotate(-4deg); }
        75% { transform: rotate(10deg); }
    }

    .oct-hero-title {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        font-weight: 700;
        line-height: 1.2;
        color: var(--oct-text);
        margin: 0 0 0.5rem;
        letter-spacing: -0.01em;
    }

    .oct-hero-subtitle {
        font-size: 0.9375rem;
        color: var(--oct-text-2);
        font-weight: 400;
        max-width: 480px;
        margin: 0;
        line-height: 1.6;
    }

    .oct-hero-greeting {
        display: inline-block;
        font-family: 'Poppins', sans-serif;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--oct-primary);
        background: var(--oct-primary-bg);
        padding: 0.375rem 0.875rem;
        border-radius: 50rem;
        margin-bottom: 1rem;
        letter-spacing: 0.02em;
    }

    /* ── Stats Grid ── */
    .oct-stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    /* ── Stat Card ── */
    .oct-stat-card {
        background: var(--oct-card);
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: var(--oct-shadow-sm);
        border: 1px solid var(--oct-border-light);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        position: relative;
        overflow: hidden;
    }

    .oct-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--oct-shadow-lift);
    }

    .oct-stat-card::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 80px;
        height: 80px;
        border-radius: 0 16px 0 80px;
        opacity: 0.08;
        transition: opacity 0.25s ease;
    }

    .oct-stat-card:hover::after {
        opacity: 0.14;
    }

    .oct-stat-card--blue::after { background: var(--oct-primary); }
    .oct-stat-card--green::after { background: var(--oct-accent-green); }
    .oct-stat-card--yellow::after { background: var(--oct-accent-yellow); }
    .oct-stat-card--pink::after { background: var(--oct-accent-pink); }
    .oct-stat-card--indigo::after { background: var(--oct-accent-indigo); }

    .oct-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        margin-bottom: 1rem;
        color: #fff;
    }

    .oct-stat-icon--blue { background: linear-gradient(135deg, #3B82F6, #60A5FA); }
    .oct-stat-icon--green { background: linear-gradient(135deg, #4ADE80, #22C55E); }
    .oct-stat-icon--yellow { background: linear-gradient(135deg, #FBBF24, #F59E0B); }
    .oct-stat-icon--pink { background: linear-gradient(135deg, #F472B6, #EC4899); }
    .oct-stat-icon--indigo { background: linear-gradient(135deg, #6366F1, #818CF8); }

    .oct-stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--oct-text-muted);
        margin-bottom: 0.375rem;
    }

    .oct-stat-value {
        font-family: 'Poppins', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: var(--oct-text);
        line-height: 1;
        letter-spacing: -0.02em;
    }

    /* ── Progress Rings Section ── */
    .oct-rings-card {
        background: var(--oct-card);
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: var(--oct-shadow-sm);
        border: 1px solid var(--oct-border-light);
        margin-bottom: 1.5rem;
    }

    .oct-rings-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--oct-text);
        margin: 0 0 1.25rem;
    }

    .oct-rings-grid {
        display: flex;
        justify-content: space-around;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .oct-ring-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.625rem;
    }

    .oct-ring-svg {
        width: 90px;
        height: 90px;
        transform: rotate(-90deg);
    }

    .oct-ring-bg {
        fill: none;
        stroke: var(--oct-border);
        stroke-width: 8;
    }

    .oct-ring-fill {
        fill: none;
        stroke-width: 8;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .oct-ring-pct {
        font-family: 'Poppins', sans-serif;
        font-size: 0.875rem;
        font-weight: 700;
        fill: var(--oct-text);
        text-anchor: middle;
        dominant-baseline: central;
        /* counter-rotate so text is upright */
        transform: rotate(90deg);
        transform-origin: center;
    }

    .oct-ring-label {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--oct-text);
        text-align: center;
    }

    .oct-ring-sublabel {
        font-size: 0.6875rem;
        font-weight: 400;
        color: var(--oct-text-muted);
        text-align: center;
    }

    /* ── Action Buttons ── */
    .oct-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .oct-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
    }

    .oct-btn-primary {
        background: var(--oct-primary);
        color: #fff;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
    }

    .oct-btn-primary:hover {
        background: var(--oct-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(59, 130, 246, 0.35);
        color: #fff;
        text-decoration: none;
    }

    .oct-btn-outline {
        background: transparent;
        color: var(--oct-text-2);
        border: 1.5px solid var(--oct-border);
    }

    .oct-btn-outline:hover {
        border-color: var(--oct-primary);
        color: var(--oct-primary);
        background: var(--oct-primary-bg);
        text-decoration: none;
    }

    .oct-btn i {
        font-size: 1rem;
    }

    /* ── Table Card ── */
    .oct-table-card {
        background: var(--oct-card);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--oct-shadow-sm);
        border: 1px solid var(--oct-border-light);
        margin-bottom: 1.5rem;
    }

    .oct-table-title-bar {
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.625rem;
        border-bottom: 1px solid var(--oct-border-light);
    }

    .oct-table-title-bar i {
        color: var(--oct-primary);
        font-size: 1.125rem;
    }

    .oct-table-title-bar h3 {
        font-family: 'Poppins', sans-serif;
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--oct-text);
    }

    .oct-table-wrap {
        overflow-x: auto;
    }

    .oct-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .oct-table thead th {
        background: var(--oct-bg);
        color: var(--oct-text-muted);
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        padding: 0.875rem 1.25rem;
        border-bottom: 1px solid var(--oct-border);
        text-align: left;
    }

    .oct-table tbody tr {
        transition: background 0.15s ease;
    }

    .oct-table tbody tr:hover {
        background: var(--oct-card-hover);
    }

    .oct-table tbody tr:last-child td {
        border-bottom: none;
    }

    .oct-table td {
        padding: 0.875rem 1.25rem;
        border-bottom: 1px solid var(--oct-border-light);
        color: var(--oct-text);
        font-size: 0.875rem;
    }

    .oct-table td strong {
        font-weight: 600;
        color: var(--oct-text);
    }

    .oct-sku {
        display: inline-block;
        background: var(--oct-bg);
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.75rem;
        color: var(--oct-text-2);
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        letter-spacing: 0.02em;
    }

    .oct-stock-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.3rem 0.75rem;
        border-radius: 50rem;
        font-weight: 600;
        font-size: 0.8125rem;
    }

    .oct-stock-pill--ok {
        background: rgba(74, 222, 128, 0.12);
        color: var(--oct-accent-green-dark);
    }

    .oct-stock-pill--low {
        background: rgba(251, 191, 36, 0.12);
        color: var(--oct-accent-yellow-dark);
    }

    .oct-stock-pill--critical {
        background: rgba(244, 114, 182, 0.12);
        color: var(--oct-accent-pink-dark);
    }

    .oct-empty {
        text-align: center;
        padding: 2.5rem 1.5rem;
        color: var(--oct-text-muted);
    }

    .oct-empty i {
        font-size: 2rem;
        margin-bottom: 0.75rem;
        opacity: 0.35;
        display: block;
    }

    .oct-empty span {
        font-size: 0.875rem;
    }

    /* ── Profile Card ── */
    .oct-profile-card {
        background: var(--oct-card);
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: var(--oct-shadow-sm);
        border: 1px solid var(--oct-border-light);
    }

    .oct-profile-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--oct-border-light);
    }

    .oct-profile-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--oct-primary), var(--oct-accent-indigo));
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 1.125rem;
        flex-shrink: 0;
    }

    .oct-profile-name {
        font-family: 'Poppins', sans-serif;
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--oct-text);
        margin: 0;
    }

    .oct-profile-role {
        font-size: 0.8125rem;
        color: var(--oct-text-muted);
        text-transform: capitalize;
    }

    .oct-profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.875rem;
    }

    .oct-profile-field {
        padding: 0.875rem 1rem;
        background: var(--oct-bg);
        border-radius: 12px;
        border: 1px solid var(--oct-border-light);
        transition: border-color 0.2s ease;
    }

    .oct-profile-field:hover {
        border-color: var(--oct-primary-light);
    }

    .oct-profile-field.full-width {
        grid-column: 1 / -1;
    }

    .oct-field-label {
        font-size: 0.6875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--oct-primary);
        margin-bottom: 0.25rem;
    }

    .oct-field-value {
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--oct-text);
    }

    /* ── Entrance Animation ── */
    .oct-fade-up {
        opacity: 0;
        transform: translateY(16px);
    }

    .oct-fade-up.oct-visible {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.5s cubic-bezier(0, 0, 0.2, 1),
                    transform 0.5s cubic-bezier(0, 0, 0.2, 1);
    }

    /* ── Responsive ── */
    @media (max-width: 767px) {
        .oct-stats-row {
            grid-template-columns: 1fr;
        }

        .oct-hero-title {
            font-size: 1.5rem;
        }

        .oct-profile-grid {
            grid-template-columns: 1fr;
        }

        .oct-actions {
            flex-direction: column;
        }

        .oct-btn {
            width: 100%;
            justify-content: center;
        }

        .oct-rings-grid {
            gap: 1rem;
        }

        .oct-ring-svg {
            width: 72px;
            height: 72px;
        }
    }

    @media (min-width: 768px) and (max-width: 991px) {
        .oct-stats-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* ── Reduced Motion ── */
    @media (prefers-reduced-motion: reduce) {
        .oct-hero-emoji { animation: none; }
        .oct-stat-card,
        .oct-btn,
        .oct-profile-field { transition: none; }
        .oct-fade-up { opacity: 1; transform: none; }
        .oct-ring-fill { transition: none; }
    }
</style>

<div class="oct-dashboard">
    <!-- Hero -->
    <div class="oct-hero oct-fade-up">
        <% if (profile) { %>
            <span class="oct-hero-greeting">
                <i class="fas fa-hand-sparkles" style="margin-right: 0.375rem; font-size: 0.75rem;"></i>
                Halo, <%= profile.username %>!
            </span>
        <% } %>
        <span class="oct-hero-emoji" aria-hidden="true">
            <% if (profile && profile.role === 'admin') { %>&#128202;<% } else if (profile && profile.role === 'cabang') { %>&#127978;<% } else if (profile && profile.role === 'sales') { %>&#128722;<% } else if (profile && profile.role === 'gudang') { %>&#128230;<% } else { %>&#128075;<% } %>
        </span>
        <h1 class="oct-hero-title">
            <% if (profile && profile.role === 'admin') { %>
                Kelola Semua dari Satu Tempat
            <% } else if (profile && profile.role === 'cabang') { %>
                Stok Toko Kamu Hari Ini
            <% } else if (profile && profile.role === 'sales') { %>
                Siap Ambil Pesanan Baru?
            <% } else if (profile && profile.role === 'gudang') { %>
                Kirim Barang Hari Ini
            <% } else { %>
                Dashboard Kamu
            <% } %>
        </h1>
        <p class="oct-hero-subtitle">
            <% if (profile && profile.role === 'admin') { %>
                Pantau pengguna, cabang, dan performa bisnis secara menyeluruh.
            <% } else if (profile && profile.role === 'cabang') { %>
                Lihat ketersediaan stok produk di toko kamu secara real-time.
            <% } else if (profile && profile.role === 'sales') { %>
                Lacak status pesanan dan buat pesanan baru dengan mudah.
            <% } else if (profile && profile.role === 'gudang') { %>
                Kelola pengemasan dan pengiriman pesanan dengan efisien.
            <% } else { %>
                Pantau aktivitas dan performa kamu dari sini.
            <% } %>
        </p>
    </div>

    <% if (profile && profile.role === 'admin') { %>
    <%
        var totalUsers = (counts && counts.total) || 0;
        var adminCount = (counts && counts.admin) || 0;
        var cabangCount = (counts && counts.cabang) || 0;
        var salesCount = (counts && counts.sales) || 0;
        var gudangCount = (counts && counts.gudang) || 0;
        var adminPct = totalUsers > 0 ? Math.round(adminCount / totalUsers * 100) : 0;
        var cabangPct = totalUsers > 0 ? Math.round(cabangCount / totalUsers * 100) : 0;
        var salesPct = totalUsers > 0 ? Math.round((salesCount + gudangCount) / totalUsers * 100) : 0;
    %>
    <!-- Admin Stats -->
    <div class="oct-stats-row">
        <div class="oct-stat-card oct-stat-card--blue oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--blue">
                <i class="fas fa-users"></i>
            </div>
            <div class="oct-stat-label">Total Pengguna</div>
            <div class="oct-stat-value"><%= totalUsers %></div>
        </div>
        <div class="oct-stat-card oct-stat-card--indigo oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--indigo">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="oct-stat-label">Admin</div>
            <div class="oct-stat-value"><%= adminCount %></div>
        </div>
        <div class="oct-stat-card oct-stat-card--green oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--green">
                <i class="fas fa-store-alt"></i>
            </div>
            <div class="oct-stat-label">Cabang</div>
            <div class="oct-stat-value"><%= cabangCount %></div>
        </div>
    </div>

    <!-- Admin Progress Rings -->
    <div class="oct-rings-card oct-fade-up">
        <h3 class="oct-rings-title">Distribusi Pengguna</h3>
        <div class="oct-rings-grid">
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#6366F1"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - adminPct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= adminPct %>%</text>
                </svg>
                <div class="oct-ring-label">Admin</div>
                <div class="oct-ring-sublabel"><%= adminCount %> pengguna</div>
            </div>
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#3B82F6"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - cabangPct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= cabangPct %>%</text>
                </svg>
                <div class="oct-ring-label">Cabang</div>
                <div class="oct-ring-sublabel"><%= cabangCount %> pengguna</div>
            </div>
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#4ADE80"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - salesPct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= salesPct %>%</text>
                </svg>
                <div class="oct-ring-label">Sales & Gudang</div>
                <div class="oct-ring-sublabel"><%= (salesCount + gudangCount) %> pengguna</div>
            </div>
        </div>
    </div>
    <% } else if (profile && profile.role === 'cabang') { %>
    <!-- Cabang Stock Table -->
    <div class="oct-table-card oct-fade-up">
        <div class="oct-table-title-bar">
            <i class="fas fa-boxes-stacked"></i>
            <h3>Stok Tersedia di Toko</h3>
        </div>
        <div class="oct-table-wrap">
            <table class="oct-table">
                <thead>
                    <tr>
                        <th>Nama Produk</th>
                        <th>SKU</th>
                        <th>Stok</th>
                        <th>Satuan</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (branchStocks && branchStocks.length > 0) { %>
                        <% branchStocks.forEach(item => { %>
                            <tr>
                                <td><strong><%= item.nama_produk %></strong></td>
                                <td><span class="oct-sku"><%= item.sku %></span></td>
                                <td>
                                    <span class="oct-stock-pill <%= item.stok_tersedia <= 5 ? 'oct-stock-pill--critical' : item.stok_tersedia <= 20 ? 'oct-stock-pill--low' : 'oct-stock-pill--ok' %>">
                                        <i class="fas fa-cube" style="font-size: 0.65rem;"></i>
                                        <%= item.stok_tersedia %>
                                    </span>
                                </td>
                                <td><%= item.satuan %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="oct-empty">
                                <i class="fas fa-box-open"></i>
                                <span>Belum ada data stok tersedia</span>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <% } else if (profile && profile.role === 'sales') { %>
    <%
        var pending = (salesStats && salesStats.pending) || 0;
        var approved = (salesStats && salesStats.approved) || 0;
        var done = (salesStats && salesStats.rejected) || 0;
        var totalOrders = pending + approved + done;
        var pendingPct = totalOrders > 0 ? Math.round(pending / totalOrders * 100) : 0;
        var approvedPct = totalOrders > 0 ? Math.round(approved / totalOrders * 100) : 0;
        var donePct = totalOrders > 0 ? Math.round(done / totalOrders * 100) : 0;
    %>
    <!-- Sales Stats -->
    <div class="oct-stats-row">
        <div class="oct-stat-card oct-stat-card--yellow oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--yellow">
                <i class="fas fa-clock"></i>
            </div>
            <div class="oct-stat-label">Pending</div>
            <div class="oct-stat-value"><%= pending %></div>
        </div>
        <div class="oct-stat-card oct-stat-card--blue oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--blue">
                <i class="fas fa-sync"></i>
            </div>
            <div class="oct-stat-label">Dalam Proses</div>
            <div class="oct-stat-value"><%= approved %></div>
        </div>
        <div class="oct-stat-card oct-stat-card--green oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="oct-stat-label">Selesai</div>
            <div class="oct-stat-value"><%= done %></div>
        </div>
    </div>

    <!-- Sales Progress Rings -->
    <div class="oct-rings-card oct-fade-up">
        <h3 class="oct-rings-title">Pipeline Pesanan</h3>
        <div class="oct-rings-grid">
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#FBBF24"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - pendingPct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= pendingPct %>%</text>
                </svg>
                <div class="oct-ring-label">Pending</div>
                <div class="oct-ring-sublabel">Menunggu konfirmasi</div>
            </div>
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#3B82F6"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - approvedPct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= approvedPct %>%</text>
                </svg>
                <div class="oct-ring-label">Proses</div>
                <div class="oct-ring-sublabel">Sedang diproses</div>
            </div>
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#4ADE80"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - donePct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= donePct %>%</text>
                </svg>
                <div class="oct-ring-label">Selesai</div>
                <div class="oct-ring-sublabel">Pesanan selesai</div>
            </div>
        </div>
    </div>

    <div class="oct-actions oct-fade-up">
        <a href="/sales/orders" class="oct-btn oct-btn-primary">
            <i class="fas fa-shopping-cart"></i>
            <span>Buat Pesanan</span>
        </a>
    </div>
    <% } else if (profile && profile.role === 'gudang') { %>
    <%
        var ready = (gudangStats && gudangStats.readyToPack) || 0;
        var packed = (gudangStats && gudangStats.packed) || 0;
        var sent = (gudangStats && gudangStats.sent) || 0;
        var totalGudang = ready + packed + sent;
        var readyPct = totalGudang > 0 ? Math.round(ready / totalGudang * 100) : 0;
        var packedPct = totalGudang > 0 ? Math.round(packed / totalGudang * 100) : 0;
        var sentPct = totalGudang > 0 ? Math.round(sent / totalGudang * 100) : 0;
    %>
    <!-- Gudang Stats -->
    <div class="oct-stats-row">
        <div class="oct-stat-card oct-stat-card--blue oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--blue">
                <i class="fas fa-boxes-stacked"></i>
            </div>
            <div class="oct-stat-label">Siap Dikemas</div>
            <div class="oct-stat-value"><%= ready %></div>
        </div>
        <div class="oct-stat-card oct-stat-card--yellow oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--yellow">
                <i class="fas fa-box-open"></i>
            </div>
            <div class="oct-stat-label">Sedang Dikemas</div>
            <div class="oct-stat-value"><%= packed %></div>
        </div>
        <div class="oct-stat-card oct-stat-card--green oct-fade-up">
            <div class="oct-stat-icon oct-stat-icon--green">
                <i class="fas fa-truck"></i>
            </div>
            <div class="oct-stat-label">Dalam Pengiriman</div>
            <div class="oct-stat-value"><%= sent %></div>
        </div>
    </div>

    <!-- Gudang Progress Rings -->
    <div class="oct-rings-card oct-fade-up">
        <h3 class="oct-rings-title">Progress Pengiriman</h3>
        <div class="oct-rings-grid">
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#3B82F6"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - readyPct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= readyPct %>%</text>
                </svg>
                <div class="oct-ring-label">Siap Dikemas</div>
                <div class="oct-ring-sublabel">Menunggu dikemas</div>
            </div>
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#FBBF24"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - packedPct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= packedPct %>%</text>
                </svg>
                <div class="oct-ring-label">Dikemas</div>
                <div class="oct-ring-sublabel">Sedang dikemas</div>
            </div>
            <div class="oct-ring-item">
                <svg class="oct-ring-svg" viewBox="0 0 100 100">
                    <circle class="oct-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="oct-ring-fill" cx="50" cy="50" r="40"
                        stroke="#4ADE80"
                        stroke-dasharray="251.33"
                        stroke-dashoffset="251.33"
                        data-target="<%= 251.33 * (1 - sentPct / 100) %>"/>
                    <text class="oct-ring-pct" x="50" y="50"><%= sentPct %>%</text>
                </svg>
                <div class="oct-ring-label">Terkirim</div>
                <div class="oct-ring-sublabel">Dalam pengiriman</div>
            </div>
        </div>
    </div>

    <div class="oct-actions oct-fade-up">
        <a href="/gudang/orders" class="oct-btn oct-btn-primary">
            <i class="fas fa-boxes-stacked"></i>
            <span>Lihat Pengemasan</span>
        </a>
        <a href="/admin/shipments" class="oct-btn oct-btn-outline">
            <i class="fas fa-truck"></i>
            <span>Pengiriman</span>
        </a>
    </div>
    <% } %>

    <!-- Profile Section -->
    <div class="oct-profile-card oct-fade-up">
        <div class="oct-profile-header">
            <div class="oct-profile-avatar">
                <% if (profile && profile.username) { %><%= profile.username.charAt(0).toUpperCase() %><% } else { %>?<% } %>
            </div>
            <div>
                <h2 class="oct-profile-name"><%= profile ? profile.username : 'Pengguna' %></h2>
                <div class="oct-profile-role"><%= profile ? profile.role : '' %></div>
            </div>
        </div>
        <% if (profile) { %>
            <div class="oct-profile-grid">
                <div class="oct-profile-field">
                    <div class="oct-field-label">ID</div>
                    <div class="oct-field-value"><%= profile.id %></div>
                </div>
                <div class="oct-profile-field">
                    <div class="oct-field-label">Username</div>
                    <div class="oct-field-value"><%= profile.username %></div>
                </div>
                <div class="oct-profile-field">
                    <div class="oct-field-label">Role</div>
                    <div class="oct-field-value" style="text-transform: capitalize;"><%= profile.role %></div>
                </div>
                <div class="oct-profile-field">
                    <div class="oct-field-label">Nama Cabang</div>
                    <div class="oct-field-value"><%= profile.nama_cabang || '-' %></div>
                </div>
                <div class="oct-profile-field">
                    <div class="oct-field-label">Provinsi</div>
                    <div class="oct-field-value"><%= profile.provinsi || '-' %></div>
                </div>
                <div class="oct-profile-field">
                    <div class="oct-field-label">Kota</div>
                    <div class="oct-field-value"><%= profile.kota || '-' %></div>
                </div>
                <div class="oct-profile-field full-width">
                    <div class="oct-field-label">Jalan</div>
                    <div class="oct-field-value"><%= profile.jalan || '-' %></div>
                </div>
            </div>
        <% } else { %>
            <div class="oct-empty">
                <i class="fas fa-user-circle"></i>
                <span>Profil tidak ditemukan.</span>
            </div>
        <% } %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Staggered fade-in
        var items = document.querySelectorAll('.oct-fade-up');
        items.forEach(function(el, i) {
            setTimeout(function() {
                el.classList.add('oct-visible');
            }, 60 + i * 80);
        });

        // Animate progress rings
        setTimeout(function() {
            var rings = document.querySelectorAll('.oct-ring-fill');
            rings.forEach(function(ring) {
                var target = parseFloat(ring.getAttribute('data-target'));
                if (!isNaN(target)) {
                    ring.style.strokeDashoffset = target;
                }
            });
        }, 400);
    });
</script>
