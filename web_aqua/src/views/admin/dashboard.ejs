<%
    /* ── Locals dari routes/dashboard.route.js ──────────────────────────────
       title, user, profile, counts {total, admin, cabang},
       branchStocks[] (khusus cabang), salesStats {pending, approved, rejected},
       gudangStats {readyToPack, packed, sent}
       Semua bisa kosong — setiap pembacaan di bawah ini dijaga. */

    var prof = profile || null;
    var role = (prof && prof.role) ? String(prof.role) : '';

    var cnt = counts || {};
    var sStat = salesStats || {};
    var gStat = gudangStats || {};
    var stocks = Array.isArray(branchStocks) ? branchStocks : [];

    function num(v) { return Number(v || 0); }
    function fmtNum(v) { return num(v).toLocaleString('id-ID'); }
    function rupiah(v) { return 'Rp ' + num(v).toLocaleString('id-ID'); }
    function share(part, whole) { return whole > 0 ? Math.round(part / whole * 100) : 0; }

    // Keliling lingkaran ring: 2 · π · r, dengan r = 40
    var RING_C = 251.33;

    // ── Angka per peran ────────────────────────────────────────────────────
    var totalUsers = num(cnt.total);
    var adminCount = num(cnt.admin);
    var cabangCount = num(cnt.cabang);
    // counts.sales / counts.gudang belum disediakan route — turunkan dari sisa
    var opsCount = (cnt.sales != null || cnt.gudang != null)
        ? (num(cnt.sales) + num(cnt.gudang))
        : Math.max(0, totalUsers - adminCount - cabangCount);

    var sPending = num(sStat.pending);
    var sProses = num(sStat.approved);
    var sSelesai = num(sStat.rejected); // route memakai field ini untuk pesanan selesai
    var sTotal = sPending + sProses + sSelesai;

    var gReady = num(gStat.readyToPack);
    var gPacked = num(gStat.packed);
    var gSent = num(gStat.sent);
    var gTotal = gReady + gPacked + gSent;

    // Rekap stok toko (peran cabang)
    var stokUnit = 0, stokNilai = 0, nKritis = 0, nMenipis = 0, nAman = 0;
    for (var i = 0; i < stocks.length; i++) {
        var q = num(stocks[i].stok_tersedia);
        stokUnit += q;
        stokNilai += q * num(stocks[i].harga_jual);
        if (q <= 5) nKritis++;
        else if (q <= 20) nMenipis++;
        else nAman++;
    }

    var stokBuckets = [
        { key: 'all', label: 'Semua', n: stocks.length },
        { key: 'aman', label: 'Aman', n: nAman },
        { key: 'menipis', label: 'Menipis', n: nMenipis },
        { key: 'kritis', label: 'Kritis', n: nKritis }
    ];

    // ── Judul halaman ──────────────────────────────────────────────────────
    var pageTitle = 'Dashboard';
    var pageSub = 'Ringkasan aktivitas akun Anda.';
    if (role === 'admin') {
        pageTitle = 'Ringkasan platform';
        pageSub = 'Pengguna, cabang, dan jalur distribusi dalam satu tampilan.';
    } else if (role === 'cabang') {
        pageTitle = 'Stok toko';
        pageSub = 'Ketersediaan produk di toko Anda beserta barang yang perlu dipesan ulang.';
    } else if (role === 'sales') {
        pageTitle = 'Pipeline pesanan';
        pageSub = 'Status pesanan yang sedang berjalan dan yang sudah selesai.';
    } else if (role === 'gudang') {
        pageTitle = 'Antrean gudang';
        pageSub = 'Pesanan yang perlu dikemas dan pengiriman yang sedang berjalan.';
    }

    // ── Tombol utama di kepala halaman ─────────────────────────────────────
    var headActions = [];
    if (role === 'admin') {
        headActions = [
            { href: '/admin/orders', icon: 'fa-receipt', label: 'Pesanan cabang', primary: true },
            { href: '/admin/laporan', icon: 'fa-chart-simple', label: 'Laporan', primary: false }
        ];
    } else if (role === 'cabang') {
        headActions = [
            { href: '/cabang/shipments', icon: 'fa-truck-fast', label: 'Pengiriman masuk', primary: true },
            { href: '/cabang/orders', icon: 'fa-receipt', label: 'Pesanan saya', primary: false }
        ];
    } else if (role === 'sales') {
        headActions = [
            { href: '/sales/orders', icon: 'fa-receipt', label: 'Pesanan cabang', primary: true },
            { href: '/sales/report', icon: 'fa-chart-simple', label: 'Laporan penjualan', primary: false }
        ];
    } else if (role === 'gudang') {
        headActions = [
            { href: '/gudang/orders', icon: 'fa-boxes-stacked', label: 'Lihat pengemasan', primary: true },
            { href: '/admin/shipments', icon: 'fa-truck-fast', label: 'Pengiriman', primary: false }
        ];
    }

    // ── Ring komposisi + pintasan ──────────────────────────────────────────
    var rings = [], distTitle = '', distSub = '', distTotal = 0, distEmpty = '';
    var shortcuts = [];

    if (role === 'admin') {
        distTitle = 'Distribusi pengguna';
        distSub = 'Porsi tiap peran terhadap seluruh akun terdaftar.';
        distTotal = totalUsers;
        distEmpty = 'Belum ada akun yang terdaftar pada sistem.';
        rings = [
            { label: 'Admin', sub: fmtNum(adminCount) + ' pengguna', pct: share(adminCount, totalUsers), tone: 1 },
            { label: 'Cabang', sub: fmtNum(cabangCount) + ' pengguna', pct: share(cabangCount, totalUsers), tone: 2 },
            { label: 'Sales & gudang', sub: fmtNum(opsCount) + ' pengguna', pct: share(opsCount, totalUsers), tone: 3 }
        ];
        shortcuts = [
            { href: '/admin/orders', icon: 'fa-receipt', title: 'Pesanan cabang', sub: 'Tinjau dan setujui pesanan masuk' },
            { href: '/admin/shipments', icon: 'fa-truck-fast', title: 'Pengiriman', sub: 'Pantau surat jalan yang berjalan' },
            { href: '/admin/products', icon: 'fa-box', title: 'Produk', sub: 'Katalog dan stok pusat' },
            { href: '/admin/cabang', icon: 'fa-store', title: 'Stok cabang', sub: 'Persediaan tiap toko' },
            { href: '/admin/users', icon: 'fa-users', title: 'Pengguna', sub: 'Tambah atau ubah akun' }
        ];
    } else if (role === 'sales') {
        distTitle = 'Komposisi pesanan';
        distSub = 'Sebaran pesanan berdasarkan tahap penanganannya.';
        distTotal = sTotal;
        distEmpty = 'Belum ada pesanan yang tercatat.';
        rings = [
            { label: 'Menunggu', sub: fmtNum(sPending) + ' pesanan', pct: share(sPending, sTotal), tone: 3 },
            { label: 'Diproses', sub: fmtNum(sProses) + ' pesanan', pct: share(sProses, sTotal), tone: 1 },
            { label: 'Selesai', sub: fmtNum(sSelesai) + ' pesanan', pct: share(sSelesai, sTotal), tone: 2 }
        ];
        shortcuts = [
            { href: '/sales/orders', icon: 'fa-receipt', title: 'Pesanan cabang', sub: 'Konfirmasi pesanan masuk dari cabang' },
            { href: '/sales/history', icon: 'fa-clock-rotate-left', title: 'Riwayat approval', sub: 'Rekap keputusan pesanan yang telah diproses' },
            { href: '/sales/report', icon: 'fa-chart-simple', title: 'Laporan penjualan', sub: 'Rekap penjualan Anda' }
        ];
    } else if (role === 'gudang') {
        distTitle = 'Progres pengemasan';
        distSub = 'Sebaran pesanan dari antrean kemas sampai berangkat.';
        distTotal = gTotal;
        distEmpty = 'Belum ada pesanan yang masuk ke gudang.';
        rings = [
            { label: 'Siap dikemas', sub: fmtNum(gReady) + ' pesanan', pct: share(gReady, gTotal), tone: 1 },
            { label: 'Dikemas', sub: fmtNum(gPacked) + ' pesanan', pct: share(gPacked, gTotal), tone: 3 },
            { label: 'Dikirim', sub: fmtNum(gSent) + ' pesanan', pct: share(gSent, gTotal), tone: 2 }
        ];
        shortcuts = [
            { href: '/gudang/orders', icon: 'fa-boxes-stacked', title: 'Pengemasan', sub: 'Pesanan yang menunggu dikemas' },
            { href: '/admin/shipments', icon: 'fa-truck-fast', title: 'Pengiriman', sub: 'Surat jalan yang sudah berangkat' }
        ];
    }

    var hasRings = rings.length > 0;
%>

<style>
    /* View-scoped saja — komponen bersama ada di layouts/base.ejs */
    .dsh-rings {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 1.25rem 1rem;
        align-items: start;
    }

    .dsh-ring-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .dsh-ring-svg {
        width: 92px;
        height: 92px;
        transform: rotate(-90deg);
    }

    .dsh-ring-bg {
        fill: none;
        stroke: var(--oct-inset-2);
        stroke-width: 8;
    }

    .dsh-ring-fill {
        fill: none;
        stroke-width: 8;
        stroke-linecap: round;
        stroke: var(--oct-series-1);
        transition: stroke-dashoffset 1.1s cubic-bezier(0.32, 0.72, 0, 1);
    }

    .dsh-ring-1 { stroke: var(--oct-series-1); }
    .dsh-ring-2 { stroke: var(--oct-series-2); }
    .dsh-ring-3 { stroke: var(--oct-series-3); }

    .dsh-ring-pct {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.9375rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        fill: var(--oct-text);
        text-anchor: middle;
        dominant-baseline: central;
        /* lawan rotasi svg agar teks tetap tegak */
        transform: rotate(90deg);
        transform-origin: center;
    }

    .dsh-ring-label {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--oct-text);
        text-align: center;
    }

    .dsh-ring-sub {
        font-size: 0.75rem;
        color: var(--oct-text-muted);
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    .dsh-shortcut-icon { font-size: 0.75rem; }

    @media (max-width: 767px) {
        .dsh-ring-svg { width: 78px; height: 78px; }
    }

    @media (prefers-reduced-motion: reduce) {
        .dsh-ring-fill { transition: none; }
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title"><%= pageTitle %></h1>
        <p class="oct-page-sub"><%= pageSub %></p>
    </div>
    <div class="oct-page-actions">
        <% if (prof && prof.username) { %>
            <span class="oct-chip"><i class="fas fa-circle-user"></i> <%= prof.username %></span>
        <% } %>
        <% for (var ha = 0; ha < headActions.length; ha++) { var act = headActions[ha]; %>
            <a href="<%= act.href %>" class="btn <%= act.primary ? 'btn-primary' : 'oct-btn-ghost' %>">
                <i class="fas <%= act.icon %> mr-2"></i><%= act.label %>
            </a>
        <% } %>
    </div>
</div>

<% if (role === 'admin') { %>
<!-- Ringkasan pengguna -->
<div class="oct-panel mb-3">
    <div class="oct-kpi-grid">
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-users"></i></span>
                <span class="oct-kpi-label">Total pengguna</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(totalUsers) %></span>
                <span class="oct-kpi-note">akun terdaftar</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-user-shield"></i></span>
                <span class="oct-kpi-label">Admin</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(adminCount) %></span>
                <span class="oct-kpi-note"><%= share(adminCount, totalUsers) %>% dari total</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-store"></i></span>
                <span class="oct-kpi-label">Cabang</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(cabangCount) %></span>
                <span class="oct-kpi-note"><%= share(cabangCount, totalUsers) %>% dari total</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-people-carry-box"></i></span>
                <span class="oct-kpi-label">Sales &amp; gudang</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(opsCount) %></span>
                <span class="oct-kpi-note">tim operasional</span>
            </div>
        </div>
    </div>
</div>
<% } else if (role === 'sales') { %>
<!-- Ringkasan pesanan -->
<div class="oct-panel mb-3">
    <div class="oct-kpi-grid">
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-receipt"></i></span>
                <span class="oct-kpi-label">Total pesanan</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(sTotal) %></span>
                <span class="oct-kpi-note">seluruh tahap</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-hourglass-half"></i></span>
                <span class="oct-kpi-label">Menunggu</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(sPending) %></span>
                <% if (sPending > 0) { %>
                    <span class="oct-delta oct-delta-warn"><i class="fas fa-clock"></i> perlu ditindak</span>
                <% } else { %>
                    <span class="oct-kpi-note">tidak ada antrean</span>
                <% } %>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-rotate"></i></span>
                <span class="oct-kpi-label">Dalam proses</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(sProses) %></span>
                <span class="oct-kpi-note">disetujui s/d dikirim</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-circle-check"></i></span>
                <span class="oct-kpi-label">Selesai</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(sSelesai) %></span>
                <span class="oct-kpi-note"><%= share(sSelesai, sTotal) %>% dari total</span>
            </div>
        </div>
    </div>
</div>
<% } else if (role === 'gudang') { %>
<!-- Ringkasan gudang -->
<div class="oct-panel mb-3">
    <div class="oct-kpi-grid">
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-boxes-stacked"></i></span>
                <span class="oct-kpi-label">Siap dikemas</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(gReady) %></span>
                <% if (gReady > 0) { %>
                    <span class="oct-delta oct-delta-warn"><i class="fas fa-triangle-exclamation"></i> menunggu</span>
                <% } else { %>
                    <span class="oct-kpi-note">antrean kosong</span>
                <% } %>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-box-open"></i></span>
                <span class="oct-kpi-label">Sedang dikemas</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(gPacked) %></span>
                <span class="oct-kpi-note">dalam pengerjaan</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-truck-fast"></i></span>
                <span class="oct-kpi-label">Dalam pengiriman</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(gSent) %></span>
                <span class="oct-kpi-note">sudah berangkat</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-list-check"></i></span>
                <span class="oct-kpi-label">Total ditangani</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(gTotal) %></span>
                <span class="oct-kpi-note">pesanan aktif</span>
            </div>
        </div>
    </div>
</div>
<% } else if (role === 'cabang') { %>
<!-- Ringkasan stok toko -->
<div class="oct-panel mb-3">
    <div class="oct-kpi-grid">
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-box"></i></span>
                <span class="oct-kpi-label">Produk tersedia</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(stocks.length) %></span>
                <span class="oct-kpi-note">jenis produk</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-cubes"></i></span>
                <span class="oct-kpi-label">Total unit</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(stokUnit) %></span>
                <span class="oct-kpi-note">di rak toko</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-triangle-exclamation"></i></span>
                <span class="oct-kpi-label">Perlu dipesan ulang</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= fmtNum(nMenipis + nKritis) %></span>
                <% if (nKritis > 0) { %>
                    <span class="oct-delta oct-delta-down"><i class="fas fa-arrow-down"></i> <%= fmtNum(nKritis) %> kritis</span>
                <% } else if (nMenipis > 0) { %>
                    <span class="oct-delta oct-delta-warn"><i class="fas fa-clock"></i> menipis</span>
                <% } else { %>
                    <span class="oct-kpi-note">semua aman</span>
                <% } %>
            </div>
            <div class="oct-kpi-foot">ambang menipis 20 unit, kritis 5 unit</div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-wallet"></i></span>
                <span class="oct-kpi-label">Nilai persediaan</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value oct-kpi-value-sm"><%= rupiah(stokNilai) %></span>
            </div>
            <div class="oct-kpi-foot">berdasarkan harga jual produk</div>
        </div>
    </div>
</div>
<% } %>

<% if (hasRings) { %>
<!-- Komposisi + pintasan -->
<div class="oct-grid oct-grid-main mb-3">
    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title"><%= distTitle %></h2>
                <p class="oct-card-sub"><%= distSub %></p>
            </div>
            <span class="oct-chip"><i class="fas fa-layer-group"></i> <%= fmtNum(distTotal) %> total</span>
        </div>
        <div class="oct-card-body">
            <% if (distTotal === 0) { %>
                <div class="oct-empty">
                    <div class="oct-empty-icon"><i class="fas fa-chart-pie"></i></div>
                    <h3 class="oct-empty-title">Belum ada data</h3>
                    <p class="oct-empty-text"><%= distEmpty %></p>
                </div>
            <% } else { %>
                <div class="dsh-rings">
                    <% for (var ri = 0; ri < rings.length; ri++) { var r = rings[ri]; %>
                        <div class="dsh-ring-item">
                            <svg class="dsh-ring-svg" viewBox="0 0 100 100" role="img"
                                 aria-label="<%= r.label %>: <%= r.pct %> persen, <%= r.sub %>">
                                <circle class="dsh-ring-bg" cx="50" cy="50" r="40"></circle>
                                <circle class="dsh-ring-fill dsh-ring-<%= r.tone %>" cx="50" cy="50" r="40"
                                        stroke-dasharray="<%= RING_C %>"
                                        stroke-dashoffset="<%= RING_C %>"
                                        data-target="<%= RING_C * (1 - r.pct / 100) %>"></circle>
                                <text class="dsh-ring-pct" x="50" y="50"><%= r.pct %>%</text>
                            </svg>
                            <div class="dsh-ring-label"><%= r.label %></div>
                            <div class="dsh-ring-sub"><%= r.sub %></div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
        <% if (distTotal > 0) { %>
        <div class="oct-card-foot">
            <span class="oct-card-sub mb-0">Persentase dibulatkan ke bilangan bulat terdekat.</span>
        </div>
        <% } %>
    </section>

    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Pintasan</h2>
                <p class="oct-card-sub">Halaman yang paling sering dibuka untuk peran Anda.</p>
            </div>
        </div>
        <div class="oct-card-body">
            <nav class="oct-listnav" aria-label="Pintasan halaman">
                <% for (var ci = 0; ci < shortcuts.length; ci++) { var sc = shortcuts[ci]; %>
                    <a class="oct-listnav-item" href="<%= sc.href %>">
                        <span class="oct-avatar oct-avatar-sm"><i class="fas <%= sc.icon %> dsh-shortcut-icon"></i></span>
                        <span class="oct-listnav-meta">
                            <span class="oct-listnav-title"><%= sc.title %></span>
                            <span class="oct-listnav-sub"><%= sc.sub %></span>
                        </span>
                        <i class="fas fa-chevron-right" style="font-size:0.6875rem; color:var(--oct-text-muted);"></i>
                    </a>
                <% } %>
            </nav>
        </div>
    </section>
</div>
<% } %>

<% if (role === 'cabang') { %>
<!-- Stok tersedia di toko -->
<% if (stocks.length === 0) { %>
    <section class="oct-card mb-3">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-box-open"></i></div>
            <h2 class="oct-empty-title">Belum ada stok di toko</h2>
            <p class="oct-empty-text">Stok bertambah setiap kali Anda mengonfirmasi pengiriman dari pusat. Ajukan pesanan bila rak masih kosong.</p>
            <div class="oct-empty-actions">
                <a href="/cabang/orders" class="btn btn-primary"><i class="fas fa-plus mr-2"></i>Buat pesanan</a>
            </div>
        </div>
    </section>
<% } else { %>
    <section class="oct-card mb-3">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Stok tersedia di toko</h2>
                <p class="oct-card-sub"><%= fmtNum(stocks.length) %> produk &middot; <%= fmtNum(stokUnit) %> unit tercatat di cabang Anda.</p>
            </div>
            <div class="oct-row">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="dshCariStok">Cari produk</label>
                    <input type="text" id="dshCariStok" placeholder="Cari nama produk atau SKU…" autocomplete="off">
                </div>
                <div class="oct-seg" id="dshSegStok" role="tablist" aria-label="Saring berdasarkan tingkat stok">
                    <% for (var bi = 0; bi < stokBuckets.length; bi++) { var b = stokBuckets[bi]; %>
                        <button type="button" role="tab" class="oct-seg-item <%= bi === 0 ? 'active' : '' %>"
                                data-bucket="<%= b.key %>" aria-selected="<%= bi === 0 %>">
                            <%= b.label %><span class="oct-seg-count"><%= b.n %></span>
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="dshTabelStok">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Produk</th>
                            <th>Satuan</th>
                            <th class="num">Stok</th>
                            <th class="num">Nilai</th>
                            <th class="col-fit">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var si = 0; si < stocks.length; si++) {
                            var it = stocks[si];
                            var qty = num(it.stok_tersedia);
                            var bucket = qty <= 5 ? 'kritis' : (qty <= 20 ? 'menipis' : 'aman');
                            var pillCls = qty <= 5 ? 'oct-pill-gagal' : (qty <= 20 ? 'oct-pill-pending' : 'oct-pill-aktif');
                            var pillTxt = qty <= 5 ? 'Kritis' : (qty <= 20 ? 'Menipis' : 'Aman');
                            var nama = it.nama_produk || '—';
                            var sku = it.sku || '—';
                        %>
                        <tr class="dsh-stok-row"
                            data-bucket="<%= bucket %>"
                            data-search="<%= (nama + ' ' + sku + ' ' + (it.barcode || '')).toLowerCase() %>">
                            <td class="col-fit oct-td-muted"><%= si + 1 %></td>
                            <td>
                                <div class="oct-cell-media">
                                    <% if (it.gambar_url) { %>
                                        <img class="oct-thumb" src="<%= it.gambar_url %>" alt="Foto produk <%= nama %>" loading="lazy">
                                    <% } else { %>
                                        <span class="oct-thumb oct-thumb-empty"><i class="fas fa-image"></i></span>
                                    <% } %>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= nama %></span>
                                        <span class="oct-cell-sub oct-mono"><%= sku %></span>
                                    </span>
                                </div>
                            </td>
                            <td class="oct-td-muted"><%= it.satuan || '—' %></td>
                            <td class="num oct-td-strong"><%= fmtNum(qty) %></td>
                            <td class="num"><%= it.harga_jual ? rupiah(qty * num(it.harga_jual)) : '—' %></td>
                            <td class="col-fit"><span class="oct-pill oct-pill-dot <%= pillCls %>"><%= pillTxt %></span></td>
                        </tr>
                        <% } %>
                        <tr id="dshStokKosong" hidden>
                            <td colspan="6" class="oct-td-muted text-center" style="padding:1.5rem;">Tidak ada produk yang cocok dengan filter.</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="oct-td-muted">Total</td>
                            <td class="num"><%= fmtNum(stokUnit) %></td>
                            <td class="num" style="color:var(--oct-primary);"><%= rupiah(stokNilai) %></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </section>
<% } %>
<% } %>

<!-- Profil akun -->
<section class="oct-card">
    <div class="oct-card-head">
        <div class="oct-row">
            <span class="oct-avatar oct-avatar-lg oct-avatar-solid">
                <%= (prof && prof.username) ? prof.username.charAt(0).toUpperCase() : '?' %>
            </span>
            <div>
                <h2 class="oct-card-title" style="font-size:1.0625rem;"><%= (prof && prof.username) || 'Pengguna' %></h2>
                <p class="oct-card-sub">Detail akun yang sedang masuk</p>
            </div>
        </div>
        <% if (prof && prof.role) { %>
            <span class="oct-pill" style="text-transform:capitalize;"><%= prof.role %></span>
        <% } %>
    </div>
    <div class="oct-card-body">
        <% if (prof) { %>
            <div class="oct-dl">
                <div>
                    <div class="oct-dl-key">ID pengguna</div>
                    <div class="oct-dl-val oct-mono" style="font-size:0.75rem;"><%= prof.id || '—' %></div>
                </div>
                <div>
                    <div class="oct-dl-key">Username</div>
                    <div class="oct-dl-val"><%= prof.username || '—' %></div>
                </div>
                <div>
                    <div class="oct-dl-key">Peran</div>
                    <div class="oct-dl-val" style="text-transform:capitalize;"><%= prof.role || '—' %></div>
                </div>
                <div>
                    <div class="oct-dl-key">Nama cabang</div>
                    <div class="oct-dl-val"><%= prof.nama_cabang || '—' %></div>
                </div>
                <div>
                    <div class="oct-dl-key">Provinsi</div>
                    <div class="oct-dl-val"><%= prof.provinsi || '—' %></div>
                </div>
                <div>
                    <div class="oct-dl-key">Kota</div>
                    <div class="oct-dl-val"><%= prof.kota || '—' %></div>
                </div>
                <div style="grid-column:1/-1;">
                    <div class="oct-dl-key">Jalan</div>
                    <div class="oct-dl-val"><%= prof.jalan || '—' %></div>
                </div>
            </div>
        <% } else { %>
            <div class="oct-empty">
                <div class="oct-empty-icon"><i class="fas fa-circle-user"></i></div>
                <h3 class="oct-empty-title">Profil tidak ditemukan</h3>
                <p class="oct-empty-text">Data akun tidak dapat dimuat. Keluar lalu masuk kembali untuk menyegarkan sesi.</p>
            </div>
        <% } %>
    </div>
</section>

<script>
    (function () {
        /* ── Animasi ring komposisi ────────────────────────────── */
        function animateRings() {
            document.querySelectorAll('.dsh-ring-fill').forEach(function (ring) {
                var target = parseFloat(ring.getAttribute('data-target'));
                if (!isNaN(target)) ring.style.strokeDashoffset = target;
            });
        }

        /* ── Filter tabel stok: pencarian + segmen status ──────── */
        function initStokFilter() {
            var table = document.getElementById('dshTabelStok');
            if (!table) return;

            var rows = Array.prototype.slice.call(table.querySelectorAll('.dsh-stok-row'));
            var searchEl = document.getElementById('dshCariStok');
            var segEl = document.getElementById('dshSegStok');
            var emptyRow = document.getElementById('dshStokKosong');
            var bucket = 'all';

            function apply() {
                var q = searchEl ? searchEl.value.trim().toLowerCase() : '';
                var shown = 0;

                rows.forEach(function (row) {
                    var okBucket = bucket === 'all' || row.dataset.bucket === bucket;
                    var okSearch = !q || (row.dataset.search || '').indexOf(q) !== -1;
                    var hit = okBucket && okSearch;
                    row.hidden = !hit;
                    if (hit) shown++;
                });

                if (emptyRow) emptyRow.hidden = shown !== 0;
            }

            if (searchEl) searchEl.addEventListener('input', apply);

            if (segEl) {
                segEl.addEventListener('click', function (e) {
                    var btn = e.target.closest('.oct-seg-item');
                    if (!btn) return;
                    bucket = btn.dataset.bucket;
                    segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                        var on = b === btn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    apply();
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            initStokFilter();
            setTimeout(animateRings, 260);
        });
    })();
</script>
