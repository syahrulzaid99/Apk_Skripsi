<%
    var rows = Array.isArray(reportRows) ? reportRows : [];

    var totQty = 0, totNet = 0, totCost = 0, totTax = 0;
    var invoiceSet = {}, customerSet = {}, invoiceCount = 0, customerCount = 0;
    for (var i = 0; i < rows.length; i++) {
        totQty += Number(rows[i].billed_qty || 0);
        totNet += Number(rows[i].item_net_value || 0);
        totCost += Number(rows[i].item_cost || 0);
        totTax += Number(rows[i].item_tax || 0);
        var inv = rows[i].invoice_no || '';
        if (inv && !invoiceSet[inv]) { invoiceSet[inv] = 1; invoiceCount++; }
        var cst = rows[i].customer_code || '';
        if (cst && !customerSet[cst]) { customerSet[cst] = 1; customerCount++; }
    }

    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
    function angka(n) { return Number(n || 0).toLocaleString('id-ID'); }
    function fDate(d) {
        if (!d) return '—';
        var dt = new Date(d);
        if (isNaN(dt)) return '—';
        return String(dt.getDate()).padStart(2, '0') + '/' + String(dt.getMonth() + 1).padStart(2, '0') + '/' + dt.getFullYear();
    }
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .rpt-chart { height: 300px; position: relative; }
    .rpt-chart canvas { width: 100% !important; }

    .rpt-tablehost .dataTables_info,
    .rpt-tablehost .dataTables_paginate,
    .rpt-tablehost .dataTables_length { padding-left: 0.875rem; padding-right: 0.875rem; }

    /* Tombol ekspor bawaan DataTables tetap dibuat, tapi dipicu dari tombol halaman */
    .rpt-dt-export { display: none; }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Laporan penjualan</h1>
        <p class="oct-page-sub">Rekap seluruh baris barang pada setiap surat jalan, siap diunduh sebagai berkas Excel.</p>
    </div>
    <% if (rows.length > 0) { %>
    <div class="oct-page-actions">
        <button type="button" class="btn btn-primary" id="btnDownloadExcel">
            <i class="fas fa-file-excel mr-2"></i>Unduh Excel
        </button>
    </div>
    <% } %>
</div>

<% if (rows.length === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-chart-line"></i></div>
            <h2 class="oct-empty-title">Belum ada data laporan</h2>
            <p class="oct-empty-text">Setiap barang yang dikirim ke cabang akan tercatat di sini sebagai satu baris invoice beserta nilainya.</p>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-coins"></i></span>
                    <span class="oct-kpi-label">Nilai bersih</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm"><%= rupiah(totNet) %></span>
                </div>
                <div class="oct-kpi-foot">Pajak <%= rupiah(totTax) %> &middot; biaya <%= rupiah(totCost) %></div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-file-invoice"></i></span>
                    <span class="oct-kpi-label">Invoice</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(invoiceCount) %></span>
                    <span class="oct-kpi-note"><%= angka(rows.length) %> baris barang</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-cubes"></i></span>
                    <span class="oct-kpi-label">Kuantitas ditagih</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(totQty) %></span>
                    <span class="oct-kpi-note">unit</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-store"></i></span>
                    <span class="oct-kpi-label">Pelanggan unik</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(customerCount) %></span>
                    <span class="oct-kpi-note">cabang penerima</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafik -->
    <section class="oct-card mb-3">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Grafik pendapatan bulanan</h2>
                <p class="oct-card-sub">Total nilai bersih barang berdasarkan tanggal invoice.</p>
            </div>
            <span class="oct-chip"><i class="fas fa-calendar-days"></i> Per bulan</span>
        </div>
        <div class="oct-card-body">
            <div class="rpt-chart"><canvas id="salesChart" aria-label="Grafik pendapatan bulanan" role="img"></canvas></div>
        </div>
    </section>

    <!-- Tabel -->
    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Rekap transaksi</h2>
                <p class="oct-card-sub"><%= angka(rows.length) %> baris barang dari <%= angka(invoiceCount) %> invoice.</p>
            </div>
            <div class="oct-row">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="reportSearch">Cari transaksi</label>
                    <input type="text" id="reportSearch" placeholder="Cari invoice, pelanggan, material…" autocomplete="off">
                </div>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body rpt-tablehost">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table oct-table-sm" id="reportsTable" width="100%">
                    <thead>
                        <tr>
                            <th>Invoice No.</th>
                            <th class="col-fit">Invoice Date</th>
                            <th>Delivery Note</th>
                            <th>Customer code</th>
                            <th>Customer name</th>
                            <th>PO number</th>
                            <th class="col-fit">PO Date</th>
                            <th>Material No.</th>
                            <th>Material description</th>
                            <th class="col-fit">Division</th>
                            <th class="num">Billed qty</th>
                            <th class="num">Net value</th>
                            <th class="num">Cost</th>
                            <th class="num">Tax</th>
                            <th>SO number</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var r0 = 0; r0 < rows.length; r0++) { var r = rows[r0]; %>
                        <tr>
                            <td class="oct-mono"><%= r.invoice_no %></td>
                            <td class="col-fit"><%= fDate(r.invoice_date) %></td>
                            <td class="oct-mono oct-td-muted"><%= r.delivery_note %></td>
                            <td class="oct-td-muted"><%= r.customer_code %></td>
                            <td><%= r.customer_name %></td>
                            <td class="oct-mono"><%= r.po_number || '—' %></td>
                            <td class="col-fit"><%= fDate(r.po_date) %></td>
                            <td class="oct-mono"><%= r.material_no %></td>
                            <td><%= r.material_desc %></td>
                            <td class="col-fit"><%= r.material_div || '—' %></td>
                            <td class="num oct-td-strong"><%= r.billed_qty %></td>
                            <td class="num"><%= r.item_net_value %></td>
                            <td class="num"><%= r.item_cost %></td>
                            <td class="num"><%= r.item_tax %></td>
                            <td class="oct-mono oct-td-muted"><%= r.so_number || '—' %></td>
                        </tr>
                        <% } %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="10" class="oct-td-muted">Total <%= angka(rows.length) %> baris</td>
                            <td class="num"><%= angka(totQty) %></td>
                            <td class="num"><%= angka(totNet) %></td>
                            <td class="num"><%= angka(totCost) %></td>
                            <td class="num"><%= angka(totTax) %></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </section>
<% } %>

<!-- DataTables + Export -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap4.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    $(document).ready(function () {
        if (!$('#reportsTable').length) return;

        var dt = $('#reportsTable').DataTable({
            pageLength: 50,
            lengthMenu: [10, 25, 50, 100, 500],
            order: [[1, 'desc']],
            dom: "<'rpt-dt-export'B>" +
                 "<'row'<'col-sm-12'tr>>" +
                 "<'row align-items-center'<'col-sm-12 col-md-4'l><'col-sm-12 col-md-8'p>>" +
                 "<'row'<'col-sm-12'i>>",
            buttons: [{
                extend: 'excelHtml5',
                text: '<i class="fas fa-file-excel"></i> Unduh Excel',
                className: 'btn btn-primary btn-sm',
                title: 'Laporan_Penjualan_AquaStock'
            }],
            language: {
                search: 'Cari:',
                paginate: { previous: 'Sebelumnya', next: 'Selanjutnya' },
                info: 'Menampilkan _START_ s/d _END_ dari _TOTAL_ baris',
                infoEmpty: 'Tidak ada baris untuk ditampilkan',
                lengthMenu: 'Tampilkan _MENU_ baris',
                emptyTable: 'Belum ada data laporan',
                zeroRecords: 'Tidak ada baris yang cocok'
            }
        });

        $('#reportSearch').on('keyup', function () { dt.search(this.value).draw(); });
        /* Tombol ekspor bawaan DataTables disembunyikan; dipicu lewat indeksnya
           supaya tidak bergantung pada kelas yang ditambahkan pustaka. */
        $('#btnDownloadExcel').on('click', function () { dt.button(0).trigger(); });
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var ctx = document.getElementById('salesChart');
        if (!ctx || typeof Chart === 'undefined') return;

        /* Warna diambil dari token desain agar ikut tema terang/gelap.
           Tidak ada nilai warna yang ditulis langsung di berkas ini. */
        var css = getComputedStyle(document.documentElement);
        var warnaTeksDasar = getComputedStyle(ctx).color;
        function tok(name, fallback) {
            var v = (css.getPropertyValue(name) || '').trim();
            return v || fallback || warnaTeksDasar;
        }
        var cSeries = tok('--oct-series-1', tok('--oct-primary', ''));
        var cGrid = tok('--oct-border-light', tok('--oct-border', ''));
        var cText = tok('--oct-text-muted', tok('--oct-text-2', ''));
        var cTextStrong = tok('--oct-text', '');
        var cSurface = tok('--oct-card', 'transparent');
        var cBorder = tok('--oct-border', '');

        var reportData = <%- JSON.stringify(rows) %>;
        var groupedData = {};
        reportData.forEach(function (row) {
            if (!row.invoice_date) return;
            var dateObj = new Date(row.invoice_date);
            if (isNaN(dateObj)) return;
            var key = dateObj.getFullYear() + '-' + String(dateObj.getMonth() + 1).padStart(2, '0');
            if (!groupedData[key]) groupedData[key] = 0;
            groupedData[key] += Number(row.item_net_value || 0);
        });

        var sortedKeys = Object.keys(groupedData).sort();
        if (!sortedKeys.length) return;

        var labels = sortedKeys.map(function (key) {
            var parts = key.split('-');
            return new Date(parts[0], parts[1] - 1).toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
        });
        var dataValues = sortedKeys.map(function (key) { return groupedData[key]; });

        /* Ubah warna token jadi rgba tanpa menuliskan nilai warna apa pun.
           Kanvas menormalkan warna apa pun yang valid, jadi token cukup dibaca ulang. */
        function withAlpha(color, alpha) {
            var probe = document.createElement('canvas').getContext('2d');
            if (!probe) return 'transparent';
            probe.fillStyle = 'transparent';
            probe.fillStyle = color;
            var s = String(probe.fillStyle);
            if (s.charAt(0) === '#' && s.length === 7) {
                return 'rgba(' + parseInt(s.substr(1, 2), 16) + ', ' +
                    parseInt(s.substr(3, 2), 16) + ', ' +
                    parseInt(s.substr(5, 2), 16) + ', ' + alpha + ')';
            }
            var m = s.match(/rgba?\(([^)]+)\)/);
            if (m) {
                var p = m[1].split(',');
                var a0 = p.length > 3 ? parseFloat(p[3]) : 1;
                if (!a0) return 'transparent';
                return 'rgba(' + p[0].trim() + ', ' + p[1].trim() + ', ' + p[2].trim() + ', ' + alpha + ')';
            }
            return 'transparent';
        }

        var grad = ctx.getContext('2d').createLinearGradient(0, 0, 0, 300);
        grad.addColorStop(0, withAlpha(cSeries, 0.18));
        grad.addColorStop(1, withAlpha(cSeries, 0));

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Pendapatan (Rp)',
                    data: dataValues,
                    backgroundColor: grad,
                    borderColor: cSeries,
                    borderWidth: 2.5,
                    pointRadius: 4,
                    pointBackgroundColor: cSeries,
                    pointBorderColor: cSurface,
                    pointBorderWidth: 2,
                    pointHoverRadius: 7,
                    fill: true,
                    tension: 0.35
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: cText, font: { family: 'Inter', size: 11 } }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: cGrid, drawBorder: false },
                        ticks: {
                            color: cText,
                            font: { family: 'Inter', size: 10 },
                            callback: function (v) {
                                if (v >= 1000000) return 'Rp ' + (v / 1000000).toLocaleString('id-ID') + 'jt';
                                if (v >= 1000) return 'Rp ' + (v / 1000).toLocaleString('id-ID') + 'rb';
                                return 'Rp ' + v.toLocaleString('id-ID');
                            }
                        }
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: cSurface,
                        bodyColor: cText,
                        titleColor: cTextStrong,
                        borderColor: cBorder,
                        borderWidth: 1,
                        cornerRadius: 10,
                        padding: 12,
                        displayColors: false,
                        callbacks: { label: function (c) { return 'Rp ' + c.parsed.y.toLocaleString('id-ID'); } }
                    }
                },
                interaction: { mode: 'index', intersect: false }
            }
        });
    });
</script>
