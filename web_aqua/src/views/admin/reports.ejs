<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.5rem;">
    <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(1.25rem,3vw,1.5rem); font-weight:700; margin:0; color:var(--oct-text);">
        <span style="margin-right:0.5rem;">&#128202;</span>Laporan Penjualan
    </h1>
</div>

<style>
    .oct-chart-card { background: var(--oct-card); border: 1px solid var(--oct-border-light); border-radius: 16px; box-shadow: var(--oct-shadow-sm); overflow: hidden; margin-bottom: 1.5rem; }
    .oct-chart-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--oct-border-light); font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.9375rem; color: var(--oct-text); }
    .oct-chart-body { padding: 1.25rem; }
</style>

<!-- Chart -->
<div class="oct-chart-card">
    <div class="oct-chart-header"><i class="fas fa-chart-line" style="color:var(--oct-primary); margin-right:0.5rem;"></i> Grafik Pendapatan (Bulanan)</div>
    <div class="oct-chart-body">
        <div style="height:300px;"><canvas id="salesChart"></canvas></div>
    </div>
</div>

<!-- Table -->
<div class="oct-chart-card">
    <div class="oct-chart-header"><i class="fas fa-table" style="color:var(--oct-primary); margin-right:0.5rem;"></i> Rekap Transaksi</div>
    <div class="oct-chart-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="reportsTable" width="100%">
                <thead>
                    <tr>
                        <th>Invoice No.</th><th>Invoice Date</th><th>Delivery Note</th><th>Customer code</th>
                        <th>Customer name</th><th>PO number</th><th>PO Date</th><th>Material No.</th>
                        <th>Material description</th><th>Division</th><th class="text-right">Billed qty</th>
                        <th class="text-right">Net value</th><th class="text-right">Cost</th><th class="text-right">Tax</th><th>SO number</th>
                    </tr>
                </thead>
                <tbody>
                    <% function fDate(d) { if (!d) return '-'; const dt = new Date(d); return String(dt.getDate()).padStart(2,'0') + '/' + String(dt.getMonth()+1).padStart(2,'0') + '/' + dt.getFullYear(); }
                       reportRows.forEach(r => { %>
                        <tr>
                            <td><%= r.invoice_no %></td><td><%= fDate(r.invoice_date) %></td><td><%= r.delivery_note %></td>
                            <td><%= r.customer_code %></td><td><%= r.customer_name %></td><td><%= r.po_number || '-' %></td>
                            <td><%= fDate(r.po_date) %></td><td><%= r.material_no %></td><td><%= r.material_desc %></td>
                            <td><%= r.material_div || '-' %></td><td class="text-right"><%= r.billed_qty %></td>
                            <td class="text-right"><%= r.item_net_value %></td><td class="text-right"><%= r.item_cost %></td>
                            <td class="text-right"><%= r.item_tax %></td><td><%= r.so_number || '-' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- DataTables + Export -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap4.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

<script>
    $(document).ready(function() {
        $('#reportsTable').DataTable({
            pageLength: 50, lengthMenu: [10, 25, 50, 100, 500], order: [[1, 'desc']],
            dom: "<'row'<'col-sm-12 col-md-4'l><'col-sm-12 col-md-4 text-center'B><'col-sm-12 col-md-4'f>>" +
                 "<'row'<'col-sm-12'tr>>" +
                 "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            buttons: [{ extend: 'excelHtml5', text: '<i class="fas fa-file-excel"></i> Download Excel', className: 'btn btn-success btn-sm', title: 'Laporan_Penjualan_AquaStock' }]
        });
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const reportData = <%- JSON.stringify(reportRows) %>;
        const groupedData = {};
        reportData.forEach(function(row) {
            if (!row.invoice_date) return;
            var dateObj = new Date(row.invoice_date);
            var key = dateObj.getFullYear() + '-' + String(dateObj.getMonth() + 1).padStart(2, '0');
            if (!groupedData[key]) groupedData[key] = 0;
            groupedData[key] += Number(row.item_net_value || 0);
        });
        var sortedKeys = Object.keys(groupedData).sort();
        var labels = sortedKeys.map(function(key) {
            var parts = key.split('-');
            return new Date(parts[0], parts[1] - 1).toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
        });
        var dataValues = sortedKeys.map(function(key) { return groupedData[key]; });

        var ctx = document.getElementById('salesChart');
        if (ctx && sortedKeys.length > 0) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Pendapatan (Rp)', data: dataValues,
                        backgroundColor: 'rgba(59, 130, 246, 0.05)',
                        borderColor: 'rgba(59, 130, 246, 1)',
                        pointRadius: 4, pointBackgroundColor: '#3B82F6', pointBorderColor: '#3B82F6',
                        pointHoverRadius: 6, fill: true, tension: 0.3
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            ticks: { callback: function(v) { return v >= 1000000 ? 'Rp ' + (v/1000000).toLocaleString('id-ID') + 'M' : v >= 1000 ? 'Rp ' + (v/1000).toLocaleString('id-ID') + 'K' : 'Rp ' + v.toLocaleString('id-ID'); } },
                            grid: { color: 'rgba(226,232,240,0.5)', drawBorder: false }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#fff', bodyColor: '#64748B', titleColor: '#1E293B',
                            borderColor: '#E2E8F0', borderWidth: 1, padding: 12,
                            callbacks: { label: function(c) { return 'Rp ' + c.parsed.y.toLocaleString('id-ID'); } }
                        }
                    }
                }
            });
        }
    });
</script>