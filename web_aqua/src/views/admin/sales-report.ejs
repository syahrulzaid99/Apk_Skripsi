<%
    var branchList = Array.isArray(branches) ? branches : [];
    var sum = (typeof summary !== 'undefined' && summary) ? summary : {};

    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
    function angka(n) { return Number(n || 0).toLocaleString('id-ID'); }
    function brInitial(s) { return String(s || 'C').charAt(0).toUpperCase(); }

    function tglPenjualan(v) {
        if (!v) return '—';
        var d;
        if (v.toDate) d = v.toDate();
        else if (v._seconds) d = new Date(v._seconds * 1000);
        else d = new Date(v);
        if (!d || isNaN(d)) return '—';
        return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    var totalPendapatan = Number(sum.totalPendapatan || 0);
    var totalTransaksi = Number(sum.totalTransaksi || 0);
    var totalItem = Number(sum.totalItemTerjual || 0);
    var totalCabang = Number(sum.totalCabang != null ? sum.totalCabang : branchList.length);
    var rataTransaksi = totalTransaksi > 0 ? Math.round(totalPendapatan / totalTransaksi) : 0;
    var pendapatanTertinggi = 0;
    for (var mi = 0; mi < branchList.length; mi++) {
        pendapatanTertinggi = Math.max(pendapatanTertinggi, Number(branchList[mi].totalPendapatan || 0));
    }
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .srp-card + .srp-card { margin-top: var(--oct-gap); }
    .srp-card[hidden] { display: none; }

    /* Kontribusi pendapatan di tabel peringkat */
    .srp-meter {
        width: 92px;
        height: 6px;
        border-radius: 999px;
        background: var(--oct-inset-2);
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
    }

    .srp-meter-fill {
        display: block;
        height: 100%;
        border-radius: 999px;
        background: var(--oct-primary);
    }

    /* Bar chart bulanan bisa digeser saat datanya panjang */
    .srp-barscroll {
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--oct-border) transparent;
    }

    .srp-barscroll::-webkit-scrollbar { height: 6px; }
    .srp-barscroll::-webkit-scrollbar-thumb { background: var(--oct-border); border-radius: 3px; }

    .srp-amount { text-align: right; line-height: 1.25; }

    .srp-amount b {
        display: block;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.035em;
        font-variant-numeric: tabular-nums;
        color: var(--oct-text);
    }

    @media (max-width: 575px) {
        .srp-meter { width: 60px; }
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Laporan penjualan per cabang</h1>
        <p class="oct-page-sub">Peringkat pendapatan tiap cabang, tren bulanannya, dan transaksi terakhir yang tercatat.</p>
    </div>
</div>

<!-- Ringkasan -->
<div class="oct-panel mb-3">
    <div class="oct-kpi-grid">
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-coins"></i></span>
                <span class="oct-kpi-label">Total pendapatan</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value oct-kpi-value-sm"><%= rupiah(totalPendapatan) %></span>
            </div>
            <div class="oct-kpi-foot">Rata-rata <%= rupiah(rataTransaksi) %> per transaksi</div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-store"></i></span>
                <span class="oct-kpi-label">Cabang menjual</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= angka(totalCabang) %></span>
                <span class="oct-kpi-note">punya transaksi</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-receipt"></i></span>
                <span class="oct-kpi-label">Total transaksi</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= angka(totalTransaksi) %></span>
                <span class="oct-kpi-note">penjualan cabang</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-cubes"></i></span>
                <span class="oct-kpi-label">Item terjual</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= angka(totalItem) %></span>
                <span class="oct-kpi-note">unit</span>
            </div>
        </div>
    </div>
</div>

<% if (branchList.length === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-chart-column"></i></div>
            <h2 class="oct-empty-title">Belum ada data penjualan</h2>
            <p class="oct-empty-text">Setiap penjualan yang dicatat cabang akan muncul di sini dan diurutkan berdasarkan pendapatan terbesar.</p>
        </div>
    </div>
<% } else { %>

    <!-- Peringkat cabang -->
    <section class="oct-card mb-3">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Peringkat cabang</h2>
                <p class="oct-card-sub">Urutan awal mengikuti pendapatan terbesar. Gunakan penyaring untuk mengubah dasar urutan.</p>
            </div>
            <div class="oct-row">
                <div class="oct-seg" id="srpSeg" role="tablist" aria-label="Urutkan berdasarkan">
                    <button type="button" role="tab" class="oct-seg-item active" data-sort="rev" aria-selected="true">Pendapatan</button>
                    <button type="button" role="tab" class="oct-seg-item" data-sort="trx" aria-selected="false">Transaksi</button>
                    <button type="button" role="tab" class="oct-seg-item" data-sort="item" aria-selected="false">Item</button>
                </div>
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="srpSearch">Cari cabang</label>
                    <input type="text" id="srpSearch" placeholder="Cari cabang atau kota…" autocomplete="off">
                </div>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="srpTable">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Cabang</th>
                            <th>Lokasi</th>
                            <th class="num">Transaksi</th>
                            <th class="num">Item</th>
                            <th class="num">Pendapatan</th>
                            <th class="col-fit">Kontribusi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var bi = 0; bi < branchList.length; bi++) {
                            var b = branchList[bi];
                            var namaB = b.nama_cabang || b.username || '—';
                            var lokasi = [b.kota, b.provinsi].filter(Boolean).join(', ');
                            var revB = Number(b.totalPendapatan || 0);
                            var pctB = pendapatanTertinggi > 0 ? Math.max(2, Math.round((revB / pendapatanTertinggi) * 100)) : 0;
                        %>
                        <tr class="srp-row"
                            data-cabang="<%= b.cabang_id %>"
                            data-search="<%= (namaB + ' ' + (b.username || '') + ' ' + lokasi).toLowerCase() %>"
                            data-rev="<%= revB %>"
                            data-trx="<%= Number(b.totalTransaksi || 0) %>"
                            data-item="<%= Number(b.totalItemTerjual || 0) %>">
                            <td class="col-fit oct-td-muted srp-rank"><%= bi + 1 %></td>
                            <td>
                                <div class="oct-cell-media">
                                    <span class="oct-avatar oct-avatar-sm"><%= brInitial(namaB) %></span>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= namaB %></span>
                                        <span class="oct-cell-sub"><%= b.username || '—' %></span>
                                    </span>
                                </div>
                            </td>
                            <td class="oct-td-muted"><%= lokasi || '—' %></td>
                            <td class="num"><%= angka(b.totalTransaksi) %></td>
                            <td class="num"><%= angka(b.totalItemTerjual) %></td>
                            <td class="num oct-td-strong"><%= rupiah(revB) %></td>
                            <td class="col-fit">
                                <span class="srp-meter" role="img" aria-label="<%= pctB %> persen dari cabang tertinggi">
                                    <span class="srp-meter-fill" style="width:<%= pctB %>%;"></span>
                                </span>
                            </td>
                        </tr>
                        <% } %>
                        <tr id="srpTableEmpty" hidden>
                            <td colspan="7" class="oct-td-muted text-center" style="padding:1.5rem;">Tidak ada cabang yang cocok.</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="oct-td-muted">Total <%= angka(branchList.length) %> cabang</td>
                            <td class="num"><%= angka(totalTransaksi) %></td>
                            <td class="num"><%= angka(totalItem) %></td>
                            <td class="num"><%= rupiah(totalPendapatan) %></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </section>

    <!-- Rincian per cabang -->
    <div id="srpCards">
        <% for (var di = 0; di < branchList.length; di++) {
            var d = branchList[di];
            var namaD = d.nama_cabang || d.username || '—';
            var lokasiD = [d.kota, d.provinsi].filter(Boolean).join(', ');
            var monthly = Array.isArray(d.monthly) ? d.monthly : [];
            var recent = Array.isArray(d.recentSales) ? d.recentSales : [];
            var maxMonthly = 1;
            for (var mm = 0; mm < monthly.length; mm++) maxMonthly = Math.max(maxMonthly, Number(monthly[mm].total || 0));
            var barsWidth = Math.max(240, monthly.length * 56);
        %>
        <section class="oct-card srp-card"
                 data-cabang="<%= d.cabang_id %>"
                 data-search="<%= (namaD + ' ' + (d.username || '') + ' ' + lokasiD).toLowerCase() %>"
                 data-rev="<%= Number(d.totalPendapatan || 0) %>"
                 data-trx="<%= Number(d.totalTransaksi || 0) %>"
                 data-item="<%= Number(d.totalItemTerjual || 0) %>">
            <header class="oct-card-head">
                <div class="oct-cell-media">
                    <span class="oct-avatar oct-avatar-solid srp-badge"><%= di + 1 %></span>
                    <span class="oct-cell-stack">
                        <span class="oct-card-title"><%= namaD %></span>
                        <span class="oct-cell-sub"><%= lokasiD || d.username || '—' %></span>
                    </span>
                </div>
                <div class="srp-amount">
                    <b><%= rupiah(d.totalPendapatan) %></b>
                    <span class="oct-card-sub"><%= angka(d.totalTransaksi) %> transaksi &middot; <%= angka(d.totalItemTerjual) %> item</span>
                </div>
            </header>

            <div class="oct-card-body">
                <% if (monthly.length > 0) { %>
                    <div class="oct-card-head oct-card-head-plain" style="padding:0 0 0.25rem;">
                        <h3 class="oct-card-title">Pendapatan per bulan</h3>
                        <span class="oct-chip"><%= angka(monthly.length) %> periode</span>
                    </div>
                    <div class="srp-barscroll">
                        <div class="oct-bars" style="min-width:<%= barsWidth %>px;">
                            <% for (var mb = 0; mb < monthly.length; mb++) {
                                var m = monthly[mb];
                                var tot = Number(m.total || 0);
                                var h = maxMonthly > 0 ? Math.max(3, Math.round((tot / maxMonthly) * 100)) : 3;
                                var isMax = tot > 0 && tot === maxMonthly;
                            %>
                            <div class="oct-bar-col <%= isMax ? 'active' : '' %>">
                                <div class="oct-bar-track" title="<%= m.label || '' %> — <%= rupiah(tot) %> dari <%= angka(m.count) %> transaksi">
                                    <div class="oct-bar-fill" style="height:<%= h %>%;"></div>
                                </div>
                                <div class="oct-bar-label"><%= m.label || '—' %></div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                <% } else { %>
                    <p class="oct-card-sub mb-0">Belum ada rekap bulanan untuk cabang ini.</p>
                <% } %>

                <% if (recent.length > 0) { %>
                    <div class="oct-card-head oct-card-head-plain" style="padding:1rem 0 0.5rem;">
                        <h3 class="oct-card-title">Transaksi terakhir</h3>
                        <span class="oct-chip"><%= angka(recent.length) %> baris</span>
                    </div>
                    <div class="oct-tablewrap oct-tablewrap-card">
                        <table class="oct-table oct-table-sm oct-table-nested">
                            <thead>
                                <tr>
                                    <th class="col-fit">#</th>
                                    <th>Kode penjualan</th>
                                    <th class="num">Item</th>
                                    <th class="col-fit">Tanggal</th>
                                    <th class="num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (var ri = 0; ri < recent.length; ri++) { var s = recent[ri]; %>
                                <tr>
                                    <td class="col-fit oct-td-muted"><%= ri + 1 %></td>
                                    <td class="oct-mono"><%= s.kode_penjualan || '—' %></td>
                                    <td class="num"><%= angka(s.jumlah_item) %></td>
                                    <td class="col-fit oct-td-muted"><%= tglPenjualan(s.createdAt) %></td>
                                    <td class="num oct-td-strong"><%= rupiah(s.total_harga) %></td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="oct-card-sub mt-3 mb-0">Belum ada transaksi terakhir yang tercatat.</p>
                <% } %>
            </div>
        </section>
        <% } %>
    </div>

    <p class="oct-empty-text" id="srpCardsEmpty" hidden style="padding:1.25rem 0; text-align:left;">
        Tidak ada cabang yang cocok dengan pencarian.
    </p>
<% } %>

<script>
    (function () {
        var tableBody = document.querySelector('#srpTable tbody');
        if (!tableBody) return;

        var rows = Array.prototype.slice.call(document.querySelectorAll('.srp-row'));
        var cards = Array.prototype.slice.call(document.querySelectorAll('.srp-card'));
        var cardHost = document.getElementById('srpCards');
        var searchEl = document.getElementById('srpSearch');
        var segEl = document.getElementById('srpSeg');
        var rowEmpty = document.getElementById('srpTableEmpty');
        var cardEmpty = document.getElementById('srpCardsEmpty');
        var sortKey = 'rev';

        function val(el, key) { return Number(el.getAttribute('data-' + key) || 0); }

        function applySort() {
            var ordered = rows.slice().sort(function (a, b) { return val(b, sortKey) - val(a, sortKey); });
            ordered.forEach(function (row) { tableBody.insertBefore(row, rowEmpty); });

            if (cardHost) {
                cards.slice()
                    .sort(function (a, b) { return val(b, sortKey) - val(a, sortKey); })
                    .forEach(function (card) { cardHost.appendChild(card); });
            }
            renumber();
        }

        function renumber() {
            var n = 0;
            rows.forEach(function (row) {
                if (row.hidden) return;
                n++;
                var cell = row.querySelector('.srp-rank');
                if (cell) cell.textContent = n;
            });
            var c = 0;
            cards.forEach(function (card) {
                if (card.hidden) return;
                c++;
                var badge = card.querySelector('.srp-badge');
                if (badge) badge.textContent = c;
            });
        }

        function applyFilter() {
            var q = searchEl ? searchEl.value.trim().toLowerCase() : '';
            var shown = 0;

            rows.forEach(function (row) {
                var hit = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
                row.hidden = !hit;
                if (hit) shown++;
            });
            cards.forEach(function (card) {
                var hit = !q || (card.getAttribute('data-search') || '').indexOf(q) !== -1;
                card.hidden = !hit;
            });

            if (rowEmpty) rowEmpty.hidden = shown !== 0;
            if (cardEmpty) cardEmpty.hidden = shown !== 0;
            renumber();
        }

        if (searchEl) searchEl.addEventListener('input', applyFilter);

        if (segEl) {
            segEl.addEventListener('click', function (e) {
                var btn = e.target.closest('.oct-seg-item');
                if (!btn) return;
                sortKey = btn.getAttribute('data-sort') || 'rev';
                segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                    var on = b === btn;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                applySort();
            });
        }
    })();
</script>
