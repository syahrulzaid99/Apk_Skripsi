<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.5rem;">
    <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(1.25rem,3vw,1.5rem); font-weight:700; margin:0; color:var(--oct-text);">
        <span style="margin-right:0.5rem;">&#128722;</span>Pesanan Cabang
    </h1>
</div>

<style>
    .oct-card { background: var(--oct-card); border: 1px solid var(--oct-border-light); border-radius: 16px; box-shadow: var(--oct-shadow-sm); overflow: hidden; margin-bottom: 1.25rem; }
    .oct-card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--oct-border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .oct-card-body { padding: 1.25rem 1.5rem; }
    .oct-pill { padding: 0.375em 1em; border-radius: 50rem; font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; display: inline-block; }
    .oct-pill-pending { background: var(--oct-yellow); color: #1E293B; }
    .oct-pill-approved_admin { background: #06B6D4; }
    .oct-pill-dipaket { background: var(--oct-yellow-dark); }
    .oct-pill-dikirim { background: var(--oct-primary); }
    .oct-pill-selesai, .oct-pill-diterima { background: var(--oct-green-dark); }
    .oct-pill-rejected, .oct-pill-ditolak { background: var(--oct-red); }
    .oct-pill-lunas { background: var(--oct-green-dark); }
    .oct-pill-bayar { background: var(--oct-yellow); color: #1E293B; }
    .oct-kode { color: var(--oct-primary); background: var(--oct-primary-bg); padding: 0.25rem 0.625rem; border-radius: 6px; font-weight: 700; font-size: 0.8125rem; font-family: 'JetBrains Mono', monospace; }
    .oct-table-wrap { border-collapse: separate; border-spacing: 0; }
    .oct-table-wrap thead th { border-bottom: 2px solid var(--oct-border); background: var(--oct-bg); color: var(--oct-text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.6875rem; letter-spacing: 0.06em; padding: 0.75rem 0.625rem; }
    .oct-table-wrap td { border-top: 1px solid var(--oct-border-light); padding: 0.625rem; vertical-align: middle; font-size: 0.875rem; }
    .oct-table-wrap tbody tr:hover { background: var(--oct-card-hover); }
    .oct-grand-total { background: var(--oct-bg); font-weight: 900; font-size: 1.0625rem; background: linear-gradient(135deg, var(--oct-green-dark), #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .oct-section-label { font-family: 'Poppins', sans-serif; font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--oct-primary); margin-bottom: 0.75rem; }
</style>

<!-- Filter -->
<div class="card" style="margin-bottom:1.25rem;">
    <div class="card-body" style="padding:1rem 1.25rem;">
        <!-- Search -->
        <div class="input-group" style="margin-bottom:0.875rem;">
            <div class="input-group-prepend"><span class="input-group-text" style="border-radius:10px 0 0 10px;"><i class="fas fa-search"></i></span></div>
            <input id="filterSearch" class="form-control form-control-sm" placeholder="Cari kode order, nama cabang, atau status..." style="border-radius:0 10px 10px 0;">
        </div>
        <!-- Filters row -->
        <div style="display:flex; flex-wrap:wrap; gap:0.625rem; align-items:flex-end;">
            <div style="flex:1; min-width:180px;">
                <label style="font-size:0.6875rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--oct-text-muted); margin-bottom:0.25rem; display:block;">Cabang</label>
                <select id="filterCabang" class="form-control form-control-sm" style="width:100%;">
                    <option value="">Semua</option>
                    <% cabangList.forEach(function(c) { %><option value="<%= c.id %>"><%= c.username %></option><% }); %>
                </select>
            </div>
            <div style="flex:1; min-width:180px;">
                <label style="font-size:0.6875rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--oct-text-muted); margin-bottom:0.25rem; display:block;">Status</label>
                <select id="filterStatus" class="form-control form-control-sm" style="width:100%;">
                    <option value="">Semua</option>
                    <option value="pending">Pending</option>
                    <option value="approved_admin">Diverifikasi</option>
                    <option value="dipaket">Dikemas</option>
                    <option value="dikirim">Dikirim</option>
                    <option value="selesai">Selesai</option>
                    <option value="rejected">Ditolak</option>
                </select>
            </div>
            <div style="flex:1; min-width:155px;">
                <label style="font-size:0.6875rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--oct-text-muted); margin-bottom:0.25rem; display:block;">Dari Tanggal</label>
                <input type="date" id="filterDateStart" class="form-control form-control-sm" style="width:100%;">
            </div>
            <div style="flex:1; min-width:155px;">
                <label style="font-size:0.6875rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--oct-text-muted); margin-bottom:0.25rem; display:block;">Sampai Tanggal</label>
                <input type="date" id="filterDateEnd" class="form-control form-control-sm" style="width:100%;">
            </div>
            <div style="display:flex; align-items:flex-end; gap:0.5rem; padding-bottom:1px;">
                <button id="filterResetBtn" class="btn btn-sm btn-outline-secondary" style="white-space:nowrap;"><i class="fas fa-undo"></i> Reset</button>
                <span style="color:var(--oct-text-muted); font-size:0.8125rem; white-space:nowrap;" id="filterInfo"></span>
            </div>
        </div>
    </div>
</div>

<% var list = Array.isArray(orders) ? orders : []; %>

<% if (list.length === 0) { %>
    <div class="oct-card"><div class="oct-card-body text-center" style="padding:3rem;">
        <i class="fas fa-shopping-cart" style="font-size:2.5rem; color:var(--oct-text-muted); opacity:0.3; display:block; margin-bottom:0.75rem;"></i>
        <span style="color:var(--oct-text-muted);">Belum ada pesanan dari cabang.</span>
    </div></div>
<% } %>

<% for (var si = 0; si < list.length; si++) { %>
    <% var o = list[si]; var st = (o.status || '').toLowerCase(); var cabang = (usersMap && usersMap[o.cabang_id]) ? usersMap[o.cabang_id] : null; var paymentStatus = String(o.payment_status || '').toLowerCase(); %>
    <div class="oct-card" data-cabang-id="<%= o.cabang_id %>" data-status="<%= st %>" data-timestamp="<%= o.createdAt ? (o.createdAt._seconds ? o.createdAt._seconds * 1000 : new Date(o.createdAt).getTime()) : 0 %>" data-search="<%= ((o.kode_order || '') + ' ' + (cabang ? (cabang.username + ' ' + (cabang.nama_cabang || '')) : o.cabang_id) + ' ' + (o.status || '') + ' ' + (paymentStatus === 'settlement' ? 'lunas' : 'belum bayar')).toLowerCase() %>">
        <div class="oct-card-header">
            <div>
                <div style="font-weight:700; margin-bottom:0.5rem;">
                    Kode Order: <span class="oct-kode"><%= o.kode_order %></span>
                </div>
                <div style="font-size:0.8125rem; color:var(--oct-text-muted); margin-bottom:0.25rem;">
                    <i class="fas fa-store" style="margin-right:0.25rem;"></i> Cabang: <strong style="color:var(--oct-text);"><%= cabang ? cabang.username : o.cabang_id %></strong>
                </div>
                <div style="font-size:0.8125rem; color:var(--oct-text-muted);">
                    <i class="far fa-clock" style="margin-right:0.25rem;"></i>
                    <% if (o.createdAt) { %><strong style="color:var(--oct-text);"><%= new Date(o.createdAt._seconds ? o.createdAt._seconds * 1000 : o.createdAt).toLocaleDateString('id-ID', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></strong><% } else { %>-<% } %>
                </div>
            </div>
            <div class="d-flex align-items-center" style="gap:0.625rem;">
                <span class="oct-pill oct-pill-<%= st %>"><%= (o.status || 'pending').toUpperCase() %></span>
                <% if (paymentStatus === 'settlement') { %><span class="oct-pill oct-pill-lunas">LUNAS</span><% } else { %><span class="oct-pill oct-pill-bayar">BELUM BAYAR</span><% } %>
                <form method="POST" action="/admin/orders/<%= o.id %>/delete" style="display:inline;" data-confirm-delete>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Hapus Pesanan"><i class="fas fa-trash"></i></button>
                </form>
            </div>
        </div>

        <div class="oct-card-body">
            <% if (o.keterangan) { %>
                <div class="alert alert-info" style="padding:0.625rem 1rem; margin-bottom:1rem; font-size:0.875rem;">
                    <i class="fas fa-info-circle" style="margin-right:0.375rem;"></i><strong>Catatan Cabang:</strong> <%= o.keterangan %>
                </div>
            <% } %>
            <div class="table-responsive">
                <table class="table oct-table-wrap w-100" style="margin-bottom:0.5rem;">
                    <thead><tr>
                        <th style="width:48px;">#</th><th>SKU</th><th>Nama Produk</th><th style="width:100px;">Satuan</th>
                        <th style="width:110px;" class="text-right">Harga</th><th style="width:100px;" class="text-right">Qty</th><th style="width:140px;" class="text-right">Subtotal</th>
                    </tr></thead>
                    <tbody>
                        <% var grandTotal = 0; var items = Array.isArray(o.items) ? o.items : []; for (var i = 0; i < items.length; i++) { var it = items[i]; var sub = Number(it.subtotal || 0); grandTotal += sub; %>
                        <tr>
                            <td><%= i + 1 %></td><td><%= it.sku || '-' %></td><td><%= it.nama_produk || '-' %></td><td><%= it.satuan || '-' %></td>
                            <td class="text-right">Rp <%= Number(it.harga || 0).toLocaleString('id-ID') %></td>
                            <td class="text-right font-weight-bold"><%= it.qty %></td>
                            <td class="text-right font-weight-bold" style="color:var(--oct-primary);">Rp <%= sub.toLocaleString('id-ID') %></td>
                        </tr>
                        <% } %>
                    </tbody>
                    <tfoot><tr style="background:var(--oct-bg);">
                        <td colspan="6" class="text-right text-uppercase" style="font-weight:700; color:var(--oct-text-muted); font-size:0.75rem; letter-spacing:0.05em; vertical-align:middle;">Grand Total Pesanan</td>
                        <td class="text-right oct-grand-total">Rp <%= grandTotal.toLocaleString('id-ID') %></td>
                    </tr></tfoot>
                </table>
            </div>

            <div style="margin-top:1.25rem; padding:1rem; background:var(--oct-bg); border-radius:12px;">
                <div class="oct-section-label"><i class="fas fa-edit" style="margin-right:0.375rem;"></i> Verifikasi Admin</div>
                <% if (st === 'selesai' || st === 'diterima') { %>
                    <div class="alert alert-success d-flex align-items-center" style="margin:0;"><i class="fas fa-check-circle" style="margin-right:0.75rem; font-size:1.125rem;"></i><div><strong>Pesanan Selesai</strong><br><small style="color:var(--oct-text-muted);">Pesanan telah diterima cabang.</small></div></div>
                <% } else if (st === 'dikirim') { %>
                    <div class="alert alert-primary d-flex align-items-center" style="margin:0;"><i class="fas fa-truck" style="margin-right:0.75rem; font-size:1.125rem;"></i><div><strong>Pesanan Sedang Dikirim</strong><br><small style="color:var(--oct-text-muted);">Menunggu konfirmasi cabang.</small></div></div>
                <% } else if (st === 'dipaket') { %>
                    <div class="alert alert-warning d-flex align-items-center" style="margin:0;"><i class="fas fa-box" style="margin-right:0.75rem; font-size:1.125rem;"></i><div><strong>Sedang Dikemas</strong><br><small style="color:var(--oct-text-muted);">Gudang sedang memproses pengemasan.</small></div></div>
                <% } else if (st === 'approved_admin') { %>
                    <div class="alert alert-primary d-flex align-items-center" style="margin:0;"><i class="fas fa-check-double" style="margin-right:0.75rem; font-size:1.125rem;"></i><div><strong>Sudah Diverifikasi</strong><br><small style="color:var(--oct-text-muted);">Menunggu gudang untuk mengemas.</small></div></div>
                <% } else if (st === 'pending' && paymentStatus === 'settlement') { %>
                    <form method="POST" action="/admin/orders/<%= o.id %>" class="form-inline" data-confirm-verify>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="status" value="approved_admin">
                        <div class="form-group mb-2 mr-3 flex-grow-1">
                            <input type="text" name="keterangan" class="form-control form-control-sm w-100" placeholder="Catatan Admin (opsional)" value="<%= o.keterangan_admin || '' %>">
                        </div>
                        <button type="submit" class="btn btn-primary mb-2"><i class="fas fa-check-double" style="margin-right:0.375rem;"></i> Verifikasi & Lanjut ke Gudang</button>
                    </form>
                <% } else if (st === 'pending' && paymentStatus !== 'settlement') { %>
                    <div class="alert alert-warning d-flex align-items-center" style="margin:0;"><i class="fas fa-clock" style="margin-right:0.75rem; font-size:1.125rem;"></i><div><strong>Menunggu Pembayaran</strong><br><small style="color:var(--oct-text-muted);">Belum bisa diverifikasi sebelum lunas.</small></div></div>
                <% } else if (st === 'rejected') { %>
                    <div class="alert alert-danger d-flex align-items-center" style="margin:0;"><i class="fas fa-times-circle" style="margin-right:0.75rem; font-size:1.125rem;"></i><div><strong>Ditolak oleh Sales</strong><br><small style="color:var(--oct-text-muted);"><%= o.rejection_reason || '' %></small></div></div>
                <% } else { %>
                    <div class="alert alert-info d-flex align-items-center" style="margin:0;"><i class="fas fa-clock" style="margin-right:0.75rem; font-size:1.125rem;"></i><div><strong>Menunggu Persetujuan Sales</strong><br><small style="color:var(--oct-text-muted);">Pesanan masih dalam antrian sales.</small></div></div>
                <% } %>
            </div>
        </div>
    </div>
<% } %>

<script>
    (function () {
        var params = new URLSearchParams(window.location.search);
        var ok = params.get('ok'), err = params.get('err');
        function hasSwal() { return typeof Swal !== 'undefined' && Swal && Swal.fire; }
        if (ok && hasSwal()) {
            var title = ok === 'deleted' ? 'Pesanan dihapus' : ok === 'barang_dikirim' ? 'Barang berhasil dikirim!' : ok === 'updated' ? 'Pesanan diverifikasi!' : ok;
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: title, showConfirmButton: false, timer: 3000, timerProgressBar: true });
            params.delete('ok'); window.history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params.toString() : ''));
        }
        if (err && hasSwal()) { Swal.fire({ icon: 'error', title: 'Gagal', text: err, confirmButtonColor: '#3B82F6' }); params.delete('err'); window.history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params.toString() : '')); }

        document.addEventListener('submit', function (ev) {
            var form = ev.target;
            if (form.matches('form[data-confirm-delete]')) {
                ev.preventDefault();
                if (form.dataset.confirmHandled === '1') return;
                Swal.fire({ icon: 'warning', title: 'Hapus Pesanan?', text: 'Tindakan ini tidak dapat dibatalkan.', showCancelButton: true, confirmButtonText: 'Ya, Hapus', cancelButtonText: 'Batal', confirmButtonColor: '#EF4444' }).then(function(r) { if (r.isConfirmed) { form.dataset.confirmHandled = '1'; form.submit(); } });
            }
        }, true);

        var filterCabang = document.getElementById('filterCabang');
        var filterStatus = document.getElementById('filterStatus');
        var filterDateStart = document.getElementById('filterDateStart');
        var filterDateEnd = document.getElementById('filterDateEnd');
        var filterResetBtn = document.getElementById('filterResetBtn');
        var filterInfo = document.getElementById('filterInfo');
        var orderCards = document.querySelectorAll('.oct-card[data-cabang-id]');

        var filterSearch = document.getElementById('filterSearch');

        function applyFilter() {
            var cv = filterCabang.value, sv = filterStatus.value, startVal = filterDateStart.value, endVal = filterDateEnd.value;
            var q = (filterSearch.value || '').toLowerCase().trim();
            var startTime = startVal ? new Date(startVal + 'T00:00:00').getTime() : 0;
            var endTime = endVal ? new Date(endVal + 'T23:59:59').getTime() : Infinity;
            var visible = 0;
            orderCards.forEach(function(card) {
                var match = true;
                if (cv && card.getAttribute('data-cabang-id') !== cv) match = false;
                if (match && sv && card.getAttribute('data-status') !== sv) match = false;
                if (match) { var ts = parseInt(card.getAttribute('data-timestamp')) || 0; if (ts < startTime || ts > endTime) match = false; }
                if (match && q && (card.getAttribute('data-search') || '').indexOf(q) === -1) match = false;
                card.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            filterInfo.textContent = visible + ' pesanan ditampilkan';
        }
        filterCabang.addEventListener('change', applyFilter);
        filterStatus.addEventListener('change', applyFilter);
        filterDateStart.addEventListener('change', applyFilter);
        filterDateEnd.addEventListener('change', applyFilter);
        filterSearch.addEventListener('input', applyFilter);
        filterResetBtn.addEventListener('click', function() { filterCabang.value = ''; filterStatus.value = ''; filterDateStart.value = ''; filterDateEnd.value = ''; filterSearch.value = ''; applyFilter(); });
        filterInfo.textContent = orderCards.length + ' pesanan ditampilkan';
    })();
</script>