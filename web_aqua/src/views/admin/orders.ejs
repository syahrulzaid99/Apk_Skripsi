<%
    var list = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : [];
    var cabList = (typeof cabangList !== 'undefined' && Array.isArray(cabangList)) ? cabangList : [];
    var uMap = (typeof usersMap !== 'undefined' && usersMap) ? usersMap : {};

    function aoDate(v) {
        if (!v) return null;
        return new Date(v._seconds ? v._seconds * 1000 : v);
    }
    function aoFmt(v, withTime) {
        var d = aoDate(v);
        if (!d || isNaN(d)) return '—';
        var opt = { day: '2-digit', month: 'short', year: 'numeric' };
        if (withTime) { opt.hour = '2-digit'; opt.minute = '2-digit'; }
        return d.toLocaleDateString('id-ID', opt);
    }
    function aoMs(v) {
        var d = aoDate(v);
        return (d && !isNaN(d)) ? d.getTime() : 0;
    }
    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }

    function itemsOf(o) { return Array.isArray(o.items) ? o.items : []; }
    function totalOf(o) {
        var its = itemsOf(o), t = 0;
        for (var i = 0; i < its.length; i++) t += Number(its[i].subtotal || 0);
        if (!t) t = Number(o.total_harga || 0);
        return t;
    }
    function unitOf(o) {
        var its = itemsOf(o), q = 0;
        for (var i = 0; i < its.length; i++) q += Number(its[i].qty || 0);
        return q;
    }
    function cabangName(o) {
        var c = uMap[o.cabang_id];
        if (!c) return o.cabang_id || '—';
        return c.nama_cabang || c.username || o.cabang_id;
    }
    function cabangUser(o) {
        var c = uMap[o.cabang_id];
        return c ? (c.username || o.cabang_id) : (o.cabang_id || '—');
    }
    // 'rejected' is a legacy value — it shares the ditolak palette
    function pillOf(st) { return st === 'rejected' ? 'ditolak' : (st || 'pending'); }
    function bucketOf(st) {
        if (st === 'pending') return 'pending';
        if (st === 'approved_admin' || st === 'dipaket' || st === 'dikirim') return 'proses';
        if (st === 'diterima' || st === 'selesai') return 'selesai';
        if (st === 'ditolak' || st === 'rejected') return 'ditolak';
        return 'lain';
    }

    var STATUS_LABEL = {
        pending: 'Menunggu verifikasi', approved_admin: 'Diverifikasi', dipaket: 'Dikemas',
        dikirim: 'Dikirim', diterima: 'Diterima', selesai: 'Selesai',
        ditolak: 'Ditolak', rejected: 'Ditolak sales'
    };

    // Midtrans payment_status values rendered in Indonesian
    var PAY_LABEL = {
        pending: 'Menunggu pembayaran', settlement: 'Lunas', capture: 'Lunas',
        deny: 'Ditolak penyedia', cancel: 'Dibatalkan', expire: 'Kedaluwarsa',
        refund: 'Dana dikembalikan', failed_to_generate: 'Gagal membuat tagihan'
    };

    // Lifecycle order used by the progress rail
    var FLOW = ['pending', 'approved_admin', 'dipaket', 'dikirim', 'diterima'];
    var FLOW_LABEL = {
        pending: 'Pesanan masuk', approved_admin: 'Diverifikasi admin', dipaket: 'Dikemas gudang',
        dikirim: 'Dalam pengiriman', diterima: 'Diterima cabang'
    };

    // Summary figures
    var totalOrders = list.length;
    var nPending = 0, nSiap = 0, nProses = 0, nSelesai = 0, nTolak = 0, nilaiTotal = 0;
    for (var k = 0; k < list.length; k++) {
        var stk = String(list[k].status || 'pending').toLowerCase();
        var payk = String(list[k].payment_status || '').toLowerCase();
        var bk = bucketOf(stk);
        nilaiTotal += totalOf(list[k]);
        if (bk === 'pending') { nPending++; if (payk === 'settlement') nSiap++; }
        else if (bk === 'proses') nProses++;
        else if (bk === 'selesai') nSelesai++;
        else if (bk === 'ditolak') nTolak++;
    }

    // Segmented filter buckets
    var buckets = [
        { key: 'all', label: 'Semua', n: totalOrders },
        { key: 'pending', label: 'Menunggu', n: nPending },
        { key: 'proses', label: 'Diproses', n: nProses },
        { key: 'selesai', label: 'Selesai', n: nSelesai },
        { key: 'ditolak', label: 'Ditolak', n: nTolak }
    ];
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .ord-layout {
        display: grid;
        grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
        gap: var(--oct-gap);
        align-items: start;
    }

    .ord-rail {
        background: var(--oct-inset);
        border: 1px solid var(--oct-border-light);
        border-radius: var(--oct-r-lg);
        padding: 0.75rem;
        position: sticky;
        top: 84px;
        max-height: calc(100dvh - 108px);
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .ord-rail-list {
        overflow-y: auto;
        margin: 0 -0.25rem;
        padding: 0 0.25rem;
        scrollbar-width: thin;
        scrollbar-color: var(--oct-border) transparent;
    }

    .ord-rail-list::-webkit-scrollbar { width: 6px; }
    .ord-rail-list::-webkit-scrollbar-thumb { background: var(--oct-border); border-radius: 3px; }

    .ord-rail-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0 0.25rem;
    }

    .ord-rail-count {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--oct-text-muted);
    }

    /* Cabang + date-range filters inside the rail */
    .ord-filters {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
    }

    .ord-filters .ord-filter-wide { grid-column: 1 / -1; }

    .ord-filter-label {
        display: block;
        font-size: 0.625rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--oct-text-muted);
        margin-bottom: 0.1875rem;
    }

    /* Modifiers for shared components used inside this view.
       Prefixed so the layout's own rules stay untouched. */
    .ord-search { max-width: none; flex: none; }
    .ord-item { align-items: flex-start; }
    .ord-item-dot { margin-top: 0.4375rem; }
    .ord-item-code { font-size: 0.8125rem; }
    .ord-item-total { font-size: 0.75rem; font-weight: 600; color: var(--oct-text-2); font-variant-numeric: tabular-nums; }
    .ord-list-empty { padding: 0.75rem 0.25rem; text-align: left; }

    .ord-detail[hidden] { display: none; }

    .ord-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1.125rem 1.25rem;
        border-bottom: 1px solid var(--oct-border-light);
    }

    .ord-head-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 1.125rem;
        letter-spacing: -0.03em;
        margin: 0 0 0.3125rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .ord-head-side {
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
    }

    .ord-head-amount { text-align: right; line-height: 1.25; }

    .ord-head-amount b {
        display: block;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.035em;
        font-variant-numeric: tabular-nums;
    }

    /* Progress rail — horizontal on desktop, stacks on narrow */
    .ord-flow {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 1fr;
        gap: 0.5rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--oct-border-light);
    }

    .ord-step { min-width: 0; }

    .ord-step-bar {
        height: 4px;
        border-radius: 999px;
        background: var(--oct-inset-2);
        margin-bottom: 0.5rem;
    }

    .ord-step.done .ord-step-bar,
    .ord-step.current .ord-step-bar { background: var(--oct-primary); }
    .ord-step.failed .ord-step-bar { background: var(--oct-red); }

    .ord-step-label {
        font-size: 0.75rem;
        color: var(--oct-text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ord-step.done .ord-step-label,
    .ord-step.current .ord-step-label { color: var(--oct-text); font-weight: 600; }
    .ord-step.failed .ord-step-label { color: var(--oct-red); font-weight: 600; }

    .ord-notes { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }

    .ord-verify-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .ord-verify-field { flex: 1 1 220px; min-width: 0; }

    @media (max-width: 1100px) {
        .ord-layout { grid-template-columns: minmax(0, 1fr); }
        .ord-rail { position: static; max-height: none; }
        .ord-rail-list { max-height: 320px; }
    }

    @media (max-width: 640px) {
        .ord-flow { grid-auto-flow: row; }
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Pesanan cabang</h1>
        <p class="oct-page-sub">Verifikasi pesanan yang sudah dibayar cabang, lalu teruskan ke gudang untuk dikemas dan dikirim.</p>
    </div>
    <% if (nSiap > 0) { %>
    <div class="oct-page-actions">
        <span class="oct-pill oct-pill-dot oct-pill-pending"><%= nSiap %> siap diverifikasi</span>
    </div>
    <% } %>
</div>

<% if (totalOrders === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-receipt"></i></div>
            <h2 class="oct-empty-title">Belum ada pesanan</h2>
            <p class="oct-empty-text">Setiap pesanan yang diajukan cabang akan muncul di sini untuk diperiksa dan diverifikasi.</p>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-receipt"></i></span>
                    <span class="oct-kpi-label">Total pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= totalOrders %></span>
                    <span class="oct-kpi-note">dari semua cabang</span>
                </div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-check-double"></i></span>
                    <span class="oct-kpi-label">Siap diverifikasi</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nSiap %></span>
                    <% if (nSiap > 0) { %>
                        <span class="oct-delta oct-delta-warn"><i class="fas fa-clock"></i> perlu tindakan</span>
                    <% } else { %>
                        <span class="oct-kpi-note">tidak ada antrean</span>
                    <% } %>
                </div>
                <div class="oct-kpi-foot"><%= Math.max(nPending - nSiap, 0) %> pesanan masih menunggu pembayaran</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-truck-fast"></i></span>
                    <span class="oct-kpi-label">Sedang diproses</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= nProses %></span>
                    <span class="oct-kpi-note">gudang s/d pengiriman</span>
                </div>
                <div class="oct-kpi-foot"><%= nSelesai %> selesai &middot; <%= nTolak %> ditolak</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-wallet"></i></span>
                    <span class="oct-kpi-label">Nilai seluruh pesanan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm"><%= rupiah(nilaiTotal) %></span>
                </div>
                <div class="oct-kpi-foot">akumulasi seluruh pesanan cabang</div>
            </div>
        </div>
    </div>

    <!-- Daftar + detail -->
    <div class="ord-layout">
        <aside class="ord-rail">
            <div class="oct-search ord-search">
                <i class="fas fa-magnifying-glass"></i>
                <label class="oct-sr" for="filterSearch">Cari pesanan</label>
                <input type="text" id="filterSearch" placeholder="Cari kode, cabang, atau status…" autocomplete="off">
            </div>

            <div class="oct-seg" id="ordSeg" role="tablist" aria-label="Saring berdasarkan status">
                <% for (var bi = 0; bi < buckets.length; bi++) { var b = buckets[bi]; %>
                    <button type="button" role="tab" class="oct-seg-item <%= bi === 0 ? 'active' : '' %>" data-bucket="<%= b.key %>" aria-selected="<%= bi === 0 %>">
                        <%= b.label %><span class="oct-seg-count"><%= b.n %></span>
                    </button>
                <% } %>
            </div>

            <div class="ord-filters">
                <div class="ord-filter-wide">
                    <label class="ord-filter-label" for="filterCabang">Cabang</label>
                    <select id="filterCabang" class="form-control form-control-sm">
                        <option value="">Semua cabang</option>
                        <% for (var ci = 0; ci < cabList.length; ci++) { var c = cabList[ci]; %>
                            <option value="<%= c.id %>"><%= c.username || c.id %></option>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label class="ord-filter-label" for="filterDateStart">Dari tanggal</label>
                    <input type="date" id="filterDateStart" class="form-control form-control-sm">
                </div>
                <div>
                    <label class="ord-filter-label" for="filterDateEnd">Sampai tanggal</label>
                    <input type="date" id="filterDateEnd" class="form-control form-control-sm">
                </div>
            </div>

            <div class="ord-rail-foot">
                <span class="ord-rail-count" id="filterInfo"><%= totalOrders %> pesanan ditampilkan</span>
                <button type="button" id="filterResetBtn" class="oct-icon-btn" title="Atur ulang filter" aria-label="Atur ulang filter">
                    <i class="fas fa-rotate-left"></i>
                </button>
            </div>

            <div class="ord-rail-list oct-listnav" id="ordList" role="tablist" aria-label="Daftar pesanan">
                <% for (var si = 0; si < list.length; si++) {
                    var o = list[si];
                    var st = String(o.status || 'pending').toLowerCase();
                    var pay = String(o.payment_status || '').toLowerCase();
                    var bucket = bucketOf(st);
                    var dotClass = bucket === 'ditolak' ? 'oct-dot-bad'
                                 : bucket === 'selesai' ? 'oct-dot-ok'
                                 : bucket === 'pending' ? 'oct-dot-warn' : 'oct-dot-info';
                    var tot = totalOf(o);
                    var nItems = itemsOf(o).length;
                    var cariRow = ((o.kode_order || '') + ' ' + cabangUser(o) + ' ' + cabangName(o) + ' ' + (o.status || '') + ' ' + (pay === 'settlement' ? 'lunas' : 'belum bayar')).toLowerCase();
                %>
                <button type="button" role="tab"
                        class="oct-listnav-item ord-item <%= si === 0 ? 'active' : '' %>"
                        data-target="ordDetail<%= si %>"
                        data-bucket="<%= bucket %>"
                        data-cabang-id="<%= o.cabang_id || '' %>"
                        data-status="<%= st %>"
                        data-timestamp="<%= aoMs(o.createdAt) %>"
                        data-search="<%= cariRow %>"
                        aria-selected="<%= si === 0 %>"
                        aria-controls="ordDetail<%= si %>">
                    <span class="oct-dot ord-item-dot <%= dotClass %>"></span>
                    <span class="oct-listnav-meta">
                        <span class="oct-listnav-title oct-mono ord-item-code"><%= o.kode_order || '—' %></span>
                        <span class="oct-listnav-sub"><%= cabangName(o) %> &middot; <%= nItems %> item</span>
                        <span class="oct-listnav-sub"><%= aoFmt(o.createdAt, false) %></span>
                    </span>
                    <span class="ord-item-total"><%= rupiah(tot) %></span>
                </button>
                <% } %>
            </div>

            <p class="oct-empty-text ord-list-empty" id="ordListEmpty" hidden>
                Tidak ada pesanan yang cocok dengan filter.
            </p>
        </aside>

        <div class="ord-detail-host">
            <% for (var di = 0; di < list.length; di++) {
                var od = list[di];
                var sd = String(od.status || 'pending').toLowerCase();
                var payD = String(od.payment_status || '').toLowerCase();
                var isRejected = (sd === 'ditolak' || sd === 'rejected');
                var doneIdx = FLOW.indexOf(sd === 'selesai' ? 'diterima' : sd);
                var itemsD = itemsOf(od);
                var totD = totalOf(od);
                var qtyD = unitOf(od);
            %>
            <section class="oct-card ord-detail" id="ordDetail<%= di %>" role="tabpanel" <%= di === 0 ? '' : 'hidden' %>>
                <header class="ord-head">
                    <div>
                        <h2 class="ord-head-title">
                            <span class="oct-mono"><%= od.kode_order || '—' %></span>
                            <span class="oct-pill oct-pill-dot oct-pill-<%= pillOf(sd) %>"><%= STATUS_LABEL[sd] || sd %></span>
                            <% if (payD === 'settlement') { %>
                                <span class="oct-pill oct-pill-lunas">Lunas</span>
                            <% } else { %>
                                <span class="oct-pill oct-pill-pending">Belum bayar</span>
                            <% } %>
                        </h2>
                        <p class="oct-card-sub">
                            <%= cabangName(od) %> &middot; dibuat <%= aoFmt(od.createdAt, true) %>
                            <% if (od.updatedAt && String(od.updatedAt) !== String(od.createdAt)) { %>
                                &middot; diperbarui <%= aoFmt(od.updatedAt, true) %>
                            <% } %>
                        </p>
                    </div>
                    <div class="ord-head-side">
                        <div class="ord-head-amount">
                            <b><%= rupiah(totD) %></b>
                            <span class="oct-card-sub"><%= itemsD.length %> produk &middot; <%= qtyD.toLocaleString('id-ID') %> unit</span>
                        </div>
                        <form method="POST" action="/admin/orders/<%= od.id %>/delete" data-confirm-delete data-kode="<%= od.kode_order || '' %>" style="display:inline;">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="oct-icon-btn oct-icon-btn-danger" title="Hapus pesanan" aria-label="Hapus pesanan <%= od.kode_order || '' %>">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </header>

                <!-- Progres pesanan -->
                <div class="ord-flow">
                    <% if (isRejected) { %>
                        <div class="ord-step failed" style="grid-column:1/-1;">
                            <div class="ord-step-bar"></div>
                            <div class="ord-step-label"><i class="fas fa-circle-xmark mr-1"></i>Pesanan ditolak</div>
                        </div>
                    <% } else {
                        for (var fi = 0; fi < FLOW.length; fi++) {
                            var cls = fi < doneIdx ? 'done' : (fi === doneIdx ? 'current' : '');
                    %>
                        <div class="ord-step <%= cls %>">
                            <div class="ord-step-bar"></div>
                            <div class="ord-step-label"><%= FLOW_LABEL[FLOW[fi]] %></div>
                        </div>
                    <% } } %>
                </div>

                <!-- Ringkasan pesanan -->
                <div class="oct-card-body" style="padding-bottom:0.75rem;">
                    <div class="oct-dl">
                        <div>
                            <div class="oct-dl-key">Kode pesanan</div>
                            <div class="oct-dl-val oct-mono"><%= od.kode_order || '—' %></div>
                        </div>
                        <div>
                            <div class="oct-dl-key">Cabang pemesan</div>
                            <div class="oct-dl-val"><%= cabangUser(od) %></div>
                        </div>
                        <div>
                            <div class="oct-dl-key">Status pembayaran</div>
                            <div class="oct-dl-val">
                                <% if (payD) { %>
                                    <span class="oct-pill oct-pill-<%= payD %>"><%= PAY_LABEL[payD] || payD.replace(/_/g, ' ') %></span>
                                <% } else { %>
                                    <span class="oct-td-muted">Belum ada data</span>
                                <% } %>
                            </div>
                        </div>
                        <div>
                            <div class="oct-dl-key">Jumlah unit</div>
                            <div class="oct-dl-val"><%= qtyD.toLocaleString('id-ID') %></div>
                        </div>
                        <div>
                            <div class="oct-dl-key">Total tagihan</div>
                            <div class="oct-dl-val"><%= rupiah(totD) %></div>
                        </div>
                    </div>
                </div>

                <!-- Rincian produk -->
                <div class="oct-card-head oct-card-head-plain" style="padding-top:0.5rem;">
                    <h3 class="oct-card-title">Rincian produk</h3>
                    <span class="oct-chip"><%= itemsD.length %> baris</span>
                </div>

                <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

                <div class="oct-card-body" style="padding-top:0.75rem; padding-bottom:0.75rem;">
                    <div class="oct-tablewrap oct-tablewrap-card">
                        <table class="oct-table oct-table-sm oct-table-nested">
                            <thead>
                                <tr>
                                    <th class="col-fit">#</th>
                                    <th>Produk</th>
                                    <th>Satuan</th>
                                    <th class="num">Harga</th>
                                    <th class="num">Qty</th>
                                    <th class="num">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (itemsD.length === 0) { %>
                                    <tr><td colspan="6" class="oct-td-muted text-center" style="padding:1.5rem;">Tidak ada item pada pesanan ini.</td></tr>
                                <% } %>
                                <% for (var ii = 0; ii < itemsD.length; ii++) { var it = itemsD[ii]; %>
                                <tr>
                                    <td class="col-fit oct-td-muted"><%= ii + 1 %></td>
                                    <td>
                                        <div class="oct-cell-media">
                                            <% if (it.gambar_url) { %>
                                                <img class="oct-thumb" src="<%= it.gambar_url %>" alt="Foto produk <%= it.nama_produk || 'tanpa nama' %>" loading="lazy">
                                            <% } else { %>
                                                <span class="oct-thumb oct-thumb-empty"><i class="fas fa-image"></i></span>
                                            <% } %>
                                            <span class="oct-cell-stack">
                                                <span class="oct-cell-main"><%= it.nama_produk || '—' %></span>
                                                <span class="oct-cell-sub oct-mono"><%= it.sku || '—' %></span>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="oct-td-muted"><%= it.satuan || '—' %></td>
                                    <td class="num"><%= rupiah(it.harga) %></td>
                                    <td class="num oct-td-strong"><%= Number(it.qty || 0).toLocaleString('id-ID') %></td>
                                    <td class="num oct-td-strong"><%= rupiah(it.subtotal) %></td>
                                </tr>
                                <% } %>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="oct-td-muted">Grand total pesanan</td>
                                    <td class="num"><%= qtyD.toLocaleString('id-ID') %></td>
                                    <td class="num" style="color:var(--oct-primary); font-size:0.9375rem;"><%= rupiah(totD) %></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="oct-card-body" style="padding-top:0;">
                    <% if (od.keterangan || od.keterangan_admin) { %>
                    <div class="ord-notes">
                        <% if (od.keterangan) { %>
                            <div class="oct-note">
                                <i class="fas fa-note-sticky"></i>
                                <span><strong>Catatan cabang:</strong> <%= od.keterangan %></span>
                            </div>
                        <% } %>
                        <% if (od.keterangan_admin) { %>
                            <div class="oct-note oct-note-accent">
                                <i class="fas fa-comment-dots"></i>
                                <span><strong>Catatan admin:</strong> <%= od.keterangan_admin %></span>
                            </div>
                        <% } %>
                    </div>
                    <% } %>

                    <div class="oct-panel-inset">
                        <h3 class="oct-card-title" style="margin-bottom:0.75rem;">
                            <i class="fas fa-user-shield mr-2" style="color:var(--oct-primary);"></i>Verifikasi admin
                        </h3>

                        <% if (sd === 'selesai' || sd === 'diterima') { %>
                            <div class="alert alert-success mb-0">
                                <strong>Pesanan selesai.</strong> Barang sudah diterima cabang, tidak ada tindakan lanjutan.
                            </div>
                        <% } else if (sd === 'dikirim') { %>
                            <div class="alert alert-primary mb-0">
                                <strong>Pesanan sedang dikirim.</strong> Menunggu cabang mengonfirmasi penerimaan.
                            </div>
                        <% } else if (sd === 'dipaket') { %>
                            <div class="alert alert-warning mb-0">
                                <strong>Sedang dikemas.</strong> Gudang masih memproses pengemasan pesanan ini.
                            </div>
                        <% } else if (sd === 'approved_admin') { %>
                            <div class="alert alert-primary mb-0">
                                <strong>Sudah diverifikasi.</strong> Menunggu gudang mengemas pesanan.
                            </div>
                        <% } else if (sd === 'pending' && payD === 'settlement') { %>
                            <form method="POST" action="/admin/orders/<%= od.id %>" data-confirm-verify data-kode="<%= od.kode_order || '' %>">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="status" value="approved_admin">
                                <div class="ord-verify-row">
                                    <div class="ord-verify-field">
                                        <label class="oct-sr" for="ketAdmin<%= di %>">Catatan admin</label>
                                        <input type="text" name="keterangan" id="ketAdmin<%= di %>" class="form-control form-control-sm"
                                               placeholder="Catatan admin (opsional)" value="<%= od.keterangan_admin || '' %>" maxlength="200">
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="fas fa-check-double mr-2"></i>Verifikasi dan lanjut ke gudang
                                    </button>
                                </div>
                            </form>
                        <% } else if (sd === 'pending') { %>
                            <div class="alert alert-warning mb-0">
                                <strong>Menunggu pembayaran.</strong> Pesanan belum bisa diverifikasi sebelum status pembayaran lunas.
                            </div>
                        <% } else if (sd === 'rejected') { %>
                            <div class="alert alert-danger mb-0">
                                <strong>Ditolak oleh sales.</strong>
                                <%= od.rejection_reason ? od.rejection_reason : 'Tidak ada alasan yang dicatat.' %>
                            </div>
                        <% } else if (sd === 'ditolak') { %>
                            <div class="alert alert-danger mb-0">
                                <strong>Pesanan ditolak.</strong>
                                <%= od.rejection_reason ? od.rejection_reason : 'Stok pusat sudah dikembalikan.' %>
                            </div>
                        <% } else { %>
                            <div class="oct-note">
                                <i class="fas fa-clock"></i>
                                <span><strong>Menunggu persetujuan sales.</strong> Pesanan masih dalam antrean sales.</span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>
            <% } %>
        </div>
    </div>
<% } %>

<script>
    (function () {
        /* ── Master/detail: rail selection + filters ───────────── */
        var listEl = document.getElementById('ordList');
        if (listEl) {
            var items = Array.prototype.slice.call(listEl.querySelectorAll('.ord-item'));
            var panels = Array.prototype.slice.call(document.querySelectorAll('.ord-detail'));
            var filterSearch = document.getElementById('filterSearch');
            var filterCabang = document.getElementById('filterCabang');
            var filterDateStart = document.getElementById('filterDateStart');
            var filterDateEnd = document.getElementById('filterDateEnd');
            var filterResetBtn = document.getElementById('filterResetBtn');
            var filterInfo = document.getElementById('filterInfo');
            var segEl = document.getElementById('ordSeg');
            var emptyEl = document.getElementById('ordListEmpty');
            var bucket = 'all';

            function select(id) {
                items.forEach(function (btn) {
                    var on = btn.dataset.target === id;
                    btn.classList.toggle('active', on);
                    btn.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                panels.forEach(function (p) { p.hidden = p.id !== id; });
            }

            items.forEach(function (btn) {
                btn.addEventListener('click', function () { select(btn.dataset.target); });
            });

            function applyFilter() {
                var q = filterSearch ? filterSearch.value.trim().toLowerCase() : '';
                var cv = filterCabang ? filterCabang.value : '';
                var startVal = filterDateStart ? filterDateStart.value : '';
                var endVal = filterDateEnd ? filterDateEnd.value : '';
                var startTime = startVal ? new Date(startVal + 'T00:00:00').getTime() : 0;
                var endTime = endVal ? new Date(endVal + 'T23:59:59').getTime() : Infinity;
                var shown = 0;
                var firstVisible = null;

                items.forEach(function (btn) {
                    var hit = true;
                    if (bucket !== 'all' && btn.dataset.bucket !== bucket) hit = false;
                    if (hit && cv && btn.dataset.cabangId !== cv) hit = false;
                    if (hit) {
                        var ts = parseInt(btn.dataset.timestamp, 10) || 0;
                        if (ts < startTime || ts > endTime) hit = false;
                    }
                    if (hit && q && (btn.dataset.search || '').indexOf(q) === -1) hit = false;

                    btn.hidden = !hit;
                    if (hit) { shown++; if (!firstVisible) firstVisible = btn; }
                });

                if (filterInfo) filterInfo.textContent = shown + ' pesanan ditampilkan';
                if (emptyEl) emptyEl.hidden = shown !== 0;

                // Keep the open panel valid for the current filter
                var active = items.filter(function (b) { return b.classList.contains('active') && !b.hidden; })[0];
                if (!active && firstVisible) select(firstVisible.dataset.target);
            }

            if (filterSearch) filterSearch.addEventListener('input', applyFilter);
            if (filterCabang) filterCabang.addEventListener('change', applyFilter);
            if (filterDateStart) filterDateStart.addEventListener('change', applyFilter);
            if (filterDateEnd) filterDateEnd.addEventListener('change', applyFilter);

            if (filterResetBtn) {
                filterResetBtn.addEventListener('click', function () {
                    if (filterSearch) filterSearch.value = '';
                    if (filterCabang) filterCabang.value = '';
                    if (filterDateStart) filterDateStart.value = '';
                    if (filterDateEnd) filterDateEnd.value = '';
                    bucket = 'all';
                    if (segEl) {
                        segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                            var on = b.dataset.bucket === 'all';
                            b.classList.toggle('active', on);
                            b.setAttribute('aria-selected', on ? 'true' : 'false');
                        });
                    }
                    applyFilter();
                });
            }

            if (segEl) {
                segEl.addEventListener('click', function (e) {
                    var btn = e.target.closest('.oct-seg-item');
                    if (!btn) return;
                    bucket = btn.dataset.bucket;
                    segEl.querySelectorAll('.oct-seg-item').forEach(function (b) {
                        var on = b === btn;
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    applyFilter();
                });
            }

            applyFilter();
        }

        /* ── Destructive / irreversible actions ────────────────── */
        document.addEventListener('submit', function (ev) {
            var form = ev.target;
            var isDelete = form.matches && form.matches('form[data-confirm-delete]');
            var isVerify = form.matches && form.matches('form[data-confirm-verify]');
            if (!isDelete && !isVerify) return;
            if (form.dataset.confirmHandled === '1') return;

            ev.preventDefault();
            var kode = form.dataset.kode || 'pesanan ini';

            var opts = isDelete
                ? {
                    icon: 'warning',
                    title: 'Hapus pesanan?',
                    text: 'Pesanan ' + kode + ' dihapus permanen dan tidak dapat dikembalikan.',
                    confirmText: 'Ya, hapus'
                }
                : {
                    icon: 'question',
                    title: 'Verifikasi pesanan?',
                    text: 'Pesanan ' + kode + ' diteruskan ke gudang untuk dikemas.',
                    confirmText: 'Ya, verifikasi'
                };

            Aqua.confirm(opts).then(function (r) {
                if (!r.isConfirmed) return;
                form.dataset.confirmHandled = '1';
                form.submit();
            });
        }, true);

        /* ── Flash messages ────────────────────────────────────── */
        Aqua.flash({
            deleted: 'Pesanan dihapus',
            updated: 'Pesanan diverifikasi',
            barang_dikirim: 'Barang berhasil dikirim'
        });
    })();
</script>
