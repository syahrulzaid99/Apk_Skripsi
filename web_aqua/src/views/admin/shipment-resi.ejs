<%
    var s = shipment || {};
    var itemsList = Array.isArray(items) ? items : [];
    var kode = s.kode_pengiriman || '';

    function resiDate(v) {
        if (!v) return null;
        var d = new Date(v && v._seconds ? v._seconds * 1000 : v);
        return isNaN(d) ? null : d;
    }
    function resiFmt(v, withTime) {
        var d = resiDate(v);
        if (!d) return '—';
        var opt = { day: '2-digit', month: 'short', year: 'numeric' };
        if (withTime) { opt.hour = '2-digit'; opt.minute = '2-digit'; }
        return d.toLocaleDateString('id-ID', opt);
    }
    function angka(n) { return Number(n || 0).toLocaleString('id-ID'); }

    var resiStatus = String(s.status || '').toLowerCase();
    var STATUS_LABEL = {
        draft: 'Draft', dikirim: 'Dalam perjalanan', terkirim: 'Dalam perjalanan',
        diterima: 'Diterima', ditolak: 'Ditolak'
    };

    var namaPengirim = (pengirim && (pengirim.nama_cabang || pengirim.username || pengirim.nama)) || '—';
    var namaPenerima = (penerima && (penerima.nama_cabang || penerima.username || penerima.nama)) || '—';
    var alamatBaris = [];
    if (penerima) {
        if (penerima.jalan) alamatBaris.push(penerima.jalan);
        var kotaProv = [penerima.kota, penerima.provinsi].filter(Boolean).join(', ');
        if (kotaProv) alamatBaris.push(kotaProv);
    }

    var totalQty = 0;
    for (var i = 0; i < itemsList.length; i++) totalQty += Number(itemsList[i]._qty || 0);

    var resiLoc = null;
    if (resiStatus === 'diterima' && s.lokasi_penerimaan) resiLoc = s.lokasi_penerimaan;
    else if (resiStatus === 'ditolak' && s.lokasi_penolakan) resiLoc = s.lokasi_penolakan;

    var tglKirim = s.createdAt || s.created_at || s.tanggal_kirim || null;
%>
<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">

    <style>
        /* Halaman ini dirender tanpa layouts/base.ejs (layout: false),
           jadi ia membawa salinan token sendiri — sama seperti login.ejs. */
        :root {
            --oct-primary: #6E5DE7;
            --oct-primary-bg: #EEEBFD;
            --oct-on-primary: #FFFFFF;
            --oct-bg: #F5F4FA;
            --oct-card: #FFFFFF;
            --oct-inset: #F7F6FC;
            --oct-text: #16141F;
            --oct-text-2: #5C5872;
            --oct-text-muted: #8B87A0;
            --oct-border: #E4E1F0;
            --oct-border-light: #EFEDF7;
            --oct-green-dark: #0D7A4E;
            --oct-red-dark: #B23636;
            --oct-shadow-lift: 0 14px 34px rgba(30, 22, 70, 0.12);
            --oct-r-lg: 16px;
            --oct-r-sm: 9px;
        }

        @page { margin: 8mm; }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 1.5rem 1rem 3rem;
            background: var(--oct-bg);
            color: var(--oct-text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 12px;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Bilah aksi: hanya tampil di layar ─────────────────── */
        .resi-toolbar {
            max-width: 560px;
            margin: 0 auto 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            background: var(--oct-card);
            border: 1px solid var(--oct-border-light);
            border-radius: var(--oct-r-lg);
            padding: 0.875rem 1rem;
        }

        .resi-toolbar-title {
            display: block;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.9375rem;
            letter-spacing: -0.025em;
        }

        .resi-toolbar-sub {
            display: block;
            font-size: 0.75rem;
            color: var(--oct-text-2);
            margin-top: 0.125rem;
        }

        .resi-toolbar-actions { display: flex; align-items: center; gap: 0.5rem; }

        .resi-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            border: 1px solid var(--oct-border);
            background: var(--oct-card);
            color: var(--oct-text);
            border-radius: var(--oct-r-sm);
            padding: 0.4375rem 0.875rem;
            font-size: 0.8125rem;
            font-weight: 600;
            font-family: inherit;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.16s ease, border-color 0.16s ease;
        }

        .resi-btn:hover { background: var(--oct-inset); border-color: var(--oct-primary); }

        .resi-btn-primary {
            background: var(--oct-primary);
            border-color: var(--oct-primary);
            color: var(--oct-on-primary);
        }

        .resi-btn-primary:hover { background: var(--oct-primary); border-color: var(--oct-primary); opacity: 0.92; }

        .resi-btn:focus-visible { outline: 2px solid var(--oct-primary); outline-offset: 2px; }

        /* ── Lembar resi: 80 mm, sama seperti hasil cetak ──────── */
        .resi {
            width: 80mm;
            margin: 0 auto;
            background: var(--oct-card);
            border: 1px solid var(--oct-border-light);
            border-radius: var(--oct-r-lg);
            box-shadow: var(--oct-shadow-lift);
            padding: 5mm;
        }

        .resi-brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--oct-border);
        }

        .resi-mark {
            width: 26px;
            height: 26px;
            border-radius: 8px;
            background: var(--oct-primary);
            color: var(--oct-on-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 11px;
            flex-shrink: 0;
        }

        .resi-brand-name {
            display: block;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 13px;
            letter-spacing: -0.02em;
            line-height: 1.2;
        }

        .resi-brand-sub { display: block; font-size: 10px; color: var(--oct-text-muted); }

        .resi-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 15px;
            font-weight: 800;
            letter-spacing: -0.03em;
            margin: 0.625rem 0 0.125rem;
        }

        .resi-status {
            display: inline-block;
            border: 1px solid var(--oct-border);
            border-radius: 6px;
            padding: 1px 6px;
            font-size: 10px;
            font-weight: 700;
            color: var(--oct-text-2);
        }

        .resi-status-ok { border-color: var(--oct-green-dark); color: var(--oct-green-dark); }
        .resi-status-bad { border-color: var(--oct-red-dark); color: var(--oct-red-dark); }

        .resi-barcode {
            text-align: center;
            margin: 0.625rem 0 0.5rem;
        }

        .resi-barcode svg { max-width: 100%; height: auto; }

        .resi-section {
            border-top: 1px dashed var(--oct-border);
            padding-top: 0.5rem;
            margin-top: 0.5rem;
        }

        .resi-key {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--oct-text-muted);
            margin-bottom: 1px;
        }

        .resi-val { font-size: 12px; font-weight: 500; word-break: break-word; }
        .resi-val-mono { font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace; font-size: 11px; }

        .resi-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.5rem 0.625rem;
        }

        .resi-row + .resi-row { margin-top: 0.4375rem; }

        .resi-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 0.375rem;
            font-size: 11px;
        }

        .resi-table th {
            text-align: left;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--oct-text-muted);
            border-bottom: 1px solid var(--oct-border);
            padding: 3px 4px;
        }

        .resi-table td {
            padding: 4px;
            border-bottom: 1px solid var(--oct-border-light);
            vertical-align: top;
        }

        .resi-table tfoot td {
            border-top: 1px solid var(--oct-border);
            border-bottom: none;
            font-weight: 700;
            padding-top: 5px;
        }

        .resi-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .resi-table .col-fit { width: 1%; white-space: nowrap; }
        .resi-mono { font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace; font-size: 10px; }
        .resi-muted { color: var(--oct-text-muted); }

        .resi-sign {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.625rem;
            margin-top: 0.875rem;
            text-align: center;
        }

        .resi-sign-line {
            margin-top: 14mm;
            border-top: 1px solid var(--oct-border);
            padding-top: 3px;
            font-size: 10px;
            color: var(--oct-text-2);
        }

        .resi-foot {
            margin: 0.75rem 0 0;
            font-size: 9px;
            color: var(--oct-text-muted);
            text-align: center;
        }

        /* ── Cetak: hitam-putih murni untuk printer termal ─────── */
        @media print {
            :root {
                --oct-text: #000000;
                --oct-text-2: #000000;
                --oct-text-muted: #000000;
                --oct-border: #000000;
                --oct-border-light: #000000;
                --oct-card: #FFFFFF;
                --oct-bg: #FFFFFF;
                --oct-primary: #000000;
                --oct-on-primary: #FFFFFF;
                --oct-green-dark: #000000;
                --oct-red-dark: #000000;
            }

            body { padding: 0; background: var(--oct-bg); }
            .resi-toolbar { display: none !important; }

            .resi {
                width: 80mm;
                margin: 0;
                padding: 0;
                border: none;
                border-radius: 0;
                box-shadow: none;
            }

            /* .resi-mark tetap blok hitam dengan teks putih lewat token di atas. */
            .resi-table { page-break-inside: auto; }
            .resi-table tr { page-break-inside: avoid; }
        }
    </style>
</head>

<body onload="window.print()">
    <div class="resi-toolbar">
        <div>
            <span class="resi-toolbar-title">Pratinjau resi</span>
            <span class="resi-toolbar-sub">Dialog cetak terbuka otomatis. Ukuran kertas 80 mm.</span>
        </div>
        <div class="resi-toolbar-actions">
            <a class="resi-btn" href="/admin/shipments">Kembali</a>
            <button type="button" class="resi-btn resi-btn-primary" onclick="window.print()">Cetak resi</button>
        </div>
    </div>

    <article class="resi">
        <div class="resi-brand">
            <span class="resi-mark" aria-hidden="true">AQ</span>
            <span>
                <span class="resi-brand-name">Aqua Stock</span>
                <span class="resi-brand-sub">Distribusi Aqua Japan</span>
            </span>
        </div>

        <h1 class="resi-title">Resi pengiriman</h1>
        <div>
            <span class="resi-status <%= resiStatus === 'diterima' ? 'resi-status-ok' : (resiStatus === 'ditolak' ? 'resi-status-bad' : '') %>">
                <%= STATUS_LABEL[resiStatus] || (resiStatus ? resiStatus : 'Belum ada status') %>
            </span>
        </div>

        <div class="resi-barcode">
            <svg id="barcode" role="img" aria-label="Barcode kode pengiriman <%= kode || 'belum tersedia' %>"></svg>
            <% if (!kode) { %><div class="resi-muted">Kode pengiriman belum tersedia</div><% } %>
        </div>

        <div class="resi-section">
            <div class="resi-grid">
                <div>
                    <div class="resi-key">Kode resi</div>
                    <div class="resi-val resi-val-mono"><%= kode || '—' %></div>
                </div>
                <div>
                    <div class="resi-key">Tanggal kirim</div>
                    <div class="resi-val"><%= resiFmt(tglKirim, true) %></div>
                </div>
                <div>
                    <div class="resi-key">Nomor PO</div>
                    <div class="resi-val resi-val-mono"><%= s.po_number || '—' %></div>
                </div>
                <div>
                    <div class="resi-key">Nomor SO</div>
                    <div class="resi-val resi-val-mono"><%= s.so_number || '—' %></div>
                </div>
            </div>
        </div>

        <div class="resi-section">
            <div class="resi-row">
                <div class="resi-key">Pengirim</div>
                <div class="resi-val"><%= namaPengirim %></div>
            </div>
            <div class="resi-row">
                <div class="resi-key">Penerima</div>
                <div class="resi-val"><%= namaPenerima %></div>
                <% if (alamatBaris.length) { %>
                    <div class="resi-val resi-muted">
                        <% for (var a = 0; a < alamatBaris.length; a++) { %><%= alamatBaris[a] %><% if (a < alamatBaris.length - 1) { %><br><% } %><% } %>
                    </div>
                <% } else { %>
                    <div class="resi-val resi-muted">Alamat belum dilengkapi</div>
                <% } %>
            </div>
        </div>

        <% if (resiLoc && resiLoc.lat != null && resiLoc.lng != null) { %>
        <div class="resi-section">
            <div class="resi-key">Lokasi <%= resiStatus === 'diterima' ? 'penerimaan' : 'penolakan' %></div>
            <div class="resi-val resi-val-mono"><%= resiLoc.lat %>, <%= resiLoc.lng %></div>
            <% if (resiLoc.accuracy != null) { %>
                <div class="resi-val resi-muted">Akurasi &plusmn;<%= Number(resiLoc.accuracy).toFixed(0) %> m</div>
            <% } %>
            <% if (resiLoc.captured_at) { %>
                <div class="resi-val resi-muted"><%= resiLoc.captured_at %></div>
            <% } %>
            <% if (resiLoc.address) { %>
                <div class="resi-val resi-muted"><%= resiLoc.address %></div>
            <% } %>
        </div>
        <% } %>

        <div class="resi-section">
            <div class="resi-key">Rincian barang</div>
            <table class="resi-table">
                <thead>
                    <tr>
                        <th class="col-fit">No</th>
                        <th>Nama barang</th>
                        <th class="num">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (itemsList.length === 0) { %>
                        <tr><td colspan="3" class="resi-muted" style="text-align:center; padding:10px 4px;">Belum ada rincian barang.</td></tr>
                    <% } %>
                    <% for (var it = 0; it < itemsList.length; it++) {
                        var b = itemsList[it];
                        var namaBarang = b._nama_produk || b.nama_produk || b.nama || '—';
                        var kodeBarang = b._barcode || b.barcode || '';
                    %>
                    <tr>
                        <td class="col-fit resi-muted"><%= it + 1 %></td>
                        <td>
                            <%= namaBarang %>
                            <% if (kodeBarang) { %><br><span class="resi-mono resi-muted"><%= kodeBarang %></span><% } %>
                        </td>
                        <td class="num"><%= angka(b._qty) %></td>
                    </tr>
                    <% } %>
                </tbody>
                <tfoot>
                    <tr>
                        <td class="col-fit"></td>
                        <td>Total <%= angka(itemsList.length) %> produk</td>
                        <td class="num"><%= angka(totalQty) %></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="resi-sign">
            <div>
                <div class="resi-key">Pengirim</div>
                <div class="resi-sign-line"><%= namaPengirim %></div>
            </div>
            <div>
                <div class="resi-key">Penerima</div>
                <div class="resi-sign-line"><%= namaPenerima %></div>
            </div>
        </div>

        <p class="resi-foot">Dicetak <%= resiFmt(new Date(), true) %> &middot; Aqua Stock</p>
    </article>

    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script>
        (function () {
            var kode = "<%= kode %>";
            if (!kode || typeof JsBarcode === 'undefined') return;
            JsBarcode("#barcode", kode, {
                format: "CODE128",
                displayValue: true,
                width: 1.6,
                height: 44,
                fontSize: 12,
                margin: 4
            });
        })();
    </script>
</body>

</html>
