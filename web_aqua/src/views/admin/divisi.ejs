<%
    var list = Array.isArray(divisi) ? divisi : [];

    function dvsDate(v) {
        if (!v) return null;
        var d = new Date(v && v._seconds ? v._seconds * 1000 : v);
        return isNaN(d) ? null : d;
    }
    function dvsFmt(v) {
        var d = dvsDate(v);
        if (!d) return '—';
        return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
    }
    function angka(n) { return Number(n || 0).toLocaleString('id-ID'); }

    var totalDivisi = list.length;
    var nBerketerangan = 0, nBaru = 0;
    var batasBaru = Date.now() - (30 * 24 * 60 * 60 * 1000);
    for (var i = 0; i < list.length; i++) {
        if (String(list[i].keterangan || '').trim()) nBerketerangan++;
        var dd = dvsDate(list[i].createdAt);
        if (dd && dd.getTime() >= batasBaru) nBaru++;
    }
    var nTanpaKeterangan = totalDivisi - nBerketerangan;
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .dvs-toolbar-label {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--oct-text-muted);
        white-space: nowrap;
    }

    /* DataTables menyisipkan wrapper-nya di dalam .oct-tablewrap:
       beri jarak agar info & paginasi tidak menempel ke tepi kartu tabel. */
    .dvs-dt .dataTables_info,
    .dvs-dt .dataTables_paginate {
        padding-left: 0.875rem;
        padding-right: 0.875rem;
        padding-bottom: 0.75rem;
    }

    .dvs-name {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        min-width: 0;
    }

    .dvs-tag {
        width: 28px;
        height: 28px;
        border-radius: 9px;
        background: var(--oct-primary-bg);
        color: var(--oct-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6875rem;
        flex-shrink: 0;
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Kelola divisi</h1>
        <p class="oct-page-sub">Divisi mengelompokkan produk di katalog pusat dan menjadi penyaring pada halaman produk serta laporan.</p>
    </div>
    <div class="oct-page-actions">
        <a class="btn btn-outline-secondary" href="/admin/products">
            <i class="fas fa-box mr-2"></i>Lihat produk
        </a>
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalCreate">
            <i class="fas fa-plus mr-2"></i>Tambah divisi
        </button>
    </div>
</div>

<% if (totalDivisi === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-tags"></i></div>
            <h2 class="oct-empty-title">Belum ada divisi</h2>
            <p class="oct-empty-text">Buat divisi seperti Elektronik atau Minuman agar produk lebih mudah dikelompokkan dan dicari.</p>
            <div class="oct-empty-actions">
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalCreate">
                    <i class="fas fa-plus mr-2"></i>Tambah divisi
                </button>
            </div>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-tags"></i></span>
                    <span class="oct-kpi-label">Total divisi</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(totalDivisi) %></span>
                    <span class="oct-kpi-note">kelompok produk</span>
                </div>
                <div class="oct-kpi-foot">Dipakai sebagai penyaring di halaman produk</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-align-left"></i></span>
                    <span class="oct-kpi-label">Punya keterangan</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(nBerketerangan) %></span>
                    <% if (nTanpaKeterangan > 0) { %>
                        <span class="oct-delta oct-delta-warn"><i class="fas fa-circle-exclamation"></i> <%= angka(nTanpaKeterangan) %> kosong</span>
                    <% } else { %>
                        <span class="oct-kpi-note">lengkap</span>
                    <% } %>
                </div>
                <div class="oct-kpi-foot">Keterangan memudahkan staf baru memahami divisi</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-clock-rotate-left"></i></span>
                    <span class="oct-kpi-label">Ditambahkan 30 hari terakhir</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(nBaru) %></span>
                    <span class="oct-kpi-note">divisi baru</span>
                </div>
                <div class="oct-kpi-foot">Berdasarkan tanggal pembuatan</div>
            </div>
        </div>
    </div>

    <!-- Daftar divisi -->
    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Daftar divisi</h2>
                <p class="oct-card-sub">Menghapus divisi tidak mengubah produk yang sudah memakainya.</p>
            </div>
            <div class="oct-row">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="tableSearch">Cari divisi</label>
                    <input type="text" id="tableSearch" placeholder="Cari nama atau keterangan…" autocomplete="off">
                </div>
            </div>
        </div>

        <div class="oct-toolbar">
            <span class="dvs-toolbar-label"><i class="fas fa-filter mr-1"></i>Keterangan</span>
            <div class="oct-seg" id="dvsSeg" role="tablist" aria-label="Saring berdasarkan kelengkapan keterangan">
                <button type="button" role="tab" class="oct-seg-item active" data-ket="all" aria-selected="true">
                    Semua<span class="oct-seg-count"><%= angka(totalDivisi) %></span>
                </button>
                <button type="button" role="tab" class="oct-seg-item" data-ket="ada" aria-selected="false">
                    Sudah diisi<span class="oct-seg-count"><%= angka(nBerketerangan) %></span>
                </button>
                <button type="button" role="tab" class="oct-seg-item" data-ket="kosong" aria-selected="false">
                    Belum diisi<span class="oct-seg-count"><%= angka(nTanpaKeterangan) %></span>
                </button>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card dvs-dt">
                <table class="oct-table" id="divisiTable">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Nama divisi</th>
                            <th>Keterangan</th>
                            <th class="col-fit">Dibuat</th>
                            <th class="oct-td-actions">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (list.length === 0) { %>
                            <tr><td colspan="5" class="oct-td-muted text-center" style="padding:1.5rem;">Belum ada data.</td></tr>
                        <% } %>
                        <% for (var li = 0; li < list.length; li++) {
                            var d = list[li];
                            var ket = String(d.keterangan || '').trim();
                            var dibuat = dvsDate(d.createdAt);
                        %>
                        <tr>
                            <td class="col-fit oct-td-muted"><%= li + 1 %></td>
                            <td>
                                <div class="dvs-name">
                                    <span class="dvs-tag" aria-hidden="true"><i class="fas fa-tag"></i></span>
                                    <span class="oct-cell-main"><%= d.nama || '—' %></span>
                                </div>
                            </td>
                            <td><% if (ket) { %><%= ket %><% } else { %><span class="oct-td-muted">—</span><% } %></td>
                            <td class="col-fit oct-td-muted" data-order="<%= dibuat ? dibuat.getTime() : 0 %>"><%= dvsFmt(d.createdAt) %></td>
                            <td class="oct-td-actions">
                                <button type="button" class="oct-icon-btn oct-icon-btn-primary" data-toggle="modal"
                                    data-target="#modalEdit" data-id="<%= d.id %>" data-nama="<%= d.nama %>"
                                    data-keterangan="<%= d.keterangan || '' %>"
                                    title="Ubah divisi" aria-label="Ubah divisi <%= d.nama || '' %>">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button type="button" class="oct-icon-btn oct-icon-btn-danger btn-del" data-id="<%= d.id %>" data-nama="<%= d.nama %>"
                                    title="Hapus divisi" aria-label="Hapus divisi <%= d.nama || '' %>">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
<% } %>

<!-- CREATE MODAL -->
<div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="modalCreateLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <form method="post" action="/admin/divisi" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalCreateLabel">Tambah divisi</h5>
                    <p class="oct-card-sub">Nama divisi harus unik.</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="cr_nama">Nama divisi</label>
                    <input name="nama" id="cr_nama" class="form-control" required placeholder="mis. Televisi, Elektronik" autocomplete="off">
                </div>
                <div class="form-group mb-0">
                    <label for="cr_keterangan">Keterangan <span class="oct-label-hint">(opsional)</span></label>
                    <textarea name="keterangan" id="cr_keterangan" class="form-control" rows="2" placeholder="Jelaskan singkat isi divisi ini."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk mr-2"></i>Simpan divisi</button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="modalEditLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <form id="formEdit" method="post" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalEditLabel">Ubah divisi</h5>
                    <p class="oct-card-sub">Produk yang sudah memakai nama lama tidak ikut berubah.</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="edit_nama">Nama divisi</label>
                    <input name="nama" id="edit_nama" class="form-control" required autocomplete="off">
                </div>
                <div class="form-group mb-0">
                    <label for="edit_keterangan">Keterangan <span class="oct-label-hint">(opsional)</span></label>
                    <textarea name="keterangan" id="edit_keterangan" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk mr-2"></i>Simpan perubahan</button>
            </div>
        </form>
    </div>
</div>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        /* ── Tabel divisi ──────────────────────────────────────── */
        if ($('#divisiTable').length && $.fn.DataTable) {
            /* Penyaring kelengkapan keterangan — kolom ke-2 */
            let ketFilter = 'all';
            $.fn.dataTable.ext.search.push(function (settings, data) {
                if (!settings.nTable || settings.nTable.id !== 'divisiTable') return true;
                if (ketFilter === 'all') return true;
                /* Buang sisa markup agar perbandingan tetap benar apa pun tipe kolom */
                const ket = String(data[2] || '').replace(/<[^>]*>/g, '').trim();
                const ada = ket !== '' && ket !== '—';
                return ketFilter === 'ada' ? ada : !ada;
            });

            const dt = $('#divisiTable').DataTable({
                pageLength: 10,
                lengthChange: false,
                order: [[1, 'asc']],
                columnDefs: [{ orderable: false, targets: [0, 4] }],
                language: {
                    emptyTable: 'Belum ada divisi.',
                    zeroRecords: 'Tidak ada divisi yang cocok.',
                    info: 'Menampilkan _START_–_END_ dari _TOTAL_ divisi',
                    infoEmpty: 'Tidak ada divisi',
                    infoFiltered: '(disaring dari _MAX_ divisi)',
                    paginate: { first: 'Awal', last: 'Akhir', next: 'Berikutnya', previous: 'Sebelumnya' }
                }
            });
            $('#divisiTable_filter').hide();
            $('#tableSearch').on('keyup', function () { dt.search(this.value).draw(); });

            $('#dvsSeg').on('click', '.oct-seg-item', function () {
                const $btn = $(this);
                ketFilter = String($btn.data('ket'));
                $('#dvsSeg .oct-seg-item').removeClass('active').attr('aria-selected', 'false');
                $btn.addClass('active').attr('aria-selected', 'true');
                dt.draw();
            });

            /* Hapus divisi */
            $('#divisiTable').on('click', '.btn-del', function () {
                const $btn = $(this);
                const id = $btn.data('id');
                const nama = $btn.data('nama');
                Aqua.confirm({
                    title: 'Hapus divisi?',
                    text: 'Divisi ' + nama + ' dihapus permanen. Produk yang memakainya tidak ikut terhapus.',
                    confirmText: 'Ya, hapus'
                }).then(function (r) {
                    if (!r.isConfirmed) return;
                    const form = $('<form>', { method: 'post', action: '/admin/divisi/' + id + '/delete' });
                    form.append($('<input>', { type: 'hidden', name: '_csrf', value: '<%= csrfToken %>' }));
                    $('body').append(form); form.trigger('submit');
                });
            });
        }

        /* ── Modal ubah divisi ─────────────────────────────────── */
        $('#modalEdit').on('show.bs.modal', function (e) {
            const $btn = $(e.relatedTarget).closest('button');
            const id = $btn.data('id');
            $('#formEdit').attr('action', '/admin/divisi/' + id);
            $('#edit_nama').val($btn.data('nama'));
            $('#edit_keterangan').val($btn.data('keterangan'));
        });

        /* ── Pesan kilat ───────────────────────────────────────── */
        Aqua.flash({
            created: 'Divisi ditambahkan',
            updated: 'Perubahan disimpan',
            deleted: 'Divisi dihapus'
        });
    });
</script>
