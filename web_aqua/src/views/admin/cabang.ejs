<%
    var list = Array.isArray(cabangSummaries) ? cabangSummaries : [];
    var areaList = Array.isArray(areas) ? areas : [];
    var sel = (typeof selectedCabang !== 'undefined') ? selectedCabang : null;
    var selId = (typeof selectedCabangId !== 'undefined') ? selectedCabangId : null;

    var totalCabang = list.length;
    var totalStok = 0, totalJenis = 0, totalKiriman = 0, cabangKosong = 0;
    for (var ki = 0; ki < list.length; ki++) {
        totalStok += Number(list[ki].totalStok || 0);
        totalJenis += Number(list[ki].totalItems || 0);
        totalKiriman += Number(list[ki].totalShipmentsDiterima || 0);
        if (!Number(list[ki].totalStok || 0)) cabangKosong++;
    }

    function angka(n) { return Number(n || 0).toLocaleString('id-ID'); }
    function cbInitial(s) { return String(s || 'C').charAt(0).toUpperCase(); }

    var selStocks = (sel && Array.isArray(sel.stocks)) ? sel.stocks : [];
    var selTotalStok = 0;
    for (var xi = 0; xi < selStocks.length; xi++) selTotalStok += Number(selStocks[xi].stok || 0);
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .cbg-tablehost .dataTables_info,
    .cbg-tablehost .dataTables_paginate { padding-left: 0.875rem; padding-right: 0.875rem; }

    .cbg-area {
        max-width: 220px;
        min-width: 160px;
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Stok cabang</h1>
        <p class="oct-page-sub">Pantau sebaran stok yang sudah diterima tiap cabang dan buka rinciannya per produk.</p>
    </div>
    <% if (sel) { %>
    <div class="oct-page-actions">
        <a href="/admin/cabang" class="btn btn-outline-secondary">
            <i class="fas fa-xmark mr-2"></i>Tutup detail
        </a>
    </div>
    <% } %>
</div>

<!-- Ringkasan -->
<div class="oct-panel mb-3">
    <div class="oct-kpi-grid">
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-store"></i></span>
                <span class="oct-kpi-label">Total cabang</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= angka(totalCabang) %></span>
                <span class="oct-kpi-note"><%= selectedArea ? 'di ' + selectedArea : 'semua area' %></span>
            </div>
            <% if (cabangKosong > 0) { %>
                <div class="oct-kpi-foot"><%= angka(cabangKosong) %> cabang belum punya stok</div>
            <% } %>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-boxes-stacked"></i></span>
                <span class="oct-kpi-label">Total stok tersebar</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= angka(totalStok) %></span>
                <span class="oct-kpi-note">unit</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-layer-group"></i></span>
                <span class="oct-kpi-label">Jenis produk tercatat</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= angka(totalJenis) %></span>
                <span class="oct-kpi-note">baris stok cabang</span>
            </div>
        </div>
        <div class="oct-kpi oct-rise">
            <div class="oct-kpi-head">
                <span class="oct-kpi-icon"><i class="fas fa-truck-fast"></i></span>
                <span class="oct-kpi-label">Pengiriman diterima</span>
            </div>
            <div class="oct-kpi-body">
                <span class="oct-kpi-value"><%= angka(totalKiriman) %></span>
                <span class="oct-kpi-note">surat jalan</span>
            </div>
        </div>
    </div>
</div>

<!-- Daftar cabang -->
<section class="oct-card mb-3">
    <div class="oct-card-head">
        <div>
            <h2 class="oct-card-title">Daftar cabang</h2>
            <p class="oct-card-sub">Angka stok dihitung dari seluruh pengiriman yang sudah dikonfirmasi cabang.</p>
        </div>
        <div class="oct-row">
            <label class="oct-sr" for="areaFilter">Saring area</label>
            <select id="areaFilter" class="form-control form-control-sm cbg-area">
                <option value="">Semua area</option>
                <% for (var ai = 0; ai < areaList.length; ai++) { var a = areaList[ai]; %>
                    <option value="<%= a %>" <%= a === selectedArea ? 'selected' : '' %>><%= a %></option>
                <% } %>
            </select>
            <% if (totalCabang > 0) { %>
            <div class="oct-search">
                <i class="fas fa-magnifying-glass"></i>
                <label class="oct-sr" for="tableSearch">Cari cabang</label>
                <input type="text" id="tableSearch" placeholder="Cari cabang atau kota…" autocomplete="off">
            </div>
            <% } %>
        </div>
    </div>

    <% if (totalCabang === 0) { %>
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-store-slash"></i></div>
            <h2 class="oct-empty-title">Belum ada data cabang</h2>
            <p class="oct-empty-text">
                <% if (selectedArea) { %>
                    Tidak ada cabang pada area <%= selectedArea %>. Pilih area lain untuk melihat datanya.
                <% } else { %>
                    Cabang yang terdaftar sebagai pengguna akan muncul di sini beserta stok yang dimilikinya.
                <% } %>
            </p>
            <% if (selectedArea) { %>
            <div class="oct-empty-actions">
                <a href="/admin/cabang" class="btn btn-primary">Tampilkan semua area</a>
            </div>
            <% } %>
        </div>
    <% } else { %>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body cbg-tablehost">
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table" id="cabangTable">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Cabang</th>
                            <th>Kota</th>
                            <th>Provinsi</th>
                            <th class="num">Jenis produk</th>
                            <th class="num">Total stok</th>
                            <th class="num">Pengiriman</th>
                            <th class="oct-td-actions">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var i = 0; i < list.length; i++) {
                            var c = list[i];
                            var namaC = c.nama_cabang || c.username || '—';
                            var punyaStok = Number(c.totalStok || 0) > 0;
                        %>
                        <tr class="<%= (selId && c.id === selId) ? 'oct-tr-active' : '' %>">
                            <td class="col-fit oct-td-muted"><%= i + 1 %></td>
                            <td>
                                <div class="oct-cell-media">
                                    <span class="oct-avatar oct-avatar-sm"><%= cbInitial(namaC) %></span>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= namaC %></span>
                                        <span class="oct-cell-sub"><%= c.username || '—' %></span>
                                    </span>
                                </div>
                            </td>
                            <td><%= c.kota || '—' %></td>
                            <td><%= c.provinsi || '—' %></td>
                            <td class="num"><%= angka(c.totalItems) %></td>
                            <td class="num <%= punyaStok ? 'oct-td-strong' : 'oct-td-muted' %>"><%= angka(c.totalStok) %></td>
                            <td class="num"><%= angka(c.totalShipmentsDiterima) %></td>
                            <td class="oct-td-actions">
                                <a href="/admin/cabang?cabang=<%= c.id %>" class="oct-icon-btn oct-icon-btn-primary"
                                   title="Lihat detail stok <%= namaC %>" aria-label="Lihat detail stok <%= namaC %>">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="oct-td-muted">Total <%= angka(totalCabang) %> cabang</td>
                            <td class="num"><%= angka(totalJenis) %></td>
                            <td class="num"><%= angka(totalStok) %></td>
                            <td class="num"><%= angka(totalKiriman) %></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    <% } %>
</section>

<!-- Detail stok cabang -->
<% if (sel) { %>
<section class="oct-card" id="detailCabang">
    <div class="oct-card-head">
        <div>
            <h2 class="oct-card-title">Detail stok — <%= sel.nama_cabang || sel.username || '—' %></h2>
            <p class="oct-card-sub"><%= angka(selStocks.length) %> jenis produk &middot; <%= angka(selTotalStok) %> unit tersedia di cabang ini.</p>
        </div>
        <a href="/admin/cabang" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-xmark mr-1"></i>Tutup
        </a>
    </div>

    <% if (selStocks.length > 0) { %>
    <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>
    <% } %>

    <div class="oct-card-body">
        <div class="oct-panel-inset mb-3">
            <div class="oct-dl">
                <div>
                    <div class="oct-dl-key">Nama cabang</div>
                    <div class="oct-dl-val"><%= sel.nama_cabang || '—' %></div>
                </div>
                <div>
                    <div class="oct-dl-key">Username</div>
                    <div class="oct-dl-val"><%= sel.username || '—' %></div>
                </div>
                <div>
                    <div class="oct-dl-key">Alamat</div>
                    <div class="oct-dl-val"><%= [sel.jalan, sel.kota, sel.provinsi].filter(Boolean).join(', ') || '—' %></div>
                </div>
                <div>
                    <div class="oct-dl-key">Pengiriman diterima</div>
                    <div class="oct-dl-val"><%= angka(sel.totalShipmentsDiterima) %> surat jalan</div>
                </div>
            </div>
        </div>

        <% if (selStocks.length > 0) { %>
            <div class="oct-tablewrap oct-tablewrap-card">
                <table class="oct-table oct-table-sm" id="stockDetailTable">
                    <thead>
                        <tr>
                            <th class="col-fit">#</th>
                            <th>Produk</th>
                            <th>SKU</th>
                            <th>Barcode</th>
                            <th class="col-fit">Divisi</th>
                            <th class="num">Stok tersedia</th>
                            <th>Satuan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (var si = 0; si < selStocks.length; si++) { var s = selStocks[si]; %>
                        <tr>
                            <td class="col-fit oct-td-muted"><%= si + 1 %></td>
                            <td>
                                <div class="oct-cell-media">
                                    <% if (s.gambar_url) { %>
                                        <img class="oct-thumb" src="<%= s.gambar_url %>" alt="Foto produk <%= s.nama_produk || 'tanpa nama' %>" loading="lazy">
                                    <% } else { %>
                                        <span class="oct-thumb oct-thumb-empty"><i class="fas fa-image"></i></span>
                                    <% } %>
                                    <span class="oct-cell-main"><%= s.nama_produk || '—' %></span>
                                </div>
                            </td>
                            <td class="oct-mono"><%= s.sku || '—' %></td>
                            <td class="oct-td-muted oct-mono"><%= s.barcode || '—' %></td>
                            <td class="col-fit"><% if (s.divisi) { %><span class="oct-chip"><%= s.divisi %></span><% } else { %><span class="oct-td-muted">—</span><% } %></td>
                            <td class="num <%= Number(s.stok || 0) > 0 ? 'oct-td-strong' : 'oct-td-muted' %>"><%= angka(s.stok) %></td>
                            <td class="oct-td-muted"><%= s.satuan || '—' %></td>
                        </tr>
                        <% } %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="oct-td-muted">Total stok</td>
                            <td class="num"><%= angka(selTotalStok) %></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        <% } else { %>
            <div class="oct-empty">
                <div class="oct-empty-icon"><i class="fas fa-box-open"></i></div>
                <h2 class="oct-empty-title">Belum ada stok di cabang ini</h2>
                <p class="oct-empty-text">Stok bertambah otomatis setiap kali cabang mengonfirmasi pengiriman dari pusat.</p>
            </div>
        <% } %>
    </div>
</section>
<% } %>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        /* ── Tabel cabang ───────────────────────────────────────── */
        if ($('#cabangTable').length) {
            var dt = $('#cabangTable').DataTable({
                pageLength: 10,
                lengthChange: false,
                order: [[1, 'asc']],
                columnDefs: [{ orderable: false, targets: [0, -1] }],
                language: {
                    search: 'Cari:',
                    paginate: { previous: 'Sebelumnya', next: 'Selanjutnya' },
                    info: 'Menampilkan _START_ s/d _END_ dari _TOTAL_ cabang',
                    infoEmpty: 'Tidak ada cabang untuk ditampilkan',
                    emptyTable: 'Tidak ada data',
                    zeroRecords: 'Tidak ada cabang yang cocok'
                }
            });
            $('#cabangTable_filter').hide();
            $('#tableSearch').on('keyup', function () { dt.search(this.value).draw(); });
        }

        /* ── Saring area (memuat ulang halaman) ─────────────────── */
        $('#areaFilter').on('change', function () {
            var params = new URLSearchParams(window.location.search);
            var area = this.value;
            if (area) params.set('area', area); else params.delete('area');
            window.location.href = '/admin/cabang' + (params.toString() ? '?' + params.toString() : '');
        });

        /* ── Tabel detail stok ──────────────────────────────────── */
        <% if (sel && selStocks.length > 0) { %>
        $('#stockDetailTable').DataTable({
            pageLength: 25,
            lengthChange: false,
            order: [[1, 'asc']],
            columnDefs: [{ orderable: false, targets: 0 }],
            language: {
                search: 'Cari:',
                paginate: { previous: 'Sebelumnya', next: 'Selanjutnya' },
                info: 'Menampilkan _START_ s/d _END_ dari _TOTAL_ produk',
                zeroRecords: 'Tidak ada produk yang cocok'
            }
        });
        $('html, body').animate({ scrollTop: $('#detailCabang').offset().top - 80 }, 400);
        <% } %>
    });
</script>
