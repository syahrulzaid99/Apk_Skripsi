<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.5rem;">
    <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(1.25rem,3vw,1.5rem); font-weight:700; margin:0; color:var(--oct-text);">
        <span style="margin-right:0.5rem;">&#128666;</span>Pengiriman
    </h1>
</div>

<style>
    .oct-card { background: var(--oct-card); border: 1px solid var(--oct-border-light); border-radius: 16px; box-shadow: var(--oct-shadow-sm); overflow: hidden; margin-bottom: 1.25rem; }
    .oct-card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--oct-border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .oct-card-body { padding: 1.25rem 1.5rem; }
    .oct-pill { padding: 0.375em 1em; border-radius: 50rem; font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; display: inline-block; }
    .oct-pill-terkirim, .oct-pill-dikirim { background: #06B6D4; }
    .oct-pill-diterima { background: var(--oct-green-dark); }
    .oct-pill-ditolak { background: var(--oct-red); }
    .oct-pill-draft { background: var(--oct-text-muted); }
    .oct-kode { color: var(--oct-primary); background: var(--oct-primary-bg); padding: 0.25rem 0.625rem; border-radius: 6px; font-weight: 700; font-size: 0.8125rem; font-family: 'JetBrains Mono', monospace; }
    .oct-btn-print { background: var(--oct-primary); color: #fff; padding: 0.375em 1em; border-radius: 50rem; font-weight: 600; font-size: 0.6875rem; text-decoration: none; text-transform: uppercase; letter-spacing: 0.05em; display: inline-flex; align-items: center; gap: 0.375rem; transition: all 0.15s ease; }
    .oct-btn-print:hover { background: var(--oct-primary-dark); color: #fff; text-decoration: none; transform: translateY(-1px); }
    .oct-btn-del { background: linear-gradient(135deg, #EF4444, #DC2626); color: #fff; border: none; border-radius: 8px; padding: 0.375rem 0.625rem; font-size: 0.8125rem; cursor: pointer; transition: all 0.15s ease; }
    .oct-btn-del:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(239,68,68,0.3); }
    .oct-table { border-collapse: separate; border-spacing: 0; }
    .oct-table thead th { border-bottom: 2px solid var(--oct-border); background: var(--oct-bg); color: var(--oct-text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.6875rem; letter-spacing: 0.06em; padding: 0.75rem 0.625rem; }
    .oct-table td { border-top: 1px solid var(--oct-border-light); padding: 0.625rem; vertical-align: middle; font-size: 0.875rem; }
    .oct-table tbody tr:hover { background: var(--oct-card-hover); }
    .oct-grand-total { font-weight: 900; font-size: 1.0625rem; background: linear-gradient(135deg, var(--oct-green-dark), #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .bukti-img { border-radius: 8px; border: 2px solid var(--oct-card); box-shadow: 0 4px 10px rgba(0,0,0,0.1); transition: transform 0.2s ease; }
    .bukti-img:hover { transform: scale(1.15); }
</style>

<!-- Filter -->
<div class="card" style="margin-bottom:1rem;">
    <div class="card-body" style="padding:1rem 1.25rem;">
        <!-- Search -->
        <div class="input-group" style="margin-bottom:0.875rem;">
            <div class="input-group-prepend"><span class="input-group-text" style="border-radius:10px 0 0 10px;"><i class="fas fa-search"></i></span></div>
            <input id="filterSearch" class="form-control form-control-sm" placeholder="Cari kode resi, PO, SO, pengirim, atau penerima..." style="border-radius:0 10px 10px 0;">
        </div>
        <!-- Cabang filter -->
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:0.375rem;">
            <span style="font-size:0.6875rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--oct-text-muted); margin-right:0.25rem;"><i class="fas fa-store" style="margin-right:0.25rem;"></i> Cabang</span>
            <button type="button" class="btn btn-sm btn-primary filter-cabang active" data-cabang="all">Semua</button>
            <% if(typeof cabangs !== 'undefined' && Array.isArray(cabangs)) { cabangs.forEach(function(c) { %>
                <button type="button" class="btn btn-sm btn-outline-secondary filter-cabang" data-cabang="<%= c.id %>"><%= c.nama_cabang || c.username || c.id %></button>
            <% }) } %>
        </div>
    </div>
</div>

<% var list = Array.isArray(shipments) ? shipments : []; %>

<% if (list.length === 0) { %>
    <div class="oct-card"><div class="oct-card-body" style="padding:2rem; text-align:center; color:var(--oct-text-muted);">Tidak ada pengiriman.</div></div>
<% } %>

<% for (var si = 0; si < list.length; si++) { %>
    <% var s = list[si]; var st = (s.status || '').toLowerCase(); var pengirim = (usersMap && usersMap[s.pengirim]) ? usersMap[s.pengirim] : null; var penerima = (usersMap && usersMap[s.penerima]) ? usersMap[s.penerima] : null; %>
    <div class="oct-card" data-pengirim="<%= s.pengirim || '' %>" data-penerima="<%= s.penerima || '' %>" data-search="<%= ((s.kode_pengiriman || '') + ' ' + (s.po_number || '') + ' ' + (s.so_number || '') + ' ' + (pengirim ? (pengirim.username + ' ' + (pengirim.nama_cabang || '')) : '') + ' ' + (penerima ? (penerima.username + ' ' + (penerima.nama_cabang || '')) : '') + ' ' + (s.keterangan || '') + ' ' + (s.status || '')).toLowerCase() %>">
        <div class="oct-card-header">
            <div>
                <div style="font-weight:700; margin-bottom:0.5rem;">Kode Resi: <span class="oct-kode"><%= s.kode_pengiriman %></span></div>
                <div style="font-size:0.8125rem; color:var(--oct-text-muted); margin-bottom:0.25rem;">
                    <i class="fas fa-file-invoice" style="margin-right:0.25rem;"></i> PO: <strong style="color:var(--oct-text);"><%= s.po_number || '-' %></strong>
                    <span style="margin:0 0.5rem; color:var(--oct-border);">•</span> SO: <strong style="color:var(--oct-text);"><%= s.so_number || '-' %></strong>
                </div>
                <div style="font-size:0.8125rem; color:var(--oct-text-muted);">
                    <i class="fas fa-truck" style="margin-right:0.25rem;"></i> Asal: <strong style="color:var(--oct-text);"><%= pengirim ? pengirim.username : s.pengirim %></strong>
                    <span style="color:var(--oct-primary); margin:0 0.5rem;">→</span> Tujuan: <strong style="color:var(--oct-text);"><%= penerima ? penerima.username : s.penerima %></strong>
                </div>
            </div>
            <div class="d-flex align-items-center" style="gap:0.625rem;">
                <span class="oct-pill oct-pill-<%= st %>"><%= (s.status || 'draft').toUpperCase() %></span>
                <a class="oct-btn-print" href="/admin/shipments/<%= s.id %>/resi" target="_blank"><i class="fas fa-print"></i> Cetak Resi</a>
                <form method="POST" action="/admin/shipments/<%= s.id %>/delete" class="d-inline" data-confirm>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="oct-btn-del"><i class="fas fa-trash"></i></button>
                </form>
            </div>
        </div>

        <div class="oct-card-body">
            <div class="table-responsive">
                <table class="table oct-table w-100" style="margin-bottom:0.5rem;">
                    <thead><tr>
                        <th style="width:48px;">#</th><th style="width:64px;">Gambar</th><th>SKU</th><th>Nama Produk</th>
                        <th style="width:100px;">Satuan</th><th style="width:130px;">Barcode</th>
                        <th style="width:110px;" class="text-right">Harga</th><th style="width:90px;" class="text-right">Qty Kirim</th>
                        <th style="width:90px;" class="text-right">Qty Terima</th><th style="width:130px;" class="text-right">Subtotal</th>
                    </tr></thead>
                    <tbody>
                        <% var grandTotal = 0; var items = Array.isArray(s.data_barang) ? s.data_barang : []; for (var i = 0; i < items.length; i++) { var it = items[i]; var p = null; var pid = it.product_id || it.produk_id || it.productId || it.id || it.product || it.pid || it.id_produk; if (pid && productsMap && productsMap[pid]) { p = productsMap[pid]; } var qtyKirim = Number(it._qty || it.qty || it.jumlah || it.quantity || it.qty_in || it.qty_out || 0); var qtyTerima = it.qty_diterima != null ? Number(it.qty_diterima) : null; var sku = (p && p.sku) || it.sku || '-'; var nama = (p && p.nama_produk) || it.nama || it.nama_produk || '-'; var satuan = (p && p.satuan) || it.satuan || '-'; var barcode = (p && p.barcode) || it.barcode || '-'; var img = (p && p.gambar_url) || ''; var netVal = Number(it.item_net_value || it.harga) || 0; var tax = Number(it.item_tax) || 0; var unitPrice = netVal + tax; var subtotal = qtyKirim * unitPrice; grandTotal += subtotal; %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td class="text-center"><% if (img) { %><img src="<%= img %>" alt="img" style="width:44px;height:44px;object-fit:cover;border-radius:8px;"><% } else { %><span style="color:var(--oct-text-muted); font-size:0.8125rem;">(no image)</span><% } %></td>
                            <td><%= sku %></td><td><%= nama %></td><td><%= satuan %></td><td><%= barcode %></td>
                            <td class="text-right">Rp <%= unitPrice.toLocaleString('id-ID') %></td>
                            <td class="text-right font-weight-bold"><%= qtyKirim %></td>
                            <td class="text-right"><% if (st === 'diterima' && qtyTerima != null) { %><%= qtyTerima %><% if (qtyTerima < qtyKirim) { %> <span class="badge badge-warning">kurang</span><% } %><% } else { %>-<% } %></td>
                            <td class="text-right font-weight-bold" style="color:var(--oct-primary);">Rp <%= subtotal.toLocaleString('id-ID') %></td>
                        </tr>
                        <% } %>
                    </tbody>
                    <tfoot><tr style="background:var(--oct-bg);">
                        <td colspan="8" class="text-right text-uppercase" style="font-weight:700; color:var(--oct-text-muted); font-size:0.75rem; letter-spacing:0.05em; vertical-align:middle;">Grand Total</td>
                        <td colspan="2" class="text-right oct-grand-total">Rp <%= grandTotal.toLocaleString('id-ID') %></td>
                    </tr></tfoot>
                </table>
            </div>

            <% if (st === 'diterima' && Array.isArray(s.bukti_penerimaan_urls) && s.bukti_penerimaan_urls.length) { %>
                <div style="margin-top:1.25rem; padding:1rem; background:var(--oct-bg); border-radius:12px;">
                    <div style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--oct-primary); margin-bottom:0.5rem;"><i class="fas fa-camera" style="margin-right:0.375rem;"></i> Bukti Penerimaan Cabang</div>
                    <div class="d-flex flex-wrap" style="gap:0.625rem;">
                        <% for (var b = 0; b < s.bukti_penerimaan_urls.length; b++) { %>
                            <a href="<%= s.bukti_penerimaan_urls[b] %>" target="_blank"><img src="<%= s.bukti_penerimaan_urls[b] %>" class="bukti-img" style="width:85px;height:85px;object-fit:cover;"></a>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <% var loc = null; if (st === 'diterima' && s.lokasi_penerimaan) { loc = s.lokasi_penerimaan; } else if (st === 'ditolak' && s.lokasi_penolakan) { loc = s.lokasi_penolakan; } %>
            <% if (loc && loc.lat != null && loc.lng != null) { %>
                <div style="margin-top:1rem; padding:1rem; background:rgba(251,191,36,0.08); border:1px solid rgba(251,191,36,0.2); border-radius:12px;">
                    <div style="display:flex; align-items:center; margin-bottom:0.5rem;">
                        <i class="fas fa-map-marker-alt" style="color:var(--oct-red); margin-right:0.5rem;"></i>
                        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--oct-yellow-dark); letter-spacing:0.05em;">Lokasi <%= st === 'diterima' ? 'Penerimaan' : 'Penolakan' %> Cabang</span>
                    </div>
                    <div style="font-size:0.8125rem;">
                        <div style="margin-bottom:0.375rem;"><span style="color:var(--oct-text-muted);">Koordinat:</span> <strong style="font-family:monospace;"><%= loc.lat %>, <%= loc.lng %></strong></div>
                        <% if (loc.accuracy != null) { %><div style="margin-bottom:0.375rem;"><span style="color:var(--oct-text-muted);">Akurasi:</span> <strong>±<%= Number(loc.accuracy).toFixed(0) %> m</strong></div><% } %>
                        <% if (loc.address) { %><div style="margin-bottom:0.375rem;"><span style="color:var(--oct-text-muted);">Alamat:</span> <strong><%= loc.address %></strong></div><% } %>
                        <a class="btn btn-sm btn-outline-danger" style="margin-top:0.375rem;" href="https://www.google.com/maps?q=<%= loc.lat %>,<%= loc.lng %>" target="_blank"><i class="fas fa-external-link-alt" style="margin-right:0.375rem;"></i> Buka di Google Maps</a>
                    </div>
                </div>
            <% } %>

            <div style="margin-top:1.25rem;">
                <% if (st === 'diterima') { %>
                    <div class="alert alert-success d-flex align-items-center" style="margin:0;"><i class="fas fa-check-circle" style="margin-right:0.75rem; font-size:1.125rem;"></i><div><strong>Pengiriman Sudah Diterima</strong><br><small style="color:var(--oct-text-muted);">Tidak dapat diubah lagi.</small></div></div>
                <% } else { %>
                    <form method="POST" action="/admin/shipments/<%= s.id %>" class="form-inline" data-confirm-status>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group mb-2 mr-2">
                            <label class="mr-2">Status</label>
                            <select name="status" class="form-control form-control-sm">
                                <option value="draft" <%= st === 'draft' ? 'selected' : '' %>>draft</option>
                                <option value="terkirim" <%= (st === 'terkirim' || st === 'dikirim') ? 'selected' : '' %>>terkirim</option>
                                <option value="diterima" <%= st === 'diterima' ? 'selected' : '' %>>diterima</option>
                                <option value="ditolak" <%= st === 'ditolak' ? 'selected' : '' %>>ditolak</option>
                            </select>
                        </div>
                        <div class="form-group mb-2 mr-2">
                            <input type="text" name="keterangan" class="form-control form-control-sm" placeholder="Keterangan" value="<%= s.keterangan || '' %>">
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary mb-2"><i class="fas fa-save" style="margin-right:0.375rem;"></i> Simpan</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>
<% } %>

<script>
    (function () {
        var params = new URLSearchParams(window.location.search);
        var ok = params.get('ok'), err = params.get('err');
        function hasSwal() { return typeof Swal !== 'undefined' && Swal && Swal.fire; }
        if (ok && hasSwal()) {
            var title = ok === 'created' ? 'Pengiriman dibuat' : ok === 'updated' ? 'Perubahan disimpan' : ok === 'deleted' ? 'Pengiriman dihapus' : ok === 'confirmed' ? 'Konfirmasi tersimpan' : ok;
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: title, showConfirmButton: false, timer: 2200, timerProgressBar: true });
            params.delete('ok'); window.history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params.toString() : ''));
        }
        if (err && hasSwal()) { Swal.fire({ icon: 'error', title: 'Gagal', text: err, confirmButtonColor: '#3B82F6' }); params.delete('err'); window.history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params.toString() : '')); }

        document.addEventListener('submit', function (ev) {
            var form = ev.target;
            if (!form.matches('form[data-confirm]') && !form.matches('form[data-confirm-status]')) return;
            if (form.dataset.confirmHandled === '1') return;
            ev.preventDefault();
            var isDelete = form.matches('form[data-confirm]');
            var msg = isDelete ? 'Yakin hapus item ini?' : 'Status akan diubah. Simpan perubahan?';
            var title = isDelete ? 'Konfirmasi' : 'Ubah Status?';
            Swal.fire({ icon: isDelete ? 'warning' : 'question', title: title, text: msg, showCancelButton: true, confirmButtonText: isDelete ? 'Hapus' : 'Simpan', cancelButtonText: 'Batal', confirmButtonColor: isDelete ? '#EF4444' : '#3B82F6' }).then(function(r) { if (r.isConfirmed) { form.dataset.confirmHandled = '1'; form.submit(); } });
        }, true);

        var filterBtns = document.querySelectorAll('.filter-cabang');
        var shipmentCards = document.querySelectorAll('.oct-card[data-pengirim]');
        var filterSearch = document.getElementById('filterSearch');
        var activeCabang = 'all';

        function applyShipmentFilter() {
            var q = (filterSearch.value || '').toLowerCase().trim();
            shipmentCards.forEach(function(card) {
                var matchCabang = (activeCabang === 'all' || card.getAttribute('data-pengirim') === activeCabang || card.getAttribute('data-penerima') === activeCabang);
                var matchSearch = !q || (card.getAttribute('data-search') || '').indexOf(q) !== -1;
                card.style.display = (matchCabang && matchSearch) ? '' : 'none';
            });
        }

        filterBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                activeCabang = this.getAttribute('data-cabang');
                filterBtns.forEach(function(b) { b.classList.remove('btn-primary'); b.classList.add('btn-outline-secondary'); });
                this.classList.remove('btn-outline-secondary'); this.classList.add('btn-primary');
                applyShipmentFilter();
            });
        });

        filterSearch.addEventListener('input', applyShipmentFilter);
    })();
</script>