<%
    var list = Array.isArray(products) ? products : [];
    var divisiList = (typeof listDivisi !== 'undefined' && Array.isArray(listDivisi)) ? listDivisi : [];

    function rupiah(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
    function angka(n) { return Number(n || 0).toLocaleString('id-ID'); }

    // Ambang batas stok menipis — dipakai untuk pil status pada tabel
    var AMBANG_MENIPIS = 10;

    var totalProduk = list.length;
    var totalUnit = 0, nilaiModal = 0, nHabis = 0, nMenipis = 0, nTanpaDivisi = 0;
    var perDivisi = {};

    for (var i = 0; i < list.length; i++) {
        var stok = Number(list[i].stok || 0);
        totalUnit += stok;
        nilaiModal += stok * Number(list[i].harga_modal || 0);
        if (stok <= 0) nHabis++;
        else if (stok <= AMBANG_MENIPIS) nMenipis++;
        var dv = String(list[i].divisi || '').trim();
        if (dv) perDivisi[dv] = (perDivisi[dv] || 0) + 1;
        else nTanpaDivisi++;
    }
%>

<style>
    /* View-scoped only — shared components live in layouts/base.ejs */
    .prd-toolbar-label {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--oct-text-muted);
        white-space: nowrap;
    }

    /* DataTables menyisipkan wrapper-nya di dalam .oct-tablewrap:
       beri jarak agar info & paginasi tidak menempel ke tepi kartu tabel. */
    .prd-dt .dataTables_info,
    .prd-dt .dataTables_paginate {
        padding-left: 0.875rem;
        padding-right: 0.875rem;
        padding-bottom: 0.75rem;
    }

    .prd-preview-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
</style>

<div class="oct-page-head">
    <div>
        <h1 class="oct-page-title">Kelola produk</h1>
        <p class="oct-page-sub">Katalog produk pusat beserta SKU, harga, dan stok gudang yang menjadi sumber semua pengiriman ke cabang.</p>
    </div>
    <div class="oct-page-actions">
        <a class="btn btn-outline-secondary" href="/admin/divisi">
            <i class="fas fa-tags mr-2"></i>Kelola divisi
        </a>
        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalCreate">
            <i class="fas fa-plus mr-2"></i>Tambah produk
        </button>
    </div>
</div>

<% if (totalProduk === 0) { %>
    <div class="oct-card">
        <div class="oct-empty">
            <div class="oct-empty-icon"><i class="fas fa-box-open"></i></div>
            <h2 class="oct-empty-title">Belum ada produk</h2>
            <p class="oct-empty-text">Tambahkan produk pertama agar cabang dapat memesan dan gudang dapat mencatat stoknya.</p>
            <div class="oct-empty-actions">
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#modalCreate">
                    <i class="fas fa-plus mr-2"></i>Tambah produk
                </button>
            </div>
        </div>
    </div>
<% } else { %>

    <!-- Ringkasan katalog -->
    <div class="oct-panel mb-3">
        <div class="oct-kpi-grid">
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon oct-kpi-icon-accent"><i class="fas fa-box"></i></span>
                    <span class="oct-kpi-label">Total produk</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(totalProduk) %></span>
                    <span class="oct-kpi-note">SKU aktif</span>
                </div>
                <div class="oct-kpi-foot"><%= divisiList.length %> divisi terdaftar<% if (nTanpaDivisi > 0) { %> &middot; <%= angka(nTanpaDivisi) %> produk tanpa divisi<% } %></div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-cubes"></i></span>
                    <span class="oct-kpi-label">Stok gudang pusat</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(totalUnit) %></span>
                    <span class="oct-kpi-note">unit</span>
                </div>
                <div class="oct-kpi-foot">Akumulasi seluruh produk</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-wallet"></i></span>
                    <span class="oct-kpi-label">Nilai stok modal</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value oct-kpi-value-sm"><%= rupiah(nilaiModal) %></span>
                </div>
                <div class="oct-kpi-foot">Stok dikali harga modal</div>
            </div>
            <div class="oct-kpi oct-rise">
                <div class="oct-kpi-head">
                    <span class="oct-kpi-icon"><i class="fas fa-triangle-exclamation"></i></span>
                    <span class="oct-kpi-label">Perlu diisi ulang</span>
                </div>
                <div class="oct-kpi-body">
                    <span class="oct-kpi-value"><%= angka(nHabis + nMenipis) %></span>
                    <% if (nHabis > 0) { %>
                        <span class="oct-delta oct-delta-down"><i class="fas fa-circle-xmark"></i> <%= angka(nHabis) %> habis</span>
                    <% } else if (nMenipis > 0) { %>
                        <span class="oct-delta oct-delta-warn"><i class="fas fa-clock"></i> menipis</span>
                    <% } else { %>
                        <span class="oct-kpi-note">stok aman</span>
                    <% } %>
                </div>
                <div class="oct-kpi-foot">Menipis bila sisa <%= AMBANG_MENIPIS %> unit atau kurang</div>
            </div>
        </div>
    </div>

    <!-- Daftar produk -->
    <section class="oct-card">
        <div class="oct-card-head">
            <div>
                <h2 class="oct-card-title">Daftar produk</h2>
                <p class="oct-card-sub">Klik ikon pensil untuk mengubah data produk, ikon tong sampah untuk menghapus.</p>
            </div>
            <div class="oct-row">
                <div class="oct-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <label class="oct-sr" for="tableSearch">Cari produk</label>
                    <input type="text" id="tableSearch" placeholder="Cari SKU, nama, atau barcode…" autocomplete="off">
                </div>
            </div>
        </div>

        <div class="oct-toolbar">
            <span class="prd-toolbar-label"><i class="fas fa-layer-group mr-1"></i>Divisi</span>
            <div class="oct-seg" id="prdDivisiSeg" role="tablist" aria-label="Saring berdasarkan divisi">
                <button type="button" role="tab" class="oct-seg-item active" data-divisi="all" aria-selected="true">
                    Semua<span class="oct-seg-count"><%= angka(totalProduk) %></span>
                </button>
                <% for (var di = 0; di < divisiList.length; di++) { var dv2 = divisiList[di]; %>
                    <button type="button" role="tab" class="oct-seg-item" data-divisi="<%= dv2.nama %>" aria-selected="false">
                        <%= dv2.nama %><span class="oct-seg-count"><%= angka(perDivisi[dv2.nama] || 0) %></span>
                    </button>
                <% } %>
            </div>
        </div>

        <div class="oct-table-hint"><i class="fas fa-arrows-left-right"></i> Geser tabel untuk melihat semua kolom</div>

        <div class="oct-card-body">
            <div class="oct-tablewrap oct-tablewrap-card prd-dt">
                <table class="oct-table" id="productsTable">
                    <thead>
                        <tr>
                            <th>Produk</th>
                            <th class="col-fit">Barcode</th>
                            <th class="col-fit">Satuan</th>
                            <th class="col-fit">Divisi</th>
                            <th class="num">Stok</th>
                            <th class="col-fit">Status</th>
                            <th class="num">H. modal</th>
                            <th class="num">H. jual</th>
                            <th class="num">Pajak</th>
                            <th class="oct-td-actions">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (list.length === 0) { %>
                            <tr><td colspan="10" class="oct-td-muted text-center" style="padding:1.5rem;">Belum ada data.</td></tr>
                        <% } %>
                        <% for (var pi = 0; pi < list.length; pi++) {
                            var p = list[pi];
                            var stokP = Number(p.stok || 0);
                            var statusKey = stokP <= 0 ? 'ditolak' : (stokP <= AMBANG_MENIPIS ? 'pending' : 'aktif');
                            var statusLabel = stokP <= 0 ? 'Habis' : (stokP <= AMBANG_MENIPIS ? 'Menipis' : 'Tersedia');
                            var statusOrder = stokP <= 0 ? 0 : (stokP <= AMBANG_MENIPIS ? 1 : 2);
                        %>
                        <tr>
                            <td data-order="<%= p.sku || '' %>" data-search="<%= (p.nama_produk || '') + ' ' + (p.sku || '') %>">
                                <div class="oct-cell-media">
                                    <% if (p.gambar_url) { %>
                                        <img class="oct-thumb" src="<%= p.gambar_url %>" alt="Foto produk <%= p.nama_produk || p.sku || 'tanpa nama' %>" loading="lazy">
                                    <% } else { %>
                                        <span class="oct-thumb oct-thumb-empty"><i class="fas fa-image"></i></span>
                                    <% } %>
                                    <span class="oct-cell-stack">
                                        <span class="oct-cell-main"><%= p.nama_produk || '—' %></span>
                                        <span class="oct-cell-sub oct-mono"><%= p.sku || '—' %></span>
                                    </span>
                                </div>
                            </td>
                            <td class="col-fit oct-td-muted oct-mono" style="font-size:0.75rem;"><%= p.barcode || '—' %></td>
                            <td class="col-fit oct-td-muted"><%= p.satuan || '—' %></td>
                            <td class="col-fit" data-search="<%= p.divisi || '' %>"><% if (p.divisi) { %><span class="oct-chip"><%= p.divisi %></span><% } else { %><span class="oct-td-muted">—</span><% } %></td>
                            <td class="num oct-td-strong" data-order="<%= stokP %>"><%= angka(stokP) %></td>
                            <td class="col-fit" data-order="<%= statusOrder %>"><span class="oct-pill oct-pill-<%= statusKey %>"><%= statusLabel %></span></td>
                            <td class="num" data-order="<%= Number(p.harga_modal || 0) %>"><%= rupiah(p.harga_modal) %></td>
                            <td class="num oct-td-strong" data-order="<%= Number(p.harga_jual || 0) %>"><%= rupiah(p.harga_jual) %></td>
                            <td class="num oct-td-muted" data-order="<%= Number(p.pajak || 0) %>"><%= angka(p.pajak) %></td>
                            <td class="oct-td-actions">
                                <button type="button" class="oct-icon-btn oct-icon-btn-primary" data-toggle="modal"
                                    data-target="#modalEdit" data-id="<%= p.id %>" data-sku="<%= p.sku %>"
                                    data-barcode="<%= p.barcode || '' %>" data-nama-produk="<%= p.nama_produk %>"
                                    data-satuan="<%= p.satuan %>" data-gambar-url="<%= p.gambar_url || '' %>"
                                    data-divisi="<%= p.divisi || '' %>" data-stok="<%= p.stok || 0 %>" data-hargamodal="<%= p.harga_modal || 0 %>"
                                    data-hargajual="<%= p.harga_jual || 0 %>" data-pajak="<%= p.pajak || 0 %>"
                                    title="Ubah produk" aria-label="Ubah produk <%= p.sku || '' %>">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <button type="button" class="oct-icon-btn oct-icon-btn-danger btn-del" data-id="<%= p.id %>" data-sku="<%= p.sku %>"
                                    title="Hapus produk" aria-label="Hapus produk <%= p.sku || '' %>">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
<% } %>

<!-- CREATE MODAL -->
<div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="modalCreateLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <form method="post" action="/admin/products" enctype="multipart/form-data" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalCreateLabel">Tambah produk</h5>
                    <p class="oct-card-sub">SKU wajib unik. Stok yang diisi di sini adalah stok gudang pusat.</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="cr_sku">SKU</label>
                        <input name="sku" id="cr_sku" class="form-control" required autocomplete="off">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="cr_barcode">Barcode <span class="oct-label-hint">(opsional)</span></label>
                        <input name="barcode" id="cr_barcode" class="form-control" autocomplete="off">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="cr_satuan">Satuan</label>
                        <input name="satuan" id="cr_satuan" class="form-control" required placeholder="mis. pcs, box">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label for="cr_nama_produk">Nama produk</label>
                        <input name="nama_produk" id="cr_nama_produk" class="form-control" required>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="cr_divisi">Divisi <span class="oct-label-hint">(opsional)</span></label>
                        <select name="divisi" id="cr_divisi" class="form-control">
                            <option value="">— pilih divisi —</option>
                            <% for (var ci = 0; ci < divisiList.length; ci++) { %><option value="<%= divisiList[ci].nama %>"><%= divisiList[ci].nama %></option><% } %>
                        </select>
                    </div>
                    <div class="form-group col-md-3">
                        <label for="cr_stok">Stok gudang</label>
                        <input type="number" name="stok" id="cr_stok" class="form-control" value="0" min="0" step="1">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="cr_harga_modal">Harga modal</label>
                        <input type="number" name="harga_modal" id="cr_harga_modal" class="form-control" value="0" min="0" step="1">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="cr_harga_jual">Harga jual</label>
                        <input type="number" name="harga_jual" id="cr_harga_jual" class="form-control" value="0" min="0" step="1">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="cr_pajak">Pajak</label>
                        <input type="number" name="pajak" id="cr_pajak" class="form-control" value="0" min="0" step="1">
                    </div>
                </div>
                <div class="form-group mb-0">
                    <label for="cr_gambar">Gambar produk <span class="oct-label-hint">(opsional, maks 5 MB)</span></label>
                    <div class="oct-drop">
                        <input type="file" name="gambar" id="cr_gambar" accept="image/*">
                        <i class="fas fa-cloud-arrow-up oct-drop-icon"></i>
                        <span class="oct-drop-text">Seret berkas ke sini atau klik untuk memilih</span>
                        <span class="oct-drop-hint">JPG, PNG, WEBP atau GIF</span>
                        <span class="oct-drop-files"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk mr-2"></i>Simpan produk</button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="modalEditLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <form id="formEdit" method="post" enctype="multipart/form-data" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalEditLabel">Ubah produk</h5>
                    <p class="oct-card-sub">Kosongkan bagian gambar bila foto tidak diganti.</p>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="edit_sku">SKU</label>
                        <input name="sku" id="edit_sku" class="form-control" required autocomplete="off">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="edit_barcode">Barcode <span class="oct-label-hint">(opsional)</span></label>
                        <input name="barcode" id="edit_barcode" class="form-control" autocomplete="off">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="edit_satuan">Satuan</label>
                        <input name="satuan" id="edit_satuan" class="form-control" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label for="edit_nama_produk">Nama produk</label>
                        <input name="nama_produk" id="edit_nama_produk" class="form-control" required>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="edit_divisi">Divisi <span class="oct-label-hint">(opsional)</span></label>
                        <select name="divisi" id="edit_divisi" class="form-control">
                            <option value="">— pilih divisi —</option>
                            <% for (var ei = 0; ei < divisiList.length; ei++) { %><option value="<%= divisiList[ei].nama %>"><%= divisiList[ei].nama %></option><% } %>
                        </select>
                    </div>
                    <div class="form-group col-md-3">
                        <label for="edit_stok">Stok gudang</label>
                        <input type="number" name="stok" id="edit_stok" class="form-control" value="0" step="1">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="edit_harga_modal">Harga modal</label>
                        <input type="number" name="harga_modal" id="edit_harga_modal" class="form-control" value="0" step="1">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="edit_harga_jual">Harga jual</label>
                        <input type="number" name="harga_jual" id="edit_harga_jual" class="form-control" value="0" step="1">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="edit_pajak">Pajak</label>
                        <input type="number" name="pajak" id="edit_pajak" class="form-control" value="0" step="1">
