                </div>
                <div class="form-group mb-0">
                    <label for="edit_gambar">Gambar produk <span class="oct-label-hint">(biarkan kosong bila tidak diubah)</span></label>
                    <div class="prd-preview-row">
                        <img id="edit_preview" class="oct-thumb oct-thumb-lg" src="" alt="Pratinjau gambar produk" style="display:none;">
                        <div class="oct-drop" style="flex:1;">
                            <input type="file" name="gambar" id="edit_gambar" accept="image/*">
                            <i class="fas fa-cloud-arrow-up oct-drop-icon"></i>
                            <span class="oct-drop-text">Seret berkas ke sini atau klik untuk memilih</span>
                            <span class="oct-drop-hint">JPG, PNG, WEBP atau GIF &middot; maks 5 MB</span>
                            <span class="oct-drop-files"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-primary" type="submit"><i class="fas fa-floppy-disk mr-2"></i>Simpan perubahan</button>
            </div>
        </form>
    </div>
</div>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        /* ── Tabel produk ──────────────────────────────────────── */
        if ($('#productsTable').length && $.fn.DataTable) {
            const dt = $('#productsTable').DataTable({
                pageLength: 10,
                lengthChange: false,
                order: [[0, 'asc']],
                columnDefs: [{ orderable: false, targets: [9] }],
                language: {
                    emptyTable: 'Belum ada produk.',
                    zeroRecords: 'Tidak ada produk yang cocok.',
                    info: 'Menampilkan _START_–_END_ dari _TOTAL_ produk',
                    infoEmpty: 'Tidak ada produk',
                    infoFiltered: '(disaring dari _MAX_ produk)',
                    paginate: { first: 'Awal', last: 'Akhir', next: 'Berikutnya', previous: 'Sebelumnya' }
                }
            });
            $('#productsTable_filter').hide();
            $('#tableSearch').on('keyup', function () { dt.search(this.value).draw(); });

            /* Saring per divisi — kolom ke-3 adalah kolom Divisi */
            $('#prdDivisiSeg').on('click', '.oct-seg-item', function () {
                const $btn = $(this);
                const divisi = String($btn.data('divisi'));
                $('#prdDivisiSeg .oct-seg-item').removeClass('active').attr('aria-selected', 'false');
                $btn.addClass('active').attr('aria-selected', 'true');
                const aman = divisi.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                dt.column(3).search(divisi === 'all' ? '' : '^' + aman + '$', true, false).draw();
            });

            /* Hapus produk */
            $('#productsTable').on('click', '.btn-del', function () {
                const $btn = $(this);
                const id = $btn.data('id');
                const sku = $btn.data('sku');
                Aqua.confirm({
                    title: 'Hapus produk?',
                    text: 'Produk ' + sku + ' dihapus permanen beserta fotonya.',
                    confirmText: 'Ya, hapus'
                }).then(function (r) {
                    if (!r.isConfirmed) return;
                    const form = $('<form>', { method: 'post', action: '/admin/products/' + id + '/delete' });
                    form.append($('<input>', { type: 'hidden', name: '_csrf', value: '<%= csrfToken %>' }));
                    $('body').append(form); form.trigger('submit');
                });
            });
        }

        /* ── Modal ubah produk ─────────────────────────────────── */
        $('#modalEdit').on('show.bs.modal', function (e) {
            const $btn = $(e.relatedTarget).closest('button');
            const id = $btn.data('id');
            $('#formEdit').attr('action', '/admin/products/' + id);
            $('#edit_sku').val($btn.data('sku'));
            $('#edit_barcode').val($btn.data('barcode'));
            $('#edit_nama_produk').val($btn.data('nama-produk'));
            $('#edit_satuan').val($btn.data('satuan'));
            $('#edit_divisi').val($btn.data('divisi'));
            $('#edit_stok').val($btn.data('stok'));
            $('#edit_harga_modal').val($btn.data('hargamodal'));
            $('#edit_harga_jual').val($btn.data('hargajual'));
            $('#edit_pajak').val($btn.data('pajak'));
            const img = $btn.data('gambar-url');
            if (img) { $('#edit_preview').attr('src', img).show(); } else { $('#edit_preview').hide(); }
        });

        /* ── Pesan kilat ───────────────────────────────────────── */
        Aqua.flash({
            created: 'Produk ditambahkan',
            updated: 'Perubahan disimpan',
            deleted: 'Produk dihapus'
        });
    });
</script>
